// ⚠ ARCHIVO GENERADO — NO EDITAR A MANO.
// Regenerar con:  bash scripts/gen_prelude.sh   (verificar: --check)
// Fuentes, en este orden: std/{io,math,array,file,map}.nx + scripts/prelude_core.nx.in
// Para agregar algo al prelude se edita el MÓDULO std/ que corresponda
// (o el core, si no pertenece a ninguno) y se regenera. Un edit directo
// acá lo borra la próxima regeneración, y `make test-ai-first` lo caza antes.

// std/io.nx — Funciones de entrada/salida de la Standard Library v0.21

pub fn println(s: String) {
    print(s)
}

// std/math.nx — Funciones matemáticas de la Standard Library v6.0

// Constants
const MATH_PI = 3.14159265358979323846
const MATH_E = 2.71828182845904523536
const MATH_TAU = 6.28318530717958647692

// Signal constants
const SIGINT = 2
const SIGTERM = 15
const SIGKILL = 9
const SIGUSR1 = 10
const SIGUSR2 = 12
const SIGPIPE = 13
const SIGALRM = 14

// Límites de `int` (i64, complemento a dos) — usados por checked_add/sub/mul/div.
const INT_MIN = -9223372036854775808
const INT_MAX = 9223372036854775807

pub fn abs(n: int) -> int {
    if n < 0 { return -n }
    return n
}

pub fn min(a: int, b: int) -> int {
    if a < b { return a }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

pub fn clamp(n: int, lo: int, hi: int) -> int {
    return max(lo, min(n, hi))
}

pub fn pow_int(base: int, exp: int) -> int {
    var result = 1
    var i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

pub fn gcd(a: int, b: int) -> int {
    var x = abs(a)
    var y = abs(b)
    while y != 0 {
        let temp = y
        y = x % y
        x = temp
    }
    return x
}

pub fn lcm(a: int, b: int) -> int {
    if a == 0 or b == 0 { return 0 }
    return abs(a * b) / gcd(a, b)
}

pub fn is_even(n: int) -> bool {
    return n % 2 == 0
}

pub fn is_odd(n: int) -> bool {
    return n % 2 != 0
}

pub fn sqrt_int(n: int) -> int {
    if n < 0 { return -1 }
    if n == 0 { return 0 }
    var x = n
    var y = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

// --- Aritmética chequeada (arco checked-math, docs/design/plans/2026-09-08-checked-math.md) ---
//
// `+`, `-`, `*` en Nyx desbordan en wraparound DEFINIDO de complemento a dos
// (docs/gotchas/int-wraps-silently.md) — no hay `nsw`/`nuw` en el IR. Eso
// significa que el resultado ya calculado, aunque "incorrecto", es
// determinístico y sirve para detectar el desborde con las pruebas de signo
// clásicas de dos-complemento, sin necesitar un tipo más ancho.
// `checked_div` es la excepción: dividir es UB a nivel de IR en dos casos
// (`b == 0`, `INT_MIN / -1`) — esos casos se detectan ANTES y la división
// nunca se ejecuta.

// checked_add: `s = a + b` solo puede desbordar cuando `a` y `b` tienen el
// MISMO signo (sumar dos operandos de signo distinto no puede cruzar el
// límite representable) y el resultado `s` sale con el signo CONTRARIO.
pub fn checked_add(a: int, b: int) -> Option<int> {
    let s: int = a + b
    let a_neg: bool = a < 0
    let b_neg: bool = b < 0
    let s_neg: bool = s < 0
    if a_neg == b_neg and s_neg != a_neg {
        return Option.None
    }
    return Option.Some(s)
}

// checked_sub: `s = a - b` solo puede desbordar cuando `a` y `b` tienen
// signos DISTINTOS (restar dos del mismo signo no puede cruzar el límite) y
// el resultado `s` sale con el signo del sustraendo `b`.
pub fn checked_sub(a: int, b: int) -> Option<int> {
    let s: int = a - b
    let a_neg: bool = a < 0
    let b_neg: bool = b < 0
    let s_neg: bool = s < 0
    if a_neg != b_neg and s_neg == b_neg {
        return Option.None
    }
    return Option.Some(s)
}

// checked_mul: los casos borde se resuelven ANTES de dividir, porque
// dividir por 0 o hacer `INT_MIN / -1` es UB (docs/gotchas/int-wraps-silently.md):
//   - `a == 0 or b == 0` -> `Some(0)` directo, sin tocar `b` como divisor.
//   - `a == -1` (o, simétricamente, `b == -1`): el único desborde posible es
//     multiplicar por `INT_MIN`, porque el complemento a dos no tiene un
//     `+INT_MAX + 1` que represente a `-INT_MIN`.
// Con esos casos afuera, `b` nunca vale `0` ni `-1` en lo que sigue, así que
// la división inversa `p / b` es segura y detecta cualquier otro desborde:
// si el producto envolvió, la vuelta no da `a`.
pub fn checked_mul(a: int, b: int) -> Option<int> {
    if a == 0 or b == 0 {
        return Option.Some(0)
    }
    if a == -1 {
        if b == INT_MIN {
            return Option.None
        }
        return Option.Some(-b)
    }
    if b == -1 {
        if a == INT_MIN {
            return Option.None
        }
        return Option.Some(-a)
    }
    let p: int = a * b
    if p / b != a {
        return Option.None
    }
    return Option.Some(p)
}

// checked_div: los dos casos UB de `sdiv i64` (docs/gotchas/int-wraps-silently.md)
// se detectan ANTES de dividir y NUNCA se ejecutan: `b == 0` (división por
// cero) y `a == INT_MIN and b == -1` (el único cociente que no entra en
// `int`, porque `-INT_MIN` desborda).
pub fn checked_div(a: int, b: int) -> Option<int> {
    if b == 0 {
        return Option.None
    }
    if a == INT_MIN and b == -1 {
        return Option.None
    }
    return Option.Some(a / b)
}

// --- mul_div_round: `a*b/c` con el producto intermedio en 128 bits ---
// (arco checked-math, docs/design/plans/2026-09-08-checked-math.md)
//
// `checked_mul` DETECTA que `a * b` desborda, pero no deja calcular: la
// fórmula financiera `monto * tasa / escala` necesita el producto EXACTO
// aunque no entre en `int`, porque el COCIENTE sí entra (9.3e12 * 1e6
// desborda; 9.3e12 * 1e6 / 1e6 es un número chico). El cálculo vive en C
// —runtime/runtime.c::nyx_mul_div_round, con `__int128`— porque Nyx no tiene
// hoy un entero de 128 bits.
//
// El estado del fallo NO cruza por un out-param (nada de punteros en esta
// frontera, y un `int` de C no se sign-extiende — gotcha
// ffi-c-int-no-sign-extend): la función C lo deja en una variable
// thread-local y el segundo builtin lo devuelve. Se consulta INMEDIATAMENTE
// después de la llamada, antes de cualquier otra cosa que pueda llamarla.
extern "C" fn nyx_mul_div_round(a: int, b: int, c: int, mode: int) -> int
extern "C" fn nyx_mul_div_round_status() -> int

// Modos de redondeo del cociente EXACTO `a*b/c` (D1 del plan):
//   Truncate — hacia cero          Floor — hacia -infinito   Ceil — hacia +infinito
//   HalfUp   — al más cercano, empates ALEJÁNDOSE de cero (2.5 -> 3, -2.5 -> -3)
//   HalfEven — al más cercano, empates al PAR (2.5 -> 2, 3.5 -> 4; bancario)
pub enum RoundMode {
    Truncate,
    Floor,
    Ceil,
    HalfUp,
    HalfEven
}

// Código entero que viaja a C. El `match` es EXPLÍCITO a propósito: si el
// código saliera del orden de declaración del enum, reordenar `RoundMode` un día
// cambiaría en silencio el redondeo de todo el software que lo use.
fn round_mode_code(mode: RoundMode) -> int {
    return match mode {
        RoundMode.Truncate => 0,
        RoundMode.Floor => 1,
        RoundMode.Ceil => 2,
        RoundMode.HalfUp => 3,
        RoundMode.HalfEven => 4
    }
}

// mul_div_round: `a*b/c` redondeado según `mode`, con el producto intermedio
// exacto en 128 bits. PANICA si `c == 0` o si el cociente no entra en `int`
// (D2 del plan, regla de dos niveles de la std). La hermana que devuelve
// `Result<int, Error>` es `try_mul_div_round`, en std/math_ext — no puede
// vivir acá porque std/math.nx viaja en el prelude congelado, que no importa
// std/error (ver la cabecera de std/math_ext.nx).
pub fn mul_div_round(a: int, b: int, c: int, mode: RoundMode) -> int {
    let v: int = nyx_mul_div_round(a, b, c, round_mode_code(mode))
    let st: int = nyx_mul_div_round_status()
    if st == 1 {
        panic("mul_div_round: division by zero")
    }
    if st == 2 {
        panic("mul_div_round: result overflows int")
    }
    return v
}

// std/array.nx — Funciones de array de la Standard Library v0.21
// Nota: push como statement no está disponible. Las funciones que modifican
// arrays operan in-place sobre el array recibido.

pub fn array_sum(arr: Array) -> int {
    var total = 0
    var i = 0
    while i < arr.length() {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

pub fn array_min(arr: Array) -> int {
    var m = arr[0]
    var i = 1
    while i < arr.length() {
        if arr[i] < m { m = arr[i] }
        i = i + 1
    }
    return m
}

pub fn array_max(arr: Array) -> int {
    var m = arr[0]
    var i = 1
    while i < arr.length() {
        if arr[i] > m { m = arr[i] }
        i = i + 1
    }
    return m
}

// array_reverse: invierte arr in-place y lo retorna
pub fn array_reverse(arr: Array) -> Array {
    let n = arr.length()
    var i = 0
    while i < n / 2 {
        let temp = arr[i]
        arr[i] = arr[n - 1 - i]
        arr[n - 1 - i] = temp
        i = i + 1
    }
    return arr
}

pub fn array_contains_int(arr: Array, val: int) -> bool {
    var i = 0
    while i < arr.length() {
        if arr[i] == val { return true }
        i = i + 1
    }
    return false
}

pub fn array_index_of(arr: Array, val: int) -> int {
    var i = 0
    while i < arr.length() {
        if arr[i] == val { return i }
        i = i + 1
    }
    return -1
}

// sort_int: ordena arr in-place (bubble sort) y lo retorna
pub fn sort_int(arr: Array) -> Array {
    let n = arr.length()
    var swapped = true
    while swapped == true {
        swapped = false
        var j = 0
        while j < n - 1 {
            if arr[j] > arr[j + 1] {
                let temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
                swapped = true
            }
            j = j + 1
        }
    }
    return arr
}

// sort_by: ordena arr in-place usando comparator fn
// cmp(a, b) debe retornar int: negativo si a < b, 0 si a == b, positivo si a > b
pub fn sort_by(arr: Array, cmp: Fn(int, int) -> int) -> Array {
    let n = arr.length()
    if n <= 1 { return arr }
    // Insertion sort — estable, simple, eficiente para arrays pequenos
    var i = 1
    while i < n {
        let key = arr[i]
        var j = i - 1
        var done = false
        while j >= 0 and not done {
            let c: int = cmp(arr[j], key)
            if c > 0 {
                arr[j + 1] = arr[j]
                j = j - 1
            } else {
                done = true
            }
        }
        arr[j + 1] = key
        i = i + 1
    }
    return arr
}

// str_compare: compara dos strings lexicograficamente
// retorna negativo si a < b, 0 si iguales, positivo si a > b
pub fn str_compare(a: String, b: String) -> int {
    let la = a.length()
    let lb = b.length()
    var min_len = la
    if lb < min_len { min_len = lb }
    var i = 0
    while i < min_len {
        let ca: int = a.charAt(i) as int
        let cb: int = b.charAt(i) as int
        if ca < cb { return -1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if la < lb { return -1 }
    if la > lb { return 1 }
    return 0
}

// sort_str: ordena array de strings in-place
pub fn sort_str(arr: Array) -> Array {
    let n = arr.length()
    if n <= 1 { return arr }
    var i = 1
    while i < n {
        let key: String = arr[i]
        var j = i - 1
        var done = false
        while j >= 0 and not done {
            let cur: String = arr[j]
            if str_compare(cur, key) > 0 {
                arr[j + 1] = cur
                j = j - 1
            } else {
                done = true
            }
        }
        arr[j + 1] = key
        i = i + 1
    }
    return arr
}

// std/file.nx — Funciones de archivo de la Standard Library v0.21

pub fn read_text(path: String) -> String {
    return read_file(path)
}

pub fn write_text(path: String, content: String) {
    write_file(path, content)
}

// std/map.nx — Funciones de mapa de la Standard Library v0.21

pub fn map_new() -> Map {
    return Map.new()
}

pub fn map_put(m: Map, k: String, v: int) {
    m.insert(k, v)
}

pub fn map_get_int(m: Map, k: String) -> int {
    return m.get(k)
}

pub fn map_has(m: Map, k: String) -> bool {
    return m.contains(k)
}

// Task 2 (campaña "cerrar-silently-wrong"): el bug de tamaño documentado acá
// (mismo que std/prelude.nx::map_size, copia duplicada verbatim) era
// EXACTAMENTE el caso que motivó NYX1022 — m.length() sobre un Map coincidía
// con la rama de Array en codegen y devolvía basura en vez de fallar. NYX1022
// lo detectó en cuanto se activó. Sigue sin pub-earse porque nadie la
// necesitaba con ese nombre; usar directamente `m.size()`.
fn map_size(m: Map) -> int {
    return m.size()
}

// std/error.nx — El tipo Error canónico de la stdlib (E4, spec
// 2026-08-11-errores-tipados-design §3.1, ratificado 2026-08-14).
//
// UN solo shape para toda la std: Result<T, Error> es la firma estándar
// de toda función falible; Option<T> queda para ausencia-sin-causa.
// La regla de dos niveles del híbrido: si el caller razonablemente hace
// algo distinto de loggear-y-morir → Result; si no → panic.
//
// kind usa un VOCABULARIO CERRADO v1 — agregar un kind nuevo es una
// decisión de diseño con ficha, no un string ad-hoc:
//   "not_found"  — el recurso no existe (ENOENT, 404, clave ausente)
//   "permission" — sin permisos (EACCES, 403)
//   "connection" — fallo de red/conexión (ECONNREFUSED, reset)
//   "parse"      — entrada malformada (json inválido, header roto)
//   "timeout"    — se agotó el tiempo (ETIMEDOUT)
//   "in_use"     — el recurso ya está tomado (EADDRINUSE — agregado en
//                  E5.1: sin este kind, un listen duplicado caía en "io"
//                  genérico, indistinguible de cualquier otro fallo de
//                  bind/listen; medido con test-374)
//   "io"         — fallo de E/S genérico (el resto de errno)
//   "invalid"    — argumento/estado inválido (EINVAL)
//   "oom"        — sin memoria (ENOMEM)
//   "eof"        — fin de stream ESPERADO (code 0 — agregado en E5.2b para
//                  las centinelas que necesitan distinguir EOF de un Ok
//                  vacío legítimo, ej. try_tcp_read_line/try_tcp_read_exact
//                  en std/net.nx). NO es un fallo: es información de
//                  control de flujo, como io.EOF en Go. errno_to_kind NO lo
//                  mapea (code 0 real jamás llega a esta función) — el
//                  kind lo arma el caller directo vía err_new(0, "eof", …).
//   "db"         — fallo de motor de base de datos EMBEBIDO (agregado en
//                  E5.5 para try_sqlite_*/std/sqlite.nx). Los result codes
//                  de sqlite3 (1-27: SQLITE_ERROR, SQLITE_INTERNAL,
//                  SQLITE_PERM, ...) COLISIONAN con el espacio errno —
//                  rc 2 es SQLITE_INTERNAL, no ENOENT; mapearlos por
//                  errno_to_kind mentiría sobre la causa. "db" es un
//                  espacio de código PROPIO (mismo precedente que "eof"):
//                  `code` es lo que expone runtime/sqlite_adapter.c para
//                  ese fallo (no siempre el rc granular de sqlite — el
//                  adapter colapsa varias de sus funciones a boolean/NULL,
//                  ver el comentario de try_sqlite_open en std/sqlite.nx),
//                  `msg` es SIEMPRE el errmsg real de sqlite3_errmsg(db)
//                  cuando hay un db handle vivo para consultarlo.

pub struct Error {
    code: int,
    kind: String,
    msg: String,
}

pub fn err_new(code: int, kind: String, msg: String) -> Error {
    return Error { code: code, kind: kind, msg: msg }
}

// errno → kind. Los números son los de Linux (el único target nativo hoy);
// wasm32-wasi mapea sus errno equivalentes a los mismos valores POSIX.
pub fn errno_to_kind(code: int) -> String {
    if code == 2   { return "not_found" }
    if code == 13  { return "permission" }
    if code == 12  { return "oom" }
    if code == 22  { return "invalid" }
    if code == 110 { return "timeout" }
    if code == 111 { return "connection" }
    if code == 98  { return "in_use" }
    return "io"
}

// Formato humano único: es lo que muestra un unwrap() panicante y lo que
// un log estructurado parsea. `kind: msg (code N)`.
pub fn error_to_string(e: Error) -> String {
    return e.kind + ": " + e.msg + " (code " + int_to_string(e.code) + ")"
}

// Distingue EOF-esperado de un fallo real. Necesaria porque Err{code:0}
// rompe el patrón habitual "code != 0 = fallo" (0 normalmente es éxito) —
// comparar e.kind == "eof" a mano en cada call-site es frágil y se
// desincroniza si el vocabulario de kind cambia; este helper es el único
// lugar que conoce el string literal.
pub fn is_eof(e: Error) -> bool {
    return e.kind == "eof"
}

// ─────────────────────────────────────────────────────────────────────────
// CORE DEL LENGUAJE (scripts/prelude_core.nx.in) — las 13 declaraciones que
// NO vienen de ningún módulo std/: Option, Result y los 11 traits de
// sobrecarga de operadores. El compilador las busca POR NOMBRE y sin ellas
// no compila NI UN programa (tampoco el propio compilador), así que no se
// pueden regenerar concatenando: son la única parte del prelude escrita a
// mano. Todo el resto de std/prelude.nx es copia literal de los 5 módulos.
// ─────────────────────────────────────────────────────────────────────────

// === Option<T> and Result<T,E> — builtin generic enums ===

enum Option<T> {
    Some(T),
    None
}

enum Result<T, E> {
    Ok(T),
    Err(E)
}

// === Operator Overloading Traits ===

trait Add { fn add(self, other: Self) -> Self }
trait Sub { fn sub(self, other: Self) -> Self }
trait Mul { fn mul(self, other: Self) -> Self }
trait Div { fn div(self, other: Self) -> Self }
trait Rem { fn rem(self, other: Self) -> Self }
trait Neg { fn neg(self) -> Self }
trait PartialEq { fn eq(self, other: Self) -> bool }
trait PartialOrd { fn lt(self, other: Self) -> bool }
trait Clone { fn clone(self) -> Self }
trait Debug { fn debug_str(self) -> String }
trait Copy { }
