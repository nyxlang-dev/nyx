// std/array.nx — Funciones de array de la Standard Library v0.21
// Nota: push como statement no está disponible. Las funciones que modifican
// arrays operan in-place sobre el array recibido.

pub fn array_sum(arr: Array) -> int {
    var total = 0
    var i = 0
    while i < arr.length() {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

pub fn array_min(arr: Array) -> int {
    var m = arr[0]
    var i = 1
    while i < arr.length() {
        if arr[i] < m { m = arr[i] }
        i = i + 1
    }
    return m
}

pub fn array_max(arr: Array) -> int {
    var m = arr[0]
    var i = 1
    while i < arr.length() {
        if arr[i] > m { m = arr[i] }
        i = i + 1
    }
    return m
}

// array_reverse: invierte arr in-place y lo retorna
pub fn array_reverse(arr: Array) -> Array {
    let n = arr.length()
    var i = 0
    while i < n / 2 {
        let temp = arr[i]
        arr[i] = arr[n - 1 - i]
        arr[n - 1 - i] = temp
        i = i + 1
    }
    return arr
}

pub fn array_contains_int(arr: Array, val: int) -> bool {
    var i = 0
    while i < arr.length() {
        if arr[i] == val { return true }
        i = i + 1
    }
    return false
}

pub fn array_index_of(arr: Array, val: int) -> int {
    var i = 0
    while i < arr.length() {
        if arr[i] == val { return i }
        i = i + 1
    }
    return -1
}

// sort_int: ordena arr in-place (mezcla, O(n log n), estable) y lo retorna
pub fn sort_int(arr: Array) -> Array { return __sort_merge(arr, 0, __sort_sin_cmp) }

// sort_by: ordena arr in-place usando comparator fn (mezcla, O(n log n),
// estable) y lo retorna
// cmp(a, b) debe retornar int: negativo si a < b, 0 si a == b, positivo si a > b
pub fn sort_by(arr: Array, cmp: Fn(int, int) -> int) -> Array { return __sort_merge(arr, 2, cmp) }

// str_compare: compara dos strings lexicograficamente
// retorna negativo si a < b, 0 si iguales, positivo si a > b
pub fn str_compare(a: String, b: String) -> int {
    let la = a.length()
    let lb = b.length()
    var min_len = la
    if lb < min_len { min_len = lb }
    var i = 0
    while i < min_len {
        let ca: int = a.charAt(i) as int
        let cb: int = b.charAt(i) as int
        if ca < cb { return -1 }
        if ca > cb { return 1 }
        i = i + 1
    }
    if la < lb { return -1 }
    if la > lb { return 1 }
    return 0
}

// Ordenacion por mezcla de abajo hacia arriba: O(n log n) y estable. Primero
// ordena tramos de 32 elementos (run = 32) por insercion (en tramos chicos es
// mas rapida que mezclar), despues mezcla tramos de ancho 32, 64, ... alternando
// entre arr y un buffer. Sin recursion: la profundidad no depende de n.
// Es la base de sort_int, sort_str y sort_by (antes burbuja/insercion, O(n^2):
// 32.000 elementos tardaban 15 s en sort_by).
// modo: 0 = enteros, 1 = String (str_compare), 2 = cmp del usuario.
// Compara x[i] con y[j] (negativo, 0, positivo) leyendo cada elemento con el
// tipo de su modo.
fn __sort_cmp(x: Array, i: int, y: Array, j: int, modo: int, cmp: Fn(int, int) -> int) -> int {
    if modo == 0 {
        let a: int = x[i]
        let b: int = y[j]
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
    if modo == 1 {
        let sa: String = x[i]
        let sb: String = y[j]
        return str_compare(sa, sb)
    }
    return cmp(x[i], y[j])
}

fn __sort_merge(arr: Array, modo: int, cmp: Fn(int, int) -> int) -> Array {
    let n = arr.length()
    if n <= 1 { return arr }
    let run = 32
    // 1. Inserción por tramos (estable: solo corre lo estrictamente mayor).
    var lo = 0
    while lo < n {
        var hi = lo + run
        if hi > n { hi = n }
        // Inserción por intercambios adyacentes: solo cruza lo estrictamente
        // mayor, así que los iguales conservan su orden.
        var i = lo + 1
        while i < hi {
            var j = i
            while j > lo and __sort_cmp(arr, j - 1, arr, j, modo, cmp) > 0 {
                let t = arr[j - 1]
                arr[j - 1] = arr[j]
                arr[j] = t
                j = j - 1
            }
            i = i + 1
        }
        lo = hi
    }
    if n <= run { return arr }
    // 2. Mezclas de ancho creciente entre src y dst.
    var buf: Array = []
    var k = 0
    while k < n {
        buf.push(arr[k])
        k = k + 1
    }
    var src: Array = arr
    var dst: Array = buf
    var en_arr = true
    var w = run
    while w < n {
        var a = 0
        while a < n {
            var m = a + w
            if m > n { m = n }
            var b = a + 2 * w
            if b > n { b = n }
            var i = a
            var j = m
            var o = a
            while i < m and j < b {
                // <= 0 toma primero el de la izquierda: estable.
                if __sort_cmp(src, i, src, j, modo, cmp) <= 0 {
                    dst[o] = src[i]
                    i = i + 1
                } else {
                    dst[o] = src[j]
                    j = j + 1
                }
                o = o + 1
            }
            while i < m {
                dst[o] = src[i]
                i = i + 1
                o = o + 1
            }
            while j < b {
                dst[o] = src[j]
                j = j + 1
                o = o + 1
            }
            a = b
        }
        let t = src
        src = dst
        dst = t
        en_arr = not en_arr
        w = w * 2
    }
    // El resultado quedó en src; si src es el buffer, se copia a arr (el
    // contrato es ordenar arr in situ y devolverlo).
    if not en_arr {
        var c = 0
        while c < n {
            arr[c] = src[c]
            c = c + 1
        }
    }
    return arr
}

fn __sort_sin_cmp(a: int, b: int) -> int { return 0 }

// sort_str: ordena array de strings in-place (mezcla, O(n log n), estable)
// y lo retorna
pub fn sort_str(arr: Array) -> Array { return __sort_merge(arr, 1, __sort_sin_cmp) }
