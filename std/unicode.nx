// std/unicode.nx — Unicode utilities for Nyx
//
// chr(code) is byte-level (strings-are-bytes contract, v0.14); this module owns
// the codepoint-level half: utf8_encode (D2), wcwidth/display_width (D4),
// latin1/windows1252 → UTF-8 (D5).

// utf8_encode — encode a Unicode codepoint to its 1-4 UTF-8 bytes.
//
// Total function: invalid input (negative, > U+10FFFF, or the surrogate range
// U+D800..U+DFFF, which UTF-8 forbids) yields U+FFFD (replacement character)
// instead of aborting — the same semantics HTML parsing gives invalid numeric
// character references, which is this function's primary consumer
// (html_unescape). Use char_length() == 1 to sanity-check a result.
pub fn utf8_encode(codepoint: int) -> String {
    var cp: int = codepoint
    if cp < 0 or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) {
        cp = 0xFFFD
    }
    if cp < 0x80 {
        return chr(cp)
    }
    if cp < 0x800 {
        return chr(0xC0 | (cp >> 6)) + chr(0x80 | (cp & 0x3F))
    }
    if cp < 0x10000 {
        return chr(0xE0 | (cp >> 12)) + chr(0x80 | ((cp >> 6) & 0x3F)) + chr(0x80 | (cp & 0x3F))
    }
    return chr(0xF0 | (cp >> 18)) + chr(0x80 | ((cp >> 12) & 0x3F)) + chr(0x80 | ((cp >> 6) & 0x3F)) + chr(0x80 | (cp & 0x3F))
}

// Zero-width codepoints: combining marks + format/joiner characters.
// Curated Kuhn-style subset of the big Unicode table — the ranges that show up
// in real text (Latin/Greek/Cyrillic/Hebrew/Arabic/Indic combining, variation
// selectors, ZWSP/ZWJ family). Unlisted rare combining blocks degrade to
// width 1 (misalignment, never a crash).
fn __ucs_zero_width(cp: int) -> bool {
    if cp >= 0x0300 and cp <= 0x036F { return true }    // combining diacriticals
    if cp >= 0x0483 and cp <= 0x0489 { return true }    // cyrillic combining
    if cp >= 0x0591 and cp <= 0x05C7 { return true }    // hebrew points
    if cp >= 0x0610 and cp <= 0x061A { return true }    // arabic marks
    if cp >= 0x064B and cp <= 0x065F { return true }    // arabic diacritics
    if cp == 0x0670 { return true }
    if cp >= 0x06D6 and cp <= 0x06DC { return true }
    if cp >= 0x06DF and cp <= 0x06E4 { return true }
    if cp >= 0x0900 and cp <= 0x0902 { return true }    // devanagari
    if cp == 0x093C or cp == 0x094D { return true }
    if cp >= 0x0941 and cp <= 0x0948 { return true }
    if cp >= 0x0E31 and cp <= 0x0E3A and cp != 0x0E32 and cp != 0x0E33 { return true }  // thai
    if cp >= 0x0E47 and cp <= 0x0E4E { return true }
    if cp >= 0x1AB0 and cp <= 0x1AFF { return true }    // combining extended
    if cp >= 0x1DC0 and cp <= 0x1DFF { return true }    // combining supplement
    if cp >= 0x200B and cp <= 0x200F { return true }    // ZWSP/ZWNJ/ZWJ/LRM/RLM
    if cp >= 0x202A and cp <= 0x202E { return true }    // bidi embedding
    if cp >= 0x2060 and cp <= 0x2064 { return true }    // word joiner
    if cp >= 0x20D0 and cp <= 0x20FF { return true }    // combining for symbols
    if cp >= 0xFE00 and cp <= 0xFE0F { return true }    // variation selectors
    if cp >= 0xFE20 and cp <= 0xFE2F { return true }    // combining half marks
    if cp == 0xFEFF { return true }                     // ZWNBSP/BOM
    if cp >= 0xE0100 and cp <= 0xE01EF { return true }  // variation selectors sup
    return false
}

// East Asian Wide/Fullwidth + Emoji_Presentation: 2 terminal columns.
fn __ucs_wide(cp: int) -> bool {
    // Unicode 15.1 EastAsianWidth W/F (generado de unicodedata). Rangos contiguos
    // agrupados; los cortes tempranos por plano mantienen barato el caso común.
    if cp < 0x1100 { return false }
    if cp < 0x10000 {
        if (cp >= 0x1100 and cp <= 0x115F) or (cp >= 0x231A and cp <= 0x231B) or (cp >= 0x2329 and cp <= 0x232A) { return true }
        if (cp >= 0x23E9 and cp <= 0x23EC) or cp == 0x23F0 or cp == 0x23F3 { return true }
        if (cp >= 0x25FD and cp <= 0x25FE) or (cp >= 0x2614 and cp <= 0x2615) or (cp >= 0x2648 and cp <= 0x2653) { return true }
        if cp == 0x267F or cp == 0x2693 or cp == 0x26A1 { return true }
        if (cp >= 0x26AA and cp <= 0x26AB) or (cp >= 0x26BD and cp <= 0x26BE) or (cp >= 0x26C4 and cp <= 0x26C5) { return true }
        if cp == 0x26CE or cp == 0x26D4 or cp == 0x26EA { return true }
        if (cp >= 0x26F2 and cp <= 0x26F3) or cp == 0x26F5 or cp == 0x26FA { return true }
        if cp == 0x26FD or cp == 0x2705 or (cp >= 0x270A and cp <= 0x270B) { return true }
        if cp == 0x2728 or cp == 0x274C or cp == 0x274E { return true }
        if (cp >= 0x2753 and cp <= 0x2755) or cp == 0x2757 or (cp >= 0x2795 and cp <= 0x2797) { return true }
        if cp == 0x27B0 or cp == 0x27BF or (cp >= 0x2B1B and cp <= 0x2B1C) { return true }
        if cp == 0x2B50 or cp == 0x2B55 or (cp >= 0x2E80 and cp <= 0x2E99) { return true }
        if (cp >= 0x2E9B and cp <= 0x2EF3) or (cp >= 0x2F00 and cp <= 0x2FD5) or (cp >= 0x2FF0 and cp <= 0x303E) { return true }
        if (cp >= 0x3041 and cp <= 0x3096) or (cp >= 0x3099 and cp <= 0x30FF) or (cp >= 0x3105 and cp <= 0x312F) { return true }
        if (cp >= 0x3131 and cp <= 0x318E) or (cp >= 0x3190 and cp <= 0x31E3) or (cp >= 0x31EF and cp <= 0x321E) { return true }
        if (cp >= 0x3220 and cp <= 0x3247) or (cp >= 0x3250 and cp <= 0x4DBF) or (cp >= 0x4E00 and cp <= 0xA48C) { return true }
        if (cp >= 0xA490 and cp <= 0xA4C6) or (cp >= 0xA960 and cp <= 0xA97C) or (cp >= 0xAC00 and cp <= 0xD7A3) { return true }
        if (cp >= 0xF900 and cp <= 0xFAFF) or (cp >= 0xFE10 and cp <= 0xFE19) or (cp >= 0xFE30 and cp <= 0xFE52) { return true }
        if (cp >= 0xFE54 and cp <= 0xFE66) or (cp >= 0xFE68 and cp <= 0xFE6B) or (cp >= 0xFF01 and cp <= 0xFF60) { return true }
        if (cp >= 0xFFE0 and cp <= 0xFFE6) { return true }
        return false
    }
    if cp < 0x16FE0 { return false }
    if (cp >= 0x16FE0 and cp <= 0x16FE4) or (cp >= 0x16FF0 and cp <= 0x16FF1) or (cp >= 0x17000 and cp <= 0x187F7) { return true }
    if (cp >= 0x18800 and cp <= 0x18CD5) or (cp >= 0x18D00 and cp <= 0x18D08) or (cp >= 0x1AFF0 and cp <= 0x1AFF3) { return true }
    if (cp >= 0x1AFF5 and cp <= 0x1AFFB) or (cp >= 0x1AFFD and cp <= 0x1AFFE) or (cp >= 0x1B000 and cp <= 0x1B122) { return true }
    if cp == 0x1B132 or (cp >= 0x1B150 and cp <= 0x1B152) or cp == 0x1B155 { return true }
    if (cp >= 0x1B164 and cp <= 0x1B167) or (cp >= 0x1B170 and cp <= 0x1B2FB) or cp == 0x1F004 { return true }
    if cp == 0x1F0CF or cp == 0x1F18E or (cp >= 0x1F191 and cp <= 0x1F19A) { return true }
    if (cp >= 0x1F200 and cp <= 0x1F202) or (cp >= 0x1F210 and cp <= 0x1F23B) or (cp >= 0x1F240 and cp <= 0x1F248) { return true }
    if (cp >= 0x1F250 and cp <= 0x1F251) or (cp >= 0x1F260 and cp <= 0x1F265) or (cp >= 0x1F300 and cp <= 0x1F320) { return true }
    if (cp >= 0x1F32D and cp <= 0x1F335) or (cp >= 0x1F337 and cp <= 0x1F37C) or (cp >= 0x1F37E and cp <= 0x1F393) { return true }
    if (cp >= 0x1F3A0 and cp <= 0x1F3CA) or (cp >= 0x1F3CF and cp <= 0x1F3D3) or (cp >= 0x1F3E0 and cp <= 0x1F3F0) { return true }
    if cp == 0x1F3F4 or (cp >= 0x1F3F8 and cp <= 0x1F43E) or cp == 0x1F440 { return true }
    if (cp >= 0x1F442 and cp <= 0x1F4FC) or (cp >= 0x1F4FF and cp <= 0x1F53D) or (cp >= 0x1F54B and cp <= 0x1F54E) { return true }
    if (cp >= 0x1F550 and cp <= 0x1F567) or cp == 0x1F57A or (cp >= 0x1F595 and cp <= 0x1F596) { return true }
    if cp == 0x1F5A4 or (cp >= 0x1F5FB and cp <= 0x1F64F) or (cp >= 0x1F680 and cp <= 0x1F6C5) { return true }
    if cp == 0x1F6CC or (cp >= 0x1F6D0 and cp <= 0x1F6D2) or (cp >= 0x1F6D5 and cp <= 0x1F6D7) { return true }
    if (cp >= 0x1F6DC and cp <= 0x1F6DF) or (cp >= 0x1F6EB and cp <= 0x1F6EC) or (cp >= 0x1F6F4 and cp <= 0x1F6FC) { return true }
    if (cp >= 0x1F7E0 and cp <= 0x1F7EB) or cp == 0x1F7F0 or (cp >= 0x1F90C and cp <= 0x1F93A) { return true }
    if (cp >= 0x1F93C and cp <= 0x1F945) or (cp >= 0x1F947 and cp <= 0x1F9FF) or (cp >= 0x1FA70 and cp <= 0x1FA7C) { return true }
    if (cp >= 0x1FA80 and cp <= 0x1FA88) or (cp >= 0x1FA90 and cp <= 0x1FABD) or (cp >= 0x1FABF and cp <= 0x1FAC5) { return true }
    if (cp >= 0x1FACE and cp <= 0x1FADB) or (cp >= 0x1FAE0 and cp <= 0x1FAE8) or (cp >= 0x1FAF0 and cp <= 0x1FAF8) { return true }
    if (cp >= 0x20000 and cp <= 0x2FFFD) or (cp >= 0x30000 and cp <= 0x3FFFD) { return true }
    return false
}

// wcwidth — terminal column width of one codepoint, wcwidth(3)/Kuhn contract:
// NUL -> 0; other C0/C1 controls (incl. TAB/LF/DEL) -> -1; zero-width
// (combining/joiners) -> 0; East Asian Wide/Fullwidth + emoji -> 2; else 1.
pub fn wcwidth(codepoint: int) -> int {
    if codepoint == 0 { return 0 }
    if codepoint < 32 { return 0 - 1 }
    if codepoint >= 0x7F and codepoint <= 0x9F { return 0 - 1 }
    if codepoint < 0 or codepoint > 0x10FFFF { return 0 - 1 }
    if __ucs_zero_width(codepoint) { return 0 }
    if __ucs_wide(codepoint) { return 2 }
    return 1
}

// display_width — terminal columns a String occupies: decodes the UTF-8 bytes
// and sums wcwidth per codepoint, counting controls (-1) as 0. Malformed bytes
// (stray continuation, truncated lead) count 1 column per invalid byte —
// degrade to misalignment, never crash or stall. This is the column-accurate
// companion to char_length() (which counts codepoints, not columns).
pub fn display_width(s: String) -> int {
    let n: int = s.length()
    var total: int = 0
    var i: int = 0
    while i < n {
        let b0: int = s.charAt(i)
        var cp: int = 0 - 1
        var len: int = 1
        if b0 < 0x80 {
            cp = b0
        } else {
            var need: int = 0
            if b0 >= 0xC0 and b0 <= 0xDF { need = 1; cp = b0 & 0x1F }
            if b0 >= 0xE0 and b0 <= 0xEF { need = 2; cp = b0 & 0x0F }
            if b0 >= 0xF0 and b0 <= 0xF4 { need = 3; cp = b0 & 0x07 }
            if need > 0 and i + need <= n - 1 {
                var k: int = 1
                var ok: bool = true
                while k <= need {
                    let bk: int = s.charAt(i + k)
                    if bk < 0x80 or bk > 0xBF { ok = false; break }
                    cp = (cp << 6) | (bk & 0x3F)
                    k = k + 1
                }
                if ok { len = need + 1 } else { cp = 0 - 1 }
            } else {
                cp = 0 - 1
            }
        }
        if cp < 0 {
            total = total + 1          // byte inválido: 1 columna, avanza 1
        } else {
            let w: int = wcwidth(cp)
            if w > 0 { total = total + w }
        }
        i = i + len
    }
    return total
}

// ── Legacy encodings → UTF-8 (D5) ─────────────────────────────────────────────

// latin1_to_utf8 — reinterpret raw ISO-8859-1 bytes as UTF-8. Total: every
// byte maps 1:1 to the same codepoint (Latin-1 is Unicode's first 256), so
// this can never fail. Pure-ASCII input round-trips unchanged.
pub fn latin1_to_utf8(s: String) -> String {
    let n: int = s.length()
    var sb: StringBuilder = StringBuilder.new()
    var i: int = 0
    while i < n {
        let b: int = s.charAt(i)
        if b < 0x80 {
            sb.append(s.substring(i, i + 1))
        } else {
            sb.append(utf8_encode(b))
        }
        i = i + 1
    }
    return sb.to_string()
}

// cp1252 0x80-0x9F → codepoint. The 5 unassigned slots (0x81/0x8D/0x8F/0x90/
// 0x9D) pass through as their C1 codepoint — WHATWG encoding semantics, what
// browsers do with mislabeled legacy pages.
fn __cp1252_high(b: int) -> int {
    if b == 0x80 { return 0x20AC }   // €
    if b == 0x82 { return 0x201A }   // ‚
    if b == 0x83 { return 0x0192 }   // ƒ
    if b == 0x84 { return 0x201E }   // „
    if b == 0x85 { return 0x2026 }   // …
    if b == 0x86 { return 0x2020 }   // †
    if b == 0x87 { return 0x2021 }   // ‡
    if b == 0x88 { return 0x02C6 }   // ˆ
    if b == 0x89 { return 0x2030 }   // ‰
    if b == 0x8A { return 0x0160 }   // Š
    if b == 0x8B { return 0x2039 }   // ‹
    if b == 0x8C { return 0x0152 }   // Œ
    if b == 0x8E { return 0x017D }   // Ž
    if b == 0x91 { return 0x2018 }   // '
    if b == 0x92 { return 0x2019 }   // '
    if b == 0x93 { return 0x201C }   // "
    if b == 0x94 { return 0x201D }   // "
    if b == 0x95 { return 0x2022 }   // •
    if b == 0x96 { return 0x2013 }   // –
    if b == 0x97 { return 0x2014 }   // —
    if b == 0x98 { return 0x02DC }   // ˜
    if b == 0x99 { return 0x2122 }   // ™
    if b == 0x9A { return 0x0161 }   // š
    if b == 0x9B { return 0x203A }   // ›
    if b == 0x9C { return 0x0153 }   // œ
    if b == 0x9E { return 0x017E }   // ž
    if b == 0x9F { return 0x0178 }   // Ÿ
    return b                          // 0x81/0x8D/0x8F/0x90/0x9D → C1 passthrough
}

// windows1252_to_utf8 — like latin1_to_utf8 but 0x80-0x9F goes through the
// cp1252 table (typographic quotes, dashes, €, ™...). Total, never fails.
pub fn windows1252_to_utf8(s: String) -> String {
    let n: int = s.length()
    var sb: StringBuilder = StringBuilder.new()
    var i: int = 0
    while i < n {
        let b: int = s.charAt(i)
        if b < 0x80 {
            sb.append(s.substring(i, i + 1))
        } else {
            if b <= 0x9F {
                sb.append(utf8_encode(__cp1252_high(b)))
            } else {
                sb.append(utf8_encode(b))
            }
        }
        i = i + 1
    }
    return sb.to_string()
}
