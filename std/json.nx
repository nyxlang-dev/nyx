// ============================================
// JSON.NX - JSON Parser/Serializer for Nyx v5.2
// ============================================
// Pure Nyx implementation — recursive descent parser

import "std/unicode"
import "std/error"

// JSON value types represented as tagged arrays:
// ["null"]
// ["bool", 0/1]
// ["number", int_value]
// ["string", string_value]
// ["array", [values...]]
// ["object", keys_array, values_array]

pub fn json_null() -> Array {
    let arr: Array = ["null"]
    return arr
}

pub fn json_bool(val: bool) -> Array {
    let arr: Array = ["bool"]
    if val {
        arr.push(1)
    } else {
        arr.push(0)
    }
    return arr
}

pub fn json_number(val: int) -> Array {
    let arr: Array = ["number", val]
    return arr
}

// ["float", text] — el valor se guarda como el TEXTO numérico original
// ("10.5", "4.2e3"), no como un double crudo: los Arrays de Nyx almacenan
// i64, así que un double necesitaría bitcast manual al leerlo; preservar el
// texto evita ese footgun y además da round-trip exacto en json_stringify.
pub fn json_float(val: float) -> Array {
    let arr: Array = ["float", float_to_string(val)]
    return arr
}

pub fn json_string(val: String) -> Array {
    let arr: Array = ["string"]
    arr.push(val)
    return arr
}

pub fn json_array(items: Array) -> Array {
    let arr: Array = ["array"]
    arr.push(items)
    return arr
}

pub fn json_object(keys: Array, vals: Array) -> Array {
    let arr: Array = ["object"]
    arr.push(keys)
    arr.push(vals)
    return arr
}

// Get the type tag of a JSON value
pub fn json_type(val: Array) -> String {
    let tag: String = val[0]
    return tag
}

// Look up a field in a JSON object value. Returns its JSON value, or json_null
// if the value is not an object or the key is absent.
pub fn json_get(obj: Array, key: String) -> Array {
    let tag: String = obj[0]
    if tag != "object" { return json_null() }
    let keys: Array = obj[1]
    let vals: Array = obj[2]
    var i: int = 0
    while i < keys.length() {
        let k: String = keys[i]
        if k == key {
            let v: Array = vals[i]
            return v
        }
        i = i + 1
    }
    return json_null()
}

// E5.4: hermana Result de json_get. json_get es AMBIGUA con una clave presente
// cuyo valor es null: ambos casos (clave ausente vs. clave presente con valor
// `null`) devuelven el mismo ["null"] centinela — el caller no puede distinguir
// "no existe" de "existe y es null" mirando el resultado. Esta función SÍ puede,
// porque replica la iteración de json_get en vez de delegarle: si la clave
// aparece en `keys` (aunque su valor sea `["null"]`), es Ok(valor) — la
// distinción vive en la PRESENCIA de la clave, no en el valor. Clave ausente →
// Err{2,"not_found"} con la clave en el mensaje. `obj` que no es un objeto JSON
// (otro tag) → Err{22,"invalid"}, mismo code que EINVAL vía errno_to_kind.
pub fn try_json_get(obj: Array, key: String) -> Result<Array, Error> {
    let tag: String = obj[0]
    if tag != "object" {
        return Result.Err(err_new(22, "invalid", "try_json_get: el valor no es un objeto JSON (tag=" + tag + ")"))
    }
    let keys: Array = obj[1]
    let vals: Array = obj[2]
    var i: int = 0
    while i < keys.length() {
        let k: String = keys[i]
        if k == key {
            let v: Array = vals[i]
            return Result.Ok(v)
        }
        i = i + 1
    }
    return Result.Err(err_new(2, "not_found", "try_json_get: clave ausente: " + key))
}

// Extract the underlying String of a ["string", s] JSON value ("" otherwise).
pub fn json_as_string(val: Array) -> String {
    let tag: String = val[0]
    if tag == "string" {
        let s: String = val[1]
        return s
    }
    return ""
}

// Extract the underlying int of a ["number", n] JSON value (0 otherwise).
// Para ["float", text] trunca a entero (string_to_int corta en el punto).
pub fn json_as_int(val: Array) -> int {
    let tag: String = val[0]
    if tag == "number" {
        let n: int = val[1]
        return n
    }
    if tag == "float" {
        let s: String = val[1]
        return float_to_int(string_to_float(s))
    }
    return 0
}

// Extract the underlying float of a ["float", text] o ["number", n] JSON value
// (0.0 otherwise). Es el accesor correcto para coordenadas/magnitudes.
pub fn json_as_float(val: Array) -> float {
    let tag: String = val[0]
    if tag == "float" {
        let s: String = val[1]
        return string_to_float(s)
    }
    if tag == "number" {
        let n: int = val[1]
        return int_to_float(n)
    }
    return 0.0
}

// Extrae el i-ésimo elemento de un `["array", [...]]` JSON (json_null si `arr` no
// es array o `i` está fuera de rango). El accesor que faltaba para recorrer arrays
// JSON — coordenadas de GeoJSON, listas de resultados, etc. — sin desempacar a mano.
pub fn json_array_get(arr: Array, i: int) -> Array {
    let tag: String = arr[0]
    if tag != "array" { return json_null() }
    let items: Array = arr[1]
    if i < 0 or i >= items.length() { return json_null() }
    let v: Array = items[i]
    return v
}

// E5.4: hermana Result de json_array_get. Índice fuera de rango (o `arr` que no
// es un array JSON) devuelve json_null() en la centinela — indistinguible de un
// elemento que fuera legítimamente `null`. Acá el fuera-de-rango es Err{22,
// "invalid"} con el índice y el largo real en el mensaje; `arr` que no es
// "array" también es Err{22,"invalid"} (mismo kind, distinto mensaje).
pub fn try_json_array_get(arr: Array, i: int) -> Result<Array, Error> {
    let tag: String = arr[0]
    if tag != "array" {
        return Result.Err(err_new(22, "invalid", "try_json_array_get: el valor no es un array JSON (tag=" + tag + ")"))
    }
    let items: Array = arr[1]
    let len: int = items.length()
    if i < 0 or i >= len {
        return Result.Err(err_new(22, "invalid", "try_json_array_get: indice " + int_to_string(i) + " fuera de rango (len=" + int_to_string(len) + ")"))
    }
    let v: Array = items[i]
    return Result.Ok(v)
}

// Longitud de un `["array", [...]]` JSON (0 si no es un array).
pub fn json_array_len(arr: Array) -> int {
    let tag: String = arr[0]
    if tag != "array" { return 0 }
    let items: Array = arr[1]
    return items.length()
}

// Escapa un string crudo para incrustarlo entre comillas JSON (RFC 8259 §7).
// Recorre BYTES (contrato strings=bytes de v0.14): los caracteres multibyte
// UTF-8 pasan sin tocar, que es válido en JSON. Los controles por debajo de
// 0x20 se emiten como \u00XX porque JSON los prohíbe literales.
pub fn json_escape(s: String) -> String {
    var out: String = ""
    var i: int = 0
    let n: int = s.length()
    while i < n {
        let c: char = s.charAt(i)
        if c == '"' {
            out = out + "\\\""
        } else if c == '\\' {
            out = out + "\\\\"
        } else if c == '\n' {
            out = out + "\\n"
        } else if c == '\r' {
            out = out + "\\r"
        } else if c == '\t' {
            out = out + "\\t"
        } else {
            let b: int = c as int
            if b >= 0 and b < 32 {
                // Control sin escape corto: \u00XX en hexadecimal minúscula
                let hex: String = "0123456789abcdef"
                let hi: int = b / 16
                let lo: int = b % 16
                out = out + "\\u00" + char_to_string(hex.charAt(hi)) + char_to_string(hex.charAt(lo))
            } else {
                out = out + char_to_string(c)
            }
        }
        i = i + 1
    }
    return out
}

// Stringify a JSON value to a string
pub fn json_stringify(val: Array) -> String {
    let tag: String = val[0]

    if tag == "null" {
        return "null"
    }

    if tag == "bool" {
        let bv: int = val[1]
        if bv == 1 {
            return "true"
        }
        return "false"
    }

    if tag == "number" {
        let nv: int = val[1]
        return int_to_string(nv)
    }

    if tag == "float" {
        // El texto original se preservó al parsear → round-trip exacto.
        let fv: String = val[1]
        return fv
    }

    if tag == "string" {
        let sv: String = val[1]
        return "\"" + json_escape(sv) + "\""
    }

    if tag == "array" {
        let items: Array = val[1]
        var result: String = "["
        var i: int = 0
        let len: int = items.length()
        while i < len {
            if i > 0 {
                result = result + ","
            }
            let item: Array = items[i]
            result = result + json_stringify(item)
            i = i + 1
        }
        return result + "]"
    }

    if tag == "object" {
        let keys: Array = val[1]
        let vals: Array = val[2]
        var result: String = "{"
        var i: int = 0
        let len: int = keys.length()
        while i < len {
            if i > 0 {
                result = result + ","
            }
            let k: String = keys[i]
            let v: Array = vals[i]
            result = result + "\"" + json_escape(k) + "\":" + json_stringify(v)
            i = i + 1
        }
        return result + "}"
    }

    return "null"
}

// ===== JSON PARSER =====
// Recursive descent parser using a position counter in an array

pub fn json_parse(input: String) -> Array {
    let pos: Array = [0]
    let result: Array = parse_value(input, pos)
    return result
}

// Recorta SOLO el whitespace que define JSON (RFC 8259 §2: espacio 0x20, tab
// 0x09, LF 0x0A, CR 0x0D) — espejo exacto del set que reconoce skip_whitespace
// más abajo. Existe porque `.trim()` del runtime (nyx_string_trim → std C
// isspace()) NO alcanza: isspace() también considera whitespace a \v (0x0B,
// vertical tab) y \f (0x0C, form feed), dos bytes que JSON NO reconoce como
// tales. Con `.trim()` genérico, un input como VT+"null" (chr(11) + "null" —
// "\v" no tiene escape literal en Nyx, ver test-378 caso (n)) trimmeaba a
// "null" y colaba como Ok(null) legítimo cuando en realidad el VT inicial no
// es whitespace JSON válido ahí — debería ser Err. json_trim usa el set
// correcto y cierra esa asimetría (hallada en review, no en el diseño original).
fn json_trim(s: String) -> String {
    let len: int = s.length()
    var start: int = 0
    while start < len {
        let c: char = s.charAt(start)
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
            start = start + 1
        } else {
            break
        }
    }
    var end: int = len
    while end > start {
        let c: char = s.charAt(end - 1)
        if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
            end = end - 1
        } else {
            break
        }
    }
    return s.substring(start, end)
}

// E5.4: hermana Result de json_parse. json_parse (arriba) devuelve el mismo
// ["null"] centinela en DOS situaciones bien distintas — parsear el literal
// JSON `null` (éxito legítimo) y no lograr reconocer nada útil (input vacío,
// basura, `{`/`[`/`"`/número que no arrancan bien) — indistinguibles mirando
// solo el Array resultante. La desambiguación EXACTA: si el tag es "null" pero
// el input TRIMMEADO (vía json_trim, arriba) no es literalmente la palabra
// "null", el resultado se descarta y se reporta Err{5,"parse"}; si el input
// trimmeado ES "null", el ["null"] es el Ok legítimo.
//
// Alcance EXACTO de lo que detecta — y lo que NO (fichado para el arco de
// parser con pos-tracking, fuera de esta tarea): solo cachea basura que cae en
// el fallback final de parse_value (input vacío/solo whitespace, o un primer
// carácter/keyword que no matchea ningún prefijo válido: "x", "nul", "@"...).
// Basura ESTRUCTURAL dentro de un objeto o array ("{oops", "[1,2" sin cerrar)
// NO produce tag "null" — parse_object/parse_array siempre sintetizan una
// estructura (aunque queden huecos rellenados a null o keys vacías), así que
// ese tipo de basura pasa como Ok con contenido parcial/corrupto. Detectarla
// requiere que el parser sepa cuándo un objeto/array quedó mal cerrado, que es
// exactamente el trabajo del arco de posición mencionado arriba.
//
// Trailing garbage: dos honestidades distintas.
//   - Tras "null": "null   " trimmea a "null" → Ok. "null xyz" NO trimmea a
//     "null" → Err — gratis, mismo mecanismo (ni siquiera hace falta chequear
//     `pos` contra el largo del input).
//   - Tras un valor válido: "5 xyz" NO se valida — Ok leniente, heredado de
//     parse_value (que nunca chequea que `pos` llegue al final del input;
//     mismo comportamiento pre-existente que json_parse). Fichado junto con
//     el punto anterior para cuando el parser trackee posición end-to-end.
pub fn try_json_parse(input: String) -> Result<Array, Error> {
    let pos: Array = [0]
    let result: Array = parse_value(input, pos)
    let tag: String = result[0]
    if tag != "null" {
        return Result.Ok(result)
    }
    let trimmed: String = json_trim(input)
    if trimmed == "null" {
        return Result.Ok(result)
    }
    return Result.Err(err_new(5, "parse", "try_json_parse: entrada invalida o vacia"))
}

fn skip_whitespace(input: String, pos: Array) {
    let len: int = input.length()
    var p: int = pos[0]
    while p < len {
        let c: char = input.charAt(p)
        if c == ' ' or c == '\n' or c == '\r' or c == '\t' {
            p = p + 1
        } else {
            pos[0] = p
            return 0
        }
    }
    pos[0] = p
    return 0
}

fn parse_value(input: String, pos: Array) -> Array {
    skip_whitespace(input, pos)
    let p: int = pos[0]
    let len: int = input.length()
    if p >= len {
        return json_null()
    }

    let c: char = input.charAt(p)

    // String
    if c == '"' {
        return parse_string(input, pos)
    }

    // Number (digit or minus)
    if c == '-' or (c >= '0' and c <= '9') {
        return parse_number(input, pos)
    }

    // Array
    if c == '[' {
        return parse_array(input, pos)
    }

    // Object
    if c == '{' {
        return parse_object(input, pos)
    }

    // true — verificar el literal COMPLETO antes de avanzar. Antes bastaba la
    // 't' inicial y se hacía pos += 4 a ciegas, así que "tomato" era true.
    if c == 't' {
        if p + 4 <= len and input.substring(p, p + 4) == "true" {
            pos[0] = p + 4
            return json_bool(true)
        }
        return json_null()
    }

    // false
    if c == 'f' {
        if p + 5 <= len and input.substring(p, p + 5) == "false" {
            pos[0] = p + 5
            return json_bool(false)
        }
        return json_null()
    }

    // null
    if c == 'n' {
        if p + 4 <= len and input.substring(p, p + 4) == "null" {
            pos[0] = p + 4
            return json_null()
        }
        return json_null()
    }

    return json_null()
}

// Un dígito hex → su valor (0-15), o -1 si no es hex.
fn hex_digit_value(c: char) -> int {
    if c >= '0' and c <= '9' { return (c as int) - 48 }
    if c >= 'a' and c <= 'f' { return (c as int) - 97 + 10 }
    if c >= 'A' and c <= 'F' { return (c as int) - 65 + 10 }
    return -1
}

// Decodifica 4 dígitos hex (el cuerpo de un \uXXXX) a su valor entero, o -1
// si alguno de los 4 caracteres no es hexadecimal (\uXXXX malformado).
fn parse_hex4(hx: String) -> int {
    if hx.length() != 4 { return -1 }
    var val: int = 0
    var i: int = 0
    while i < 4 {
        let d: int = hex_digit_value(hx.charAt(i))
        if d < 0 { return -1 }
        val = val * 16 + d
        i = i + 1
    }
    return val
}

fn parse_string(input: String, pos: Array) -> Array {
    var p: int = pos[0] + 1  // skip opening quote
    let len: int = input.length()
    var result: String = ""
    while p < len {
        let c: char = input.charAt(p)
        if c == '"' {
            pos[0] = p + 1
            return json_string(result)
        }
        if c == '\\' {
            p = p + 1
            if p < len {
                let esc: char = input.charAt(p)
                if esc == 'n' {
                    result = result + "\n"
                } else if esc == 't' {
                    result = result + "\t"
                } else if esc == 'r' {
                    result = result + "\r"
                } else if esc == 'b' {
                    result = result + chr(8)
                } else if esc == 'f' {
                    result = result + chr(12)
                } else if esc == '"' {
                    result = result + "\""
                } else if esc == '\\' {
                    result = result + "\\"
                } else if esc == '/' {
                    result = result + "/"
                } else if esc == 'u' {
                    // \uXXXX: leer los 4 hex y decodificar el codepoint.
                    // Pares surrogados (\uD800-\uDBFF + \uDC00-\uDFFF, la forma
                    // en que JSON representa codepoints > U+FFFF como emojis)
                    // quedan explícitamente FUERA de alcance: se decodifican
                    // como dos codepoints UTF-8 inválidos por separado en vez
                    // de combinarse. Alcance real: BMP simple (ASCII + Latin +
                    // símbolos comunes), que es todo lo que json_escape genera.
                    if p + 4 < len {
                        let hx: String = input.substring(p + 1, p + 5)
                        let cp: int = parse_hex4(hx)
                        if cp >= 0 {
                            if cp < 0x80 {
                                result = result + chr(cp)
                            } else {
                                result = result + utf8_encode(cp)
                            }
                            p = p + 4
                        }
                    }
                } else {
                    result = result + char_to_string(esc)
                }
            }
        } else {
            result = result + char_to_string(c)
        }
        p = p + 1
    }
    pos[0] = p
    return json_string(result)
}

fn parse_number(input: String, pos: Array) -> Array {
    let len: int = input.length()
    let start: int = pos[0]
    var p: int = start
    if p < len {
        if input.charAt(p) == '-' { p = p + 1 }
    }
    var is_float: bool = false
    // Parte entera
    while p < len {
        let c: char = input.charAt(p)
        if c >= '0' and c <= '9' { p = p + 1 } else { break }
    }
    // Fracción
    if p < len {
        if input.charAt(p) == '.' {
            is_float = true
            p = p + 1
            while p < len {
                let cf: char = input.charAt(p)
                if cf >= '0' and cf <= '9' { p = p + 1 } else { break }
            }
        }
    }
    // Exponente
    if p < len {
        let ce: char = input.charAt(p)
        if ce == 'e' or ce == 'E' {
            is_float = true
            p = p + 1
            if p < len {
                let cs: char = input.charAt(p)
                if cs == '+' or cs == '-' { p = p + 1 }
            }
            while p < len {
                let cd: char = input.charAt(p)
                if cd >= '0' and cd <= '9' { p = p + 1 } else { break }
            }
        }
    }
    pos[0] = p
    let text: String = input.substring(start, p)
    if is_float {
        let farr: Array = ["float", text]
        return farr
    }
    return json_number(string_to_int(text))
}

fn parse_array(input: String, pos: Array) -> Array {
    pos[0] = pos[0] + 1  // skip [
    skip_whitespace(input, pos)
    let items: Array = []
    if pos[0] < input.length() and input.charAt(pos[0]) == ']' {
        pos[0] = pos[0] + 1
        return json_array(items)
    }

    // Parse first element
    let first: Array = parse_value(input, pos)
    items.push(first)

    skip_whitespace(input, pos)
    while pos[0] < input.length() and input.charAt(pos[0]) == ',' {
        pos[0] = pos[0] + 1  // skip comma
        let elem: Array = parse_value(input, pos)
        items.push(elem)
        skip_whitespace(input, pos)
    }

    if pos[0] < input.length() and input.charAt(pos[0]) == ']' {
        pos[0] = pos[0] + 1
    }
    return json_array(items)
}

fn parse_object(input: String, pos: Array) -> Array {
    pos[0] = pos[0] + 1  // skip {
    skip_whitespace(input, pos)
    let keys: Array = []
    let vals: Array = []

    if pos[0] < input.length() and input.charAt(pos[0]) == '}' {
        pos[0] = pos[0] + 1
        return json_object(keys, vals)
    }

    // Parse first key:value
    skip_whitespace(input, pos)
    let k1: Array = parse_string(input, pos)
    let k1v: String = k1[1]
    keys.push(k1v)
    skip_whitespace(input, pos)
    pos[0] = pos[0] + 1  // skip :
    let v1: Array = parse_value(input, pos)
    vals.push(v1)

    skip_whitespace(input, pos)
    while pos[0] < input.length() and input.charAt(pos[0]) == ',' {
        pos[0] = pos[0] + 1
        skip_whitespace(input, pos)
        let k: Array = parse_string(input, pos)
        let kv: String = k[1]
        keys.push(kv)
        skip_whitespace(input, pos)
        pos[0] = pos[0] + 1  // skip :
        let v: Array = parse_value(input, pos)
        vals.push(v)
        skip_whitespace(input, pos)
    }

    if pos[0] < input.length() and input.charAt(pos[0]) == '}' {
        pos[0] = pos[0] + 1
    }
    return json_object(keys, vals)
}
