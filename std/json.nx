// ============================================
// JSON.NX - JSON Parser/Serializer for Nyx v5.2
// ============================================
// Pure Nyx implementation — recursive descent parser

import "std/unicode"
import "std/error"

// JSON value types represented as tagged arrays:
// ["null"]
// ["bool", 0/1]
// ["number", int_value]
// ["string", string_value]
// ["array", [values...]]
// ["object", keys_array, values_array]

pub fn json_null() -> Array {
    let arr: Array = ["null"]
    return arr
}

pub fn json_bool(val: bool) -> Array {
    let arr: Array = ["bool"]
    if val {
        arr.push(1)
    } else {
        arr.push(0)
    }
    return arr
}

pub fn json_number(val: int) -> Array {
    let arr: Array = ["number", val]
    return arr
}

// ["float", text] — el valor se guarda como el TEXTO numérico original
// ("10.5", "4.2e3"), no como un double crudo: los Arrays de Nyx almacenan
// i64, así que un double necesitaría bitcast manual al leerlo; preservar el
// texto evita ese footgun y además da round-trip exacto en json_stringify.
pub fn json_float(val: float) -> Array {
    let arr: Array = ["float", float_to_string(val)]
    return arr
}

pub fn json_string(val: String) -> Array {
    let arr: Array = ["string"]
    arr.push(val)
    return arr
}

pub fn json_array(items: Array) -> Array {
    let arr: Array = ["array"]
    arr.push(items)
    return arr
}

pub fn json_object(keys: Array, vals: Array) -> Array {
    let arr: Array = ["object"]
    arr.push(keys)
    arr.push(vals)
    return arr
}

// Get the type tag of a JSON value
pub fn json_type(val: Array) -> String {
    let tag: String = val[0]
    return tag
}

// Look up a field in a JSON object value. Returns its JSON value, or json_null
// if the value is not an object or the key is absent.
pub fn json_get(obj: Array, key: String) -> Array {
    let tag: String = obj[0]
    if tag != "object" { return json_null() }
    let keys: Array = obj[1]
    let vals: Array = obj[2]
    var i: int = 0
    while i < keys.length() {
        let k: String = keys[i]
        if k == key {
            let v: Array = vals[i]
            return v
        }
        i = i + 1
    }
    return json_null()
}

// E5.4: hermana Result de json_get. json_get es AMBIGUA con una clave presente
// cuyo valor es null: ambos casos (clave ausente vs. clave presente con valor
// `null`) devuelven el mismo ["null"] centinela — el caller no puede distinguir
// "no existe" de "existe y es null" mirando el resultado. Esta función SÍ puede,
// porque replica la iteración de json_get en vez de delegarle: si la clave
// aparece en `keys` (aunque su valor sea `["null"]`), es Ok(valor) — la
// distinción vive en la PRESENCIA de la clave, no en el valor. Clave ausente →
// Err{2,"not_found"} con la clave en el mensaje. `obj` que no es un objeto JSON
// (otro tag) → Err{22,"invalid"}, mismo code que EINVAL vía errno_to_kind.
pub fn try_json_get(obj: Array, key: String) -> Result<Array, Error> {
    let tag: String = obj[0]
    if tag != "object" {
        return Result.Err(err_new(22, "invalid", "try_json_get: el valor no es un objeto JSON (tag=" + tag + ")"))
    }
    let keys: Array = obj[1]
    let vals: Array = obj[2]
    var i: int = 0
    while i < keys.length() {
        let k: String = keys[i]
        if k == key {
            let v: Array = vals[i]
            return Result.Ok(v)
        }
        i = i + 1
    }
    return Result.Err(err_new(2, "not_found", "try_json_get: clave ausente: " + key))
}

// Extract the underlying String of a ["string", s] JSON value ("" otherwise).
pub fn json_as_string(val: Array) -> String {
    let tag: String = val[0]
    if tag == "string" {
        let s: String = val[1]
        return s
    }
    return ""
}

// Extract the underlying int of a ["number", n] JSON value (0 otherwise).
// Para ["float", text] trunca a entero (string_to_int corta en el punto).
pub fn json_as_int(val: Array) -> int {
    let tag: String = val[0]
    if tag == "number" {
        let n: int = val[1]
        return n
    }
    if tag == "float" {
        let s: String = val[1]
        return float_to_int(string_to_float(s))
    }
    return 0
}

// Extract the underlying float of a ["float", text] o ["number", n] JSON value
// (0.0 otherwise). Es el accesor correcto para coordenadas/magnitudes.
pub fn json_as_float(val: Array) -> float {
    let tag: String = val[0]
    if tag == "float" {
        let s: String = val[1]
        return string_to_float(s)
    }
    if tag == "number" {
        let n: int = val[1]
        return int_to_float(n)
    }
    return 0.0
}

// Extrae el i-ésimo elemento de un `["array", [...]]` JSON (json_null si `arr` no
// es array o `i` está fuera de rango). El accesor que faltaba para recorrer arrays
// JSON — coordenadas de GeoJSON, listas de resultados, etc. — sin desempacar a mano.
pub fn json_array_get(arr: Array, i: int) -> Array {
    let tag: String = arr[0]
    if tag != "array" { return json_null() }
    let items: Array = arr[1]
    if i < 0 or i >= items.length() { return json_null() }
    let v: Array = items[i]
    return v
}

// E5.4: hermana Result de json_array_get. Índice fuera de rango (o `arr` que no
// es un array JSON) devuelve json_null() en la centinela — indistinguible de un
// elemento que fuera legítimamente `null`. Acá el fuera-de-rango es Err{22,
// "invalid"} con el índice y el largo real en el mensaje; `arr` que no es
// "array" también es Err{22,"invalid"} (mismo kind, distinto mensaje).
pub fn try_json_array_get(arr: Array, i: int) -> Result<Array, Error> {
    let tag: String = arr[0]
    if tag != "array" {
        return Result.Err(err_new(22, "invalid", "try_json_array_get: el valor no es un array JSON (tag=" + tag + ")"))
    }
    let items: Array = arr[1]
    let len: int = items.length()
    if i < 0 or i >= len {
        return Result.Err(err_new(22, "invalid", "try_json_array_get: indice " + int_to_string(i) + " fuera de rango (len=" + int_to_string(len) + ")"))
    }
    let v: Array = items[i]
    return Result.Ok(v)
}

// Longitud de un `["array", [...]]` JSON (0 si no es un array).
pub fn json_array_len(arr: Array) -> int {
    let tag: String = arr[0]
    if tag != "array" { return 0 }
    let items: Array = arr[1]
    return items.length()
}

// Escapa un string crudo para incrustarlo entre comillas JSON (RFC 8259 §7).
// Recorre BYTES (contrato strings=bytes de v0.14): los caracteres multibyte
// UTF-8 pasan sin tocar, que es válido en JSON. Los controles por debajo de
// 0x20 se emiten como \u00XX porque JSON los prohíbe literales.
// Escritura LINEAL (fricción nyxerp 20260923-210010-team-2, 2026-09-23): antes
// json_escape concatenaba de a un carácter y json_stringify recopiaba todo lo
// acumulado en cada elemento de un array u objeto (`result = result + …`), así
// que escribir crecía con el CUADRADO del largo: un texto de 32 KB tardaba
// 504 ms, y un catálogo de 1 MB, segundos. Ahora un solo StringBuilder recorre
// el árbol entero y los tramos sin nada que escapar se copian de una vez con
// substring — el mismo arreglo que ya tenía parse_string.

// Escribe `s` escapado en `sb`, copiando por tramos lo que no hay que escapar.
fn json_escape_en(s: String, sb: StringBuilder) {
    let hex: String = "0123456789abcdef"
    let n: int = s.length()
    var desde: int = 0
    var i: int = 0
    while i < n {
        let c: char = s.charAt(i)
        let b: int = c as int
        var esc: String = ""
        if c == '"' {
            esc = "\\\""
        } else if c == '\\' {
            esc = "\\\\"
        } else if c == '\n' {
            esc = "\\n"
        } else if c == '\r' {
            esc = "\\r"
        } else if c == '\t' {
            esc = "\\t"
        } else if b >= 0 and b < 32 {
            // Control sin escape corto: \u00XX en hexadecimal minúscula
            esc = "\\u00" + char_to_string(hex.charAt(b / 16)) + char_to_string(hex.charAt(b % 16))
        }
        if esc != "" {
            if i > desde { sb.append(s.substring(desde, i)) }
            sb.append(esc)
            desde = i + 1
        }
        i = i + 1
    }
    if desde == 0 {
        sb.append(s)
    } else if desde < n {
        sb.append(s.substring(desde, n))
    }
    return 0
}

pub fn json_escape(s: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    json_escape_en(s, sb)
    return sb.to_string()
}

// Escribe `val` en `sb` (recursivo, un solo StringBuilder para todo el árbol).
fn json_escribir(val: Array, sb: StringBuilder) {
    let tag: String = val[0]
    if tag == "null" {
        sb.append("null")
    } else if tag == "bool" {
        let bv: int = val[1]
        if bv == 1 { sb.append("true") } else { sb.append("false") }
    } else if tag == "number" {
        let nv: int = val[1]
        sb.append(int_to_string(nv))
    } else if tag == "float" {
        // El texto original se preservó al parsear → round-trip exacto.
        let fv: String = val[1]
        sb.append(fv)
    } else if tag == "string" {
        let sv: String = val[1]
        sb.append("\"")
        json_escape_en(sv, sb)
        sb.append("\"")
    } else if tag == "array" {
        let items: Array = val[1]
        sb.append("[")
        var i: int = 0
        while i < items.length() {
            if i > 0 { sb.append(",") }
            let item: Array = items[i]
            json_escribir(item, sb)
            i = i + 1
        }
        sb.append("]")
    } else if tag == "object" {
        let keys: Array = val[1]
        let vals: Array = val[2]
        sb.append("{")
        var i: int = 0
        while i < keys.length() {
            if i > 0 { sb.append(",") }
            let k: String = keys[i]
            let v: Array = vals[i]
            sb.append("\"")
            json_escape_en(k, sb)
            sb.append("\":")
            json_escribir(v, sb)
            i = i + 1
        }
        sb.append("}")
    } else {
        sb.append("null")
    }
    return 0
}

// Stringify a JSON value to a string
pub fn json_stringify(val: Array) -> String {
    var sb: StringBuilder = StringBuilder.new()
    json_escribir(val, sb)
    return sb.to_string()
}

// ===== JSON PARSER =====
// Recursive descent parser using a position counter in an array.
//
// Seguimiento de errores (arco pos-tracking, 2026-09-14, fricción nyxerp):
// `pos` dejó de ser solo `[posicion]` — ahora es `[posicion, error_flag,
// mensaje]`. Cualquier punto del parser que detecta que la entrada terminó
// donde no debía (objeto/arreglo/string sin cerrar, clave sin valor, coma
// final, número o literal a medias) o que sobra contenido no-blanco tras el
// valor raíz llama a record_error(pos, msg). "Primer error gana": el
// recursive-descent encuentra el problema más profundo ANTES que los `}`/`]`
// que fallan en cascada más arriba en la pila, así que ese primer mensaje es
// el más específico — record_error() es no-op si pos[1] ya está en 1.
//
// json_parse (centinela) y try_json_parse (Result) comparten la misma pasada
// (parse_document) y ven EXACTAMENTE los mismos fallos: json_parse colapsa
// cualquier error a json_null() (mismo sentinel ya usado para basura sin
// estructura — no se le suma ambigüedad nueva), try_json_parse lo traduce a
// Err{5,"parse"} con el mensaje puntual y la posición en bytes.
fn record_error(pos: Array, msg: String) {
    if pos[1] == 0 {
        pos[1] = 1
        pos[2] = msg
    }
    return 0
}

// Parsea el documento completo y deja el estado de error (si lo hay) en
// pos[1]/pos[2]. Un documento JSON es UN valor (RFC 8259) — cualquier byte
// no-blanco que sobre después de parsear ese valor es basura, no un segundo
// documento.
fn parse_document(input: String, pos: Array) -> Array {
    let result: Array = parse_value(input, pos)
    skip_whitespace(input, pos)
    if pos[0] < input.length() {
        record_error(pos, "contenido inesperado despues del valor JSON, posicion " + int_to_string(pos[0]))
    }
    return result
}

pub fn json_parse(input: String) -> Array {
    let pos: Array = [0, 0, ""]
    let result: Array = parse_document(input, pos)
    if pos[1] == 1 {
        return json_null()
    }
    return result
}

// E5.4: hermana Result de json_parse. Antes de 2026-09-14 json_parse devolvía
// el mismo ["null"] centinela tanto para el literal `null` legítimo como para
// basura SIN estructura (input vacío, primer carácter que no matchea nada) —
// y encima cualquier truncamiento DENTRO de un objeto/arreglo/string pasaba
// como Ok con contenido parcial/corrupto (parse_object/parse_array siempre
// sintetizaban una estructura, nunca propagaban el tag "null"). Reportado por
// fricción (equipo nyxerp, 2026-09-14): un JSON cortado a mitad de un objeto
// se aceptaba en silencio con menos campos de los que el texto tenía.
//
// Con pos-tracking end-to-end (parse_document, arriba) ambas ambigüedades se
// resuelven por construcción: cualquier fin de entrada dentro de una
// estructura, o contenido sobrante tras el valor raíz, deja pos[1]==1 con un
// mensaje puntual — sin volver a mirar el tag del resultado ni recortar el
// input a mano.
pub fn try_json_parse(input: String) -> Result<Array, Error> {
    let pos: Array = [0, 0, ""]
    let result: Array = parse_document(input, pos)
    if pos[1] == 1 {
        let msg: String = pos[2]
        return Result.Err(err_new(5, "parse", "try_json_parse: " + msg))
    }
    return Result.Ok(result)
}

fn skip_whitespace(input: String, pos: Array) {
    let len: int = input.length()
    var p: int = pos[0]
    while p < len {
        let c: char = input.charAt(p)
        if c == ' ' or c == '\n' or c == '\r' or c == '\t' {
            p = p + 1
        } else {
            pos[0] = p
            return 0
        }
    }
    pos[0] = p
    return 0
}

fn parse_value(input: String, pos: Array) -> Array {
    skip_whitespace(input, pos)
    let p: int = pos[0]
    let len: int = input.length()
    if p >= len {
        record_error(pos, "se esperaba un valor antes del fin de la entrada, posicion " + int_to_string(p))
        return json_null()
    }

    let c: char = input.charAt(p)

    // String
    if c == '"' {
        return parse_string(input, pos)
    }

    // Number (digit or minus)
    if c == '-' or (c >= '0' and c <= '9') {
        return parse_number(input, pos)
    }

    // Array
    if c == '[' {
        return parse_array(input, pos)
    }

    // Object
    if c == '{' {
        return parse_object(input, pos)
    }

    // true — verificar el literal COMPLETO antes de avanzar. Antes bastaba la
    // 't' inicial y se hacía pos += 4 a ciegas, así que "tomato" era true.
    if c == 't' {
        if p + 4 <= len and input.substring(p, p + 4) == "true" {
            pos[0] = p + 4
            return json_bool(true)
        }
        record_error(pos, "token invalido en la posicion " + int_to_string(p) + " (se esperaba 'true')")
        return json_null()
    }

    // false
    if c == 'f' {
        if p + 5 <= len and input.substring(p, p + 5) == "false" {
            pos[0] = p + 5
            return json_bool(false)
        }
        record_error(pos, "token invalido en la posicion " + int_to_string(p) + " (se esperaba 'false')")
        return json_null()
    }

    // null
    if c == 'n' {
        if p + 4 <= len and input.substring(p, p + 4) == "null" {
            pos[0] = p + 4
            return json_null()
        }
        record_error(pos, "token invalido en la posicion " + int_to_string(p) + " (se esperaba 'null')")
        return json_null()
    }

    record_error(pos, "token invalido en la posicion " + int_to_string(p))
    return json_null()
}

// Un dígito hex → su valor (0-15), o -1 si no es hex.
fn hex_digit_value(c: char) -> int {
    if c >= '0' and c <= '9' { return (c as int) - 48 }
    if c >= 'a' and c <= 'f' { return (c as int) - 97 + 10 }
    if c >= 'A' and c <= 'F' { return (c as int) - 65 + 10 }
    return -1
}

// Decodifica 4 dígitos hex (el cuerpo de un \uXXXX) a su valor entero, o -1
// si alguno de los 4 caracteres no es hexadecimal (\uXXXX malformado).
fn parse_hex4(hx: String) -> int {
    if hx.length() != 4 { return -1 }
    var val: int = 0
    var i: int = 0
    while i < 4 {
        let d: int = hex_digit_value(hx.charAt(i))
        if d < 0 { return -1 }
        val = val * 16 + d
        i = i + 1
    }
    return val
}

// Los bytes comunes se copian por TRAMOS: `tramo` marca dónde empieza la
// corrida sin escapes en curso, y se vuelca con UN substring al llegar a una
// barra o a la comilla de cierre. Una cadena sin escapes (el caso de casi
// todo JSON real) cuesta un solo substring.
//
// POR QUÉ (fricción de nyxerp, 2026-09-23): antes cada byte hacía
// `result = result + char_to_string(c)`, es decir un String de 1 byte más un
// String nuevo con TODO lo acumulado, por carácter: cuadrático en el largo de
// cada cadena y ~170 bytes reservados por byte de entrada. En wasm, donde nada
// se libera, un catálogo de 1 MB reservaba 180 MB solo en el parseo.
fn parse_string(input: String, pos: Array) -> Array {
    return json_string(parse_string_text(input, pos))
}

// El texto de la cadena, sin envolver: una clave de objeto no necesita el
// ["string", k] que después se desarma (un Array menos por clave).
fn parse_string_text(input: String, pos: Array) -> String {
    var p: int = pos[0] + 1  // skip opening quote
    let len: int = input.length()
    var result: String = ""
    var tramo: int = p
    var hubo_escape: bool = false
    while p < len {
        let c: char = input.charAt(p)
        if c == '"' {
            pos[0] = p + 1
            let resto: String = input.substring(tramo, p)
            if hubo_escape {
                return result + resto
            }
            return resto
        }
        if c == '\\' {
            result = result + input.substring(tramo, p)
            hubo_escape = true
            p = p + 1
            if p < len {
                let esc: char = input.charAt(p)
                if esc == 'n' {
                    result = result + "\n"
                } else if esc == 't' {
                    result = result + "\t"
                } else if esc == 'r' {
                    result = result + "\r"
                } else if esc == 'b' {
                    result = result + chr(8)
                } else if esc == 'f' {
                    result = result + chr(12)
                } else if esc == '"' {
                    result = result + "\""
                } else if esc == '\\' {
                    result = result + "\\"
                } else if esc == '/' {
                    result = result + "/"
                } else if esc == 'u' {
                    // \uXXXX: leer los 4 hex y decodificar el codepoint.
                    // Pares surrogados (\uD800-\uDBFF + \uDC00-\uDFFF, la forma
                    // en que JSON representa codepoints > U+FFFF como emojis)
                    // quedan explícitamente FUERA de alcance: se decodifican
                    // como dos codepoints UTF-8 inválidos por separado en vez
                    // de combinarse. Alcance real: BMP simple (ASCII + Latin +
                    // símbolos comunes), que es todo lo que json_escape genera.
                    if p + 4 < len {
                        let hx: String = input.substring(p + 1, p + 5)
                        let cp: int = parse_hex4(hx)
                        if cp >= 0 {
                            if cp < 0x80 {
                                result = result + chr(cp)
                            } else {
                                result = result + utf8_encode(cp)
                            }
                            p = p + 4
                        }
                    }
                } else {
                    result = result + char_to_string(esc)
                }
            }
            // El próximo tramo arranca después del escape entero.
            tramo = p + 1
        }
        p = p + 1
    }
    // Se salió del while por p >= len sin encontrar la comilla de cierre:
    // cadena sin cerrar (incluye el caso de una barra invertida colgante en
    // el último byte de la entrada, que deja p = len + 1 — se acota a len
    // para que la posición reportada no exceda el largo real del input).
    if p > len {
        p = len
    }
    // El contenido parcial conserva el tramo pendiente, como antes byte a byte
    // (substring acota si tramo quedó más allá de p por una barra colgante).
    result = result + input.substring(tramo, p)
    pos[0] = p
    record_error(pos, "cadena sin cerrar: se esperaba '\"' antes del fin de la entrada, posicion " + int_to_string(p))
    return result
}

fn parse_number(input: String, pos: Array) -> Array {
    let len: int = input.length()
    let start: int = pos[0]
    var p: int = start
    if p < len {
        if input.charAt(p) == '-' { p = p + 1 }
    }
    var is_float: bool = false
    // Parte entera — tiene que haber al menos un dígito (cubre tanto "-" solo
    // como cualquier posición donde parse_value nos mandó sin dígito alguno).
    let int_start: int = p
    while p < len {
        let c: char = input.charAt(p)
        if c >= '0' and c <= '9' { p = p + 1 } else { break }
    }
    if p == int_start {
        pos[0] = p
        record_error(pos, "numero invalido: se esperaba un digito en la posicion " + int_to_string(p))
        return json_number(0)
    }
    // Fracción — un '.' tiene que traer al menos un dígito detrás ("1." solo
    // no es un número JSON válido).
    if p < len {
        if input.charAt(p) == '.' {
            is_float = true
            p = p + 1
            let frac_start: int = p
            while p < len {
                let cf: char = input.charAt(p)
                if cf >= '0' and cf <= '9' { p = p + 1 } else { break }
            }
            if p == frac_start {
                pos[0] = p
                record_error(pos, "numero invalido: se esperaba un digito despues de '.' en la posicion " + int_to_string(p))
            }
        }
    }
    // Exponente — 'e'/'E' (con signo opcional) tiene que traer al menos un
    // dígito detrás ("1e" solo no es válido).
    if p < len {
        let ce: char = input.charAt(p)
        if ce == 'e' or ce == 'E' {
            is_float = true
            p = p + 1
            if p < len {
                let cs: char = input.charAt(p)
                if cs == '+' or cs == '-' { p = p + 1 }
            }
            let exp_start: int = p
            while p < len {
                let cd: char = input.charAt(p)
                if cd >= '0' and cd <= '9' { p = p + 1 } else { break }
            }
            if p == exp_start {
                pos[0] = p
                record_error(pos, "numero invalido: se esperaba un digito en el exponente, posicion " + int_to_string(p))
            }
        }
    }
    pos[0] = p
    let text: String = input.substring(start, p)
    if is_float {
        let farr: Array = ["float", text]
        return farr
    }
    return json_number(string_to_int(text))
}

fn parse_array(input: String, pos: Array) -> Array {
    pos[0] = pos[0] + 1  // skip [
    skip_whitespace(input, pos)
    let items: Array = []
    if pos[0] < input.length() and input.charAt(pos[0]) == ']' {
        pos[0] = pos[0] + 1
        return json_array(items)
    }

    // Parse first element — si la entrada termina acá (o en cualquier valor
    // más abajo), parse_value ya deja el error puntual en pos.
    let first: Array = parse_value(input, pos)
    items.push(first)

    skip_whitespace(input, pos)
    while pos[0] < input.length() and input.charAt(pos[0]) == ',' {
        pos[0] = pos[0] + 1  // skip comma
        let elem: Array = parse_value(input, pos)
        items.push(elem)
        skip_whitespace(input, pos)
    }

    if pos[0] < input.length() and input.charAt(pos[0]) == ']' {
        pos[0] = pos[0] + 1
    } else {
        // Fin de entrada (o basura) donde se esperaba ']' o ',': arreglo sin
        // cerrar — cubre tanto "[1,2,3" como la coma final "[1,2,".
        record_error(pos, "se esperaba ']' en la posicion " + int_to_string(pos[0]))
    }
    return json_array(items)
}

// Parsea un miembro "clave": valor de un objeto y lo agrega a keys/vals.
// Factorizado del primer miembro y de cada vuelta del bucle de comas — antes
// cada uno hacía `parse_string` y `pos[0] = pos[0] + 1 // skip :` SIN
// verificar que ahí hubiera realmente una comilla o unos dos puntos, así que
// un objeto truncado justo ahí (p.ej. `{` o `{"a"` solos) empujaba `pos` más
// allá del fin de la entrada. Ahora valida cada paso y deja el motivo puntual
// en pos si falta la clave o el ':'.
fn parse_object_member(input: String, pos: Array, keys: Array, vals: Array) {
    if pos[0] >= input.length() {
        record_error(pos, "se esperaba una clave string antes del fin de la entrada, posicion " + int_to_string(pos[0]))
        return 0
    }
    if input.charAt(pos[0]) != '"' {
        record_error(pos, "se esperaba '\"' (clave string) en la posicion " + int_to_string(pos[0]))
        return 0
    }
    let kv: String = parse_string_text(input, pos)
    keys.push(kv)
    skip_whitespace(input, pos)
    if pos[0] < input.length() and input.charAt(pos[0]) == ':' {
        pos[0] = pos[0] + 1
    } else {
        record_error(pos, "se esperaba ':' en la posicion " + int_to_string(pos[0]))
        return 0
    }
    let v: Array = parse_value(input, pos)
    vals.push(v)
    return 0
}

fn parse_object(input: String, pos: Array) -> Array {
    pos[0] = pos[0] + 1  // skip {
    skip_whitespace(input, pos)
    let keys: Array = []
    let vals: Array = []

    if pos[0] < input.length() and input.charAt(pos[0]) == '}' {
        pos[0] = pos[0] + 1
        return json_object(keys, vals)
    }

    parse_object_member(input, pos, keys, vals)

    skip_whitespace(input, pos)
    while pos[0] < input.length() and input.charAt(pos[0]) == ',' {
        pos[0] = pos[0] + 1
        skip_whitespace(input, pos)
        parse_object_member(input, pos, keys, vals)
        skip_whitespace(input, pos)
    }

    if pos[0] < input.length() and input.charAt(pos[0]) == '}' {
        pos[0] = pos[0] + 1
    } else {
        // Fin de entrada (o basura) donde se esperaba '}' o ',': objeto sin
        // cerrar.
        record_error(pos, "se esperaba '}' en la posicion " + int_to_string(pos[0]))
    }
    return json_object(keys, vals)
}
