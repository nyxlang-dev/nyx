// std/error.nx — El tipo Error canónico de la stdlib (E4, spec
// 2026-08-11-errores-tipados-design §3.1, ratificado 2026-08-14).
//
// UN solo shape para toda la std: Result<T, Error> es la firma estándar
// de toda función falible; Option<T> queda para ausencia-sin-causa.
// La regla de dos niveles del híbrido: si el caller razonablemente hace
// algo distinto de loggear-y-morir → Result; si no → panic.
//
// kind usa un VOCABULARIO CERRADO v1 — agregar un kind nuevo es una
// decisión de diseño con ficha, no un string ad-hoc:
//   "not_found"  — el recurso no existe (ENOENT, 404, clave ausente)
//   "permission" — sin permisos (EACCES, 403)
//   "connection" — fallo de red/conexión (ECONNREFUSED, reset)
//   "parse"      — entrada malformada (json inválido, header roto)
//   "timeout"    — se agotó el tiempo (ETIMEDOUT)
//   "in_use"     — el recurso ya está tomado (EADDRINUSE — agregado en
//                  E5.1: sin este kind, un listen duplicado caía en "io"
//                  genérico, indistinguible de cualquier otro fallo de
//                  bind/listen; medido con test-374)
//   "io"         — fallo de E/S genérico (el resto de errno)
//   "invalid"    — argumento/estado inválido (EINVAL)
//   "oom"        — sin memoria (ENOMEM)
//   "eof"        — fin de stream ESPERADO (code 0 — agregado en E5.2b para
//                  las centinelas que necesitan distinguir EOF de un Ok
//                  vacío legítimo, ej. try_tcp_read_line/try_tcp_read_exact
//                  en std/net.nx). NO es un fallo: es información de
//                  control de flujo, como io.EOF en Go. errno_to_kind NO lo
//                  mapea (code 0 real jamás llega a esta función) — el
//                  kind lo arma el caller directo vía err_new(0, "eof", …).
//   "db"         — fallo de motor de base de datos EMBEBIDO (agregado en
//                  E5.5 para try_sqlite_*/std/sqlite.nx). Los result codes
//                  de sqlite3 (1-27: SQLITE_ERROR, SQLITE_INTERNAL,
//                  SQLITE_PERM, ...) COLISIONAN con el espacio errno —
//                  rc 2 es SQLITE_INTERNAL, no ENOENT; mapearlos por
//                  errno_to_kind mentiría sobre la causa. "db" es un
//                  espacio de código PROPIO (mismo precedente que "eof"):
//                  `code` es lo que expone runtime/sqlite_adapter.c para
//                  ese fallo (no siempre el rc granular de sqlite — el
//                  adapter colapsa varias de sus funciones a boolean/NULL,
//                  ver el comentario de try_sqlite_open en std/sqlite.nx),
//                  `msg` es SIEMPRE el errmsg real de sqlite3_errmsg(db)
//                  cuando hay un db handle vivo para consultarlo.

pub struct Error {
    code: int,
    kind: String,
    msg: String,
}

pub fn err_new(code: int, kind: String, msg: String) -> Error {
    return Error { code: code, kind: kind, msg: msg }
}

// errno → kind. Los números son los de Linux (el único target nativo hoy);
// wasm32-wasi mapea sus errno equivalentes a los mismos valores POSIX.
pub fn errno_to_kind(code: int) -> String {
    if code == 2   { return "not_found" }
    if code == 13  { return "permission" }
    if code == 12  { return "oom" }
    if code == 22  { return "invalid" }
    if code == 110 { return "timeout" }
    if code == 111 { return "connection" }
    if code == 98  { return "in_use" }
    return "io"
}

// Formato humano único: es lo que muestra un unwrap() panicante y lo que
// un log estructurado parsea. `kind: msg (code N)`.
pub fn error_to_string(e: Error) -> String {
    return e.kind + ": " + e.msg + " (code " + int_to_string(e.code) + ")"
}

// Distingue EOF-esperado de un fallo real. Necesaria porque Err{code:0}
// rompe el patrón habitual "code != 0 = fallo" (0 normalmente es éxito) —
// comparar e.kind == "eof" a mano en cada call-site es frágil y se
// desincroniza si el vocabulario de kind cambia; este helper es el único
// lugar que conoce el string literal.
pub fn is_eof(e: Error) -> bool {
    return e.kind == "eof"
}
