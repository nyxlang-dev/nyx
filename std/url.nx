// std/url.nx — URL encoding + HTML entities for Nyx (v4.6.0)

import "std/unicode"
// url_decode vive en std/percent (compartido con std/web; ver su cabecera).
import "std/percent"

extern "C" fn nyx_url_encode(s: String) -> String

// ── URL Encoding ──────────────────────────────────────────────────────────────

// Percent-encode a string for use in URLs (RFC 3986 unreserved chars are left as-is)
pub fn url_encode(s: String) -> String {
    return nyx_url_encode(s)
}

// Build a query string from key/value pairs
// keys and values arrays must have the same length
pub fn build_query_string(keys: Array, values: Array) -> String {
    let n = keys.length()
    if n == 0 { return "" }
    var result = ""
    var i = 0
    while i < n {
        let k: String = keys[i]
        let v: String = values[i]
        let pair = nyx_url_encode(k) + "=" + nyx_url_encode(v)
        if i == 0 {
            result = pair
        } else {
            result = result + "&" + pair
        }
        i = i + 1
    }
    return result
}

// ── HTML Entities ─────────────────────────────────────────────────────────────

// Escape HTML special characters: & < > " '
pub fn html_escape(s: String) -> String {
    let s1 = s.replace("&", "&amp;")
    let s2 = s1.replace("<", "&lt;")
    let s3 = s2.replace(">", "&gt;")
    let s4 = s3.replace("\"", "&quot;")
    let s5 = s4.replace("'", "&#x27;")
    return s5
}

// Tabla de entidades con nombre: HTML 4.01 completa (latin1, símbolos, griegas,
// flechas, matemáticas, tipográficas: 253) + apos. Formato ";nombre=valor" con
// ";" final; la búsqueda es UN indexOf sobre la constante (memmem en C) en vez de
// una cadena de ~250 comparaciones de String por entidad. Ningún valor contiene
// ";" ni ningún nombre "=" ni ";", así que el delimitador es inequívoco. nbsp
// sigue mapeando a un espacio ASCII (contrato previo de test-302).
fn __html_entity_table() -> String {
    return ";quot=\";amp=&;apos=';lt=<;gt=>;nbsp= ;iexcl=¡;cent=¢;pound=£;curren=¤;yen=¥;brvbar=¦;sect=§;uml=¨" +
    ";copy=©;ordf=ª;laquo=«;not=¬;shy=­;reg=®;macr=¯;deg=°;plusmn=±;sup2=²;sup3=³;acute=´;micro=µ;para=¶" +
    ";middot=·;cedil=¸;sup1=¹;ordm=º;raquo=»;frac14=¼;frac12=½;frac34=¾;iquest=¿;Agrave=À;Aacute=Á" +
    ";Acirc=Â;Atilde=Ã;Auml=Ä;Aring=Å;AElig=Æ;Ccedil=Ç;Egrave=È;Eacute=É;Ecirc=Ê;Euml=Ë;Igrave=Ì;Iacute=Í" +
    ";Icirc=Î;Iuml=Ï;ETH=Ð;Ntilde=Ñ;Ograve=Ò;Oacute=Ó;Ocirc=Ô;Otilde=Õ;Ouml=Ö;times=×;Oslash=Ø;Ugrave=Ù" +
    ";Uacute=Ú;Ucirc=Û;Uuml=Ü;Yacute=Ý;THORN=Þ;szlig=ß;agrave=à;aacute=á;acirc=â;atilde=ã;auml=ä;aring=å" +
    ";aelig=æ;ccedil=ç;egrave=è;eacute=é;ecirc=ê;euml=ë;igrave=ì;iacute=í;icirc=î;iuml=ï;eth=ð;ntilde=ñ" +
    ";ograve=ò;oacute=ó;ocirc=ô;otilde=õ;ouml=ö;divide=÷;oslash=ø;ugrave=ù;uacute=ú;ucirc=û;uuml=ü" +
    ";yacute=ý;thorn=þ;yuml=ÿ;OElig=Œ;oelig=œ;Scaron=Š;scaron=š;Yuml=Ÿ;fnof=ƒ;circ=ˆ;tilde=˜;Alpha=Α" +
    ";Beta=Β;Gamma=Γ;Delta=Δ;Epsilon=Ε;Zeta=Ζ;Eta=Η;Theta=Θ;Iota=Ι;Kappa=Κ;Lambda=Λ;Mu=Μ;Nu=Ν;Xi=Ξ" +
    ";Omicron=Ο;Pi=Π;Rho=Ρ;Sigma=Σ;Tau=Τ;Upsilon=Υ;Phi=Φ;Chi=Χ;Psi=Ψ;Omega=Ω;alpha=α;beta=β;gamma=γ" +
    ";delta=δ;epsilon=ε;zeta=ζ;eta=η;theta=θ;iota=ι;kappa=κ;lambda=λ;mu=μ;nu=ν;xi=ξ;omicron=ο;pi=π;rho=ρ" +
    ";sigmaf=ς;sigma=σ;tau=τ;upsilon=υ;phi=φ;chi=χ;psi=ψ;omega=ω;thetasym=ϑ;upsih=ϒ;piv=ϖ;ensp= ;emsp= " +
    ";thinsp= ;zwnj=‌;zwj=‍;lrm=‎;rlm=‏;ndash=–;mdash=—;lsquo=‘;rsquo=’;sbquo=‚;ldquo=“;rdquo=”;bdquo=„" +
    ";dagger=†;Dagger=‡;bull=•;hellip=…;permil=‰;prime=′;Prime=″;lsaquo=‹;rsaquo=›;oline=‾;frasl=⁄;euro=€" +
    ";image=ℑ;weierp=℘;real=ℜ;trade=™;alefsym=ℵ;larr=←;uarr=↑;rarr=→;darr=↓;harr=↔;crarr=↵;lArr=⇐;uArr=⇑" +
    ";rArr=⇒;dArr=⇓;hArr=⇔;forall=∀;part=∂;exist=∃;empty=∅;nabla=∇;isin=∈;notin=∉;ni=∋;prod=∏;sum=∑" +
    ";minus=−;lowast=∗;radic=√;prop=∝;infin=∞;ang=∠;and=∧;or=∨;cap=∩;cup=∪;int=∫;there4=∴;sim=∼;cong=≅" +
    ";asymp=≈;ne=≠;equiv=≡;le=≤;ge=≥;sub=⊂;sup=⊃;nsub=⊄;sube=⊆;supe=⊇;oplus=⊕;otimes=⊗;perp=⊥;sdot=⋅" +
    ";lceil=⌈;rceil=⌉;lfloor=⌊;rfloor=⌋;lang=〈;rang=〉;loz=◊;spades=♠;clubs=♣;hearts=♥;diams=♦;"
}

// Named-entity lookup. "" = unknown -> caller leaves literal.
fn __html_named_entity(name: String) -> String {
    if name.length() == 0 { return "" }
    let table: String = __html_entity_table()
    let key: String = ";" + name + "="
    let at: int = table.indexOf(key)
    if at < 0 { return "" }
    let start: int = at + key.length()
    var end: int = start
    let tn: int = table.length()
    while end < tn and table.charAt(end) != 59 { end = end + 1 }
    return table.substring(start, end)
}

// Numeric reference body ("#233", "#xE9") -> codepoint; -1 = malformed.
// Accumulator clamps at 0x110000 so absurdly long digit runs can't overflow —
// anything clamped is > U+10FFFF and utf8_encode turns it into U+FFFD (HTML
// semantics for out-of-range references).
fn __html_numeric_cp(body: String) -> int {
    let n: int = body.length()
    if n < 2 { return 0 - 1 }
    var i: int = 1
    var hex: bool = false
    let c1: int = body.charAt(1)
    if c1 == 120 or c1 == 88 {        // 'x' | 'X'
        hex = true
        i = 2
        if n < 3 { return 0 - 1 }
    }
    var cp: int = 0
    while i < n {
        let c: int = body.charAt(i)
        var d: int = 0 - 1
        if c >= 48 and c <= 57 { d = c - 48 }                       // 0-9
        if hex and c >= 97 and c <= 102 { d = c - 97 + 10 }         // a-f
        if hex and c >= 65 and c <= 70 { d = c - 65 + 10 }          // A-F
        if d < 0 { return 0 - 1 }
        if hex { cp = cp * 16 + d } else { cp = cp * 10 + d }
        if cp > 0x110000 { cp = 0x110000 }
        i = i + 1
    }
    return cp
}

// Unescape HTML entities — single left-to-right pass (decoded output is never
// re-scanned, so "&amp;lt;" yields "&lt;", not "<"). Numeric references
// (&#233; / &#xE9;) go through utf8_encode (invalid -> U+FFFD, HTML semantics);
// named entities come from the HTML 4.01 table above; anything malformed or
// unknown (including a bare "&" or a missing ";") stays literal, like browsers
// treat unknown named references.
pub fn html_unescape(s: String) -> String {
    let n: int = s.length()
    var sb: StringBuilder = StringBuilder.new()
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c != 38 {                                  // '&'
            sb.append(s.substring(i, i + 1))
            i = i + 1
            continue
        }
        // Find ';' in a bounded window (longest named entity is well under 32)
        var semi: int = 0 - 1
        var j: int = i + 1
        let limit: int = i + 32
        while j < n and j < limit {
            if s.charAt(j) == 59 { semi = j; break }  // ';'
            j = j + 1
        }
        if semi < 0 {
            sb.append("&")
            i = i + 1
            continue
        }
        let body: String = s.substring(i + 1, semi)
        var decoded: String = ""
        if body.length() > 0 and body.charAt(0) == 35 {   // '#'
            var cp: int = __html_numeric_cp(body)
            if cp >= 0 {
                // HTML5 §13.2.5.80: referencia a NUL -> U+FFFD (los sustitutos y
                // > 10FFFF ya los resuelve utf8_encode).
                if cp == 0 { cp = 0xFFFD }
                decoded = utf8_encode(cp)
            }
        } else {
            decoded = __html_named_entity(body)
        }
        if decoded.length() == 0 {
            // Malformed/unknown: emit the '&' alone and rescan from the next
            // byte — "&&amp;" still decodes its second entity correctly.
            sb.append("&")
            i = i + 1
            continue
        }
        sb.append(decoded)
        i = semi + 1
    }
    return sb.to_string()
}

// ── Simple template ───────────────────────────────────────────────────────────

// Render a simple template by replacing {{key}} with values from the map
// Example: render_template("Hello {{name}}!", m) where m["name"] = "World"
pub fn render_template(tmpl: String, data: Map<String>) -> String {
    let keys = data.keys()
    var result = tmpl
    var i = 0
    while i < keys.length() {
        let k: String = keys[i]
        let placeholder = "{{" + k + "}}"
        let v = data.get(k)
        result = result.replace(placeholder, v)
        i = i + 1
    }
    return result
}
