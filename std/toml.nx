// std/toml.nx — TOML configuration file parser for Nyx (v4.9.0)
// Supports: key = "value", key = 42, key = true, [section], [section.sub],
// and [[array of tables]].
// Returns a FLAT Map<String> with dot-notation keys: "section.key" = "value".
//
// Arrays de tablas: cada aparición de [[t]] abre un elemento nuevo y sus claves
// llevan el índice — [[campos]] dos veces produce "campos.0.nombre" y
// "campos.1.nombre". El conteo se lee con toml_array_len(parsed, "campos"), que
// evita adivinar dónde termina la lista. Hasta el 2026-09-08 [[t]] caía en el
// camino de [t]: toml_parse_section devolvía "[campos" —con el corchete de
// apertura ADENTRO, porque buscaba el primer ']' desde la posición 1— y las
// entradas se pisaban entre sí, así que del manifiesto solo sobrevivía la
// última. Reporte de fricción.

// Sufijo reservado donde toml_parse deja el conteo de cada array de tablas.
// Lleva un carácter que una clave TOML válida no puede tener a secas, para no
// colisionar con una clave del usuario.
const TOML_ARRAY_LEN_SUFFIX: String = ".#len"

// ── Tokenizer ─────────────────────────────────────────────────────────────────

fn toml_skip_whitespace(line: String, pos: int) -> int {
    var i = pos
    while i < line.length() {
        let ch = line.charAt(i)
        if ch != ' ' and ch != '\t' { return i }
        i = i + 1
    }
    return i
}

fn toml_read_key(line: String, pos: int) -> String {
    var i = pos
    var key = ""
    while i < line.length() {
        let ch = line.charAt(i)
        if ch == '=' or ch == ' ' or ch == '\t' { return key }
        key = key + line.substring(i, i + 1)
        i = i + 1
    }
    return key
}

fn toml_read_string_value(line: String, pos: int) -> String {
    // pos points to opening quote
    var i = pos + 1
    var result = ""
    while i < line.length() {
        let ch = line.charAt(i)
        if ch == '"' { return result }
        if ch == '\\' and i + 1 < line.length() {
            let next = line.charAt(i + 1)
            if next == 'n' { result = result + "\n"  i = i + 2 }
            else if next == 't' { result = result + "\t"  i = i + 2 }
            else if next == '"' { result = result + "\""  i = i + 2 }
            else if next == '\\' { result = result + "\\"  i = i + 2 }
            else { result = result + line.substring(i, i + 1)  i = i + 1 }
        } else {
            result = result + line.substring(i, i + 1)
            i = i + 1
        }
    }
    return result
}

fn toml_read_value(line: String, pos: int) -> String {
    let i = toml_skip_whitespace(line, pos)
    if i >= line.length() { return "" }
    let ch = line.charAt(i)
    if ch == '"' {
        return toml_read_string_value(line, i)
    }
    // Read until end of line or comment
    var result = ""
    var j = i
    while j < line.length() {
        let c = line.charAt(j)
        if c == '#' { return result.trim() }
        result = result + line.substring(j, j + 1)
        j = j + 1
    }
    return result.trim()
}

fn toml_is_section(line: String) -> bool {
    let trimmed = line.trim()
    if trimmed.length() == 0 { return false }
    return trimmed.charAt(0) == '['
}

// ¿Es un array de tablas — [[t]] — y no una tabla normal — [t]?
fn toml_is_array_table(line: String) -> bool {
    let trimmed = line.trim()
    if trimmed.length() < 4 { return false }
    if trimmed.charAt(0) != '[' { return false }
    return trimmed.charAt(1) == '['
}

fn toml_parse_section(line: String) -> String {
    let trimmed = line.trim()
    let n = trimmed.length()
    if n < 2 { return "" }
    // [[t]] abre en el índice 2; [t] en el 1. Sin este salto el nombre salía
    // con el corchete adentro ("[campos") y toml_get(m, "campos.x") no
    // encontraba nada, mientras toml_get(m, "[campos.x") sí — el síntoma que
    // trajo el reporte.
    var start = 1
    if toml_is_array_table(trimmed) { start = 2 }
    var end = start
    while end < n and trimmed.charAt(end) != ']' {
        end = end + 1
    }
    return trimmed.substring(start, end).trim()
}

// ── Public API ────────────────────────────────────────────────────────────────

// Parse a TOML string and return a Map<String> with dot-notation keys
// e.g. [server]\nhost = "localhost"\nport = 8080
// → "server.host" = "localhost", "server.port" = "8080"
pub fn toml_parse(content: String) -> Map<String> {
    var result: Map<String> = map_new()
    let lines = content.split("\n")
    var section = ""
    // Cuántos elementos vio cada [[array de tablas]]: la clave de conteo se
    // guarda en el propio Map (bajo un sufijo reservado) para que
    // toml_array_len pueda responder sin re-parsear.
    var arr_counts: Map<int> = map_new()
    var i = 0
    while i < lines.length() {
        let line: String = lines[i]
        let trimmed = line.trim()

        // Skip blank lines and comments
        if trimmed.length() == 0 {
            i = i + 1
        } else if trimmed.charAt(0) == '#' {
            i = i + 1
        } else if toml_is_section(trimmed) {
            let sec_name: String = toml_parse_section(trimmed)
            if toml_is_array_table(trimmed) {
                // Cada [[t]] abre un elemento NUEVO: el índice entra en el
                // prefijo, así que las entradas ya no se pisan.
                var idx: int = 0
                if arr_counts.contains(sec_name) { idx = arr_counts.get(sec_name) }
                section = sec_name + "." + int_to_string(idx)
                arr_counts.insert(sec_name, idx + 1)
                result.insert(sec_name + TOML_ARRAY_LEN_SUFFIX, int_to_string(idx + 1))
            } else {
                section = sec_name
            }
            i = i + 1
        } else {
            // Find = sign
            let eq_idx = trimmed.indexOf("=")
            if eq_idx > 0 {
                let raw_key = trimmed.substring(0, eq_idx).trim()
                let raw_val = trimmed.substring(eq_idx + 1, trimmed.length()).trim()
                let val = toml_read_value(raw_val, 0)
                var full_key = raw_key
                if section.length() > 0 {
                    full_key = section + "." + raw_key
                }
                result.insert(full_key, val)
            }
            i = i + 1
        }
    }
    return result
}

// Cuántos elementos tiene el [[array de tablas]] `name` (0 si no existe).
// Con esto el manifiesto se recorre sin adivinar dónde termina:
//   var i = 0
//   while i < toml_array_len(m, "campos") {
//       let n = toml_get(m, "campos." + int_to_string(i) + ".nombre", "")
//       i = i + 1
//   }
pub fn toml_array_len(parsed: Map<String>, name: String) -> int {
    let key: String = name + TOML_ARRAY_LEN_SUFFIX
    if not parsed.contains(key) { return 0 }
    return string_to_int(parsed.get(key))
}

// Get a string value from parsed TOML (returns default if not found)
pub fn toml_get(parsed: Map<String>, key: String, default_val: String) -> String {
    if parsed.contains(key) {
        return parsed.get(key)
    }
    return default_val
}

// Get an int value from parsed TOML
pub fn toml_get_int(parsed: Map<String>, key: String, default_val: int) -> int {
    if parsed.contains(key) {
        let s = parsed.get(key)
        return string_to_int(s)
    }
    return default_val
}

// Get a bool value ("true" → true, anything else → false)
pub fn toml_get_bool(parsed: Map<String>, key: String, default_val: bool) -> bool {
    if parsed.contains(key) {
        let s = parsed.get(key)
        return s == "true"
    }
    return default_val
}

// Check if a key exists
pub fn toml_has(parsed: Map<String>, key: String) -> bool {
    return parsed.contains(key)
}

// Helper: convert string to int (simple, no error handling)
fn string_to_int(s: String) -> int {
    var result = 0
    var neg = false
    var i = 0
    if s.length() > 0 and s.charAt(0) == '-' {
        neg = true
        i = 1
    }
    while i < s.length() {
        let ch = s.charAt(i)
        let d = char_to_digit(ch)
        if d >= 0 {
            result = result * 10 + d
        }
        i = i + 1
    }
    if neg { return -result }
    return result
}

fn char_to_digit(ch: char) -> int {
    if ch == '0' { return 0 }
    if ch == '1' { return 1 }
    if ch == '2' { return 2 }
    if ch == '3' { return 3 }
    if ch == '4' { return 4 }
    if ch == '5' { return 5 }
    if ch == '6' { return 6 }
    if ch == '7' { return 7 }
    if ch == '8' { return 8 }
    if ch == '9' { return 9 }
    return -1
}
