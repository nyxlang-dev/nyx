// std/sqlite.nx — SQLite3 bindings for Nyx (v0.11.0)
// Requires: runtime/sqlite_adapter.c, -ldl in link flags
//
// E5.5 (spec §4.2.5, "sqlite: el canal lateral sqlite_error(db) desaparece
// dentro del Error"): la familia try_sqlite_* devuelve Result<T, Error> en
// vez de bool/-1 mudo + sqlite_error(db) a mano. Kind nuevo "db" en
// std/error.nx — ver ahí el porqué (colisión rc sqlite / errno). Alcance
// de esta rama: try_sqlite_open/exec/query/query_named. begin/commit/
// rollback/exec_int/exec_str/query_int quedan afuera (ficha E5.5b, mismo
// patrón mecánico) — las centinelas actuales siguen intactas.

import "std/error"

// FFI declarations — sqlite adapter bridge
extern "C" fn nyx_sqlite_open(path: String) -> *int
extern "C" fn nyx_sqlite_close(db: *int)
extern "C" fn nyx_sqlite_exec(db: *int, sql: String) -> int
extern "C" fn nyx_sqlite_prepare(db: *int, sql: String) -> *int
extern "C" fn nyx_sqlite_step(stmt: *int) -> int
extern "C" fn nyx_sqlite_finalize(stmt: *int)
extern "C" fn nyx_sqlite_column_count(stmt: *int) -> int
extern "C" fn nyx_sqlite_column_str(stmt: *int, col: int) -> String
extern "C" fn nyx_sqlite_column_name(stmt: *int, col: int) -> String
extern "C" fn nyx_sqlite_column_int(stmt: *int, col: int) -> int
extern "C" fn nyx_sqlite_bind_str(stmt: *int, idx: int, val: String) -> int
extern "C" fn nyx_sqlite_bind_int(stmt: *int, idx: int, val: int) -> int
extern "C" fn nyx_sqlite_bind_double(stmt: *int, idx: int, val: float) -> int
extern "C" fn nyx_sqlite_column_float(stmt: *int, col: int) -> float
extern "C" fn nyx_sqlite_last_insert_id(db: *int) -> int
extern "C" fn nyx_sqlite_changes(db: *int) -> int
extern "C" fn nyx_sqlite_errmsg(db: *int) -> String

// High-level wrappers

// Open database (":memory:" for in-memory)
/// Abre (o crea) el archivo. Devuelve el handle *int — capturable en closures sin drama (fn de std con retorno declarado).
pub fn sqlite_open(path: String) -> *int {
    return nyx_sqlite_open(path)
}

pub fn sqlite_close(db: *int) {
    nyx_sqlite_close(db)
}

// Execute DDL/DML with no result — returns true on success
/// DDL/DML sin resultado; true en éxito. Para SQL con valores usar sqlite_exec_params (params String).
pub fn sqlite_exec(db: *int, sql: String) -> bool {
    let rc = nyx_sqlite_exec(db, sql)
    return rc == 0
}

// Query: returns Array of rows, each row is an Array of String values
/// Array de filas; cada fila es Array y TODA celda es String — incluidas columnas INTEGER (pasar por string_to_int; leerla como int devuelve el PUNTERO como número, silencioso). Celda SQL NULL llega como la cadena "NULL". Para ints reales: sqlite_query_int.
pub fn sqlite_query(db: *int, sql: String) -> Array {
    let stmt = nyx_sqlite_prepare(db, sql)
    var rows = []
    var done = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            let ncols = nyx_sqlite_column_count(stmt)
            var row = []
            var c = 0
            while c < ncols {
                let val: String = nyx_sqlite_column_str(stmt, c)
                row.push(val)
                c = c + 1
            }
            rows.push(row)
        } else {
            done = true
        }
    }
    nyx_sqlite_finalize(stmt)
    return rows
}

// Query returning column names (first call) then rows
/// Como sqlite_query pero ANTEPONE una fila de headers: N+1 elementos, la fila 0 son los nombres de columna.
pub fn sqlite_query_named(db: *int, sql: String) -> Array {
    let stmt = nyx_sqlite_prepare(db, sql)
    var result = []

    // Get column names first
    // We need at least one step to know col count... actually col count available before step
    let ncols = nyx_sqlite_column_count(stmt)
    var headers = []
    var ci = 0
    while ci < ncols {
        let name: String = nyx_sqlite_column_name(stmt, ci)
        headers.push(name)
        ci = ci + 1
    }
    result.push(headers)

    var done = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            var row = []
            var c = 0
            while c < ncols {
                let val: String = nyx_sqlite_column_str(stmt, c)
                row.push(val)
                c = c + 1
            }
            result.push(row)
        } else {
            done = true
        }
    }
    nyx_sqlite_finalize(stmt)
    return result
}

// Execute with one int binding
pub fn sqlite_exec_int(db: *int, sql: String, val: int) -> bool {
    let stmt = nyx_sqlite_prepare(db, sql)
    nyx_sqlite_bind_int(stmt, 1, val)
    nyx_sqlite_step(stmt)
    nyx_sqlite_finalize(stmt)
    return true
}

// Execute with one string binding
pub fn sqlite_exec_str(db: *int, sql: String, val: String) -> bool {
    let stmt = nyx_sqlite_prepare(db, sql)
    nyx_sqlite_bind_str(stmt, 1, val)
    nyx_sqlite_step(stmt)
    nyx_sqlite_finalize(stmt)
    return true
}

// Last inserted row id
/// last_insert_rowid del handle.
pub fn sqlite_last_id(db: *int) -> int {
    return nyx_sqlite_last_insert_id(db)
}

// Number of rows affected by last INSERT/UPDATE/DELETE
pub fn sqlite_affected(db: *int) -> int {
    return nyx_sqlite_changes(db)
}

/// Mensaje del último error del handle (sqlite3_errmsg).
pub fn sqlite_error(db: *int) -> String {
    return nyx_sqlite_errmsg(db)
}

// === Result<T, Error> — el canal lateral muere dentro del Error (E5.5) ===
//
// SONDA (evidencia empírica, dlopen directo a libsqlite3.so.0 fuera de
// Nyx — ver report de la tarea): runtime/sqlite_adapter.c (congelado,
// CERO cambios en esta rama) colapsa el rc granular de sqlite3 a
// boolean/NULL en TODAS sus funciones — nyx_sqlite_exec devuelve 0/-1
// (nunca el rc real: 1 SQLITE_ERROR, 19 SQLITE_CONSTRAINT, etc.),
// nyx_sqlite_prepare devuelve NULL/stmt, nyx_sqlite_step devuelve 1/0/-1.
// Nyx JAMÁS ve el número real que sqlite3 devolvió. Por eso `code` en
// estos Error es 0 (documentado como "sin rc granular disponible", NO
// SQLITE_OK — el 0 vive adentro de un Err) salvo en try_sqlite_open,
// donde ni siquiera hay un db handle vivo para consultar `msg`. Exponer
// el rc real es un cambio de runtime/sqlite_adapter.c — fuera de alcance
// acá (Nyx puro) y fichado para E5.5b.

// SONDA 1: ¿qué da nyx_sqlite_open ante un path imposible? Medido con
// "/proc/nada/db": sqlite3_open() SÍ devuelve un db handle válido con rc
// real (14, SQLITE_CANTOPEN) y errmsg legible ("unable to open database
// file") — pero el adapter (`if (rc != SQLITE_OK) return NULL;`)
// DESCARTA ese handle sin cerrarlo y devuelve NULL sin más. Del lado Nyx
// no queda NADA que consultar: ni rc ni errmsg. NULL es la única señal
// disponible → fallback honesto: Err{0, "db", "no se pudo abrir <path>"}.
pub fn try_sqlite_open(path: String) -> Result<*int, Error> {
    let db: *int = nyx_sqlite_open(path)
    if db == 0 {
        return Result.Err(err_new(0, "db", "no se pudo abrir " + path))
    }
    return Result.Ok(db)
}

// A diferencia de try_sqlite_open, acá el db handle SIGUE VIVO tras un
// fallo (nyx_sqlite_exec solo puede fallar si sqlite ya abrió `db` con
// éxito) — sqlite3_exec() actualiza el errmsg interno del handle aunque
// el adapter descarte el out-param propio (medido: el errmsg sigue
// legible vía nyx_sqlite_errmsg(db) después de un exec fallido). Éxito:
// Ok(affected) vía sqlite_affected — el rc de exec SÍ distingue Ok/Err
// con claridad (0 = SQLITE_OK, -1 = cualquier otra cosa), no hace falta
// fichar ahí.
pub fn try_sqlite_exec(db: *int, sql: String) -> Result<int, Error> {
    let rc: int = nyx_sqlite_exec(db, sql)
    if rc == 0 {
        return Result.Ok(sqlite_affected(db))
    }
    return Result.Err(err_new(0, "db", nyx_sqlite_errmsg(db)))
}

// SONDA 2: ¿nyx_sqlite_prepare NULL deja errmsg legible en el db? Medido
// con SQL malformado ("SELEKT ...") y con tabla inexistente: en AMBOS
// casos prepare falla en el momento del prepare mismo (rc=1
// SQLITE_ERROR, stmt=NULL) y sqlite3_errmsg(db) da el mensaje real
// ("near "SELEKT": syntax error" / "no such table: X") — sí sirve.
//
// SONDA 3 (HALLAZGO sobre la centinela, fichado — la centinela sqlite_*
// NO se toca): el loop de sqlite_query trata TODO rc de step distinto de
// 1 como "done" — pero nyx_sqlite_step YA colapsa un error real de step
// (ej. 19 SQLITE_CONSTRAINT en un INSERT con conflicto de PK) al mismo
// -1 que cualquier fallo, DISTINTO del 0 de SQLITE_DONE real. La
// centinela ignora esa distinción (`else { done = true }`) y devuelve
// las filas juntadas hasta ahí como si la query hubiese terminado bien
// — un error de step a mitad de camino se come en silencio. Acá SÍ se
// distingue: cualquier rc != 0 en esta rama (ver HALLAZGO 2 más abajo
// sobre por qué NO es un simple `rc == -1`) es Err; rc == 0 es Ok con lo
// juntado.
pub fn try_sqlite_query(db: *int, sql: String) -> Result<Array, Error> {
    let stmt: *int = nyx_sqlite_prepare(db, sql)
    if stmt == 0 {
        return Result.Err(err_new(0, "db", nyx_sqlite_errmsg(db)))
    }
    var rows = []
    var done = false
    var failed = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            let ncols = nyx_sqlite_column_count(stmt)
            var row = []
            var c = 0
            while c < ncols {
                let val: String = nyx_sqlite_column_str(stmt, c)
                row.push(val)
                c = c + 1
            }
            rows.push(row)
        } else {
            // HALLAZGO 2 (gotcha de FFI, no de sqlite): nyx_sqlite_step
            // devuelve un C `int` de 32 bits; al cruzar a Nyx `int` (64
            // bits) NO se sign-extiende — un -1 de C llega acá como
            // 4294967295 (medido), no como -1. `rc == -1` nunca matchea.
            // Comparar contra el sentinel exacto es la trampa; lo honesto
            // es que YA sabemos rc != 1 acá — cualquier rc != 0 (sea cual
            // sea su representación de bits) es el error de SONDA 3, no
            // el DONE real. runtime/net.c evita esto declarando sus
            // _result como int64_t (ver std/net.nx) — sqlite_adapter.c NO
            // lo hace en varias fns (fichado para E5.5b: migrar sus
            // firmas C, cambio de runtime fuera de alcance acá).
            if rc != 0 {
                failed = true
            }
            done = true
        }
    }
    // errmsg ANTES de finalize — es del db handle, no del stmt, pero
    // capturarlo mientras el stmt sigue vivo evita cualquier duda.
    let errmsg: String = nyx_sqlite_errmsg(db)
    nyx_sqlite_finalize(stmt)
    if failed {
        return Result.Err(err_new(0, "db", errmsg))
    }
    return Result.Ok(rows)
}

// Como try_sqlite_query pero con la fila de headers al frente (mismo
// shape que sqlite_query_named) — mismas SONDAS 2/3 aplican, mismo fix.
pub fn try_sqlite_query_named(db: *int, sql: String) -> Result<Array, Error> {
    let stmt: *int = nyx_sqlite_prepare(db, sql)
    if stmt == 0 {
        return Result.Err(err_new(0, "db", nyx_sqlite_errmsg(db)))
    }
    let ncols = nyx_sqlite_column_count(stmt)
    var headers = []
    var ci = 0
    while ci < ncols {
        let name: String = nyx_sqlite_column_name(stmt, ci)
        headers.push(name)
        ci = ci + 1
    }
    var result = []
    result.push(headers)

    var done = false
    var failed = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            var row = []
            var c = 0
            while c < ncols {
                let val: String = nyx_sqlite_column_str(stmt, c)
                row.push(val)
                c = c + 1
            }
            result.push(row)
        } else {
            // HALLAZGO 2 — ver el comentario de try_sqlite_query arriba
            // (mismo gotcha de FFI: rc != 0, nunca rc == -1).
            if rc != 0 {
                failed = true
            }
            done = true
        }
    }
    let errmsg: String = nyx_sqlite_errmsg(db)
    nyx_sqlite_finalize(stmt)
    if failed {
        return Result.Err(err_new(0, "db", errmsg))
    }
    return Result.Ok(result)
}

// === Transactions ===

pub fn sqlite_begin(db: *int) -> bool {
    return sqlite_exec(db, "BEGIN TRANSACTION")
}

pub fn sqlite_commit(db: *int) -> bool {
    return sqlite_exec(db, "COMMIT")
}

pub fn sqlite_rollback(db: *int) -> bool {
    return sqlite_exec(db, "ROLLBACK")
}

// === Typed query results ===

// Query returning rows of int values
/// Filas de int REALES (sqlite3_column_int) — la vía tipada para columnas numéricas, sin string_to_int.
pub fn sqlite_query_int(db: *int, sql: String) -> Array {
    let stmt = nyx_sqlite_prepare(db, sql)
    var rows = []
    var done = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            let ncols = nyx_sqlite_column_count(stmt)
            var row = []
            var c = 0
            while c < ncols {
                let val: int = nyx_sqlite_column_int(stmt, c)
                row.push(val)
                c = c + 1
            }
            rows.push(row)
        } else {
            done = true
        }
    }
    nyx_sqlite_finalize(stmt)
    return rows
}

// Query returning single int value (first column of first row)
/// Primera columna de la primera fila como int real; 0 si no hay filas.
pub fn sqlite_query_one_int(db: *int, sql: String) -> int {
    let stmt = nyx_sqlite_prepare(db, sql)
    let rc = nyx_sqlite_step(stmt)
    var result: int = 0
    if rc == 1 {
        result = nyx_sqlite_column_int(stmt, 0)
    }
    nyx_sqlite_finalize(stmt)
    return result
}

// Query returning single string value (first column of first row)
/// Primera columna de la primera fila como String; "" si no hay filas. NULL llega como "NULL".
pub fn sqlite_query_one_str(db: *int, sql: String) -> String {
    let stmt = nyx_sqlite_prepare(db, sql)
    let rc = nyx_sqlite_step(stmt)
    var result: String = ""
    if rc == 1 {
        result = nyx_sqlite_column_str(stmt, 0)
    }
    nyx_sqlite_finalize(stmt)
    return result
}

// === Multi-parameter binding ===

// Execute with int + string parameters (e.g., UPDATE ... SET name=? WHERE id=?)
/// TODOS los params como String (binding textual), también los numéricos: ["7", "ana"] y no [7, "ana"].
pub fn sqlite_exec_params(db: *int, sql: String, params: Array) -> bool {
    let stmt = nyx_sqlite_prepare(db, sql)
    var i: int = 0
    while i < params.length() {
        // Bind all params as strings (most flexible)
        let val: String = params[i]
        nyx_sqlite_bind_str(stmt, i + 1, val)
        i = i + 1
    }
    nyx_sqlite_step(stmt)
    nyx_sqlite_finalize(stmt)
    return true
}

// Query with string parameters
/// Query con params (todos String, binding textual). Celdas del resultado: String, como sqlite_query.
pub fn sqlite_query_params(db: *int, sql: String, params: Array) -> Array {
    let stmt = nyx_sqlite_prepare(db, sql)
    var i: int = 0
    while i < params.length() {
        let val: String = params[i]
        nyx_sqlite_bind_str(stmt, i + 1, val)
        i = i + 1
    }
    var rows = []
    var done = false
    while not done {
        let rc = nyx_sqlite_step(stmt)
        if rc == 1 {
            let ncols = nyx_sqlite_column_count(stmt)
            var row = []
            var c = 0
            while c < ncols {
                let val: String = nyx_sqlite_column_str(stmt, c)
                row.push(val)
                c = c + 1
            }
            rows.push(row)
        } else {
            done = true
        }
    }
    nyx_sqlite_finalize(stmt)
    return rows
}

// === Schema migration ===

// Initialize migration tracking table
pub fn sqlite_migrate_init(db: *int) -> bool {
    return sqlite_exec(db, "CREATE TABLE IF NOT EXISTS _nyx_migrations (version INTEGER PRIMARY KEY, name TEXT, applied_at TEXT DEFAULT CURRENT_TIMESTAMP)")
}

// Get current schema version
pub fn sqlite_migrate_version(db: *int) -> int {
    return sqlite_query_one_int(db, "SELECT COALESCE(MAX(version), 0) FROM _nyx_migrations")
}

// Apply a migration if not already applied
pub fn sqlite_migrate(db: *int, version: int, name: String, sql: String) -> bool {
    let current = sqlite_migrate_version(db)
    if version <= current {
        return true
    }
    sqlite_begin(db)
    let ok = sqlite_exec(db, sql)
    if ok {
        let stmt = nyx_sqlite_prepare(db, "INSERT INTO _nyx_migrations (version, name) VALUES (?, ?)")
        nyx_sqlite_bind_int(stmt, 1, version)
        nyx_sqlite_bind_str(stmt, 2, name)
        nyx_sqlite_step(stmt)
        nyx_sqlite_finalize(stmt)
        sqlite_commit(db)
        return true
    }
    sqlite_rollback(db)
    return false
}

// === Table introspection ===

// List all tables in the database
pub fn sqlite_tables(db: *int) -> Array {
    let rows = sqlite_query(db, "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name")
    var names = []
    var i = 0
    while i < rows.length() {
        let row: Array = rows[i]
        let name: String = row[0]
        names.push(name)
        i = i + 1
    }
    return names
}

// Check if a table exists
pub fn sqlite_table_exists(db: *int, name: String) -> bool {
    let stmt = nyx_sqlite_prepare(db, "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name=?")
    nyx_sqlite_bind_str(stmt, 1, name)
    let rc = nyx_sqlite_step(stmt)
    var count: int = 0
    if rc == 1 {
        count = nyx_sqlite_column_int(stmt, 0)
    }
    nyx_sqlite_finalize(stmt)
    return count > 0
}

// Count rows in a table
/// SELECT COUNT(*) de la tabla, como int real.
pub fn sqlite_count(db: *int, table: String) -> int {
    return sqlite_query_one_int(db, "SELECT COUNT(*) FROM " + table)
}
