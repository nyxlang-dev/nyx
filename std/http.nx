// ============================================
// HTTP.NX - HTTP Server Library for Nyx v5.2
// ============================================
// Pure Nyx implementation over TCP builtins
// Provides request parsing, response building, and a simple server loop

import "std/json"
import "std/net"
import "std/error"
// Para el camino HTTPS verificado: tls_connect_verified y tls_set_ca_file son
// funciones de std/tls, no builtins (tls_connect sí lo es, y esa asimetría es
// justamente por qué este módulo venía usando la variante que NO verifica).
// std/tls no importa nada, así que no hay ciclo.
import "std/tls"

// Cap del body (bytes, default 1MiB, configurable con NYX_HTTP_MAX_BODY) —
// compartido con el parser rápido del runtime (net.c). Sin este cap,
// http_parse_request alocaba lo que dijera el Content-Length remoto.
extern "C" fn nyx_http_max_body() -> int

// === Multi-threaded server globals (private) ===
var __http_mt_ch: Map = Map.new()
var __http_mt_handler: Fn = 0

// === Utilities (private) ===

fn http_parse_int(s: String) -> int {
    var result: int = 0
    var i: int = 0
    let len: int = s.length()
    while i < len {
        let c: char = s.charAt(i)
        if c >= '0' and c <= '9' {
            let d: int = c - '0'
            result = result * 10 + d
        }
        i = i + 1
    }
    return result
}

// Tabla de textos de estado (reason phrase) de RFC 9110 §15. Ampliada por el
// bug de fricción 20260914-170002 (nyxerp): un 303 salía como
// "303 Unknown" contra el servidor real — faltaban 303/307/308 (los tres
// redirects que std/serve puede emitir) y varios 4xx/5xx de uso común. La
// lista cubre los códigos que un handler de std/serve/std/web puede
// devolver hoy más los que un cliente HTTP (std/http) puede recibir de un
// servidor de terceros.
pub fn http_status_text(code: int) -> String {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 204 { return "No Content" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 409 { return "Conflict" }
    if code == 413 { return "Payload Too Large" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 422 { return "Unprocessable Content" }
    if code == 429 { return "Too Many Requests" }
    if code == 500 { return "Internal Server Error" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    return "Unknown"
}

// === Response building ===

pub fn http_response(status: int, body: String) -> String {
    let crlf: String = "\r\n"
    let status_str: String = int_to_string(status)
    let body_len: String = int_to_string(str_byte_length(body))
    var resp: String = "HTTP/1.1 " + status_str + " " + http_status_text(status) + crlf
    resp = resp + "Content-Length: " + body_len + crlf
    resp = resp + "Content-Type: text/plain" + crlf
    resp = resp + "Connection: close" + crlf
    resp = resp + crlf + body
    return resp
}

// headers_arr: flat array of [key1, val1, key2, val2, ...]
pub fn http_response_with_headers(status: int, headers_arr: Array, body: String) -> String {
    let crlf: String = "\r\n"
    let status_str: String = int_to_string(status)
    let body_len: String = int_to_string(str_byte_length(body))
    var resp: String = "HTTP/1.1 " + status_str + " " + http_status_text(status) + crlf
    resp = resp + "Content-Length: " + body_len + crlf
    // Add custom headers
    var i: int = 0
    let len: int = headers_arr.length()
    while i + 1 < len {
        let k: String = headers_arr[i]
        let v: String = headers_arr[i + 1]
        resp = resp + k + ": " + v + crlf
        i = i + 2
    }
    resp = resp + "Connection: close" + crlf
    resp = resp + crlf + body
    return resp
}

pub fn http_json_response(status: int, data: Array) -> String {
    let body: String = json_stringify(data)
    let headers_arr: Array = ["Content-Type", "application/json"]
    return http_response_with_headers(status, headers_arr, body)
}

// === URL parsing ===

// ⚠️ LAYOUT — Array MIXTO ["url", host, port, path, secure]:
//   [0] "url" (tag, String) · [1] host String · [2] port INT · [3] path String
//   · [4] secure INT (1 = TLS).
// Leer un slot con el tipo equivocado (p.ej. `let p: String = parsed[2]`)
// trata el int crudo como puntero → SEGV. Anotar SIEMPRE el tipo correcto por
// slot, como hace http_get: host String [1], port int [2], path String [3],
// secure int [4].
pub fn http_parse_url(url: String) -> Array {
    // Detectar esquema. https:// → TLS, puerto por defecto 443; http:// → 80.
    var rest: String = url
    var secure: int = 0
    var default_port: int = 80
    if url.startsWith("https://") {
        rest = url.substring(8, url.length())
        secure = 1
        default_port = 443
    } else if url.startsWith("http://") {
        rest = url.substring(7, url.length())
    }
    // Split host+port from path at first "/"
    let slash_idx: int = rest.indexOf("/")
    var host_port: String = rest
    var path: String = "/"
    if slash_idx >= 0 {
        host_port = rest.substring(0, slash_idx)
        path = rest.substring(slash_idx, rest.length())
    }
    // Extract port from host
    let colon_idx: int = host_port.indexOf(":")
    var host: String = host_port
    var port: int = default_port
    if colon_idx >= 0 {
        host = host_port.substring(0, colon_idx)
        let port_str: String = host_port.substring(colon_idx + 1, host_port.length())
        port = http_parse_int(port_str)
    }
    // Slot [4] = secure (1 = TLS). Aditivo — los consumidores existentes leen [1..3].
    let result: Array = ["url", host, port, path, secure]
    return result
}

// === Client functions ===

// Valor de la cabecera `Host` (RFC 9110 §7.2: `Host = uri-host [ ":" port ]`).
// El puerto se omite SOLO cuando coincide con el de omisión del esquema (80
// http / 443 https); cualquier otro puerto va explícito "host:puerto". Sin
// esto el cliente mandaba SIEMPRE "Host: host" sin puerto — silencioso,
// rompía cualquier defensa CSRF que compara `Origin` (que un navegador manda
// CON puerto) contra `Host` (reportado por nyxerp contra 127.0.0.1:8124).
// NO soporta literales IPv6 (`[::1]:puerto`): http_parse_url tampoco los
// soporta hoy (parte host:puerto por el primer ":", así que un host IPv6
// nunca llega hasta acá entero) — fuera de alcance de este fix.
//
// pub: útil también para quien arma requests a mano (proxies, clientes
// custom) y necesita el mismo criterio de omisión que usa este módulo; y
// permite testear el caso "puerto por defecto → sin puerto" sin bindear
// los puertos privilegiados 80/443 (test de regresión en tests/ai-first).
pub fn http_host_header(host: String, port: int, default_port: int) -> String {
    if port == default_port {
        return host
    }
    return host + ":" + int_to_string(port)
}

// host_header: valor YA armado para la cabecera Host (ver http_host_header)
// — "host" o "host:puerto" según corresponda, no el hostname pelado.
pub fn http_build_request(method: String, host_header: String, path: String, headers: Array, body: String) -> String {
    let crlf: String = "\r\n"
    var req: String = method + " " + path + " HTTP/1.1" + crlf
    req = req + "Host: " + host_header + crlf
    // Custom headers (flat array [k, v, k, v, ...])
    var i: int = 0
    let len: int = headers.length()
    while i + 1 < len {
        let k: String = headers[i]
        let v: String = headers[i + 1]
        req = req + k + ": " + v + crlf
        i = i + 2
    }
    if body.length() > 0 {
        let body_len: String = int_to_string(str_byte_length(body))
        req = req + "Content-Length: " + body_len + crlf
    }
    req = req + "Connection: close" + crlf
    req = req + crlf + body
    return req
}

// Parsea un entero HEXADECIMAL (para el tamaño de un chunk de Transfer-Encoding:
// chunked). Se detiene en el primer caracter no-hex (ignora `;chunk-ext` y \r).
fn http_parse_hex(s: String) -> int {
    var result: int = 0
    var i: int = 0
    let len: int = s.length()
    while i < len {
        let c: char = s.charAt(i)
        var d: int = -1
        if c >= '0' and c <= '9' { d = c - '0' }
        else if c >= 'a' and c <= 'f' { d = c - 'a' + 10 }
        else if c >= 'A' and c <= 'F' { d = c - 'A' + 10 }
        if d < 0 { i = len } else { result = result * 16 + d i = i + 1 }
    }
    return result
}

// De-chunking de un body Transfer-Encoding: chunked ya leído a un string (camino
// TLS). Formato: `<hex-size>\r\n <data>\r\n ... 0\r\n \r\n`.
fn http_dechunk_str(chunked: String) -> String {
    var result: String = ""
    var pos: int = 0
    let n: int = chunked.length()
    var done: bool = false
    while (not done) and pos < n {
        let rest: String = chunked.substring(pos, n)
        let crlf: int = rest.indexOf("\r\n")
        if crlf < 0 {
            done = true
        } else {
            let size_hex: String = rest.substring(0, crlf)
            let size: int = http_parse_hex(size_hex)
            let data_start: int = pos + crlf + 2
            let data_end: int = data_start + size
            if size <= 0 or data_end > n {
                done = true
            } else {
                result = result + chunked.substring(data_start, data_end)
                pos = data_end + 2   // saltar el \r\n que sigue al chunk
            }
        }
    }
    return result
}

// Lee un body Transfer-Encoding: chunked directamente del fd (camino TCP), chunk
// por chunk, hasta el chunk de tamaño 0.
fn http_read_chunked_fd(fd: int) -> String {
    var body: String = ""
    var done: bool = false
    while not done {
        let size_line: String = tcp_read_line(fd)   // "<hex>" (sin \r\n)
        let size: int = http_parse_hex(size_line)
        if size <= 0 {
            done = true
        } else {
            let chunk: String = tcp_read(fd, size)
            body = body + chunk
            let discard: String = tcp_read(fd, 2)    // consumir el \r\n del chunk
        }
    }
    return body
}

fn http_read_response(fd: int) -> Array {
    // Read status line
    let status_line: String = tcp_read_line(fd)
    let parts: Array = status_line.split(" ")
    var status_code: int = 0
    if parts.length() >= 2 {
        let code_str: String = parts[1]
        status_code = http_parse_int(code_str)
    }
    // Read headers
    let headers: Array = parse_headers(fd)
    // Read body — Transfer-Encoding: chunked tiene prioridad sobre Content-Length
    var body: String = ""
    let te_str: String = http_find_header(headers, "Transfer-Encoding")
    let cl_str: String = http_find_header(headers, "Content-Length")
    if te_str.indexOf("chunked") >= 0 {
        body = http_read_chunked_fd(fd)
    } else if cl_str.length() > 0 {
        let cl: int = http_parse_int(cl_str)
        if cl > 0 {
            body = tcp_read(fd, cl)
        }
    } else {
        body = tcp_read(fd, 65536)
    }
    let result: Array = ["response", status_code, headers, body]
    return result
}

// Parsea una respuesta HTTP cruda completa (status line + headers + body) a
// ["response", status_code, headers, body]. Headers en formato plano
// [k, v, k, v, ...], igual que parse_headers. Se usa para el camino TLS, donde
// se lee toda la respuesta a un string en vez de por fd bufferado.
fn http_parse_raw_response(raw: String) -> Array {
    let sep: int = raw.indexOf("\r\n\r\n")
    var head: String = raw
    var body: String = ""
    if sep >= 0 {
        head = raw.substring(0, sep)
        body = raw.substring(sep + 4, raw.length())
    }
    let lines: Array = head.split("\r\n")
    var status_code: int = 0
    var headers: Array = []
    if lines.length() > 0 {
        let status_line: String = lines[0]
        let sparts: Array = status_line.split(" ")
        if sparts.length() >= 2 {
            let code_str: String = sparts[1]
            status_code = http_parse_int(code_str)
        }
    }
    var li: int = 1
    while li < lines.length() {
        let line: String = lines[li]
        let colon_idx: int = line.indexOf(": ")
        if colon_idx >= 0 {
            let key: String = line.substring(0, colon_idx)
            let val: String = line.substring(colon_idx + 2, line.length())
            headers.push(key)
            headers.push(val)
        }
        li = li + 1
    }
    // Transfer-Encoding: chunked → de-chunk el body (el status/headers ya están)
    let te: String = http_find_header(headers, "Transfer-Encoding")
    if te.indexOf("chunked") >= 0 {
        body = http_dechunk_str(body)
    }
    let result: Array = ["response", status_code, headers, body]
    return result
}

// ── Verificación del certificado en HTTPS ─────────────────────────────────
//
// Hasta el 2026-09-11 este camino usaba `tls_connect`, que NO verifica nada:
// un certificado vencido, uno autofirmado y uno emitido para otro nombre
// devolvían los tres `200 OK`. O sea que `https_get` daba CIFRADO pero no
// AUTENTICACIÓN — cualquiera en el camino podía responder por el servidor y el
// programa no se enteraba. Lo reportó nyxerp midiéndolo contra badssl.com.
//
// Ahora se verifica por defecto. El opt-out existe porque un entorno de
// desarrollo con certificado autofirmado es un caso legítimo, pero se pide
// EXPLÍCITO y con un nombre que no se pueda confundir con otra cosa: nadie
// escribe `http_tls_inseguro(true)` sin saber lo que hace.
var g_http_tls_verificar: bool = true

// Desactiva la verificación del certificado para TODAS las llamadas HTTPS de
// este proceso. Solo para desarrollo contra un servidor con certificado
// autofirmado: con esto puesto, HTTPS deja de autenticar al servidor.
pub fn http_tls_inseguro(si: bool) {
    g_http_tls_verificar = !si
}

// Abre una conexión TLS, envía el request y lee la respuesta completa (hasta
// EOF — los requests usan Connection: close), luego la parsea. Es el camino
// HTTPS de http_get/http_post/http_request.
pub fn http_tls_request(host: String, port: int, req: String) -> Array {
    var h: int = 0
    if g_http_tls_verificar {
        // Contra el almacén de CAs del SISTEMA, sin tocar el de tls_set_ca_file.
        // SEGURIDAD (2026-09-14): hasta acá esto era tls_set_ca_file("") +
        // tls_connect_verified. Ese almacén es del proceso entero y ACUMULA, así
        // que el primer https le sumaba las CAs públicas a la confianza que el
        // usuario había acotado a su CA privada —la del sslmode=verify-ca de
        // std/postgres—, y a la vez este cliente confiaba en esa CA privada.
        // Regresión: tests/compiler/stdlib-suite/test-424-http-no-contamina-cas.nx.
        h = tls_connect_verified_system(host, port)
    } else {
        h = tls_connect(host, port)
    }
    // `<= 0` y no `< 0`: LAS DOS devuelven 0 al fallar (runtime/tls.c), así que
    // el `h < 0` que había acá NUNCA era cierto y una conexión TLS caída seguía
    // de largo con el handle 0. Bug aparte del de la verificación, encontrado
    // arreglando aquel.
    if h <= 0 {
        var porque: String = "TLS connection failed"
        if g_http_tls_verificar {
            porque = "TLS: no se pudo verificar el certificado de " + host +
                     " (vencido, autofirmado, o emitido para otro nombre), o la conexion fallo" +
                     " — si es un servidor de desarrollo, http_tls_inseguro(true) lo desactiva"
        }
        let err: Array = ["response", -1, [], porque]
        return err
    }
    tls_write(h, req)
    var raw: String = ""
    var reading: bool = true
    while reading {
        let chunk: String = tls_read(h, 65536)
        if chunk.length() == 0 { reading = false } else { raw = raw + chunk }
    }
    tls_close(h)
    return http_parse_raw_response(raw)
}

// GET simple. Respuesta: ["response", status:int, headers:Array, body:String].
// ⚠️ NO sigue redirects: un 3xx se devuelve tal cual (status 301/302/... +
// header Location) — seguirlo es decisión del caller (leer Location con
// http_find_header y re-pedir; cuidar loops). Vale para http_request también.
pub fn http_get(url: String) -> Array {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    let port: int = parsed[2]
    let path: String = parsed[3]
    let secure: int = parsed[4]
    if secure == 1 {
        let host_hdr_s: String = http_host_header(host, port, 443)
        let empty_h: Array = []
        let sreq: String = http_build_request("GET", host_hdr_s, path, empty_h, "")
        return http_tls_request(host, port, sreq)
    }
    let fd: int = tcp_connect(host, port)
    if fd < 0 {
        let err: Array = ["response", -1, [], "Connection failed"]
        return err
    }
    // Timeout de 30s en las lecturas/escrituras del socket cliente: un host lento
    // que acepta la conexión pero no responde ya no cuelga el hilo indefinidamente.
    // (El camino TLS/HTTPS trae su propio timeout de 10s en el runtime.)
    let _to: int = tcp_set_timeout(fd, 30)
    let host_hdr: String = http_host_header(host, port, 80)
    let empty_headers: Array = []
    let req: String = http_build_request("GET", host_hdr, path, empty_headers, "")
    tcp_write(fd, req)
    let resp: Array = http_read_response(fd)
    tcp_close(fd)
    return resp
}

pub fn http_post(url: String, body: String) -> Array {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    let port: int = parsed[2]
    let path: String = parsed[3]
    let secure: int = parsed[4]
    let headers: Array = ["Content-Type", "text/plain"]
    if secure == 1 {
        let host_hdr_s: String = http_host_header(host, port, 443)
        let sreq: String = http_build_request("POST", host_hdr_s, path, headers, body)
        return http_tls_request(host, port, sreq)
    }
    let fd: int = tcp_connect(host, port)
    if fd < 0 {
        let err: Array = ["response", -1, [], "Connection failed"]
        return err
    }
    // Timeout de 30s en las lecturas/escrituras del socket cliente: un host lento
    // que acepta la conexión pero no responde ya no cuelga el hilo indefinidamente.
    // (El camino TLS/HTTPS trae su propio timeout de 10s en el runtime.)
    let _to: int = tcp_set_timeout(fd, 30)
    let host_hdr: String = http_host_header(host, port, 80)
    let req: String = http_build_request("POST", host_hdr, path, headers, body)
    tcp_write(fd, req)
    let resp: Array = http_read_response(fd)
    tcp_close(fd)
    return resp
}

pub fn http_request(method: String, url: String, headers: Array, body: String) -> Array {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    let port: int = parsed[2]
    let path: String = parsed[3]
    let secure: int = parsed[4]
    if secure == 1 {
        let host_hdr_s: String = http_host_header(host, port, 443)
        let sreq: String = http_build_request(method, host_hdr_s, path, headers, body)
        return http_tls_request(host, port, sreq)
    }
    let fd: int = tcp_connect(host, port)
    if fd < 0 {
        let err: Array = ["response", -1, [], "Connection failed"]
        return err
    }
    // Timeout de 30s en las lecturas/escrituras del socket cliente: un host lento
    // que acepta la conexión pero no responde ya no cuelga el hilo indefinidamente.
    // (El camino TLS/HTTPS trae su propio timeout de 10s en el runtime.)
    let _to: int = tcp_set_timeout(fd, 30)
    let host_hdr: String = http_host_header(host, port, 80)
    let req: String = http_build_request(method, host_hdr, path, headers, body)
    tcp_write(fd, req)
    let resp: Array = http_read_response(fd)
    tcp_close(fd)
    return resp
}

// === Client functions tipadas (E5.3) — try_http_get/post/request ===
//
// Contrato de DOS NIVELES (spec 2026-08-11-errores-tipados §4.2.3): estas
// tres NO son "http_get pero con Result" a secas — el nivel de transporte
// (¿llegó una respuesta?) y el nivel de aplicación (¿qué status trae esa
// respuesta?) son cosas DISTINTAS. Cualquier respuesta HTTP bien formada,
// SEA CUAL SEA su status — 200, 404, 500 — es `Ok(response)`: el servidor
// respondió, eso es éxito de transporte. Un 404 no es un error de RED, es
// información de aplicación que el caller decide cómo tratar (igual que
// `http_get` centinela siempre devolvió cualquier status sin distinguir).
// `Err` es EXCLUSIVO de fallos de transporte reales: URL sin host parseable,
// connect rechazado/timeout/DNS, write/read que fallan a nivel de socket, o
// una "respuesta" que no es HTTP válido (status 0 sin parsear). Quien
// necesite tratar 4xx/5xx como fallo debe chequear `http_status(r) >= 400`
// explícitamente después del `Ok` — la función no decide eso por el caller.
//
// Plazos y causa (arco http-tls-cliente, 2026-09-14). Hasta esa fecha:
// - `https://` iba por http_tls_request (tls_connect + tls_read), cuyo 0 no
//   distinguía DNS, puerto cerrado, plazo vencido, certificado ni protocolo:
//   todo llegaba como `Err{5, "connection"}` con cuatro causas en el texto.
// - los plazos eran fijos y POR operación (10 s en TLS, 3 s de connect y 30 s
//   por lectura en claro): un servidor que gotea un byte cada pocos segundos
//   no se cortaba nunca.
// - la lectura no verificaba `Content-Length`: un cuerpo cortado a mitad de
//   recepción volvía como `Ok` con el cuerpo truncado, indistinguible de uno
//   completo.
// Ahora los dos esquemas pasan por try_http_request_opts: plazo de conexión y
// plazo TOTAL de respuesta configurables (HttpOpts), el `kind`/`code` real de
// cada falla (std/tls: try_tls_connect/try_tls_read) y la respuesta verificada
// contra su `Content-Length` o su terminador chunked antes de devolver `Ok`.

extern "C" fn nyx_tcp_connect_ms_result(host: String, port: int, timeout_ms: int) -> int
// nyx_tcp_read_timed_result se declara en std/net (importado arriba): declararla
// también acá choca con «invalid redefinition» si el programa importa std/postgres.

// Opciones de una petición tipada. Se arman con http_opts() y se ajusta lo que
// haga falta: `var o: HttpOpts = http_opts()` + `o.respuesta_ms = 1500`.
pub struct HttpOpts {
    // Plazo para connect + handshake TLS, en milisegundos. <= 0 = sin plazo
    // propio. La resolución DNS NO entra: es bloqueante y nada la corta.
    connect_ms: int,
    // Plazo TOTAL para recibir la respuesta completa, en milisegundos, desde
    // que se envió el request. No se reinicia con cada byte que llega.
    // <= 0 = sin plazo propio.
    respuesta_ms: int,
    // true = verificar el certificado (cadena + nombre, CAs del sistema).
    // false = cifrar sin autenticar, SOLO para desarrollo.
    verificar_tls: bool,
}

// Opciones por defecto: 10 s para conectar, 30 s para la respuesta completa, y
// verificación según http_tls_inseguro (activada salvo que se la haya apagado).
pub fn http_opts() -> HttpOpts {
    return HttpOpts { connect_ms: 10000, respuesta_ms: 30000, verificar_tls: g_http_tls_verificar }
}

// Primer valor de un header, sin distinguir mayúsculas (RFC 9110). "" si falta.
fn http_header_ci(headers: Array, name: String) -> String {
    let vals: Array = http_find_headers(headers, name)
    if vals.length() == 0 { return "" }
    let v: String = vals[0]
    return v.trim()
}

// ¿Está completo un cuerpo chunked? Recorre los chunks como http_dechunk_str y
// solo da true al llegar al chunk de tamaño 0 seguido de su CRLF final.
fn http_chunked_completo(body: String) -> bool {
    var pos: int = 0
    let n: int = body.length()
    while pos < n {
        let rest: String = body.substring(pos, n)
        let crlf: int = rest.indexOf("\r\n")
        if crlf < 0 { return false }
        let size: int = http_parse_hex(rest.substring(0, crlf))
        let data_start: int = pos + crlf + 2
        if size <= 0 {
            // Trailers opcionales y la línea vacía que cierra.
            let tail: String = body.substring(data_start, n)
            return tail.indexOf("\r\n") >= 0
        }
        if data_start + size + 2 > n { return false }
        pos = data_start + size + 2
    }
    return false
}

// Estado de una respuesta cruda: 1 = completa, 0 = faltan bytes, y en `falta`
// (slot 0) el motivo legible para cuando la conexión se corta antes.
// Sin Content-Length ni chunked, el cuerpo termina con el cierre de la
// conexión (los requests mandan `Connection: close`): no se puede decidir antes.
fn http_respuesta_completa(method: String, raw: String, falta: Array) -> int {
    let sep: int = raw.indexOf("\r\n\r\n")
    if sep < 0 {
        falta[0] = "la conexión se cerró antes de terminar los headers"
        return 0
    }
    let resp: Array = http_parse_raw_response(raw.substring(0, sep + 4))
    let status: int = resp[1]
    let headers: Array = resp[2]
    // Sin cuerpo por definición (RFC 9110 §6.4.1).
    if method == "HEAD" or status == 204 or status == 304 or (status >= 100 and status < 200) {
        return 1
    }
    let body: String = raw.substring(sep + 4, raw.length())
    if http_header_ci(headers, "Transfer-Encoding").indexOf("chunked") >= 0 {
        if http_chunked_completo(body) { return 1 }
        falta[0] = "el cuerpo chunked se cortó antes del chunk final"
        return 0
    }
    let cl_str: String = http_header_ci(headers, "Content-Length")
    if cl_str.length() > 0 {
        let cl: int = http_parse_int(cl_str)
        if body.length() >= cl { return 1 }
        falta[0] = "el cuerpo se cortó: llegaron " + int_to_string(body.length()) + " de " + int_to_string(cl) + " bytes"
        return 0
    }
    falta[0] = ""
    return 0
}

// Estado de fin de flujo de nyx_tcp_read_timed_result (NYX_NET_EOF, runtime/net.h).
const NYX_HTTP_EOF: int = 1000

// La conexión terminó: la respuesta vale solo si ya estaba entera, o si su
// cuerpo se delimita por el cierre (sin Content-Length ni chunked). Si faltaban
// bytes es un corte, no una respuesta: `Err{5, "io"}` en vez del `Ok` truncado
// que devolvía antes.
fn http_fin_de_conexion(esquema: String, method: String, host: String, port: int, raw: String, falta: Array) -> Result<Array, Error> {
    let estado: int = http_respuesta_completa(method, raw, falta)
    let motivo: String = falta[0]
    if estado == 0 and motivo.length() > 0 {
        return Result.Err(err_new(5, "io", esquema + " " + host + ":" + int_to_string(port) + ": " + motivo))
    }
    return http_cerrar_respuesta(esquema, host, port, raw)
}

// Arma el Ok/Err final a partir de la respuesta cruda completa.
fn http_cerrar_respuesta(esquema: String, host: String, port: int, raw: String) -> Result<Array, Error> {
    let resp: Array = http_parse_raw_response(raw)
    let status: int = resp[1]
    // Rango 100-599 (RFC 9110 §15): una status-line basura tipo "FOO 12 X"
    // parsea "12" sin error y no es un status HTTP real.
    if status < 100 or status > 599 {
        return Result.Err(err_new(5, "parse", esquema + " " + host + ":" + int_to_string(port) + ": respuesta HTTP invalida o vacia"))
    }
    return Result.Ok(resp)
}

// Milisegundos que quedan hasta `limite` (monotonic_ms). -1 = sin plazo.
fn http_resto_ms(limite: int) -> int {
    if limite <= 0 { return -1 }
    let r: int = limite - monotonic_ms()
    if r < 0 { return 0 }
    return r
}

fn http_err_plazo(esquema: String, host: String, port: int, ms: int) -> Error {
    return err_new(110, "timeout", esquema + " " + host + ":" + int_to_string(port) +
                   ": la respuesta no llegó completa en " + int_to_string(ms) + " ms")
}

fn http_https_opts(method: String, host: String, port: int, req: String, opts: HttpOpts) -> Result<Array, Error> {
    var modo: int = 0
    if opts.verificar_tls { modo = 4 }
    let con_r: Result<int, Error> = try_tls_connect(host, port, modo, opts.connect_ms)
    if con_r.is_err() {
        let e: Error = con_r.unwrap_err()
        return Result.Err(err_new(e.code, e.kind, "https " + host + ":" + int_to_string(port) + ": " + e.msg))
    }
    let h: int = con_r.unwrap()
    if tls_write(h, req) < str_byte_length(req) {
        tls_close(h)
        return Result.Err(err_new(5, "io", "https " + host + ":" + int_to_string(port) + ": no se pudo enviar el request completo"))
    }
    var limite: int = 0
    if opts.respuesta_ms > 0 { limite = monotonic_ms() + opts.respuesta_ms }
    var raw: String = ""
    var falta: Array = [""]
    var leyendo: bool = true
    while leyendo {
        if http_respuesta_completa(method, raw, falta) == 1 {
            leyendo = false
        } else {
            let resto: int = http_resto_ms(limite)
            if resto == 0 {
                tls_close(h)
                return Result.Err(http_err_plazo("https", host, port, opts.respuesta_ms))
            }
            let rd: Result<String, Error> = try_tls_read(h, 65536, resto)
            if rd.is_ok() {
                let chunk: String = rd.unwrap()
                raw = raw + chunk
            } else {
                let e: Error = rd.unwrap_err()
                tls_close(h)
                if e.kind == "timeout" {
                    return Result.Err(http_err_plazo("https", host, port, opts.respuesta_ms))
                }
                if e.kind != "eof" {
                    return Result.Err(err_new(e.code, e.kind, "https " + host + ":" + int_to_string(port) + ": " + e.msg))
                }
                return http_fin_de_conexion("https", method, host, port, raw, falta)
            }
        }
    }
    tls_close(h)
    return http_cerrar_respuesta("https", host, port, raw)
}

fn http_plano_opts(method: String, host: String, port: int, req: String, opts: HttpOpts) -> Result<Array, Error> {
    let fd: int = nyx_tcp_connect_ms_result(host, port, opts.connect_ms)
    if fd < 0 {
        let code: int = 0 - fd
        return Result.Err(err_new(code, errno_to_kind(code), "http " + host + ":" + int_to_string(port) + ": connect"))
    }
    let write_r: Result<int, Error> = try_tcp_write(fd, req)
    if write_r.is_err() {
        tcp_close(fd)
        return Result.Err(write_r.unwrap_err())
    }
    // try_tcp_write puede devolver Ok(n) con n < lo pedido (short write): el
    // servidor recibiría un request truncado y su respuesta sería indistinguible
    // de una legítima. Se trata como fallo de transporte explícito.
    if write_r.unwrap() < str_byte_length(req) {
        tcp_close(fd)
        return Result.Err(err_new(5, "io", "short write: " + int_to_string(write_r.unwrap()) + " de " + int_to_string(str_byte_length(req)) + " bytes"))
    }
    var limite: int = 0
    if opts.respuesta_ms > 0 { limite = monotonic_ms() + opts.respuesta_ms }
    var raw: String = ""
    var falta: Array = [""]
    var leyendo: bool = true
    while leyendo {
        if http_respuesta_completa(method, raw, falta) == 1 {
            leyendo = false
        } else {
            let resto: int = http_resto_ms(limite)
            if resto == 0 {
                tcp_close(fd)
                return Result.Err(http_err_plazo("http", host, port, opts.respuesta_ms))
            }
            let rd: Array = nyx_tcp_read_timed_result(fd, 65536, resto)
            let st: int = rd[0]
            let datos: String = rd[1]
            if st == 0 {
                raw = raw + datos
            } else {
                tcp_close(fd)
                if st == -110 {
                    return Result.Err(http_err_plazo("http", host, port, opts.respuesta_ms))
                }
                if st != NYX_HTTP_EOF {
                    let code: int = 0 - st
                    return Result.Err(err_new(code, errno_to_kind(code), "http " + host + ":" + int_to_string(port) + ": leyendo la respuesta"))
                }
                return http_fin_de_conexion("http", method, host, port, raw, falta)
            }
        }
    }
    tcp_close(fd)
    return http_cerrar_respuesta("http", host, port, raw)
}

// Request tipado con plazos y verificación explícitos. Mismo contrato de DOS
// NIVELES que try_http_get: `Ok(response)` para CUALQUIER status HTTP; `Err`
// solo ante fallo de transporte, con el kind/code de lo que pasó:
//   invalid/22    URL sin host
//   connection/111  puerto cerrado          timeout/110  connect, handshake o
//   tls/X509_V_ERR_* certificado no verifica                respuesta vencidos
//   tls/71        handshake roto (¿habla TLS?)
//   io/5          la conexión se cortó antes de completar la respuesta
//                 (Content-Length o chunked sin terminar)
//   parse/5       lo recibido no es una respuesta HTTP
pub fn try_http_request_opts(method: String, url: String, headers: Array, body: String, opts: HttpOpts) -> Result<Array, Error> {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    let port: int = parsed[2]
    let path: String = parsed[3]
    let secure: int = parsed[4]
    // http_parse_url nunca "falla" con un flag: el detector de URL inválida es
    // host == "" (MEDIDO 2026-08-19: "", "http://", "http:///path").
    if host.length() == 0 {
        return Result.Err(err_new(22, "invalid", "http_parse_url: sin host valido en '" + url + "'"))
    }
    if secure == 1 {
        let host_hdr_s: String = http_host_header(host, port, 443)
        let sreq: String = http_build_request(method, host_hdr_s, path, headers, body)
        return http_https_opts(method, host, port, sreq, opts)
    }
    let host_hdr: String = http_host_header(host, port, 80)
    let req: String = http_build_request(method, host_hdr, path, headers, body)
    return http_plano_opts(method, host, port, req, opts)
}

// GET tipado. `Ok(response)` para CUALQUIER status (404/500 incluidos —
// ver el header de esta sección, regla de dos niveles). `Err` solo ante
// fallo real de transporte: URL sin host, connect/write/read fallidos, o
// respuesta no-HTTP con conexión OK. Plazos de http_opts().
pub fn try_http_get(url: String) -> Result<Array, Error> {
    let empty_headers: Array = []
    return try_http_request_opts("GET", url, empty_headers, "", http_opts())
}

// POST tipado — mismo contrato que try_http_get. Content-Type fijo
// text/plain, igual que la centinela http_post.
pub fn try_http_post(url: String, body: String) -> Result<Array, Error> {
    let headers: Array = ["Content-Type", "text/plain"]
    return try_http_request_opts("POST", url, headers, body, http_opts())
}

// Request tipado genérico (método/headers/body a elección) — mismo
// contrato que try_http_get.
pub fn try_http_request(method: String, url: String, headers: Array, body: String) -> Result<Array, Error> {
    return try_http_request_opts(method, url, headers, body, http_opts())
}

pub fn http_status(resp: Array) -> int {
    let s: int = resp[1]
    return s
}

pub fn http_body(resp: Array) -> String {
    let b: String = resp[3]
    return b
}

pub fn http_headers(resp: Array) -> Array {
    let h: Array = resp[2]
    return h
}

// === Request parsing ===

fn parse_request_line(line: String) -> Array {
    let parts: Array = line.split(" ")
    if parts.length() >= 3 {
        let method: String = parts[0]
        let path: String = parts[1]
        let version: String = parts[2]
        let result: Array = [method, path, version]
        return result
    }
    let empty: Array = ["GET", "/", "HTTP/1.1"]
    return empty
}

fn parse_headers(client_fd: int) -> Array {
    // Returns flat array [key1, val1, key2, val2, ...]
    let headers: Array = []
    while 1 > 0 {
        let line: String = tcp_read_line(client_fd)
        if line.length() == 0 {
            return headers
        }
        let colon_idx: int = line.indexOf(": ")
        if colon_idx >= 0 {
            let key: String = line.substring(0, colon_idx)
            let val: String = line.substring(colon_idx + 2, line.length())
            headers.push(key)
            headers.push(val)
        }
    }
    return headers
}

// Find a header value by name in headers array, returns "" if not found
// First value of a header, EXACT name match, "" if absent. Legacy contract —
// kept as-is because existing consumers depend on it. For repeated headers
// (Set-Cookie!) or case-insensitive lookup use http_find_headers below.
pub fn http_find_header(headers: Array, name: String) -> String {
    var i: int = 0
    let len: int = headers.length()
    while i + 1 < len {
        let k: String = headers[i]
        if k == name {
            let v: String = headers[i + 1]
            return v
        }
        i = i + 2
    }
    return ""
}

// ALL values of a header, in order of appearance, case-insensitive name match
// (RFC 9110: header names are case-insensitive; HTTP/2 servers send them
// lowercase). The reason this exists: Set-Cookie legally repeats — the
// singular http_find_header only ever returned the first cookie. A trailing
// key with no value (malformed flat array) is ignored, never a crash.
pub fn http_find_headers(headers: Array, name: String) -> Array {
    let target: String = name.to_lower()
    let result: Array = []
    var i: int = 0
    let len: int = headers.length()
    while i + 1 < len {
        let k: String = headers[i]
        if k.to_lower() == target {
            let v: String = headers[i + 1]
            result.push(v)
        }
        i = i + 2
    }
    return result
}

// Forma del request: ["request", method, path, headers, body, err] — el slot
// 6 (aditivo, 2026-07-21) señala 0 = ok, 413 = body sobre el cap (en ese caso
// body queda "" y el socket queda con el body SIN drenar → responder 413 y
// cerrar; http_serve/http_serve_mt lo hacen solos).
pub fn http_parse_request(client_fd: int) -> Array {
    let request_line: String = tcp_read_line(client_fd)
    // Empty request line means client disconnected
    if request_line.length() == 0 {
        let empty_req: Array = ["request", "", "", [], "", 0]
        return empty_req
    }
    let rl: Array = parse_request_line(request_line)
    let method: String = rl[0]
    let path: String = rl[1]
    let headers: Array = parse_headers(client_fd)

    // Read body if Content-Length present (cap NYX_HTTP_MAX_BODY, default
    // 1MiB — sin el cap, un Content-Length remoto arbitrario dictaba la
    // allocación: misma clase que el RESP_MAX_BULK del daemon kv)
    var body: String = ""
    var req_err: int = 0
    let cl_str: String = http_find_header(headers, "Content-Length")
    if cl_str.length() > 0 {
        let cl: int = http_parse_int(cl_str)
        if cl > nyx_http_max_body() {
            req_err = 413
        } else {
            if cl > 0 {
                body = tcp_read(client_fd, cl)
            }
        }
    }

    let request: Array = ["request", method, path, headers, body, req_err]
    return request
}

// === CORS ===

pub fn http_cors_headers(origin: String) -> Array {
    let headers: Array = [
        "Access-Control-Allow-Origin", origin,
        "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers", "Content-Type, Authorization",
        "Access-Control-Max-Age", "86400"
    ]
    return headers
}

pub fn http_cors_response(origin: String) -> String {
    let headers: Array = http_cors_headers(origin)
    return http_response_with_headers(204, headers, "")
}

// === Server ===

// Sirve HTTP en 0.0.0.0:port, un request por vez. NO retorna en éxito
// (loop infinito); retorna -1 si el bind falla (puerto ocupado/permiso —
// el runtime además lo grita por stderr desde v0.24.4). CHEQUEA el
// retorno: descartarlo deja el programa "corriendo" sin servidor.
//   if http_serve(8080, handler) < 0 { return 1 }
pub fn http_serve(port: int, handler: Fn(Array) -> String) -> int {
    let server: int = tcp_listen("0.0.0.0", port)
    if server < 0 {
        return -1
    }
    while 1 > 0 {
        let client: int = tcp_accept(server)
        if client >= 0 {
            let request: Array = http_parse_request(client)
            let method: String = request[1]
            if method.length() > 0 {
                let req_err: int = request[5]
                if req_err == 413 {
                    // Body sobre el cap: 413 sin invocar el handler (el
                    // socket queda con el body sin drenar — se cierra abajo)
                    tcp_write(client, http_response(413, ""))
                } else {
                    let response: String = handler(request)
                    tcp_write(client, response)
                }
            }
            tcp_close(client)
        }
    }
    return 0
}

// === Multi-threaded Server ===

fn __http_mt_worker() -> int {
    while 1 > 0 {
        let client: int = channel_recv(__http_mt_ch)
        if client < 0 { return 0 }
        let request: Array = http_parse_request(client)
        let method: String = request[1]
        if method.length() > 0 {
            let req_err: int = request[5]
            if req_err == 413 {
                // Ver http_serve: body sobre el cap → 413 sin handler
                tcp_write(client, http_response(413, ""))
            } else {
                let response: String = __http_mt_handler(request)
                tcp_write(client, response)
            }
        }
        tcp_close(client)
    }
    return 0
}

// Variante multi-thread de http_serve. Mismo contrato de retorno: NO
// retorna en éxito; -1 si el bind falla (ruidoso por stderr desde v0.24.4).
pub fn http_serve_mt(port: int, num_workers: int, handler: Fn) -> int {
    __http_mt_ch = channel_new(512)
    __http_mt_handler = handler
    let server: int = tcp_listen("0.0.0.0", port)
    if server < 0 { return -1 }
    var i: int = 0
    while i < num_workers {
        thread_spawn(__http_mt_worker)
        i = i + 1
    }
    while 1 > 0 {
        let client: int = tcp_accept(server)
        if client >= 0 {
            channel_send(__http_mt_ch, client)
        }
    }
    return 0
}
