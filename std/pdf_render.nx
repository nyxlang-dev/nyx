fn __pr_face_b64(i: int) -> String {
    // Sans Regular: 18316 bytes
    if i == 0 { return "" }
    // Sans Bold: 18380 bytes
    if i == 1 { return "" }
    // Sans Italic: 18924 bytes
    if i == 2 { return "" }
    // Sans BoldItalic: 19020 bytes
    if i == 3 { return "" }
    // Serif Regular: 19588 bytes
    if i == 4 { return "" }
    // Serif Bold: 19524 bytes
    if i == 5 { return "" }
    // Serif Italic: 20304 bytes
    if i == 6 { return "" }
    // Serif BoldItalic: 20124 bytes
    if i == 7 { return "" }
    // Mono Regular: 17684 bytes
    if i == 8 { return "" }
    // Mono Bold: 17804 bytes
    if i == 9 { return "" }
    // Mono Italic: 18856 bytes
    if i == 10 { return "" }
    // Mono BoldItalic: 18820 bytes
    if i == 11 { return "" }
    return ""
}

