// std/web.nx — Framework web tipo Flask para Nyx v1.7.1
// Map API: parse functions return Map<String> for real key-value access

import "std/json"

// Decoder de percent-encoding del runtime (runtime/url.c), byte-safe: maneja
// `%XX` Y `+`→espacio. Se declara como extern (en vez de `import "std/url"`)
// para evitar el choque de nombres: std/url también exporta url_decode/html_escape.
extern "C" fn nyx_url_decode(s: String) -> String

struct Request {
    method: String,
    path: String,
    query: Map,
    headers_flat: Array,
    body: String,
    form: Map,
    cookies: Map,
    params: Map,
    ctx: Map,
}

struct Response {
    status: int,
    headers_flat: Array,
    body: String,
}

struct Route {
    method: String,
    pattern: String,
    handler: Fn,
}

struct App {
    routes: Array,
    before_hooks: Array,
    after_hooks: Array,
    middlewares: Array,
    static_dir: String,
    not_found_handler: Fn,
    error_handler: Fn,
    wraps: Array,
    mounts: Array,
    access_log: bool,
}

// Construye un Request con todos los campos vacíos (Maps frescos por
// llamada). Preferilo sobre el literal Request{...}: cuando el struct gane
// campos, el literal rompe en cada call site y esto no. `ctx` es el estado
// por-request compartido entre capas: Map es referencia, así que TODAS las
// copias del struct (paso por valor incluido) comparten el MISMO ctx — lo
// que un middleware inserta, el handler y los after-hooks lo ven.
pub fn request_new() -> Request {
    var q: Map = map_new()
    var f: Map = map_new()
    var c: Map = map_new()
    var p: Map = map_new()
    var cx: Map = map_new()
    var h: Array = []
    return Request { method: "", path: "", query: q, headers_flat: h, body: "", form: f, cookies: c, params: p, ctx: cx }
}

// S1 2026-08-11 (fricción ERP "testabilidad de handlers"): request_new() era
// 0-args y armar un request de prueba exigía tocar campos a mano. Nombre
// propio porque no hay dispatch por aridad en Nyx.
/// Request sintético con method y path — para tests de handlers y helpers.
/// Los demás campos vienen frescos y utilizables (mismo contrato que
/// request_new).
pub fn request_with(method: String, path: String) -> Request {
    var r: Request = request_new()
    r.method = method
    r.path = path
    return r
}

// Decodifica percent-encoding de forms/query. Delega en el runtime C
// (nyx_url_decode): `%XX` (espacios %20, acentos UTF-8, %26, %3D...) Y `+`→espacio.
// Antes solo hacía `+`→espacio → corrompía silenciosamente toda la ingesta de forms.
pub fn url_decode(s: String) -> String {
    return nyx_url_decode(s)
}

// Returns Map<String> with extracted query params.
// Keys are the param names, values are the param values.
pub fn parse_query_string(path: String) -> Map {
    var result: Map = map_new()
    let qpos: int = path.indexOf("?")
    if qpos < 0 { return result }
    let qs: String = path.substring(qpos + 1, path.length())
    let pairs: Array = qs.split("&")
    var i: int = 0
    while i < pairs.length() {
        let pair: String = pairs[i]
        let eq: int = pair.indexOf("=")
        if eq > 0 {
            let key: String = url_decode(pair.substring(0, eq))
            let val: String = url_decode(pair.substring(eq + 1, pair.length()))
            result.insert(key, val)
        }
        i = i + 1
    }
    return result
}

// Returns Map<String> with form field key-value pairs.
// Supports application/x-www-form-urlencoded content type.
pub fn parse_form_data(body: String, content_type: String) -> Map {
    var result: Map = map_new()
    if content_type.indexOf("application/x-www-form-urlencoded") < 0 { return result }
    let pairs: Array = body.split("&")
    var i: int = 0
    while i < pairs.length() {
        let pair: String = pairs[i]
        let eq: int = pair.indexOf("=")
        if eq > 0 {
            let key: String = url_decode(pair.substring(0, eq))
            let val: String = url_decode(pair.substring(eq + 1, pair.length()))
            result.insert(key, val)
        }
        i = i + 1
    }
    return result
}

// Returns Map<String> with cookie name-value pairs.
// headers_flat is an interleaved [header_name, header_value, ...] array.
pub fn parse_cookies(headers_flat: Array) -> Map {
    var result: Map = map_new()
    var i: int = 0
    while i < headers_flat.length() - 1 {
        let hkey: String = headers_flat[i]
        let hval: String = headers_flat[i + 1]
        if hkey == "Cookie" {
            let parts: Array = hval.split("; ")
            var j: int = 0
            while j < parts.length() {
                let part: String = parts[j]
                let eq: int = part.indexOf("=")
                if eq > 0 {
                    let cname: String = part.substring(0, eq)
                    let cval: String = part.substring(eq + 1, part.length())
                    result.insert(cname, cval)
                }
                j = j + 1
            }
        }
        i = i + 2
    }
    return result
}

// Returns Map<String> with route params extracted from path segments.
// If the route matches, the map contains "_matched" = "true" plus any
// captured params (e.g. "{id}" → key "id").
// If no match, returns an empty map (no "_matched" key).
pub fn route_match(pattern: String, path: String) -> Map {
    var params: Map = map_new()
    var clean_path: String = path
    let qp: int = path.indexOf("?")
    if qp >= 0 { clean_path = path.substring(0, qp) }
    let pseg: Array = pattern.split("/")
    let rseg: Array = clean_path.split("/")
    // Wildcard: pattern ending in * matches any suffix
    let last_pseg: String = pseg[pseg.length() - 1]
    if last_pseg == "*" {
        // Path must have at least as many segments as pattern (minus the *)
        let prefix_len: int = pseg.length() - 1
        if rseg.length() < prefix_len { return params }
        var wi: int = 0
        var wmatch: bool = true
        while wi < prefix_len {
            let wps: String = pseg[wi]
            let wrs: String = rseg[wi]
            if wps != wrs { wmatch = false }
            wi = wi + 1
        }
        if wmatch {
            params.insert("_matched", "true")
        }
        return params
    }

    if pseg.length() != rseg.length() { return params }
    var i: int = 0
    var matched: bool = true
    while i < pseg.length() {
        let ps: String = pseg[i]
        let rs: String = rseg[i]
        if ps.startsWith("{") and ps.endsWith("}") {
            let pname: String = ps.substring(1, ps.length() - 1)
            params.insert(pname, rs)
        } else {
            if ps != rs { matched = false }
        }
        i = i + 1
    }
    if matched {
        params.insert("_matched", "true")
    }
    return params
}

pub fn response_new(status: int, body: String) -> Response {
    var hdrs: Array = []
    return Response { status: status, headers_flat: hdrs, body: body }
}

pub fn response_html(status: int, html: String) -> Response {
    var hdrs: Array = []
    return Response { status: status, headers_flat: hdrs, body: html }
}

pub fn response_json(status: int, json: String) -> Response {
    let hdrs: Array = ["Content-Type", "application/json; charset=utf-8"]
    return Response { status: status, headers_flat: hdrs, body: json }
}

// Build a JSON response from a Map of string key-value pairs.
// Serializes Map keys/values as a JSON object with string values.
pub fn response_json_map(status: int, data: Map) -> Response {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("{")
    let keys: Array = data.keys()
    var i: int = 0
    while i < keys.length() {
        if i > 0 { sb.append(",") }
        let k: String = keys[i]
        let v: String = data.get(k)
        sb.append("\"")
        sb.append(json_escape(k))
        sb.append("\":\"")
        sb.append(json_escape(v))
        sb.append("\"")
        i = i + 1
    }
    sb.append("}")
    let hdrs: Array = ["Content-Type", "application/json; charset=utf-8"]
    return Response { status: status, headers_flat: hdrs, body: sb.to_string() }
}

// Parse request body as JSON string key-value pairs into a Map.
// Returns empty Map if body is not valid JSON or not an object.
pub fn req_json(req: Request) -> Map {
    let result: Map = map_new()
    let body: String = req.body
    if body.length() == 0 { return result }
    let parsed: Array = json_parse(body)
    if parsed.length() == 0 { return result }
    let tag: String = parsed[0]
    if tag != "object" { return result }
    let keys: Array = parsed[1]
    let vals: Array = parsed[2]
    var i: int = 0
    while i < keys.length() {
        let key: String = keys[i]
        let val_node: Array = vals[i]
        let val_tag: String = val_node[0]
        if val_tag == "string" {
            let val: String = val_node[1]
            result.insert(key, val)
        } else if val_tag == "number" {
            let num: String = int_to_string(val_node[1])
            result.insert(key, num)
        } else if val_tag == "bool" {
            if val_node[1] == 1 {
                result.insert(key, "true")
            } else {
                result.insert(key, "false")
            }
        } else if val_tag == "null" {
            result.insert(key, "null")
        }
        i = i + 1
    }
    return result
}

// json_escape ahora viene de std/json (import de arriba) -- la copia
// privada que vivía acá escapaba `"` `\` `\n` `\r` `\t` pero le faltaba
// la rama `\u00XX` para controles < 0x20, así que un valor con un byte
// de control crudo (ej. chr(3)) producía JSON inválido en
// response_json_map. La de std/json es la completa (RFC 8259 §7) y ya
// se usaba en response_json_map antes de este fix -- se borra el
// duplicado, no queda ambigüedad de nombres porque solo sobrevive uno.

pub fn response_redirect(url: String) -> Response {
    var hdrs: Array = []
    return Response { status: 302, headers_flat: hdrs, body: url }
}

pub fn response_text(status: int, text: String) -> Response {
    var hdrs: Array = []
    return Response { status: status, headers_flat: hdrs, body: text }
}

pub fn app_new() -> App {
    var routes: Array = []
    var before_hooks: Array = []
    var after_hooks: Array = []
    var middlewares: Array = []
    var wraps: Array = []
    var mounts: Array = []
    // Bindear las fns a `let` antes del literal (no asumir que el codegen
    // toma una fn nombrada directo en el literal — spec de serve 2026-08-05).
    let nf: Fn = default_not_found
    let eh: Fn = default_error
    return App { routes: routes, before_hooks: before_hooks, after_hooks: after_hooks, middlewares: middlewares, static_dir: "", not_found_handler: nf, error_handler: eh, wraps: wraps, mounts: mounts, access_log: false }
}

pub fn app_route(app: App, method: String, pattern: String, handler: Fn) {
    let r: Route = Route { method: method, pattern: pattern, handler: handler }
    app.routes.push(r)
}

pub fn app_get(app: App, pattern: String, handler: Fn) {
    app_route(app, "GET", pattern, handler)
}

pub fn app_post(app: App, pattern: String, handler: Fn) {
    app_route(app, "POST", pattern, handler)
}

pub fn app_put(app: App, pattern: String, handler: Fn) {
    app_route(app, "PUT", pattern, handler)
}

pub fn app_delete(app: App, pattern: String, handler: Fn) {
    app_route(app, "DELETE", pattern, handler)
}

pub fn app_before(app: App, hook: Fn) {
    app.before_hooks.push(hook)
}

pub fn app_after(app: App, hook: Fn) {
    app.after_hooks.push(hook)
}

// Register a middleware function.
// Middlewares run in order before the route handler.
// Each middleware receives (req: Request) and returns a Response.
// Return a Response with status 0 to continue to the next middleware/handler.
// Return a non-zero status Response to short-circuit (e.g. 403, 429).
pub fn app_use(app: App, mw: Fn) {
    app.middlewares.push(mw)
}

// ── Error handlers registrables (fricción de serve, 2026-08-06) ──
// Doctrina: el poder al vocabulario — el 404 y el 500 son del USUARIO, con
// defaults reales desde app_new (nunca hay campo vacío).

// Default 404: la misma página que el framework servía hardcodeada.
pub fn default_not_found(req: Request) -> Response {
    return response_html(404, "<h1>404 Not Found</h1>")
}

// Default 500: genérico a propósito — NO ecoa `err` al cliente (no filtrar
// internals). El parámetro existe para los handlers registrados con
// app_error, que sí pueden usarlo.
pub fn default_error(req: Request, err: String) -> Response {
    return response_html(500, "<h1>500 Internal Server Error</h1>")
}

// handler: Fn(Request) -> Response — reemplaza la página 404.
// ⚠️ Receptor &mut App OBLIGATORIO (hallazgo del test, 2026-08-06): un campo
// escalar (Fn/String) asignado vía parámetro POR VALOR muta la copia y se
// pierde — la premisa del plan («mismo mecanismo que app.static_dir») era
// falsa: serve_static tiene el mismo patrón y está rota en silencio (los
// sites usan la vía de globals). Con &mut App el field-assign persiste
// (garantizado por test-321). Callsite: app_not_found(&mut app, mi_404)
// con `var app`.
pub fn app_not_found(app: &mut App, handler: Fn) {
    app.not_found_handler = handler
}

// handler: Fn(Request, String) -> Response — recibe el mensaje del
// panic/throw que atrapó el servidor. Mismo contrato &mut que app_not_found.
pub fn app_error(app: &mut App, handler: Fn) {
    app.error_handler = handler
}

// Activa el access-log estructurado del servidor (una línea JSON por
// request a stdout — la emite el dispatcher del consumer, p.ej. nyx-serve).
// Mismo contrato &mut que app_not_found (asignación de campo escalar).
pub fn app_access_log(app: &mut App) {
    app.access_log = true
}

// ── Routers montables + middleware envolvente (bloqueador 2 de serve) ──
// Contrato wrap: Fn(Request, Fn) -> Response. El 2º argumento es
// next: Fn(Request) -> Response — llamarlo ejecuta el resto de la cadena y
// devuelve su Response (envolver antes/después, modificar la respuesta, no
// llamarlo = short-circuit, o pasarle un Request distinto). Todo el registro
// de acá abajo hace push a Arrays (referencias) → va POR VALOR como app_get;
// la lección &mut de app_not_found aplica solo a asignar campos escalares.

struct Router {
    routes: Array,
    middlewares: Array,
    wraps: Array,
}

struct Mount {
    prefix: String,
    router: Router,
}

pub fn router_new() -> Router {
    var routes: Array = []
    var middlewares: Array = []
    var wraps: Array = []
    return Router { routes: routes, middlewares: middlewares, wraps: wraps }
}

pub fn router_route(router: Router, method: String, pattern: String, handler: Fn) {
    router.routes.push(Route { method: method, pattern: pattern, handler: handler })
}

pub fn router_get(router: Router, pattern: String, handler: Fn) {
    router_route(router, "GET", pattern, handler)
}

pub fn router_post(router: Router, pattern: String, handler: Fn) {
    router_route(router, "POST", pattern, handler)
}

pub fn router_put(router: Router, pattern: String, handler: Fn) {
    router_route(router, "PUT", pattern, handler)
}

pub fn router_delete(router: Router, pattern: String, handler: Fn) {
    router_route(router, "DELETE", pattern, handler)
}

// Middleware estilo status-0 (el contrato clásico), scoped al router.
pub fn router_use(router: Router, mw: Fn) {
    router.middlewares.push(mw)
}

// Middleware envolvente (contrato wrap), scoped al router.
pub fn router_wrap(router: Router, mw: Fn) {
    router.wraps.push(mw)
}

// Middleware envolvente a nivel app: envuelve hooks, middlewares, mounts,
// rutas, static y 404. El server los ejecuta en orden de registro (el
// primero es el más externo).
pub fn app_wrap(app: App, mw: Fn) {
    app.wraps.push(mw)
}

// Monta un router bajo un prefijo literal (sin {param}). El prefijo se
// normaliza sin "/" final: "/api" matchea "/api" y "/api/...". El matching
// interno del router ve el path SIN el prefijo ("/api" pelado → "/").
pub fn app_mount(app: App, prefix: String, router: Router) {
    var p: String = prefix
    if p.length() > 1 and p.endsWith("/") {
        p = p.substring(0, p.length() - 1)
    }
    app.mounts.push(Mount { prefix: p, router: router })
}

// ── Built-in middleware: Logging ──
// Logs: METHOD PATH -> STATUS (latency_ms)
pub fn mw_logging(req: Request) -> Response {
    // Logging is handled post-response in the dispatch loop.
    // This middleware is a no-op marker; the dispatch checks for it.
    let hdrs: Array = []
    return Response { status: 0, headers_flat: hdrs, body: "" }
}

// ── Built-in middleware: CORS ──
// Responds to OPTIONS with appropriate headers, adds CORS headers to all responses.
var __cors_origin: String = "*"
var __cors_methods: String = "GET, POST, PUT, DELETE, OPTIONS"
var __cors_headers: String = "Content-Type, Authorization"

pub fn cors_configure(origin: String, methods: String, headers: String) {
    __cors_origin = origin
    __cors_methods = methods
    __cors_headers = headers
}

pub fn mw_cors(req: Request) -> Response {
    if req.method == "OPTIONS" {
        let hdrs: Array = [
            "Access-Control-Allow-Origin", __cors_origin,
            "Access-Control-Allow-Methods", __cors_methods,
            "Access-Control-Allow-Headers", __cors_headers,
            "Access-Control-Max-Age", "86400"
        ]
        return Response { status: 204, headers_flat: hdrs, body: "" }
    }
    let hdrs: Array = []
    return Response { status: 0, headers_flat: hdrs, body: "" }
}

// Add CORS headers to a response
fn __add_cors_headers(resp: Response) -> Response {
    resp.headers_flat.push("Access-Control-Allow-Origin")
    resp.headers_flat.push(__cors_origin)
    return resp
}
