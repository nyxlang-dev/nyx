// std/barcode — códigos de barras (Code 128, EAN-13) y QR, en Nyx puro.
//
// De dónde sale: nyxerp imprime el número de la venta en el ticket de la caja
// (HTML hoy, ESC/POS mañana) para leerlo con un lector al devolver o reimprimir,
// y el mismo binario corre en el servidor y en wasm32-wasi (la caja imprime sin
// conexión). Por eso el módulo es aritmética entera pura: sin `extern "C"`, sin
// float, sin I/O — compila igual a nativo y a wasm y tiene que dar lo mismo.
//
// Devuelve DATOS, no dibujos (spec 2026-09-23, D-5): anchos de barra/espacio para
// los códigos lineales y la matriz de módulos para el QR. Cada programa lo pinta
// como necesite (un <rect> por barra en SVG, un raster para la impresora).
//
// Errores: `err_new(22, "invalid", …)` para todo dato que el formato no admite
// (el 22 es EINVAL, mismo precedente que std/math_ext). No hay otra clase de
// fallo: nada de lo que hace este módulo toca el sistema.

import "std/error"

// ── Code 128 (ISO/IEC 15417) ──────────────────────────────────────────────
// Los 107 símbolos como anchos alternados barra/espacio, en módulos. Cada uno
// suma 11 módulos; el 106 (parada) lleva una barra final más y suma 13. 103, 104
// y 105 son los arranques de los juegos A, B y C; 99 es «Code C» dentro de B y
// 100 es «Code B» dentro de C. Tabla transcrita de ISO/IEC 15417 y cruzada
// símbolo por símbolo con la implementación independiente de nyxerp
// (src/web/caja/impresion.nx), que es idéntica.
var __bc_c128: Array = ["212222", "222122", "222221", "121223", "121322", "131222", "122213", "122312", "132212", "221213",
    "221312", "231212", "112232", "122132", "122231", "113222", "123122", "123221", "223211", "221132",
    "221231", "213212", "223112", "312131", "311222", "321122", "321221", "312212", "322112", "322211",
    "212123", "212321", "232121", "111323", "131123", "131321", "112313", "132113", "132311", "211313",
    "231113", "231311", "112133", "112331", "132131", "113123", "113321", "133121", "313121", "211331",
    "231131", "213113", "213311", "213131", "311123", "311321", "331121", "312113", "312311", "332111",
    "314111", "221411", "431111", "111224", "111422", "121124", "121421", "141122", "141221", "112214",
    "112412", "122114", "122411", "142112", "142211", "241211", "221114", "413111", "241112", "134111",
    "111242", "121142", "121241", "114212", "124112", "124211", "411212", "421112", "421211", "212141",
    "214121", "412121", "111143", "111341", "131141", "114113", "114311", "411113", "411311", "113141",
    "114131", "311141", "411131", "211412", "211214", "211232", "2331112"]

fn __bc_is_digit(c: int) -> bool {
    return c >= 48 and c <= 57
}

// Cuántos dígitos seguidos hay desde `i`.
fn __bc_digit_run(data: String, i: int) -> int {
    var j: int = i
    while j < data.length() and __bc_is_digit(data.charAt(j)) {
        j = j + 1
    }
    return j - i
}

// Símbolos de un texto en Code 128, juegos B y C elegidos solos, con arranque,
// dígito de control y parada.
//
// Elección de juego (la regla de ISO/IEC 15417 Anexo E, reducida a B/C): un par
// de dígitos cuesta un símbolo en C y dos en B, y cada cambio de juego cuesta
// uno. Por eso se arranca en C si el texto empieza con 4 o más dígitos (o es
// entero un número de cantidad par de dígitos), y desde B se pasa a C ante 4 o
// más dígitos que llegan al final, o 6 o más en el medio (con 4 en el medio, ir
// y volver cuesta lo mismo que quedarse). Si la corrida es impar, el primer
// dígito va en B y el resto en pares.
//
// El juego A (controles ASCII 0-31) queda fuera: un byte fuera de 32..127 es
// Err(invalid), igual que un texto vacío.
/// Code 128: valores de símbolo 0-106 (arranque, datos en juegos B/C elegidos solos, control mod 103, parada). Err(invalid) si vacío o byte fuera de ASCII 32-127.
pub fn code128_symbols(data: String) -> Result<Array, Error> {
    let n: int = data.length()
    if n == 0 {
        return Result.Err(err_new(22, "invalid", "code128: texto vacío"))
    }
    var i: int = 0
    while i < n {
        let c: int = data.charAt(i)
        if c < 32 or c > 127 {
            return Result.Err(err_new(22, "invalid", "code128: el byte " + int_to_string(c) + " en la posición " + int_to_string(i) + " no está en el juego B (ASCII 32-127)"))
        }
        i = i + 1
    }

    var out: Array = []
    var in_c: bool = false
    let lead: int = __bc_digit_run(data, 0)
    if lead >= 4 or (lead == n and n % 2 == 0) {
        out.push(105)
        in_c = true
    } else {
        out.push(104)
    }

    i = 0
    while i < n {
        let run: int = __bc_digit_run(data, i)
        if in_c {
            if run >= 2 {
                let d0: int = data.charAt(i) - 48
                let d1: int = data.charAt(i + 1) - 48
                out.push(d0 * 10 + d1)
                i = i + 2
            } else {
                out.push(100)
                in_c = false
            }
        } else {
            if (run >= 4 and i + run == n) or run >= 6 {
                if run % 2 == 1 {
                    out.push(data.charAt(i) - 32)
                    i = i + 1
                }
                out.push(99)
                in_c = true
            } else {
                out.push(data.charAt(i) - 32)
                i = i + 1
            }
        }
    }

    // Control: arranque + suma de valor * posición (desde 1), módulo 103.
    let start: int = out[0]
    var sum: int = start
    var k: int = 1
    while k < out.length() {
        let s: int = out[k]
        sum = sum + s * k
        k = k + 1
    }
    out.push(sum % 103)
    out.push(106)
    return Result.Ok(out)
}

// Anchos alternados en MÓDULOS, empezando por barra y terminando en barra
// (la barra final de la parada). Sin zona de silencio: el que dibuja deja al
// menos 10 módulos en blanco a cada lado. Suma de los anchos: 11 * símbolos + 2.
/// Code 128: anchos alternados barra/espacio en módulos, empezando en barra, sin zona de silencio. Err(invalid) si vacío o byte fuera de ASCII 32-127.
pub fn code128_widths(data: String) -> Result<Array, Error> {
    match code128_symbols(data) {
        Result.Ok(symbols) => {
            var out: Array = []
            var i: int = 0
            while i < symbols.length() {
                let s: int = symbols[i]
                let p: String = __bc_c128[s]
                var k: int = 0
                while k < p.length() {
                    out.push(p.charAt(k) - 48)
                    k = k + 1
                }
                i = i + 1
            }
            return Result.Ok(out)
        }
        Result.Err(e) => { return Result.Err(e) }
    }
}

// ── EAN-13 (GS1 General Specifications §5.2) ──────────────────────────────
// Cada dígito ocupa 7 módulos en dos barras y dos espacios. Los anchos del juego
// L empiezan en espacio; los del R son los mismos anchos empezando en barra (R es
// el complemento de L); los del G son los de L al revés. El primer dígito no se
// dibuja: se codifica en qué dígitos de la mitad izquierda van en L y cuáles en G.
var __bc_ean_l: Array = ["3211", "2221", "2122", "1411", "1132", "1231", "1114", "1312", "1213", "3112"]
var __bc_ean_parity: Array = ["LLLLLL", "LLGLGG", "LLGGLG", "LLGGGL", "LGLLGG",
                              "LGGLLG", "LGGGLL", "LGLGLG", "LGLGGL", "LGGLGL"]

fn __bc_ean_check(digits: String) -> int {
    var t: int = 0
    var i: int = 0
    while i < 12 {
        let d: int = digits.charAt(i) - 48
        if i % 2 == 1 { t = t + 3 * d } else { t = t + d }
        i = i + 1
    }
    return (10 - t % 10) % 10
}

fn __bc_push_widths(out: Array, w: String, reversed: bool) {
    var k: int = 0
    while k < w.length() {
        if reversed {
            out.push(w.charAt(w.length() - 1 - k) - 48)
        } else {
            out.push(w.charAt(k) - 48)
        }
        k = k + 1
    }
}

// Anchos alternados en módulos, empezando por barra (la guarda de inicio) y
// terminando en barra (la guarda final): 59 anchos que suman 95 módulos, sin
// zona de silencio (GS1 pide 11 módulos a la izquierda y 7 a la derecha).
// Acepta 12 dígitos (calcula el de control) o 13 (lo valida: un control que no
// coincide es Err, no se corrige en silencio).
/// EAN-13: 59 anchos (95 módulos) empezando en barra; 12 dígitos calcula el control, 13 lo valida. Err(invalid) si no.
pub fn ean13_widths(digits: String) -> Result<Array, Error> {
    let n: int = digits.length()
    if n != 12 and n != 13 {
        return Result.Err(err_new(22, "invalid", "ean13: hacen falta 12 o 13 dígitos, llegaron " + int_to_string(n) + " bytes"))
    }
    var i: int = 0
    while i < n {
        if !__bc_is_digit(digits.charAt(i)) {
            return Result.Err(err_new(22, "invalid", "ean13: la posición " + int_to_string(i) + " no es un dígito"))
        }
        i = i + 1
    }
    let check: int = __bc_ean_check(digits)
    var full: String = digits
    if n == 12 {
        full = digits + int_to_string(check)
    } else if digits.charAt(12) - 48 != check {
        return Result.Err(err_new(22, "invalid", "ean13: el dígito de control es " + int_to_string(digits.charAt(12) - 48) + " y debería ser " + int_to_string(check)))
    }

    var out: Array = [1, 1, 1]
    let parity: String = __bc_ean_parity[full.charAt(0) - 48]
    i = 1
    while i <= 6 {
        let w: String = __bc_ean_l[full.charAt(i) - 48]
        // 'G' = 71: el patrón L leído al revés.
        __bc_push_widths(out, w, parity.charAt(i - 1) == 71)
        i = i + 1
    }
    out.push(1)
    out.push(1)
    out.push(1)
    out.push(1)
    out.push(1)
    while i <= 12 {
        let w: String = __bc_ean_l[full.charAt(i) - 48]
        __bc_push_widths(out, w, false)
        i = i + 1
    }
    out.push(1)
    out.push(1)
    out.push(1)
    return Result.Ok(out)
}

// ── QR (ISO/IEC 18004) ────────────────────────────────────────────────────
// Alcance de la fase 1 (spec D-1/D-2): versiones 1 a 10, niveles L/M/Q/H, un
// solo segmento en el modo más compacto que acepta TODO el texto (numérico,
// alfanumérico o byte). Sin Kanji ni segmentación mixta. Versión y máscara
// automáticas: la versión mínima donde entra el texto, y de las 8 máscaras la
// de menor penalización según las 4 reglas del estándar.
//
// La matriz se devuelve como Array de filas; cada fila es un Array de int, 1 =
// módulo oscuro, 0 = claro. Se eligió int y no bool porque es lo que consume el
// raster de una impresora (un bit por módulo) y porque compara con `==` sin
// sorpresas en los dos targets — el mismo precedente de datos planos que
// std/json. Lado = 17 + 4 * versión (21 en la versión 1), SIN zona de
// silencio: el que dibuja deja 4 módulos claros alrededor.

// Nivel de corrección: recupera ~7% (L), ~15% (M), ~25% (Q) o ~30% (H) de los
// módulos dañados. M es el habitual; H si el código va a sufrir (papel térmico
// que se borra, un logo encima).
pub enum QrEcc {
    L,
    M,
    Q,
    H
}

// Índice de tabla (L=0 … H=3). El match es EXPLÍCITO a propósito (el mismo
// motivo que round_mode_code en std/math): reordenar el enum no puede cambiar en
// silencio qué fila de la tabla se usa.
fn __bc_qr_ecc_index(ecc: QrEcc) -> int {
    return match ecc {
        QrEcc.L => 0,
        QrEcc.M => 1,
        QrEcc.Q => 2,
        QrEcc.H => 3
    }
}

// Palabras de corrección por bloque y cantidad de bloques, versiones 1-10, en
// filas L, M, Q, H (ISO/IEC 18004 tabla 9). Índice: nivel * 10 + (versión - 1).
// Las palabras de datos no se transcriben: salen de restar al total de la
// versión, y test-438 fija la capacidad resultante contra la tabla 7 publicada
// (p. ej. 1-M = 16, 5-Q = 62, 10-L = 274).
var __bc_qr_ecc_per_block: Array = [
    7, 10, 15, 20, 26, 18, 20, 24, 30, 18,
    10, 16, 26, 18, 24, 16, 18, 22, 22, 26,
    13, 22, 18, 26, 18, 24, 18, 22, 20, 24,
    17, 28, 22, 16, 22, 28, 26, 26, 24, 28]
var __bc_qr_blocks: Array = [
    1, 1, 1, 1, 1, 2, 2, 2, 2, 4,
    1, 1, 1, 2, 2, 4, 4, 4, 5, 5,
    1, 1, 2, 2, 4, 4, 6, 6, 8, 8,
    1, 1, 2, 4, 4, 4, 5, 6, 8, 8]

// Centros de los patrones de alineación por versión (ISO/IEC 18004 Anexo E).
fn __bc_qr_align(version: int) -> Array {
    if version == 1 { return [] }
    if version == 2 { return [6, 18] }
    if version == 3 { return [6, 22] }
    if version == 4 { return [6, 26] }
    if version == 5 { return [6, 30] }
    if version == 6 { return [6, 34] }
    if version == 7 { return [6, 22, 38] }
    if version == 8 { return [6, 24, 42] }
    if version == 9 { return [6, 26, 46] }
    return [6, 28, 50]
}

// Módulos disponibles para datos + corrección: el lado al cuadrado menos los
// patrones fijos. Fórmula de Project Nayuki («QR Code generator library»); da
// 26, 44, 70, 100, 134, 172, 196, 242, 292 y 346 palabras para las versiones
// 1-10, la columna «total» de la tabla 9 (test-438 lo fija).
fn __bc_qr_raw_modules(version: int) -> int {
    var r: int = (16 * version + 128) * version + 64
    if version >= 2 {
        let na: int = version / 7 + 2
        r = r - ((25 * na - 10) * na - 55)
        if version >= 7 { r = r - 36 }
    }
    return r
}

fn __bc_qr_capacity(version: int, eci: int) -> int {
    let k: int = eci * 10 + version - 1
    let per: int = __bc_qr_ecc_per_block[k]
    let nb: int = __bc_qr_blocks[k]
    return __bc_qr_raw_modules(version) / 8 - per * nb
}

// ── GF(256), polinomio primitivo x^8 + x^4 + x^3 + x^2 + 1 (0x11D) ────────
// exp[i] = alfa^i para i en 0..509 (duplicada para no reducir mod 255 al
// multiplicar). log[0] no existe: __bc_gf_mul devuelve 0 si un factor es 0
// ANTES de mirar la tabla — ese es el caso especial del cero.
fn __bc_gf_exp_table() -> Array {
    var t: Array = []
    var x: int = 1
    var i: int = 0
    while i < 510 {
        t.push(x)
        x = x << 1
        if (x & 256) != 0 { x = x ^ 285 }
        i = i + 1
    }
    return t
}

fn __bc_gf_log_table(exp: Array) -> Array {
    var t: Array = []
    var i: int = 0
    while i < 256 {
        t.push(0)
        i = i + 1
    }
    i = 0
    while i < 255 {
        let v: int = exp[i]
        t[v] = i
        i = i + 1
    }
    return t
}

fn __bc_gf_mul(a: int, b: int, exp: Array, log: Array) -> int {
    if a == 0 or b == 0 { return 0 }
    let la: int = log[a]
    let lb: int = log[b]
    let r: int = exp[la + lb]
    return r
}

// Generador de grado n, g(x) = (x - a^0)(x - a^1)…(x - a^(n-1)), SIN el
// coeficiente principal (que es 1): n coeficientes de mayor a menor grado.
fn __bc_rs_divisor(n: int, exp: Array, log: Array) -> Array {
    var g: Array = []
    var i: int = 0
    while i < n {
        g.push(0)
        i = i + 1
    }
    g[n - 1] = 1
    var root: int = 1
    i = 0
    while i < n {
        var j: int = 0
        while j < n {
            let gj: int = g[j]
            var v: int = __bc_gf_mul(gj, root, exp, log)
            if j + 1 < n {
                let gn: int = g[j + 1]
                v = v ^ gn
            }
            g[j] = v
            j = j + 1
        }
        root = __bc_gf_mul(root, 2, exp, log)
        i = i + 1
    }
    return g
}

// Palabras de corrección: resto de data(x)·x^n / g(x), por registro de
// desplazamiento.
fn __bc_rs_remainder(data: Array, divisor: Array, exp: Array, log: Array) -> Array {
    let n: int = divisor.length()
    var r: Array = []
    var i: int = 0
    while i < n {
        r.push(0)
        i = i + 1
    }
    var k: int = 0
    while k < data.length() {
        let b: int = data[k]
        let r0: int = r[0]
        let factor: int = b ^ r0
        var j: int = 0
        while j < n - 1 {
            let nx: int = r[j + 1]
            r[j] = nx
            j = j + 1
        }
        r[n - 1] = 0
        j = 0
        while j < n {
            let dj: int = divisor[j]
            let rj: int = r[j]
            r[j] = rj ^ __bc_gf_mul(dj, factor, exp, log)
            j = j + 1
        }
        k = k + 1
    }
    return r
}

// ── Datos ─────────────────────────────────────────────────────────────────
// Alfanumérico de QR: 0-9, A-Z, espacio y $ % * + - . / : — 45 símbolos, en
// ese orden (el valor es la posición).
var __bc_qr_alnum: String = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

fn __bc_qr_alnum_value(c: int) -> int {
    var i: int = 0
    while i < 45 {
        if __bc_qr_alnum.charAt(i) == c { return i }
        i = i + 1
    }
    return 0 - 1
}

// Modo: 1 numérico, 2 alfanumérico, 4 byte (el indicador de 4 bits del estándar).
fn __bc_qr_mode(data: String) -> int {
    var numeric: bool = true
    var alnum: bool = true
    var i: int = 0
    while i < data.length() {
        let c: int = data.charAt(i)
        if !__bc_is_digit(c) { numeric = false }
        if __bc_qr_alnum_value(c) < 0 { alnum = false }
        i = i + 1
    }
    if numeric { return 1 }
    if alnum { return 2 }
    return 4
}

// Bits del contador de caracteres (tabla 3): versiones 1-9 y 10-26.
fn __bc_qr_count_bits(mode: int, version: int) -> int {
    if mode == 1 {
        if version <= 9 { return 10 }
        return 12
    }
    if mode == 2 {
        if version <= 9 { return 9 }
        return 11
    }
    if version <= 9 { return 8 }
    return 16
}

// Bits de la carga útil (sin indicador ni contador).
fn __bc_qr_payload_bits(mode: int, n: int) -> int {
    if mode == 1 {
        var b: int = (n / 3) * 10
        if n % 3 == 1 { b = b + 4 }
        if n % 3 == 2 { b = b + 7 }
        return b
    }
    if mode == 2 {
        return (n / 2) * 11 + (n % 2) * 6
    }
    return n * 8
}

fn __bc_bits_push(buf: Array, value: int, n: int) {
    var i: int = n - 1
    while i >= 0 {
        buf.push((value >> i) & 1)
        i = i - 1
    }
}

// Palabras de datos completas: modo, contador, carga, terminador, relleno a
// byte y bytes de relleno 0xEC 0x11 alternados hasta la capacidad.
fn __bc_qr_encode_data(data: String, mode: int, version: int, capacity: int) -> Array {
    var bits: Array = []
    let n: int = data.length()
    __bc_bits_push(bits, mode, 4)
    __bc_bits_push(bits, n, __bc_qr_count_bits(mode, version))
    var i: int = 0
    if mode == 1 {
        while i < n {
            var take: int = n - i
            if take > 3 { take = 3 }
            var v: int = 0
            var k: int = 0
            while k < take {
                v = v * 10 + (data.charAt(i + k) - 48)
                k = k + 1
            }
            __bc_bits_push(bits, v, take * 3 + 1)
            i = i + take
        }
    } else if mode == 2 {
        while i < n {
            if i + 1 < n {
                let a: int = __bc_qr_alnum_value(data.charAt(i))
                let b: int = __bc_qr_alnum_value(data.charAt(i + 1))
                __bc_bits_push(bits, a * 45 + b, 11)
                i = i + 2
            } else {
                __bc_bits_push(bits, __bc_qr_alnum_value(data.charAt(i)), 6)
                i = i + 1
            }
        }
    } else {
        while i < n {
            __bc_bits_push(bits, data.charAt(i), 8)
            i = i + 1
        }
    }
    let cap_bits: int = capacity * 8
    var term: int = cap_bits - bits.length()
    if term > 4 { term = 4 }
    __bc_bits_push(bits, 0, term)
    while bits.length() % 8 != 0 {
        bits.push(0)
    }
    var out: Array = []
    i = 0
    while i < bits.length() {
        var byte: int = 0
        var k: int = 0
        while k < 8 {
            let bit: int = bits[i + k]
            byte = (byte << 1) | bit
            k = k + 1
        }
        out.push(byte)
        i = i + 8
    }
    var pad: int = 236
    while out.length() < capacity {
        out.push(pad)
        pad = pad ^ 253   // 0xEC <-> 0x11
    }
    return out
}

// Parte las palabras de datos en bloques, calcula la corrección de cada uno y
// entrelaza (§7.6): primero la palabra i de cada bloque de datos (los bloques
// cortos van primero y se saltan en la última vuelta), después la palabra i de
// cada bloque de corrección.
fn __bc_qr_interleave(data: Array, version: int, eci: int) -> Array {
    let k: int = eci * 10 + version - 1
    let ecc_len: int = __bc_qr_ecc_per_block[k]
    let nb: int = __bc_qr_blocks[k]
    let raw_cw: int = __bc_qr_raw_modules(version) / 8
    let short_len: int = raw_cw / nb        // datos + corrección del bloque corto
    let num_short: int = nb - raw_cw % nb
    let exp: Array = __bc_gf_exp_table()
    let log: Array = __bc_gf_log_table(exp)
    let divisor: Array = __bc_rs_divisor(ecc_len, exp, log)

    var dblocks: Array = []
    var eblocks: Array = []
    var pos: int = 0
    var b: int = 0
    while b < nb {
        var dlen: int = short_len - ecc_len
        if b >= num_short { dlen = dlen + 1 }
        let blk: Array = data.slice(pos, pos + dlen)
        pos = pos + dlen
        dblocks.push(blk)
        eblocks.push(__bc_rs_remainder(blk, divisor, exp, log))
        b = b + 1
    }

    var out: Array = []
    let max_d: int = short_len - ecc_len + 1
    var i: int = 0
    while i < max_d {
        b = 0
        while b < nb {
            let blk: Array = dblocks[b]
            if i < blk.length() {
                let v: int = blk[i]
                out.push(v)
            }
            b = b + 1
        }
        i = i + 1
    }
    i = 0
    while i < ecc_len {
        b = 0
        while b < nb {
            let eb: Array = eblocks[b]
            let v: int = eb[i]
            out.push(v)
            b = b + 1
        }
        i = i + 1
    }
    return out
}

// ── Matriz ────────────────────────────────────────────────────────────────
// Internamente plana (fila * lado + columna) para no pagar Array<Array> en el
// bucle caliente de las máscaras; `func` marca los módulos de función, que ni
// los datos ni la máscara tocan.
fn __bc_set_func(mods: Array, func: Array, size: int, row: int, col: int, dark: bool) {
    let i: int = row * size + col
    if dark { mods[i] = 1 } else { mods[i] = 0 }
    func[i] = 1
}

fn __bc_abs(x: int) -> int {
    if x < 0 { return 0 - x }
    return x
}

fn __bc_max(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

// Patrón de búsqueda 7x7 con su separador claro alrededor, centrado en (cr, cc).
fn __bc_qr_finder(mods: Array, func: Array, size: int, cr: int, cc: int) {
    var dy: int = 0 - 4
    while dy <= 4 {
        var dx: int = 0 - 4
        while dx <= 4 {
            let r: int = cr + dy
            let c: int = cc + dx
            if r >= 0 and r < size and c >= 0 and c < size {
                let d: int = __bc_max(__bc_abs(dx), __bc_abs(dy))
                __bc_set_func(mods, func, size, r, c, d != 2 and d != 4)
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// Información de formato (§7.9): 5 bits (nivel + máscara) + 10 de BCH(15,5)
// con generador 0x537, XOR con 0x5412.
fn __bc_qr_format_bits(eci: int, mask: int) -> int {
    // Indicador de nivel de la tabla 12: L=01, M=00, Q=11, H=10.
    var ecl: int = 1
    if eci == 1 { ecl = 0 }
    if eci == 2 { ecl = 3 }
    if eci == 3 { ecl = 2 }
    let data: int = (ecl << 3) | mask
    var rem: int = data
    var i: int = 0
    while i < 10 {
        rem = (rem << 1) ^ ((rem >> 9) * 1335)
        i = i + 1
    }
    return ((data << 10) | (rem & 1023)) ^ 21522
}

// Las dos copias del formato y el módulo oscuro. El bit 0 es el menos
// significativo de los 15.
fn __bc_qr_draw_format(mods: Array, func: Array, size: int, eci: int, mask: int) {
    let bits: int = __bc_qr_format_bits(eci, mask)
    // Primera copia, alrededor del patrón de búsqueda de arriba a la izquierda:
    // bits 0-7 bajando por la columna 8 (salteando la fila 6 de temporización),
    // bits 8-14 por la fila 8 hacia la izquierda (salteando la columna 6).
    var i: int = 0
    while i <= 5 {
        __bc_set_func(mods, func, size, i, 8, ((bits >> i) & 1) == 1)
        i = i + 1
    }
    __bc_set_func(mods, func, size, 7, 8, ((bits >> 6) & 1) == 1)
    __bc_set_func(mods, func, size, 8, 8, ((bits >> 7) & 1) == 1)
    __bc_set_func(mods, func, size, 8, 7, ((bits >> 8) & 1) == 1)
    i = 9
    while i < 15 {
        __bc_set_func(mods, func, size, 8, 14 - i, ((bits >> i) & 1) == 1)
        i = i + 1
    }
    // Segunda copia: fila 8 desde el borde derecho (bits 0-7) y columna 8
    // subiendo desde abajo (bits 8-14).
    i = 0
    while i < 8 {
        __bc_set_func(mods, func, size, 8, size - 1 - i, ((bits >> i) & 1) == 1)
        i = i + 1
    }
    while i < 15 {
        __bc_set_func(mods, func, size, size - 15 + i, 8, ((bits >> i) & 1) == 1)
        i = i + 1
    }
    // Módulo oscuro (§7.9.1): siempre oscuro, fila 4V+9, columna 8.
    __bc_set_func(mods, func, size, size - 8, 8, true)
}

// Información de versión (v7+, §7.10): 6 bits + 12 de BCH(18,6) con generador
// 0x1F25, en dos bloques de 6x3 junto a los patrones de búsqueda de arriba a la
// derecha (3 columnas) y de abajo a la izquierda (3 filas).
fn __bc_qr_draw_version(mods: Array, func: Array, size: int, version: int) {
    if version < 7 { return }
    var rem: int = version
    var i: int = 0
    while i < 12 {
        rem = (rem << 1) ^ ((rem >> 11) * 7973)
        i = i + 1
    }
    let bits: int = (version << 12) | (rem & 4095)
    i = 0
    while i < 18 {
        let dark: bool = ((bits >> i) & 1) == 1
        let a: int = size - 11 + i % 3
        let b: int = i / 3
        __bc_set_func(mods, func, size, b, a, dark)
        __bc_set_func(mods, func, size, a, b, dark)
        i = i + 1
    }
}

fn __bc_qr_function_patterns(mods: Array, func: Array, size: int, version: int, eci: int) {
    // Temporización: fila 6 y columna 6, oscuro en los índices pares.
    var i: int = 0
    while i < size {
        __bc_set_func(mods, func, size, 6, i, i % 2 == 0)
        __bc_set_func(mods, func, size, i, 6, i % 2 == 0)
        i = i + 1
    }
    __bc_qr_finder(mods, func, size, 3, 3)
    __bc_qr_finder(mods, func, size, 3, size - 4)
    __bc_qr_finder(mods, func, size, size - 4, 3)
    // Alineación: todas las combinaciones de centros menos las tres esquinas
    // que pisan un patrón de búsqueda.
    let pos: Array = __bc_qr_align(version)
    let na: int = pos.length()
    i = 0
    while i < na {
        var j: int = 0
        while j < na {
            let corner: bool = (i == 0 and j == 0) or (i == 0 and j == na - 1) or (i == na - 1 and j == 0)
            if !corner {
                let cr: int = pos[i]
                let cc: int = pos[j]
                var dy: int = 0 - 2
                while dy <= 2 {
                    var dx: int = 0 - 2
                    while dx <= 2 {
                        let d: int = __bc_max(__bc_abs(dx), __bc_abs(dy))
                        __bc_set_func(mods, func, size, cr + dy, cc + dx, d != 1)
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    // Reserva las zonas de formato (se reescriben con la máscara elegida).
    __bc_qr_draw_format(mods, func, size, eci, 0)
    __bc_qr_draw_version(mods, func, size, version)
}

// Colocación en zigzag (§7.7.3): columnas de a dos de derecha a izquierda,
// alternando subida y bajada, saltando la columna 6 de temporización. Los bits
// van del más significativo al menos significativo de cada palabra; los módulos
// que sobran (bits de resto) quedan en 0 antes de la máscara.
fn __bc_qr_draw_codewords(mods: Array, func: Array, size: int, cw: Array) {
    let total: int = cw.length() * 8
    var i: int = 0
    var right: int = size - 1
    while right >= 1 {
        if right == 6 { right = 5 }
        let upward: bool = ((right + 1) & 2) == 0
        var vert: int = 0
        while vert < size {
            var j: int = 0
            while j < 2 {
                let x: int = right - j
                var y: int = vert
                if upward { y = size - 1 - vert }
                let idx: int = y * size + x
                let f: int = func[idx]
                if f == 0 and i < total {
                    let byte: int = cw[i >> 3]
                    mods[idx] = (byte >> (7 - (i & 7))) & 1
                    i = i + 1
                }
                j = j + 1
            }
            vert = vert + 1
        }
        right = right - 2
    }
}

// Las 8 máscaras (tabla 10), con i = fila y j = columna.
fn __bc_qr_mask_bit(mask: int, i: int, j: int) -> bool {
    if mask == 0 { return (i + j) % 2 == 0 }
    if mask == 1 { return i % 2 == 0 }
    if mask == 2 { return j % 3 == 0 }
    if mask == 3 { return (i + j) % 3 == 0 }
    if mask == 4 { return (i / 2 + j / 3) % 2 == 0 }
    if mask == 5 { return (i * j) % 2 + (i * j) % 3 == 0 }
    if mask == 6 { return ((i * j) % 2 + (i * j) % 3) % 2 == 0 }
    return ((i + j) % 2 + (i * j) % 3) % 2 == 0
}

// XOR de la máscara sobre los módulos de datos. Aplicarla dos veces la deshace.
fn __bc_qr_apply_mask(mods: Array, func: Array, size: int, mask: int) {
    var r: int = 0
    while r < size {
        var c: int = 0
        while c < size {
            let idx: int = r * size + c
            let f: int = func[idx]
            if f == 0 and __bc_qr_mask_bit(mask, r, c) {
                let m: int = mods[idx]
                mods[idx] = m ^ 1
            }
            c = c + 1
        }
        r = r + 1
    }
}

// Copia una fila (horizontal) o una columna de la matriz plana, para recorrer
// las dos direcciones con el mismo código.
fn __bc_qr_line(mods: Array, size: int, line: int, horizontal: bool) -> Array {
    var out: Array = []
    var k: int = 0
    while k < size {
        var idx: int = k * size + line
        if horizontal { idx = line * size + k }
        let v: int = mods[idx]
        out.push(v)
        k = k + 1
    }
    return out
}

// 1 si el módulo k de la línea es oscuro; fuera del símbolo cuenta como claro
// (es la zona de silencio).
fn __bc_qr_dark_at(ln: Array, k: int) -> int {
    if k < 0 or k >= ln.length() { return 0 }
    let v: int = ln[k]
    return v
}

// Penalización de una máscara (§7.8.3, tabla 11):
//   N1: corrida de 5+ módulos iguales en fila o columna → 3 + (largo - 5).
//   N2: bloque 2x2 del mismo color → 3.
//   N3: 1:1:3:1:1 (oscuro-claro-oscuro³-claro-oscuro) con 4 claros a un lado,
//       contando como claro lo que queda fuera del símbolo → 40 por patrón (una
//       vez aunque tenga claros a los dos lados, la lectura de ZXing).
//   N4: desvío del 50% de oscuros → 10 por cada 5% completo.
// Ante dudas de lectura del estándar, la máscara elegida puede diferir de la
// de otro generador; eso NO afecta la lectura: el lector toma la máscara de la
// información de formato, cualquiera de las 8 es válida.
fn __bc_qr_penalty(mods: Array, size: int) -> int {
    var score: int = 0
    var pass: int = 0
    while pass < 2 {
        var line: int = 0
        while line < size {
            let ln: Array = __bc_qr_line(mods, size, line, pass == 0)
            // N1
            var run: int = 1
            var k: int = 1
            while k < size {
                let a: int = ln[k]
                let b: int = ln[k - 1]
                if a == b {
                    run = run + 1
                } else {
                    if run >= 5 { score = score + 3 + (run - 5) }
                    run = 1
                }
                k = k + 1
            }
            if run >= 5 { score = score + 3 + (run - 5) }
            // N3
            k = 0
            while k + 7 <= size {
                if __bc_qr_dark_at(ln, k) == 1 and __bc_qr_dark_at(ln, k + 1) == 0 and __bc_qr_dark_at(ln, k + 2) == 1 and __bc_qr_dark_at(ln, k + 3) == 1 and __bc_qr_dark_at(ln, k + 4) == 1 and __bc_qr_dark_at(ln, k + 5) == 0 and __bc_qr_dark_at(ln, k + 6) == 1 {
                    var before: bool = true
                    var after: bool = true
                    var q: int = 1
                    while q <= 4 {
                        if __bc_qr_dark_at(ln, k - q) == 1 { before = false }
                        if __bc_qr_dark_at(ln, k + 6 + q) == 1 { after = false }
                        q = q + 1
                    }
                    if before or after { score = score + 40 }
                }
                k = k + 1
            }
            line = line + 1
        }
        pass = pass + 1
    }
    // N2
    var r: int = 0
    while r < size - 1 {
        var c: int = 0
        while c < size - 1 {
            let a: int = mods[r * size + c]
            let b: int = mods[r * size + c + 1]
            let d: int = mods[(r + 1) * size + c]
            let e: int = mods[(r + 1) * size + c + 1]
            if a == b and a == d and a == e { score = score + 3 }
            c = c + 1
        }
        r = r + 1
    }
    // N4
    var dark: int = 0
    var i: int = 0
    let total: int = size * size
    while i < total {
        let m: int = mods[i]
        dark = dark + m
        i = i + 1
    }
    score = score + (__bc_abs(dark * 2 - total) * 10 / total) * 10
    return score
}

// La matriz de módulos de un QR con el texto `data`. Los bytes van tal cual: un
// texto con tildes va en modo byte con su UTF-8, contado por .length() (bytes),
// que es lo que el lector espera. Err(invalid) si no entra en la versión 10 con
// el nivel pedido — con M, más de 213 bytes, 311 alfanuméricos o 513 dígitos.
/// QR (versiones 1-10, modo y máscara automáticos): Array de filas de int 1 oscuro / 0 claro, lado 17+4V, sin zona de silencio. Err(invalid) si no entra.
pub fn qr_matrix(data: String, ecc: QrEcc) -> Result<Array, Error> {
    let eci: int = __bc_qr_ecc_index(ecc)
    let mode: int = __bc_qr_mode(data)
    let n: int = data.length()
    var version: int = 0
    var v: int = 1
    while v <= 10 and version == 0 {
        let need: int = 4 + __bc_qr_count_bits(mode, v) + __bc_qr_payload_bits(mode, n)
        if need <= __bc_qr_capacity(v, eci) * 8 { version = v }
        v = v + 1
    }
    if version == 0 {
        return Result.Err(err_new(22, "invalid", "qr: " + int_to_string(n) + " bytes no entran en un QR de versión 10 con ese nivel de corrección (fase 1: versiones 1-10)"))
    }

    let capacity: int = __bc_qr_capacity(version, eci)
    let data_cw: Array = __bc_qr_encode_data(data, mode, version, capacity)
    let all_cw: Array = __bc_qr_interleave(data_cw, version, eci)

    let size: int = 17 + 4 * version
    var mods: Array = []
    var func: Array = []
    var i: int = 0
    while i < size * size {
        mods.push(0)
        func.push(0)
        i = i + 1
    }
    __bc_qr_function_patterns(mods, func, size, version, eci)
    __bc_qr_draw_codewords(mods, func, size, all_cw)

    // Las 8 máscaras; gana la de menor penalización (la primera ante empate).
    var best: int = 0
    var best_score: int = 0 - 1
    var m: int = 0
    while m < 8 {
        __bc_qr_apply_mask(mods, func, size, m)
        __bc_qr_draw_format(mods, func, size, eci, m)
        let s: int = __bc_qr_penalty(mods, size)
        if best_score < 0 or s < best_score {
            best = m
            best_score = s
        }
        __bc_qr_apply_mask(mods, func, size, m)
        m = m + 1
    }
    __bc_qr_apply_mask(mods, func, size, best)
    __bc_qr_draw_format(mods, func, size, eci, best)

    var rows: Array = []
    var r: int = 0
    while r < size {
        var row: Array = []
        var c: int = 0
        while c < size {
            let x: int = mods[r * size + c]
            row.push(x)
            c = c + 1
        }
        rows.push(row)
        r = r + 1
    }
    return Result.Ok(rows)
}
