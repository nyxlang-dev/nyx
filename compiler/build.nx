// ============================================================
// BUILD.NX — Sistema de build integrado Nyx (v1.9.0)
// ============================================================
// Implementa `nyx build` que lee nyx.toml y compila el proyecto.
//
// nyx.toml formato:
//   [package]
//   name = "myapp"
//   version = "0.1.0"
//   main = "src/main.nx"
//
//   [dependencies]
//   # sin dependencias externas inicialmente
//
// Uso: make build-nyx-build && make nyx-build
//
// Comandos:
//   nyx_build build          # Compila el proyecto en nyx.toml
//   nyx_build build --release # Compila con optimizaciones
//   nyx_build run            # Compila y ejecuta
//   nyx_build info           # Muestra info del proyecto
// ============================================================

// ===== TOML PARSER (subset) =====

// Represents a parsed nyx.toml file
import "std/kvclient"
import "std/base64"
// La receta sin shell (W6 Task 2): lanzar el compilador y clang, el candado,
// el directorio temporal y lo que se sabe del host.
import "std/error"
import "std/process"
import "std/fs"
// build.nx es un módulo del compilador (importa compiler/gotchas_table), y a esos
// no se les carga el prelude (resolve.nx, es_modulo_del_compilador). std/error,
// std/process y std/fs usan los dos enums genéricos del prelude: se declaran
// acá, iguales a los de std/prelude.nx. Sin esto, `Result.Err(...)` de std/process
// compila como un método sobre una global y aborta con NYX2002.
enum Option<T> {
    Some(T),
    None
}

enum Result<T, E> {
    Ok(T),
    Err(E)
}
// Declaration-only, igual que en vet.nx: gotchas_table.nx se compila aparte y
// se linkea (ver build-nyx-build en el Makefile). El andamiaje SDD genera la
// evidencia y el test de constitución DESDE esta tabla — la misma fuente que
// alimenta AGENTS.md, LLM.md y `nyx vet`, para que no haya dos listas.
import { gotchas_table, gotcha_field, gotcha_scan_src } from "compiler/gotchas_table"

struct ProjectConfig {
    name: String,
    version: String,
    main_file: String,       // main EFECTIVO de esta corrida (lo pisa --main)
    manifest_main_file: String, // main del PROYECTO tal cual sale de nyx.toml — lo que va a nyx.lock; --main NUNCA lo toca
    description: String,
    no_gc: bool,
    target: String,      // [build] target (p.ej. wasm32-wasi) — evita exportar NYX_TARGET a mano
    dep_names: Array,   // dependency names
    dep_versions: Array, // dependency versions (parallel to dep_names)
    toml_error: String, // "" si el manifiesto es válido; si no, el mensaje a mostrar
    bin_name: String,   // nombre del artefacto; "" = el de [package] name (lo cambia --main)
    lib_modules: Array  // [lib] modules: módulos que se compilan aparte y se reutilizan (compilacion-separada)
}

// Parse a simple key = "value" line, return value or ""
fn parse_toml_value(line: String) -> String {
    let trimmed: String = line.trim()
    // Find the = sign
    var eq_pos = -1
    var i = 0
    while i < trimmed.length() {
        let c: char = trimmed.charAt(i)
        if c == '=' {
            eq_pos = i
            i = trimmed.length()
        } else {
            i = i + 1
        }
    }
    if eq_pos < 0 { return "" }

    let value_part: String = trimmed.substring(eq_pos + 1, trimmed.length()).trim()

    // Strip surrounding quotes if present
    if value_part.startsWith("\"") and value_part.endsWith("\"") {
        return value_part.substring(1, value_part.length() - 1)
    }
    // Boolean values
    if value_part == "true" { return "true" }
    if value_part == "false" { return "false" }
    return value_part
}

// Parse key name from a toml line (left side of =)
fn parse_toml_key(line: String) -> String {
    let trimmed: String = line.trim()
    var eq_pos = -1
    var i = 0
    while i < trimmed.length() {
        let c: char = trimmed.charAt(i)
        if c == '=' {
            eq_pos = i
            i = trimmed.length()
        } else {
            i = i + 1
        }
    }
    if eq_pos < 0 { return "" }
    return trimmed.substring(0, eq_pos).trim()
}

// `["src/a", "src/b"]` → agrega "src/a" y "src/b" a `out`. Devuelve "" o el
// error a mostrar. El path se escribe COMO EN EL IMPORT (sin .nx): es la clave
// con la que el compilador reconoce el import (NYX_LIB_MODULES, resolve.nx).
fn parse_lib_modules(val: String, out: Array) -> String {
    let v: String = val.trim()
    if not v.startsWith("[") or not v.endsWith("]") {
        return "[lib] modules en nyx.toml tiene que ser una lista en UNA línea: modules = [\"src/a\", \"src/b\"]"
    }
    let cuerpo: String = v.substring(1, v.length() - 1).trim()
    if cuerpo == "" { return "" }
    let partes: Array = cuerpo.split(",")
    var i: int = 0
    while i < partes.length() {
        let pp: String = partes[i]
        var m: String = pp.trim()
        if m.startsWith("\"") and m.endsWith("\"") and m.length() >= 2 {
            m = m.substring(1, m.length() - 1)
        } else {
            return "[lib] modules en nyx.toml: cada módulo va entre comillas (" + m + ")"
        }
        if m.endsWith(".nx") {
            return "[lib] modules en nyx.toml: el módulo se escribe como en el import, sin .nx (" + m + ")"
        }
        if m.startsWith("std/") {
            return "[lib] modules en nyx.toml: la stdlib no se compila aparte (" + m + ")"
        }
        out.push(m)
        i = i + 1
    }
    return ""
}

// Parse nyx.toml content into ProjectConfig
fn parse_toml(content: String) -> ProjectConfig {
    var dep_names_arr: Array = []
    var dep_versions_arr: Array = []
    var config: ProjectConfig = ProjectConfig {
        name: "",
        version: "0.1.0",
        main_file: "src/main.nx",
        manifest_main_file: "src/main.nx",
        description: "",
        no_gc: false,
        target: "",
        dep_names: dep_names_arr,
        dep_versions: dep_versions_arr,
        toml_error: "",
        bin_name: "",
        lib_modules: []
    }

    // `main` y `target` se aceptan en [package] y en [build]. [build] es lo que
    // promete la ayuda de `nyx build` («por defecto, el de [build] en nyx.toml»),
    // el spec del arco nyx-build-wasm y el fixture de test-wasm — pero este
    // parser solo leía [package] y [dependencies], así que `[build] target =
    // "wasm32-wasi"` construía NATIVO sin una palabra, y `[build] main` compilaba
    // src/main.nx aunque dijera otra cosa. [package] se mantiene porque `main`
    // está documentado ahí desde siempre y `target` es donde el binario lo leía
    // de verdad. Si las dos secciones declaran la misma clave con valores
    // DISTINTOS es un error: elegir una en silencio es la misma falla muda.
    var pkg_main = ""
    var build_main = ""
    var pkg_target = ""
    var build_target = ""

    let lines: Array<String> = content.split("\n")
    var current_section = ""
    var i = 0
    while i < lines.length() {
        let line: String = lines[i]
        let trimmed: String = line.trim()

        // Skip comments and empty lines
        if trimmed == "" or trimmed.startsWith("#") {
            i = i + 1
        } else {
            // Section header [section]
            if trimmed.startsWith("[") and trimmed.endsWith("]") {
                current_section = trimmed.substring(1, trimmed.length() - 1).trim()
                i = i + 1
            } else {
                let key: String = parse_toml_key(trimmed)
                let val: String = parse_toml_value(trimmed)
                if current_section == "package" {
                    if key == "name" { config.name = val }
                    if key == "version" { config.version = val }
                    if key == "main" { pkg_main = val }
                    if key == "description" { config.description = val }
                    if key == "no_gc" and val == "true" { config.no_gc = true }
                    if key == "target" { pkg_target = val }
                }
                if current_section == "build" {
                    // Una clave desconocida en [build] es un error, no silencio:
                    // `[build] tarjet = "wasm32-wasi"` construiría nativo y
                    // saldría 0, igual que la flag mal escrita que ya se rechaza.
                    if key == "main" { build_main = val }
                    else if key == "target" { build_target = val }
                    else if config.toml_error == "" {
                        config.toml_error = "clave desconocida en [build] de nyx.toml: '" + key + "' (claves válidas: main, target)"
                    }
                }
                if current_section == "lib" {
                    // [lib] modules = ["src/a", "src/b"]: los módulos que `nyx build`
                    // compila una vez y reutiliza (arco compilacion-separada, Task 6;
                    // decisión D-3 de la spec: se declara en el manifiesto, no se le
                    // cambia el significado a `import {}`). Una sola línea: el parser
                    // de este manifiesto es de línea a línea.
                    if key == "modules" {
                        let err_lib: String = parse_lib_modules(val, config.lib_modules)
                        if err_lib != "" and config.toml_error == "" { config.toml_error = err_lib }
                    } else if config.toml_error == "" {
                        config.toml_error = "clave desconocida en [lib] de nyx.toml: '" + key + "' (clave válida: modules)"
                    }
                }
                if current_section == "dependencies" {
                    if key != "" and val != "" {
                        config.dep_names.push(key)
                        config.dep_versions.push(val)
                    }
                }
                i = i + 1
            }
        }
    }
    if pkg_main != "" and build_main != "" and pkg_main != build_main {
        if config.toml_error == "" {
            config.toml_error = "nyx.toml declara main dos veces con valores distintos: [package] main = \"" + pkg_main + "\" y [build] main = \"" + build_main + "\" (deja uno solo)"
        }
    }
    if pkg_target != "" and build_target != "" and pkg_target != build_target {
        if config.toml_error == "" {
            config.toml_error = "nyx.toml declara target dos veces con valores distintos: [package] target = \"" + pkg_target + "\" y [build] target = \"" + build_target + "\" (deja uno solo)"
        }
    }
    if build_main != "" { config.main_file = build_main }
    else if pkg_main != "" { config.main_file = pkg_main }
    // manifest_main_file se fija DESPUÉS de resolver [build]/[package], y antes
    // de que main.nx aplique un --main de esta corrida sobre config.main_file:
    // es la única copia del main que write_lockfile puede mirar.
    config.manifest_main_file = config.main_file
    if build_target != "" { config.target = build_target }
    else if pkg_target != "" { config.target = pkg_target }
    return config
}

// ===== LOCKFILE =====

fn write_lockfile(config: ProjectConfig) {
    // main del LOCK = el del manifiesto (manifest_main_file), nunca
    // config.main_file: ese último es el main EFECTIVO de esta corrida y
    // --main lo pisa sin tocar el proyecto. Confundirlos hacía que
    // `nyx build --main otro.nx` dejara nyx.lock diciendo que el punto de
    // entrada del proyecto es "otro.nx" (fricción nyxerp 2026-09-14).
    var content = "# nyx.lock — auto-generated by nyx build, do not edit\n" +
                  "[package]\n" +
                  "name = \"" + config.name + "\"\n" +
                  "version = \"" + config.version + "\"\n" +
                  "main = \"" + config.manifest_main_file + "\"\n"
    if config.dep_names.length() > 0 {
        content = content + "\n[dependencies]\n"
        var di = 0
        while di < config.dep_names.length() {
            let dname: String = config.dep_names[di]
            let dver: String = config.dep_versions[di]
            content = content + dname + " = \"" + dver + "\"\n"
            di = di + 1
        }
    }
    // Una flag de una sola corrida (--main, --target) no debe tocar nyx.lock:
    // si el contenido calculado es idéntico al que ya está en disco, no se
    // reescribe el archivo — ni siquiera la fecha/mtime. Antes se pisaba
    // siempre, así que CUALQUIER build repetía una escritura sin cambios
    // reales (ruido en git y en el filesystem).
    if file_exists("nyx.lock") {
        let existing: String = read_file("nyx.lock")
        if existing == content { return }
    }
    write_file("nyx.lock", content)
}

// Add a package dependency: fetch from registry or local path
fn run_add(pkg_name: String, pkg_url: String, config: ProjectConfig) -> bool {
    print("Adding package: " + pkg_name)

    // Default registry: https://github.com/nyxlang-dev/<pkg>
    var url = pkg_url
    if url == "" {
        url = "https://github.com/nyxlang-dev/" + pkg_name
    }

    // Check if already in nyx.toml
    if file_exists("nyx.toml") {
        let check: String = read_file("nyx.toml")
        if check.contains(pkg_name + " =") {
            print("  Package '" + pkg_name + "' is already a dependency.")
            return true
        }
    }

    // Create packages directory if needed
    let pkg_dir = "packages/" + pkg_name

    // Skip fetch if package already exists locally
    if file_exists(pkg_dir) {
        print("  Using existing: " + pkg_dir)
    } else {
        // Try git clone
        print("  Fetching: " + url)
        let result: int = git_clone(url, pkg_dir)

        if result != 0 {
            print("  error: could not fetch " + pkg_name + " from " + url)
            return false
        }
    }

    // Update nyx.toml to add dependency
    if file_exists("nyx.toml") {
        let existing: String = read_file("nyx.toml")
        var new_content = existing
        if not existing.contains("[dependencies]") {
            new_content = existing + "\n[dependencies]\n" + pkg_name + " = \"*\"\n"
        } else {
            new_content = existing + pkg_name + " = \"*\"\n"
        }
        write_file("nyx.toml", new_content)
        print("  Updated nyx.toml")
    }

    print("Package '" + pkg_name + "' added.")
    return true
}

// ===== INIT =====

// Resolución de la toolchain para SEMBRAR (F6 del informe de fricción del
// scaffold, hallazgo nuevo #3): NYX_HOME → ~/.nyx si trae templates/ → "."
// si es el monorepo (nyx_bootstrap) → "" si no hay nada. Antes el scaffold
// leía getenv a secas: con NYX_HOME vacío buscaba "/templates/AGENTS.md",
// ningún file_exists daba true y `nyx init` sembraba CERO archivos de
// contexto IA sin decir una palabra — el proyecto quedaba mudo para el
// agente y nadie se enteraba. Mismo orden que run_build/capabilities_std_dir;
// el marcador acá es templates/ porque es lo que este camino necesita.
fn resolve_seed_home() -> String {
    var nyx_home: String = getenv("NYX_HOME")
    if nyx_home != "" { return nyx_home }
    let home_dir: String = dir_usuario()
    if home_dir != "" {
        let candidate: String = home_dir + "/.nyx"
        if file_exists(candidate + "/templates") { return candidate }
    }
    if file_exists("nyx_bootstrap") { return "." }
    return ""
}

// Sello de versión de lo sembrado (F3 del informe de fricción del scaffold,
// hallazgo A2 «cero marcas»): cada archivo de contexto IA termina con
// `<!-- nyx-version: X -->`, el mismo marcador que ya lleva CAPABILITIES.md.
// Va al FINAL del archivo a propósito: la línea 1 queda intacta (títulos,
// frontmatter YAML de las skills, que debe empezar en la línea 1). El wrapper
// (`scripts/nyx`) lo compara contra $NYX_HOME/VERSION en `nyx build` y avisa
// —WARN, nunca fatal— cuando el contexto quedó de otra versión; `nyx update
// --sync-docs` lo resiembra con el sello nuevo. Antes de esto, un proyecto
// creado con 0.22 seguía guiando al agente con manuales viejos para siempre,
// sin que nadie pudiera notarlo.
// El sello lleva TAMBIÉN el idioma del proyecto desde ADR-1 (Task 5): un
// proyecto es monolingüe (`--lang en|es`) y `nyx update --sync-docs` necesita
// saber de qué juego de plantillas resembrar sin preguntar. El substring
// `nyx-version: X` no cambia de forma, así que `_warn_seed_drift` y
// `_selfheal_capabilities` del wrapper siguen funcionando sin tocarlos.
fn seed_stamp(lang: String) -> String {
    return "<!-- nyx-version: " + toolchain_version() + " nyx-lang: " + lang + " -->\n"
}

// Idioma de un proyecto ya sembrado: lee `nyx-lang: xx` del AGENTS.md de `dir`
// (el sello está en la última línea, pero se busca en todo el archivo por si
// el usuario editó abajo). Default "en" — un proyecto anterior a ADR-1 no
// tiene idioma declarado y el juego EN es el que tenía. Task 6 (migración de
// layouts viejos) lo usa; el wrapper hace la misma lectura en bash.
fn project_lang(dir: String) -> String {
    let path: String = dir + "/AGENTS.md"
    if file_exists(path) == false { return "en" }
    let body: String = read_file(path)
    let marker: String = "nyx-lang: "
    let at: int = body.indexOf(marker)
    if at < 0 { return "en" }
    let start: int = at + marker.length()
    if start + 2 > body.length() { return "en" }
    let code: String = body.substring(start, start + 2)
    if code == "es" { return "es" }
    return "en"
}

// El TEXTO exacto que seed_file escribe: `content` con salto final garantizado
// + línea en blanco + el sello. Existe aparte del write_file para poder
// comparar contra lo que ya hay en disco sin duplicar la receta (Task 7: los
// archivos GENERADOS del andamiaje se reescriben solo si cambiaron, así un
// `sdd init` repetido no toca ni una mtime).
fn seed_body(content: String, lang: String) -> String {
    var body: String = content
    let n: int = body.length()
    var needs_nl: bool = true
    if n > 0 {
        if body.substring(n - 1, n) == "\n" { needs_nl = false }
    }
    if needs_nl { body = body + "\n" }
    return body + "\n" + seed_stamp(lang)
}

// Escribe `content` en `dst` con un salto final garantizado + línea en blanco +
// el sello. Solo para archivos de texto/markdown sembrados desde templates/.
fn seed_file(dst: String, content: String, lang: String) {
    write_file(dst, seed_body(content, lang))
}

// ===== AGENTS.md: el bloque de nyx y lo que es del proyecto =====
//
// AGENTS.md lo leen los agentes PRIMERO, y los proyectos avanzados le escriben
// sus propias reglas. Hasta el 2026-09-26 `nyx update --sync-docs` lo
// resembraba entero: solo sobrevivía un bloque entre `proyecto:inicio` y
// `proyecto:fin` que el proyecto tenía que conocer y adoptar. nyxerp perdió
// así sus «Reglas de este proyecto» varias veces y las restauraba desde git.
//
// Ahora es al revés: nyx reemplaza SOLO lo que puede demostrar que escribió,
// el texto entre `<!-- nyx:inicio -->` y `<!-- nyx:fin -->`. Todo lo demás es
// del proyecto y no se toca. El contenido propio va ARRIBA del bloque: el
// agente lo lee antes y manda sobre la guía general (decisión de Ottavio).
//
// Un AGENTS.md anterior a esto (sin el bloque) se migra por secciones `## `:
// la que la plantilla actual reconoce como suya se reemplaza; cualquier otra
// se conserva textual, arriba. Ver agents_merge_legado.

fn agents_ini() -> String { return "<!-- nyx:inicio -->" }
fn agents_fin() -> String { return "<!-- nyx:fin -->" }

fn agents_cabecera(lang: String) -> String {
    if lang == "es" {
        return "<!-- Reglas de ESTE proyecto: escríbelas acá arriba, antes del bloque de nyx; mandan sobre él. `nyx update --sync-docs` solo reemplaza lo que está entre nyx:inicio y nyx:fin. -->"
    }
    return "<!-- Rules for THIS project: write them up here, above the nyx block; they override it. `nyx update --sync-docs` only replaces what sits between nyx:inicio and nyx:fin. -->"
}

// La plantilla sin los saltos finales, entre los dos marcadores.
fn agents_bloque(template: String) -> String {
    var t: String = template
    while t.endsWith("\n") {
        t = t.substring(0, t.length() - 1)
    }
    return agents_ini() + "\n" + t + "\n" + agents_fin() + "\n"
}

// AGENTS.md de un proyecto nuevo: cabecera + bloque + sello (última línea).
fn agents_seed(template: String, lang: String) -> String {
    return agents_cabecera(lang) + "\n\n" + agents_bloque(template) + "\n" + seed_stamp(lang)
}

fn agents_es_sello(linea: String) -> bool {
    return linea.trim().startsWith("<!-- nyx-version:")
}

// Índice de la primera línea que es EXACTAMENTE `marca` (sin contar espacios
// alrededor), desde `desde`; -1 si no hay. Una línea propia, no un substring:
// la plantilla CITA los marcadores dentro de oraciones para explicarlos.
fn agents_linea_idx(lineas: Array, marca: String, desde: int) -> int {
    var i: int = desde
    while i < lineas.length() {
        let l: String = lineas[i]
        if l.trim() == marca { return i }
        i = i + 1
    }
    return -1
}

// Las líneas unidas con "\n" y sin líneas vacías al final.
fn agents_unir(lineas: Array) -> String {
    var fin: int = lineas.length()
    while fin > 0 {
        let l: String = lineas[fin - 1]
        if l.trim() != "" { break }
        fin = fin - 1
    }
    var partes: Array = []
    var i: int = 0
    while i < fin {
        partes.push(lineas[i])
        i = i + 1
    }
    return partes.join("\n")
}

// El resultado de agents_merge: el texto nuevo y el informe para la persona.
struct AgentsMerge {
    texto: String,
    informe: Array
}

// AGENTS.md con el bloque: se reemplaza el interior; lo de arriba queda byte
// a byte, lo de abajo también (salvo los sellos viejos), y el sello va al final.
fn agents_merge_bloque(lineas: Array, ini: int, fin: int, template: String, lang: String) -> String {
    var antes: String = ""
    var i: int = 0
    while i < ini {
        let l: String = lineas[i]
        antes = antes + l + "\n"
        i = i + 1
    }
    var despues: Array = []
    var j: int = fin + 1
    while j < lineas.length() {
        let l: String = lineas[j]
        if agents_es_sello(l) == false { despues.push(l) }
        j = j + 1
    }
    var post: String = agents_unir(despues)
    if post.trim() != "" { post = post + "\n" }
    return antes + agents_bloque(template) + post + "\n" + seed_stamp(lang)
}

// Una sección `## ` (o el preámbulo, con encabezado "") de un AGENTS.md viejo.
struct AgentsSeccion {
    encabezado: String,
    lineas: Array
}

// Parte en preámbulo + secciones `## `. Un `##` dentro de un bloque de código
// (```) no abre sección.
fn agents_secciones(lineas: Array) -> Array {
    var out: Array = []
    var actual: AgentsSeccion = AgentsSeccion { encabezado: "", lineas: [] }
    var en_codigo: bool = false
    var i: int = 0
    while i < lineas.length() {
        let l: String = lineas[i]
        if l.trim().startsWith("```") {
            en_codigo = !en_codigo
        }
        if en_codigo == false and l.startsWith("## ") {
            out.push(actual)
            var nuevas: Array = []
            nuevas.push(l)
            actual = AgentsSeccion { encabezado: l.trim(), lineas: nuevas }
        } else {
            actual.lineas.push(l)
        }
        i = i + 1
    }
    out.push(actual)
    return out
}

// AGENTS.md sin el bloque (anterior al 2026-09-26). Primero salen como del
// proyecto los bloques `proyecto:inicio`…`proyecto:fin` (la protección vieja)
// y el disparador `<!-- sdd:trigger -->` de `nyx sdd init`. Después, por
// sección: es de nyx si la plantilla actual tiene ese encabezado, si trae un
// bloque generado (`<!-- gen:`), o si al menos el 60 % de sus líneas están en
// la plantilla (un encabezado que cambió de nombre entre versiones). El
// preámbulo es de nyx. Lo demás es del proyecto y se conserva textual, en su
// orden, ARRIBA del bloque nuevo. Ante la duda se CONSERVA: una sección de
// más se borra a mano; una de menos era trabajo perdido.
fn agents_merge_legado(lineas: Array, template: String, lang: String) -> AgentsMerge {
    var informe: Array = []
    var propio: Array = []
    var resto: Array = []
    var i: int = 0
    while i < lineas.length() {
        let l: String = lineas[i]
        let t: String = l.trim()
        if t == "<!-- proyecto:inicio -->" {
            let f: int = agents_linea_idx(lineas, "<!-- proyecto:fin -->", i + 1)
            if f >= 0 {
                var blk: Array = []
                var k: int = i
                while k <= f {
                    blk.push(lineas[k])
                    k = k + 1
                }
                propio.push(agents_unir(blk))
                informe.push("se conservó el bloque proyecto:inicio … proyecto:fin")
                i = f + 1
                continue
            }
        }
        if t == "<!-- sdd:trigger -->" {
            var blk2: Array = []
            blk2.push(l)
            var k2: int = i + 1
            while k2 < lineas.length() {
                let l2: String = lineas[k2]
                if l2.trim() == "" or agents_es_sello(l2) { break }
                blk2.push(l2)
                k2 = k2 + 1
            }
            propio.push(agents_unir(blk2))
            informe.push("se conservó el disparador de nyx sdd (sdd:trigger)")
            i = k2
            continue
        }
        if agents_es_sello(l) == false { resto.push(l) }
        i = i + 1
    }

    // Lo que la plantilla actual trae: encabezados y líneas.
    let tlineas: Array = template.split("\n")
    var t_enc: Map = Map.new()
    var t_lin: Map = Map.new()
    let tsecs: Array = agents_secciones(tlineas)
    var ti: int = 0
    while ti < tsecs.length() {
        let ts: AgentsSeccion = tsecs[ti]
        if ts.encabezado != "" { t_enc.insert(ts.encabezado, 1) }
        ti = ti + 1
    }
    var tl: int = 0
    while tl < tlineas.length() {
        let x: String = tlineas[tl]
        let xt: String = x.trim()
        if xt != "" { t_lin.insert(xt, 1) }
        tl = tl + 1
    }

    let secs: Array = agents_secciones(resto)
    var si: int = 0
    while si < secs.length() {
        let sec: AgentsSeccion = secs[si]
        var total: int = 0
        var en_plantilla: int = 0
        var con_gen: bool = false
        var li: int = 0
        while li < sec.lineas.length() {
            let x: String = sec.lineas[li]
            let xt: String = x.trim()
            if xt.startsWith("<!-- gen:") { con_gen = true }
            if xt != "" and xt != sec.encabezado {
                total = total + 1
                if t_lin.contains(xt) { en_plantilla = en_plantilla + 1 }
            }
            li = li + 1
        }
        var de_nyx: bool = false
        if sec.encabezado == "" { de_nyx = true }
        if t_enc.contains(sec.encabezado) { de_nyx = true }
        if con_gen { de_nyx = true }
        if total > 0 and en_plantilla * 10 >= total * 6 { de_nyx = true }
        if de_nyx {
            let fuera: int = total - en_plantilla
            if fuera > 0 and sec.encabezado != "" {
                informe.push("«" + sec.encabezado + "» se reemplazó por la plantilla; " + int_to_string(fuera) + " línea(s) suya(s) no están en la plantilla nueva (texto viejo de nyx o ediciones tuyas): quedaron en el .bak")
            }
            if fuera > 0 and sec.encabezado == "" {
                informe.push("la introducción se reemplazó por la plantilla; " + int_to_string(fuera) + " línea(s) no están en la plantilla nueva: quedaron en el .bak")
            }
        } else {
            let txt: String = agents_unir(sec.lineas)
            if txt.trim() != "" {
                propio.push(txt)
                informe.push("se conservó «" + sec.encabezado + "» (no es de la plantilla)")
            }
        }
        si = si + 1
    }

    var texto: String = agents_cabecera(lang) + "\n\n"
    var pi: int = 0
    while pi < propio.length() {
        let pt: String = propio[pi]
        texto = texto + pt + "\n\n"
        pi = pi + 1
    }
    texto = texto + agents_bloque(template) + "\n" + seed_stamp(lang)
    return AgentsMerge { texto: texto, informe: informe }
}

// El AGENTS.md que tiene que quedar, dado el que hay (`existente`, "" si no hay).
fn agents_merge(existente: String, template: String, lang: String) -> AgentsMerge {
    var vacio: Array = []
    if existente.trim() == "" {
        return AgentsMerge { texto: agents_seed(template, lang), informe: vacio }
    }
    let lineas: Array = existente.split("\n")
    let ini: int = agents_linea_idx(lineas, agents_ini(), 0)
    if ini >= 0 {
        let fin: int = agents_linea_idx(lineas, agents_fin(), ini + 1)
        if fin >= 0 {
            return AgentsMerge { texto: agents_merge_bloque(lineas, ini, fin, template, lang), informe: vacio }
        }
    }
    return agents_merge_legado(lineas, template, lang)
}

// `nyx_build agents-merge <AGENTS.md> <plantilla> <lang> <salida>`: escribe en
// <salida> el AGENTS.md que tiene que quedar e imprime el informe. No toca el
// AGENTS.md: comparar, respaldar (.bak) y reemplazar lo hace el wrapper
// (`nyx update --sync-docs`), con el mismo _safe_backup del resto del sync.
fn run_agents_merge(dst: String, tpl: String, lang: String, salida: String) -> bool {
    if file_exists(tpl) == false {
        print("error: no existe la plantilla " + tpl)
        return false
    }
    var existente: String = ""
    if file_exists(dst) { existente = read_file(dst) }
    let m: AgentsMerge = agents_merge(existente, read_file(tpl), lang)
    write_file(salida, m.texto)
    var i: int = 0
    while i < m.informe.length() {
        let linea: String = m.informe[i]
        print("  → AGENTS.md: " + linea)
        i = i + 1
    }
    return true
}

// .gitignore (F4 del informe de fricción del scaffold, hallazgo A1): nyx init
// no dejaba ninguno y el primer `git add .` se llevaba el binario, packages/ y
// los .ll. Plantilla en templates/gitignore ({{binary}} = [package].name).
// Nunca pisa uno existente (init sobre un dir que ya tiene .gitignore lo
// respeta). `git init` NO se corre: es decisión del usuario (el informe lo
// marcó opcional y sin pedido explícito no se implementa).
fn seed_gitignore(dir: String, project_name: String) {
    let nyx_home: String = resolve_seed_home()
    if nyx_home == "" { return }
    let tpl: String = nyx_home + "/templates/gitignore"
    if file_exists(tpl) == false { return }
    if file_exists(dir + "/.gitignore") { return }
    let body: String = read_file(tpl)
    write_file(dir + "/.gitignore", body.replace("{{binary}}", project_name))
}

// Valida la lista de `--agent=`: coma-separada, valores `claude|cursor|copilot`.
// Cualquier otra cosa es un error RUIDOSO con exit 1 — un `--agent=cursorr`
// que sembrara nada en silencio sería justo la clase de falla muda que este
// repo persigue.
fn validate_agents(agents: String) -> bool {
    if agents == "" { return true }
    let parts: Array = agents.split(",")
    var i: int = 0
    while i < parts.length() {
        let raw: String = parts[i]
        let name: String = raw.trim()
        if name != "claude" and name != "cursor" and name != "copilot" {
            print("error: --agent inválido: '" + name + "' (valores válidos: claude, cursor, copilot)")
            print("  Uso: nyx init [nombre] [--lang en|es] [--agent=claude,cursor,copilot]")
            return false
        }
        i = i + 1
    }
    return true
}

// Adaptadores por proveedor (ADR-1): archivos de 3 líneas que solo dicen
// «lee AGENTS.md» y «las guías están en docs/nyx/guides/». Se siembran SOLO
// con `--agent=<lista>`; sin la bandera el proyecto no tiene una sola marca
// comercial adentro (guardia: run_init_golden.sh). Para claude, únicamente
// CLAUDE.md — nada bajo .claude/ (las ex-skills son las guías neutrales).
// `agents` ya viene validado por validate_agents() en main.
fn seed_adapters(dir: String, lang: String, agents: String) {
    if agents == "" { return }
    let nyx_home: String = resolve_seed_home()
    if nyx_home == "" { return }
    let adir: String = nyx_home + "/templates/adapters"
    let parts: Array = agents.split(",")
    var i: int = 0
    while i < parts.length() {
        let raw: String = parts[i]
        let name: String = raw.trim()
        if name != "" {
            let tpl: String = adir + "/" + name + "." + lang + ".md"
            if file_exists(tpl) {
                let body: String = read_file(tpl)
                if name == "claude" {
                    seed_file(dir + "/CLAUDE.md", body, lang)
                }
                if name == "cursor" {
                    seed_file(dir + "/.cursorrules", body, lang)
                }
                if name == "copilot" {
                    mkdir_p(dir + "/.github")
                    seed_file(dir + "/.github/copilot-instructions.md", body, lang)
                }
            } else {
                print("warning: falta la plantilla del adaptador '" + name + "' (" + tpl + ") — no se sembró")
            }
        }
        i = i + 1
    }
}

// Siembra el contexto para agentes de un proyecto, en UN idioma (ADR-1):
// AGENTS.md + CAPABILITIES.md (generado) + docs/nyx/{LLM.md,guides/*.md}, y
// los adaptadores opt-in. Un solo camino de código para los dos idiomas: lo
// único que cambia es `templates/<lang>/`. LLM.md sale SIEMPRE de
// `templates/en/` (la referencia densa es monolingüe por decisión: traducir
// 84 KB queda fuera de alcance, y el AGENTS.md ES lo aclara).
fn scaffold_project_files(dir: String, lang: String, agents: String) {
    let nyx_home: String = resolve_seed_home()
    let tpl: String = nyx_home + "/templates"
    let ldir: String = tpl + "/" + lang
    // Error RUIDOSO (no fatal: nyx.toml y src/main.nx ya están, el proyecto
    // compila). Antes: silencio total y cero archivos sembrados.
    var tpl_ok: bool = false
    if nyx_home != "" {
        if file_exists(ldir + "/AGENTS.md") { tpl_ok = true }
    }
    if tpl_ok == false {
        print("error: no encuentro la toolchain de Nyx (NYX_HOME vacío o sin templates/" + lang + "/): el contexto para agentes (AGENTS.md, CAPABILITIES.md, docs/nyx/) NO se sembró.")
        print("  Exporta NYX_HOME (o reinstala con install.sh) y ejecuta: nyx update --sync-docs")
        return
    }

    // AGENTS.md — el playbook PRIMARIO que el agente lee primero (rieles + qué/cómo).
    // Con el bloque de nyx desde el 2026-09-26: lo que el proyecto escriba
    // arriba sobrevive a `nyx update --sync-docs` (ver agents_merge).
    let agents_md: String = read_file(ldir + "/AGENTS.md")
    write_file(dir + "/AGENTS.md", agents_seed(agents_md, lang))

    // CAPABILITIES.md — índice generado de la stdlib (qué existe, no reinventar).
    let cok: bool = run_capabilities(dir + "/CAPABILITIES.md")

    // docs/nyx/ — la referencia densa + las tres guías neutrales.
    mkdir_p(dir + "/docs/nyx/guides")
    let llm_tpl: String = tpl + "/en/docs/nyx/LLM.md"
    if file_exists(llm_tpl) {
        let llm_md: String = read_file(llm_tpl)
        seed_file(dir + "/docs/nyx/LLM.md", llm_md, lang)
    } else {
        // Misma familia que el error de tpl_ok, y por el mismo motivo: la
        // referencia densa la inyectan los instaladores (install.sh /
        // install-local) en templates/en/docs/nyx/. Si falta, el proyecto sale
        // con 8 de 9 archivos y el agente no tiene dónde mirar la forma de las
        // cosas. No es fatal (el resto ya se sembró), pero se dice en voz alta.
        print("error: falta " + llm_tpl + " en la toolchain: docs/nyx/LLM.md (la referencia densa) NO se sembró.")
        print("  Reinstala con install.sh (o ejecuta make install-local desde el monorepo) y después: nyx update --sync-docs")
    }
    let gdir: String = ldir + "/docs/nyx/guides"
    if file_exists(gdir) {
        let guides: Array = readdir(gdir)
        var gi: int = 0
        while gi < guides.length() {
            let guide: String = guides[gi]
            let src: String = gdir + "/" + guide
            if file_exists(src) {
                let guide_body: String = read_file(src)
                seed_file(dir + "/docs/nyx/guides/" + guide, guide_body, lang)
            }
            gi = gi + 1
        }
    }

    seed_adapters(dir, lang, agents)
    // (La recomendación de extensión VS Code — .vscode/extensions.json — murió
    // el 2026-09-03: apuntaba a `nyxlang.nyx-language`, que no existe en el
    // marketplace, y la plantilla estaba gitignored. Ficha en TASKS.md para
    // resembrarla cuando haya una extensión publicada.)
}

// ============================================================
// ANDAMIAJE SDD OPCIONAL (spec 2026-09-04-andamiaje-sdd-design.md §3)
// ============================================================
// `nyx init --sdd` (proyecto nuevo) y `nyx sdd init` (proyecto que ya existe)
// siembran las 7 piezas que preparan al agente para DECIDIR, no solo para
// escribir: constitución (con el marcador SDD_INCOMPLETE), glosario, evidencia
// GENERADA de la tabla de gotchas, plantilla de ADR, specs/README.md, el test
// de constitución GENERADO y la guía de arranque. Más 2 líneas en AGENTS.md
// que las disparan. Reglas de la constitución de la feature, todas con
// guardia en scripts/testing/run_sdd_init.sh:
//   · `nyx init` SIN la bandera no cambia en nada (listado dorado intacto).
//   · Idempotente: lo que ya tiene contenido se saltea y se avisa; lo GENERADO
//     se reescribe solo si su texto cambió (una segunda corrida no toca nada).
//   · No rellena: las plantillas nacen vacías, el agente pregunta.
//   · Toca UN solo archivo existente: AGENTS.md (bloque `<!-- sdd:trigger -->`).
//   · Reversible: al terminar imprime qué borrar para volver a un init normal.
//   · Neutral: ni un nombre de proveedor de IA en nada de lo sembrado.

// La cabecera que marca una pieza GENERADA como NUESTRA. Es UNA sola cadena
// para los dos archivos generados (evidencia y test de constitución) a
// propósito: el chequeo de propiedad tiene que ser el mismo en los dos, y un
// archivo del usuario que apenas mencione «GENERATED» no puede confundirse con
// uno nuestro (hallazgo del review de la Task 7).
fn sdd_generated_marker() -> String {
    return "GENERATED by `nyx sdd init`"
}

// Mensaje en el idioma del PROYECTO (el mismo que gobierna las plantillas).
fn sdd_msg(lang: String, en: String, es: String) -> String {
    if lang == "es" { return es }
    return en
}

// Copia una plantilla del andamiaje a su destino. Nunca pisa: si el destino ya
// existe se saltea Y SE DICE (regla 3: idempotente y ruidoso, no silencioso).
fn sdd_seed_template(tpl_dir: String, name: String, dst: String, lang: String) -> bool {
    if file_exists(dst) {
        print(sdd_msg(lang, "  skipped (already there): " + dst,
                            "  salteado (ya existe): " + dst))
        return false
    }
    let src: String = tpl_dir + "/" + name
    if file_exists(src) == false {
        print("error: falta la plantilla " + src + " en la toolchain: " + dst + " NO se sembró.")
        return false
    }
    let body: String = read_file(src)
    seed_file(dst, body, lang)
    print("  " + dst)
    return true
}

// Escapa una cadena para meterla en un literal de Nyx (la tabla de gotchas
// trae regex con `\(` y títulos con comillas: sin esto el .nx generado no
// parsea).
fn nx_escape(s: String) -> String {
    var out: String = ""
    var i: int = 0
    while i < s.length() {
        let c: String = s.substring(i, i + 1)
        if c == "\\" {
            out = out + "\\\\"
        } else {
            if c == "\"" {
                out = out + "\\\""
            } else {
                out = out + c
            }
        }
        i = i + 1
    }
    return out
}

// Cuerpo de `docs/evidence/nyx-<ver>.md`: las trampas y reglas VIVAS de la
// toolchain instalada (una línea por gotcha, con id, ancla y el test que la
// prueba) + los retirados. Sale de gotchas_table(), la misma fuente que
// AGENTS.md, LLM.md y `nyx vet` — nadie mantiene esta lista a mano.
fn evidence_body(lang: String) -> String {
    let ver: String = toolchain_version()
    var out: String = ""
    out = out + sdd_msg(lang, "# Evidence — nyx " + ver + "\n", "# Evidencia — nyx " + ver + "\n")
    out = out + "\n<!-- " + sdd_generated_marker() + " from the gotcha table of the installed toolchain — do not edit by hand; `nyx update` regenerates it. -->\n\n"
    out = out + sdd_msg(lang,
        "Traps and rules that are LIVE in the toolchain this project was seeded with. Each\nline carries the stable id, the anchor term to look up in `AGENTS.md` and\n`docs/nyx/LLM.md`, and the test in the language repo that proves it. This file is\nevidence, not advice: if a line here contradicts a manual, the manual is stale.\n",
        "Trampas y reglas VIVAS en la toolchain con la que se sembró este proyecto. Cada\nlínea trae el id estable, el término ancla para buscar en `AGENTS.md` y en\n`docs/nyx/LLM.md`, y el test del repo del lenguaje que la prueba. Este archivo es\nevidencia, no consejo: si una línea de acá contradice a un manual, el manual quedó viejo.\n")
    out = out + "\n"

    let rows: Array = gotchas_table()
    var i: int = 0
    while i < rows.length() {
        let row: Array = rows[i]
        let kind: String = gotcha_field(row, "kind")
        let fixed_in: String = gotcha_field(row, "fixed_in")
        if fixed_in == "" {
            if kind == "trap" or kind == "rule" {
                let id: String = gotcha_field(row, "id")
                let since: String = gotcha_field(row, "since")
                let anchor: String = gotcha_field(row, "anchor")
                let test_path: String = gotcha_field(row, "test")
                var title: String = gotcha_field(row, "title_en")
                if lang == "es" { title = gotcha_field(row, "title_es") }
                out = out + "- **" + id + "** (" + kind + ", since " + since + ") — " + title
                if anchor != "" { out = out + " — anchor `" + anchor + "`" }
                if test_path != "" { out = out + " — test `" + test_path + "`" }
                out = out + "\n"
            }
        }
        i = i + 1
    }

    out = out + sdd_msg(lang, "\n## Retired\n\n", "\n## Retirados\n\n")
    out = out + sdd_msg(lang,
        "These were real traps and are not any more: if a manual, a blog post or an older\nagent still repeats them, it is wrong for this version.\n\n",
        "Estas fueron trampas reales y ya no lo son: si un manual, un artículo o un agente\nviejo las sigue repitiendo, está equivocado para esta versión.\n\n")
    var j: int = 0
    while j < rows.length() {
        let row2: Array = rows[j]
        let fixed2: String = gotcha_field(row2, "fixed_in")
        if fixed2 != "" {
            let id2: String = gotcha_field(row2, "id")
            var title2: String = gotcha_field(row2, "title_en")
            if lang == "es" { title2 = gotcha_field(row2, "title_es") }
            out = out + "- **" + id2 + "** (fixed in " + fixed2 + ") — " + title2 + "\n"
        }
        j = j + 1
    }
    return out
}

// Escribe la evidencia. Es un archivo GENERADO: se regenera en su lugar, pero
// SOLO si el texto cambió (idempotencia) y nunca si el que está en disco no
// lleva la cabecera GENERATED (entonces lo escribió el usuario). 0 = sin
// cambios, 1 = escrito, 2 = salteado porque es del usuario.
fn write_evidence(dir: String, lang: String) -> int {
    let path: String = dir + "/docs/evidence/nyx-" + toolchain_version() + ".md"
    let body: String = seed_body(evidence_body(lang), lang)
    if file_exists(path) {
        let existing: String = read_file(path)
        if existing == body { return 0 }
        if existing.indexOf(sdd_generated_marker()) < 0 { return 2 }
    }
    write_file(path, body)
    return 1
}

// Cuerpo de `tests/constitution_test.nx`: un bloque `test` por gotcha con
// `pattern` (los grep-ables de la tabla, hoy 5) que falla con archivo:línea, y
// un test que caza archivos en tests/ sin bloques `test` (que `nyx test`
// saltearía en silencio). El código va en inglés a propósito: es código, y los
// ids/mensajes son los mismos en los dos juegos de plantillas.
fn constitution_test_body() -> String {
    var out: String = ""
    out = out + "// " + sdd_generated_marker() + " from the installed toolchain's gotcha table — regenerate with `nyx update`.\n"
    out = out + "// Edit it and it becomes yours: with this header gone, `nyx sdd init` never touches it again.\n"
    out = out + "// Each block greps src/ for a trap the compiler cannot catch for you.\n"
    out = out + "import \"std/regex\"\n"
    out = out + "\n"
    // El recorte de comentarios y strings, inyectado como CÓDIGO: el test tiene
    // que ser autónomo (sólo importa std), así que no puede importar la tabla.
    // El fuente sale de gotcha_scan_src(), la misma plantilla que genera la
    // función que usa `nyx vet` — no hay dos copias que puedan divergir.
    out = out + gotcha_scan_src()
    out = out + "\n"
    out = out + "// `nyx test` compiles and runs every test INSIDE the toolchain (cwd = NYX_HOME),\n"
    out = out + "// not inside the project: a bare readdir(\"src\") would read the wrong directory and\n"
    out = out + "// this file would pass without looking at anything. The project directory is the\n"
    out = out + "// one the runner came from (OLDPWD). If it cannot be found, the first test below\n"
    out = out + "// FAILS out loud instead of passing on an empty scan.\n"
    out = out + "fn project_root() -> String {\n"
    out = out + "    if file_exists(\"nyx.toml\") { return \".\" }\n"
    out = out + "    let old: String = getenv(\"OLDPWD\")\n"
    out = out + "    if old != \"\" {\n"
    out = out + "        if file_exists(old + \"/nyx.toml\") { return old }\n"
    out = out + "    }\n"
    out = out + "    return \"\"\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "// Every .nx under `dir`, recursively. readdir() never returns \".\" or \"..\"; a\n"
    out = out + "// directory is told apart by file_exists(path + \"/.\").\n"
    out = out + "fn nx_files(dir: String) -> Array {\n"
    out = out + "    var out: Array = []\n"
    out = out + "    if file_exists(dir) == false { return out }\n"
    out = out + "    let entries: Array = readdir(dir)\n"
    out = out + "    var i: int = 0\n"
    out = out + "    while i < entries.length() {\n"
    out = out + "        let e: String = entries[i]\n"
    out = out + "        let p: String = dir + \"/\" + e\n"
    out = out + "        if e.endsWith(\".nx\") {\n"
    out = out + "            out.push(p)\n"
    out = out + "        } else {\n"
    out = out + "            if file_exists(p + \"/.\") {\n"
    out = out + "                let sub: Array = nx_files(p)\n"
    out = out + "                var j: int = 0\n"
    out = out + "                while j < sub.length() {\n"
    out = out + "                    let s: String = sub[j]\n"
    out = out + "                    out.push(s)\n"
    out = out + "                    j = j + 1\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "        i = i + 1\n"
    out = out + "    }\n"
    out = out + "    return out\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "// Lines of src/ matching `pattern`, as `src/file.nx:LINE` (relative to the\n"
    out = out + "// project, so the message is a path you can open).\n"
    out = out + "fn grep_sources(pattern: String) -> Array {\n"
    out = out + "    var hits: Array = []\n"
    out = out + "    let root: String = project_root()\n"
    out = out + "    if root == \"\" { return hits }\n"
    out = out + "    let files: Array = nx_files(root + \"/src\")\n"
    out = out + "    var f: int = 0\n"
    out = out + "    while f < files.length() {\n"
    out = out + "        let path: String = files[f]\n"
    out = out + "        var shown: String = path\n"
    out = out + "        if path.startsWith(root + \"/\") { shown = path.substring(root.length() + 1, path.length()) }\n"
    out = out + "        let lines: Array = read_file(path).split(\"\\n\")\n"
    out = out + "        var i: int = 0\n"
    out = out + "        while i < lines.length() {\n"
    out = out + "            let line: String = lines[i]\n"
    out = out + "            let scanned: String = gotcha_scan_line(line)\n"
    out = out + "            if regex_is_match(scanned, pattern) { hits.push(shown + \":\" + int_to_string(i + 1)) }\n"
    out = out + "            i = i + 1\n"
    out = out + "        }\n"
    out = out + "        f = f + 1\n"
    out = out + "    }\n"
    out = out + "    return hits\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "test \"the project sources are visible from here\" {\n"
    out = out + "    let root: String = project_root()\n"
    out = out + "    assert(root != \"\", \"cannot find the project root (no nyx.toml): every check below would pass without scanning anything\")\n"
    out = out + "    assert(file_exists(root + \"/src\"), \"no src/ in the project root: nothing to check\")\n"
    out = out + "}\n"

    let rows: Array = gotchas_table()
    var i: int = 0
    while i < rows.length() {
        let row: Array = rows[i]
        let pattern: String = gotcha_field(row, "pattern")
        if pattern != "" {
            let id: String = gotcha_field(row, "id")
            let title: String = gotcha_field(row, "title_en")
            let code: String = gotcha_field(row, "vet_code")
            out = out + "\n"
            out = out + "test \"gotcha " + id + ": " + nx_escape(title) + "\" {\n"
            out = out + "    let hits: Array = grep_sources(\"" + nx_escape(pattern) + "\")\n"
            out = out + "    assert(hits.length() == 0, \"" + id + " (" + code + ") at: \" + hits.join(\", \"))\n"
            out = out + "}\n"
        }
        i = i + 1
    }

    out = out + "\n"
    out = out + "test \"every file in tests/ has test blocks\" {\n"
    out = out + "    let root: String = project_root()\n"
    out = out + "    let files: Array = nx_files(root + \"/tests\")\n"
    out = out + "    var i: int = 0\n"
    out = out + "    while i < files.length() {\n"
    out = out + "        let p: String = files[i]\n"
    out = out + "        assert(read_file(p).indexOf(\"test \\\"\") >= 0, p + \" has no test blocks: nyx test would skip it silently\")\n"
    out = out + "        i = i + 1\n"
    out = out + "    }\n"
    out = out + "}\n"
    return out
}

// Escribe el test de constitución. GENERADO igual que la evidencia: se
// regenera en su lugar solo si cambió, y jamás si el archivo en disco perdió
// la cabecera GENERATED (ahí es del usuario). 0 = sin cambios, 1 = escrito,
// 2 = salteado porque es del usuario.
fn write_constitution_test(dir: String) -> int {
    let path: String = dir + "/tests/constitution_test.nx"
    let body: String = constitution_test_body()
    if file_exists(path) {
        let existing: String = read_file(path)
        if existing == body { return 0 }
        if existing.indexOf(sdd_generated_marker()) < 0 { return 2 }
    }
    write_file(path, body)
    return 1
}

// Las 2 líneas del disparador en AGENTS.md — el ÚNICO archivo existente que
// toca el andamiaje. Idempotente por el marcador `<!-- sdd:trigger -->`, y el
// bloque va JUSTO ANTES del sello `<!-- nyx-version: ... -->`, que tiene que
// seguir siendo la última línea (lo exige run_silent_failure_checks.sh y lo lee
// el wrapper para avisar de la deriva).
fn add_agents_triggers(dir: String, lang: String) -> bool {
    let path: String = dir + "/AGENTS.md"
    if file_exists(path) == false {
        print("warning: no hay AGENTS.md en " + dir + ": el disparador del andamiaje NO se insertó (ejecuta `nyx update --sync-docs`)")
        return false
    }
    let body: String = read_file(path)
    if body.indexOf("<!-- sdd:trigger -->") >= 0 {
        print(sdd_msg(lang, "  skipped (already there): AGENTS.md (trigger)",
                            "  salteado (ya existe): AGENTS.md (disparador)"))
        return false
    }
    var block: String = "<!-- sdd:trigger -->\n"
    if lang == "es" {
        block = block + "- Si `docs/constitution.md` todavía contiene `SDD_INCOMPLETE`, no escribas código: sigue `docs/sdd/onboarding.md` y ofrece al usuario completarla.\n"
        block = block + "- Ante una funcionalidad nueva sin `specs/NNN-feature/spec.md`, ofrece escribir la spec primero (ver `specs/README.md`).\n"
    } else {
        block = block + "- If `docs/constitution.md` still contains `SDD_INCOMPLETE`, do not write code yet: follow `docs/sdd/onboarding.md` and offer the user to complete it.\n"
        block = block + "- For a new feature with no `specs/NNN-feature/spec.md`, offer to write the spec first (see `specs/README.md`).\n"
    }
    // Con el bloque de nyx, el disparador va ARRIBA de él (zona del proyecto):
    // adentro, el próximo `nyx update --sync-docs` lo borraría.
    let bi: int = body.indexOf("\n" + agents_ini() + "\n")
    if bi >= 0 {
        write_file(path, body.substring(0, bi + 1) + block + "\n" + body.substring(bi + 1, body.length()))
        print(sdd_msg(lang, "  AGENTS.md (+2 lines: the trigger)",
                            "  AGENTS.md (+2 líneas: el disparador)"))
        return true
    }
    let marker: String = "<!-- nyx-version: "
    let at: int = body.indexOf(marker)
    if at < 0 {
        write_file(path, body + "\n" + block)
    } else {
        write_file(path, body.substring(0, at) + block + "\n" + body.substring(at, body.length()))
    }
    print(sdd_msg(lang, "  AGENTS.md (+2 lines: the trigger)",
                        "  AGENTS.md (+2 líneas: el disparador)"))
    return true
}

// Regenera lo GENERADO (evidencia + test de constitución) contra la toolchain
// instalada. Es lo que corre `nyx update` en un proyecto con andamiaje: si un
// gotcha se arregló, la evidencia lo manda a «Retirados» y el test deja de
// buscarlo. No siembra ni pisa ninguna de las 5 plantillas.
fn run_sdd_evidence(dir: String, lang: String) -> bool {
    mkdir_p(dir + "/docs/evidence")
    let ev: int = write_evidence(dir, lang)
    if ev == 2 {
        print(sdd_msg(lang, "  skipped (yours, no GENERATED header): docs/evidence/nyx-" + toolchain_version() + ".md",
                            "  salteado (es tuyo, sin cabecera GENERATED): docs/evidence/nyx-" + toolchain_version() + ".md"))
    }
    if ev == 1 {
        print(sdd_msg(lang, "  regenerated: docs/evidence/nyx-" + toolchain_version() + ".md",
                            "  regenerado: docs/evidence/nyx-" + toolchain_version() + ".md"))
    }
    // Nada que hacer también se DICE: un comando mudo deja al usuario sin saber
    // si corrió o si falló en silencio.
    if ev == 0 {
        print(sdd_msg(lang, "  already up to date: docs/evidence/nyx-" + toolchain_version() + ".md",
                            "  ya está al día: docs/evidence/nyx-" + toolchain_version() + ".md"))
    }
    if file_exists(dir + "/tests/constitution_test.nx") {
        let ct: int = write_constitution_test(dir)
        if ct == 1 {
            print(sdd_msg(lang, "  regenerated: tests/constitution_test.nx",
                                "  regenerado: tests/constitution_test.nx"))
        }
        if ct == 2 {
            print(sdd_msg(lang, "  skipped (yours, no GENERATED header): tests/constitution_test.nx",
                                "  salteado (es tuyo, sin cabecera GENERATED): tests/constitution_test.nx"))
        }
        if ct == 0 {
            print(sdd_msg(lang, "  already up to date: tests/constitution_test.nx",
                                "  ya está al día: tests/constitution_test.nx"))
        }
    }
    return true
}

// El comando: siembra las 7 piezas + el disparador. `dir` es la raíz del
// proyecto ("." para `nyx sdd init`), `lang` su idioma (el del sello).
fn run_sdd_init(dir: String, lang: String) -> bool {
    let nyx_home: String = resolve_seed_home()
    let tdir: String = nyx_home + "/templates/" + lang + "/sdd"
    if nyx_home == "" or file_exists(tdir + "/constitution.md") == false {
        print(sdd_msg(lang,
            "error: the SDD scaffolding templates (templates/" + lang + "/sdd/) are missing from the toolchain: NOTHING was seeded.",
            "error: no encuentro las plantillas del andamiaje (templates/" + lang + "/sdd/) en la toolchain: NO se sembró nada."))
        print(sdd_msg(lang,
            "  Reinstall with install.sh (or run `make install-local` from the monorepo) and try again: nyx sdd init",
            "  Reinstala con install.sh (o corre `make install-local` desde el monorepo) e intenta de nuevo: nyx sdd init"))
        return false
    }
    mkdir_p(dir + "/docs/adr")
    mkdir_p(dir + "/docs/sdd")
    mkdir_p(dir + "/docs/evidence")
    mkdir_p(dir + "/specs")
    mkdir_p(dir + "/tests")

    print(sdd_msg(lang, "SDD scaffolding (optional, reversible):",
                        "Andamiaje SDD (opcional, reversible):"))
    sdd_seed_template(tdir, "constitution.md", dir + "/docs/constitution.md", lang)
    sdd_seed_template(tdir, "glossary.md", dir + "/docs/glossary.md", lang)
    sdd_seed_template(tdir, "adr-template.md", dir + "/docs/adr/0000-template.md", lang)
    sdd_seed_template(tdir, "specs-README.md", dir + "/specs/README.md", lang)
    sdd_seed_template(tdir, "onboarding.md", dir + "/docs/sdd/onboarding.md", lang)

    let ev: int = write_evidence(dir, lang)
    let ev_path: String = dir + "/docs/evidence/nyx-" + toolchain_version() + ".md"
    if ev == 1 { print("  " + ev_path + sdd_msg(lang, " (generated)", " (generado)")) }
    if ev == 2 {
        print(sdd_msg(lang, "  skipped (yours, no GENERATED header): " + ev_path,
                            "  salteado (es tuyo, sin cabecera GENERATED): " + ev_path))
    }
    // Una segunda corrida no reescribe nada, pero tampoco se queda muda: sin
    // esta línea el usuario no sabe si la evidencia sigue al día o si el
    // comando ni la miró.
    if ev == 0 {
        print(sdd_msg(lang, "  already up to date: " + ev_path,
                            "  ya está al día: " + ev_path))
    }
    let ct: int = write_constitution_test(dir)
    let ct_path: String = dir + "/tests/constitution_test.nx"
    if ct == 1 { print("  " + ct_path + sdd_msg(lang, " (generated)", " (generado)")) }
    if ct == 2 {
        print(sdd_msg(lang, "  skipped (yours, no GENERATED header): " + ct_path,
                            "  salteado (es tuyo, sin cabecera GENERATED): " + ct_path))
    }
    if ct == 0 {
        print(sdd_msg(lang, "  already up to date: " + ct_path,
                            "  ya está al día: " + ct_path))
    }

    add_agents_triggers(dir, lang)

    print("")
    print(sdd_msg(lang,
        "  Next: an agent reading AGENTS.md will offer to complete docs/constitution.md (7 questions).",
        "  Ahora: un agente que lea AGENTS.md va a ofrecerte completar docs/constitution.md (7 preguntas)."))
    print(sdd_msg(lang,
        "  Reversible: to go back to a plain init, delete docs/constitution.md, docs/glossary.md,",
        "  Reversible: para volver a un init normal, borra docs/constitution.md, docs/glossary.md,"))
    print(sdd_msg(lang,
        "  docs/evidence/, docs/adr/, docs/sdd/, specs/ and tests/constitution_test.nx",
        "  docs/evidence/, docs/adr/, docs/sdd/, specs/ y tests/constitution_test.nx"))
    return true
}

fn run_init(name_arg: String, lang: String, agents: String) -> bool {
    var project_name: String = name_arg

    // If a name was given, create the directory
    if project_name != "" {
        if file_exists(project_name) {
            print("error: directory '" + project_name + "' already exists")
            return false
        }
        mkdir_p(project_name + "/src")

        let content: String = "[package]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\nmain = \"src/main.nx\"\n\n[dependencies]\n"
        write_file(project_name + "/nyx.toml", content)
        write_file(project_name + "/src/main.nx", "fn main() {\n    print(\"Hello from " + project_name + "!\")\n}\n")

        scaffold_project_files(project_name, lang, agents)
        seed_gitignore(project_name, project_name)

        print("Initialized project: " + project_name)
        print("  Created: " + project_name + "/")
        print("  Next:    cd " + project_name + " && nyx run")
        return true
    }

    // No name given — init in current directory
    if file_exists("nyx.toml") {
        print("error: nyx.toml already exists")
        return false
    }

    // Use directory name as default project name
    let cwd: String = getenv("PWD")
    project_name = "myapp"
    var last_slash: int = 0 - 1
    var si: int = 0
    while si < cwd.length() {
        if cwd.charAt(si) == 47 { last_slash = si }
        si = si + 1
    }
    if last_slash >= 0 {
        project_name = cwd.substring(last_slash + 1, cwd.length())
    }

    let content: String = "[package]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\nmain = \"src/main.nx\"\n\n[dependencies]\n"
    write_file("nyx.toml", content)
    mkdir_p("src")
    if file_exists("src/main.nx") == false {
        write_file("src/main.nx", "fn main() {\n    print(\"Hello from " + project_name + "!\")\n}\n")
    }

    scaffold_project_files(".", lang, agents)
    seed_gitignore(".", project_name)

    print("Initialized project: " + project_name)
    print("  Created: nyx.toml, src/main.nx")
    print("  Build:   nyx build")
    print("  Run:     nyx run")
    return true
}

// ===== DEPENDENCY RESOLUTION =====

fn resolve_deps(config: ProjectConfig) -> bool {
    if config.dep_names.length() == 0 { return true }

    var i: int = 0
    while i < config.dep_names.length() {
        let dep_name: String = config.dep_names[i]
        let dep_source: String = config.dep_versions[i]
        let pkg_dir: String = "packages/" + dep_name

        if file_exists(pkg_dir) == false {
            print("   resolving " + dep_name)

            var url: String = dep_source
            // If source starts with http/git, use as-is; otherwise treat as registry
            if url.startsWith("http") == false and url.startsWith("git") == false {
                url = "https://github.com/nyxlang-dev/" + dep_name
            }

            let result: int = git_clone(url, pkg_dir)
            if result != 0 {
                print("  error: failed to fetch " + dep_name + " from " + url)
                return false
            }
            print("  Fetched: " + dep_name)
        }
        i = i + 1
    }
    return true
}

// ===== BUILD SYSTEM =====
//
// LA RECETA SIN SHELL (W6 Task 2, 2026-10-31). Hasta acá run_build y run_libs
// ARMABAN un script de bash en /tmp y lo corrían con `bash`: en Windows no hay
// bash, y la receta vivía en strings con comillas escapadas. Ahora cada paso es
// un hijo lanzado con std/process (argv armado acá, sin shell, sin comillas), y
// lo que el script hacía con utilidades lo hacen piezas de std/ de la misma
// Task: mktemp → temp_dir + mkdir (que falla si el directorio ya existe, así
// que el nombre es exclusivo como el de mktemp), flock → try_lock_file,
// `ulimit -s` → el límite de pila de los hijos, `command -v` → find_program,
// `uname -m` → host_arch, nproc → cpu_count, grep/sha256sum/cat → contains,
// sha256 y read_file. La salida, los códigos de salida, las rutas y los
// mensajes son los de antes: los cubre scripts/testing/run_build_manifest.sh,
// que además corre el build con un PATH sin sh ni bash.

extern "C" fn nyx_eprint(s: String)
extern "C" fn nyx_proc_stack_limit_get() -> int
extern "C" fn nyx_proc_stack_limit_set(bytes: int) -> int

// Lo que el script mandaba con `>&2`.
fn err_print(s: String) { nyx_eprint(s) }
fn err_line(s: String) { nyx_eprint(s + "\n") }

// Absoluta: los hijos corren con cwd = NYX_HOME (el `cd "$NYX_HOME"` del
// script), así que una ruta relativa al proyecto dejaría de valer allá.
fn es_absoluta(p: String) -> bool {
    if p.startsWith("/") or p.startsWith("\\") { return true }
    if p.length() < 3 { return false }
    let c1: int = p.charAt(1)
    let c2: int = p.charAt(2)
    // C:\x o C:/x (92 es la barra invertida).
    return c1 == ':' and (c2 == '/' or c2 == 92)
}

fn absoluta(p: String) -> String {
    if es_absoluta(p) { return p }
    if p == "." { return getcwd() }
    if p.startsWith("./") { return getcwd() + "/" + p.substring(2, p.length()) }
    return getcwd() + "/" + p
}

// `mkdir -p`: el builtin mkdir crea un nivel. Acepta '/' y '\' (Windows).
fn mkdir_p(p: String) {
    var i: int = 1
    while i <= p.length() {
        var corte: bool = i == p.length()
        if not corte {
            let c: int = p.charAt(i)
            corte = c == '/' or c == 92
        }
        if corte {
            let parcial: String = p.substring(0, i)
            if parcial != "" and not file_exists(parcial) { let _r: int = mkdir(parcial) }
        }
        i = i + 1
    }
}

// `rm -rf` de lo que el build creó (sus temporales y la caché del runtime). No
// sigue más de 4 niveles: nada de lo suyo es más hondo.
fn borrar_arbol(p: String, nivel: int) {
    let st: Array = stat(p)
    if st.length() < 4 { return 0 }
    let es_dir: bool = st[3]
    if es_dir and nivel < 4 {
        let hijos: Array = readdir(p)
        var i: int = 0
        while i < hijos.length() {
            let h: String = hijos[i]
            borrar_arbol(p + "/" + h, nivel + 1)
            i = i + 1
        }
    }
    let _r: int = remove_file(p)
    return 0
}

fn solo_digitos(s: String) -> bool {
    if s.length() == 0 { return false }
    var i: int = 0
    while i < s.length() {
        let c: char = s.charAt(i)
        if c < '0' or c > '9' { return false }
        i = i + 1
    }
    return true
}

// ¿Existe el proceso? kill(pid, 0) en posix; en win32 os_proc_kill_pid abre
// el proceso y mira que no haya terminado. Si kill da EPERM (proceso de otro
// usuario) el builtin devuelve -1 igual, así que en Linux se mira /proc
// también: ante la duda, vivo.
fn pid_vivo(pid: int) -> bool {
    if kill_process(pid, 0) == 0 { return true }
    return file_exists("/proc/" + int_to_string(pid))
}

// Barre, en la base de temporales, los directorios de builds MUERTOS.
// `borrar_arbol(tmpd)` corre al final de run_build/build_libs, y a eso no se
// llega si matan el proceso (Ctrl+C, SIGKILL, un timeout externo): cada
// directorio —con los .ll de [lib] modules, 48 MB en un caso medido el
// 2026-11-05— quedaba en /tmp para siempre, y en esta máquina /tmp es tmpfs
// (RAM y después swap). Un manejador de señal no cubre KILL, así que la
// limpieza la hace EL BUILD SIGUIENTE, igual que `nyx test` (test.nx,
// barrer_huerfanos): el nombre lleva el PID del dueño y se borra lo de un PID
// que ya no existe. Solo entra la forma exacta de tmp_dir_propio
// (`nyx_libs_<pid>_<us>_<n>` / `nyx_build_<pid>_<us>_<n>`, tres tramos
// numéricos): nada que se le parezca de otro programa. Lo de un PID vivo no se
// toca; un PID reciclado solo deja el resto un build más.
fn barrer_huerfanos_build(base: String) {
    let hijos: Array = readdir(base)
    let yo: int = getpid()
    var i: int = 0
    while i < hijos.length() {
        let h: String = hijos[i]
        i = i + 1
        var resto: String = ""
        if h.startsWith("nyx_libs_") {
            resto = h.substring(9, h.length())
        } else if h.startsWith("nyx_build_") {
            resto = h.substring(10, h.length())
        } else {
            continue
        }
        let partes: Array<String> = resto.split("_")
        if partes.length() != 3 { continue }
        if not solo_digitos(partes[0]) or not solo_digitos(partes[1]) or not solo_digitos(partes[2]) { continue }
        let pid: int = string_to_int(partes[0])
        if pid <= 0 or pid == yo or pid_vivo(pid) { continue }
        borrar_arbol(base + "/" + h, 0)
    }
}

// Directorio temporal propio, el `mktemp -d` del script: mkdir falla si ya
// existe, así que nadie más puede haberlo creado antes (ni plantar un enlace
// adentro, porque es 0755 y de quien corre el build). "" si no se pudo.
// Antes de crear el suyo barre los de builds muertos (barrer_huerfanos_build).
var g_tmp_n: int = 0
fn tmp_dir_propio(prefijo: String) -> String {
    var base: String = temp_dir()
    if base == "" { base = "/tmp" }
    barrer_huerfanos_build(base)
    var intento: int = 0
    while intento < 50 {
        g_tmp_n = g_tmp_n + 1
        let d: String = base + "/" + prefijo + int_to_string(getpid()) + "_" + int_to_string(time_us()) + "_" + int_to_string(g_tmp_n)
        if mkdir(d) == 0 { return d }
        intento = intento + 1
    }
    return ""
}

// `GIT_TERMINAL_PROMPT=0 git clone --depth 1 <url> <dir> 2>/dev/null`, sin
// shell: la url y el destino llegan como un argumento cada uno.
fn git_clone(url: String, dest: String) -> int {
    var o = spawn_opts()
    o.stdin = Stdio.Null
    o.stderr = Stdio.Null
    o.env = [["GIT_TERMINAL_PROMPT", "0"]]
    term_flush()
    match try_spawn(["git", "clone", "--depth", "1", url, dest], o) {
        Result.Ok(c) => {
            match try_child_wait(c) {
                Result.Ok(rc) => { return rc }
                Result.Err(_e) => { return 1 }
            }
        }
        Result.Err(_e) => { return 127 }
    }
}

// `nyx run`: el programa en primer plano con la terminal heredada, y su código
// de salida. Mientras corre, nyx_build no muere por Ctrl+C (SIGINT) ni SIGQUIT,
// como el padre de system(): la señal le llega al programa —que puede tener su
// propio apagado ordenado— y nyx_build devuelve lo que el programa devuelva.
fn ignorar_senal(_s: int) {}

fn correr_programa(argv: Array) -> int {
    signal_handle(2, ignorar_senal)
    // SIGQUIT (3) no existe en Windows: registrarlo imprimía «no se pudo registrar
    // la señal 3 (error 22)» en cada `nyx run`.
    if not host_es_windows() { signal_handle(3, ignorar_senal) }
    term_flush()
    match try_spawn(argv, spawn_opts()) {
        Result.Ok(c) => {
            match try_child_wait(c) {
                Result.Ok(rc) => { return rc }
                Result.Err(e) => { err_line("error: " + e.msg); return 1 }
            }
        }
        Result.Err(e) => {
            let p: String = argv[0]
            err_line(p + ": " + e.msg)
            return 127
        }
    }
}

// La raíz del proyecto que contiene a `dir`: el ancestro más cercano con nyx.toml,
// o "" si no hay (la misma búsqueda hacia arriba de scripts/nyx). Acepta "/" y
// "\" como separadores, porque en Windows getcwd() devuelve la forma nativa.
fn raiz_del_proyecto(dir: String) -> String {
    var d: String = dir
    while d != "" {
        if file_exists(d + "/nyx.toml") { return d }
        var corte: int = -1
        var i: int = 0
        while i < d.length() {
            let c: int = d.charAt(i)
            if c == 47 or c == 92 { corte = i }
            i = i + 1
        }
        if corte <= 0 { return "" }
        d = d.substring(0, corte)
    }
    return ""
}

// Orden por bytes (inserción: las listas son cortas, unos pocos nombres o
// archivos). sort_str es del prelude, que este módulo no carga.
fn texto_menor(a: String, b: String) -> bool {
    var i: int = 0
    while i < a.length() and i < b.length() {
        let ca: int = a.charAt(i)
        let cb: int = b.charAt(i)
        if ca != cb { return ca < cb }
        i = i + 1
    }
    return a.length() < b.length()
}

fn ordenar_texto(xs: Array) -> Array {
    var out: Array = []
    var i: int = 0
    while i < xs.length() {
        let x: String = xs[i]
        out.push(x)
        var j: int = out.length() - 1
        while j > 0 {
            let prev: String = out[j - 1]
            if texto_menor(x, prev) { out[j] = prev; out[j - 1] = x; j = j - 1 } else { j = 0 }
        }
        i = i + 1
    }
    return out
}

// Las líneas con '⚠' (avisos del compilador), lo que hacía `grep -F '⚠'`.
fn avisos_de(log: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let lineas: Array = log.split("\n")
    var i: int = 0
    while i < lineas.length() {
        let l: String = lineas[i]
        if l.contains("⚠") { sb.append(l + "\n") }
        i = i + 1
    }
    return sb.to_string()
}

// "-O2 --target=x" → ["-O2", "--target=x"]: las banderas se arman como string
// porque así entran en la huella de [lib] y en la clave de la caché del runtime.
fn palabras(s: String) -> Array {
    var out: Array = []
    let partes: Array = s.split(" ")
    var i: int = 0
    while i < partes.length() {
        let p: String = partes[i]
        if p != "" { out.push(p) }
        i = i + 1
    }
    return out
}

fn concat(a: Array, b: Array) -> Array {
    var out: Array = []
    var i: int = 0
    while i < a.length() { let x: String = a[i]; out.push(x); i = i + 1 }
    i = 0
    while i < b.length() { let y: String = b[i]; out.push(y); i = i + 1 }
    return out
}

// La salida estándar de un programa corto (clang -print-file-name, gcc
// -dumpversion, clang --version): "" si no está o falla, como el `2>/dev/null`.
fn salida_de(argv: Array) -> String {
    var o = spawn_opts()
    o.stdin = Stdio.Null
    o.stdout = Stdio.Pipe
    o.stderr = Stdio.Null
    match try_spawn(argv, o) {
        Result.Ok(c) => {
            match try_child_collect(c) {
                Result.Ok(r) => { return r.stdout }
                Result.Err(_e) => { return "" }
            }
        }
        Result.Err(_e) => { return "" }
    }
}

// Corre argv hasta que termine, con stdout y stderr al log (los dos en modo
// agregar, así el orden entre ellos es el del programa: el `> "$LOG" 2>&1`).
// Devuelve el código de salida; si no se pudo lanzar, escribe el motivo en el
// log y devuelve 127, como un shell que no encuentra el programa.
fn correr_a_log(argv: Array, cwd: String, env: Array, log: String) -> int {
    write_file(log, "")
    var o = spawn_opts()
    o.stdin = Stdio.Null
    o.stdout = Stdio.File(log, "a")
    o.stderr = Stdio.File(log, "a")
    o.cwd = cwd
    o.env = env
    term_flush()
    match try_spawn(argv, o) {
        Result.Ok(c) => {
            match try_child_wait(c) {
                Result.Ok(rc) => { return rc }
                Result.Err(e) => { write_file(log, e.msg + "\n"); return 127 }
            }
        }
        Result.Err(e) => { write_file(log, e.msg + "\n"); return 127 }
    }
}

// Corre argv con stdout heredado y stderr a `log` (el `2> "$LOG"` de clang).
fn correr_err_a(argv: Array, cwd: String, log: String) -> int {
    var o = spawn_opts()
    o.stdin = Stdio.Null
    o.stderr = Stdio.File(log, "w")
    o.cwd = cwd
    term_flush()
    match try_spawn(argv, o) {
        Result.Ok(c) => {
            match try_child_wait(c) {
                Result.Ok(rc) => { return rc }
                Result.Err(e) => { write_file(log, e.msg + "\n"); return 127 }
            }
        }
        Result.Err(e) => { write_file(log, e.msg + "\n"); return 127 }
    }
}

// Task 10 (Fase 4, campaña "Primer intento verde"): cuando clang falla al
// linkear, el script volcaba el log crudo de LLVM (`use of undefined value
// '%2243'`, etc.) sin NINGÚN puente al código Nyx del usuario — el agente
// no tiene forma de saber si el bug es suyo o del compilador y edita al
// azar (≥4 incidentes históricos, ver PROJECT_STATE.md/TASKS.md; el repro
// del banco: `Option<Item>` con struct de 3 campos como payload produce
// `'%NNN' defined with type '%Item = type {...}' but expected 'i64'`).
// Esta función imprime la atribución (dos clases, por línea del log, como
// el `grep -qE` de antes) ANTES del log — el log completo se sigue mostrando
// siempre, esto solo agrega contexto arriba. Bilingüe vía NYX_LANG (mismo
// criterio que nyx_msg en nyx.nx). La usan el enlace nativo y el de WASM.
fn clang_failure_attribution(log: String, main_file: String) {
    var ir: bool = false
    var simbolo: bool = false
    let lineas: Array = log.split("\n")
    var i: int = 0
    while i < lineas.length() {
        let l: String = lineas[i]
        // Clase (a): IR inválido — patrones vistos en incidentes reales
        // (grep "use of undefined value"/"defined with type" en
        // PROJECT_STATE.md/TASKS.md) + el del banco. 5 patrones alcanzan.
        if l.contains("use of undefined value") or l.contains("expected instruction") or l.contains("invalid redefinition of") or l.contains("invalid forward reference") { ir = true }
        let dt: int = l.indexOf("defined with type ")
        if dt >= 0 and l.substring(dt + 18, l.length()).contains(" but expected") { ir = true }
        // Clase (b): símbolo indefinido de linker — puede ser un extern "C"
        // del usuario mal declarado O un builtin de la stdlib sin runtime
        // detrás; mensaje neutro (no asumimos de quién es la culpa).
        if l.contains("undefined reference") or l.contains("undefined symbol") { simbolo = true }
        i = i + 1
    }
    let es: bool = getenv("NYX_LANG") == "es"
    if ir {
        if es { err_line("  -> esto es casi seguro un BUG del compilador Nyx (IR invalido), no de tu codigo (archivo: " + main_file + "). Repórtalo con 'nyx report' (el reporte incluye contexto util).") }
        else { err_line("  -> this is almost certainly a Nyx compiler BUG (invalid IR), not your code (file: " + main_file + "). Report it with 'nyx report' (the report includes useful context).") }
    } else if simbolo {
        if es { err_line("  -> simbolo no encontrado al linkear: si es una funcion extern C tuya, revisa el nombre/lib; si es de la stdlib de Nyx, es un bug -- repórtalo con 'nyx report'.") }
        else { err_line("  -> symbol not found at link time: if this is your own extern C function, check the name/lib; if it is a stdlib function, it is a Nyx bug -- report it with 'nyx report'.") }
    } else {
        if es { err_line("  -> fallo de link sin patron reconocido; si sospechas que es un bug del compilador, repórtalo con 'nyx report'.") }
        else { err_line("  -> link failure with no recognized pattern; if you suspect a compiler bug, report it with 'nyx report'.") }
    }
}

// Pila del compilador (fricción nyxerp 20260920-200024, spec
// docs/design/specs/2026-09-23-pila-del-compilador-design.md): nyx_bootstrap se
// enlaza en -O0 y cada nivel de una expresión binaria apila ~151 KB de marcos de
// codegen, así que 53 operandos `+` agotaban los 8 MB por omisión y el
// compilador moría con SIGSEGV mudo. Se sube a 64 MB el límite BLANDO que
// heredan los hijos —el compilador y los clang que lanza el build—, nunca se
// BAJA uno más grande, y se restaura al terminar: el binario que corre `nyx run`
// conserva su pila de siempre. Mismo criterio que scripts/lib_stack.sh. Antes
// era `ulimit -s 65536` en el subshell del compilador. En Windows no hace nada:
// la pila la fija /STACK:67108864 al enlazar nyx_bootstrap.exe.
var g_pila_previa: int = 0
var g_pila_subida: bool = false
fn pila_compilador_subir() {
    let c: int = nyx_proc_stack_limit_get()
    // -1 = ilimitada; menor que -1, sin rlimit (Windows) o error.
    if c < 0 or c >= 67108864 { return 0 }
    if nyx_proc_stack_limit_set(67108864) == 0 {
        g_pila_previa = c
        g_pila_subida = true
    }
    return 0
}

fn pila_compilador_restaurar() {
    if g_pila_subida {
        let _r: int = nyx_proc_stack_limit_set(g_pila_previa)
        g_pila_subida = false
    }
    return 0
}

// Si el compilador murió por señal (rc >= 128), decir la causa conocida en vez
// de dejar solo el «Segmentation fault». En Windows un desborde de pila es
// 0xC00000FD, que también es >= 128.
fn nyx_pista(rc: int) {
    if rc >= 128 {
        err_line("nota: el compilador murio por una senal (rc=" + int_to_string(rc) + "). La causa conocida es quedarse sin pila con una expresion muy larga o muy anidada (cientos de operandos en una sola expresion): conviene partirla en varias. Si no es eso, se puede reportar con 'nyx report'.")
    }
    return 0
}

// Pista para un NYX1002 de una unidad [lib] (2026-09-24, nyxerp con [lib]): un
// módulo que usa una fn de otro SIN importarlo compilaba inlineado —el programa
// entero comparte un espacio de nombres— y como biblioteca, que se compila sola,
// da «'x' not declared» sin decir por qué. Se busca la fn en src/ y se dice
// dónde está, si es privada, y qué import falta. Los archivos de src/ se miran
// en orden alfabético (el `grep -rl | head -1` de antes seguía el orden del
// disco).
fn es_ident_pista(c: int, primero: bool) -> bool {
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' { return true }
    return not primero and c >= '0' and c <= '9'
}

fn nombres_no_declarados(log: String) -> Array {
    var vistos: Map = Map.new()
    var out: Array = []
    let marca: String = "' not declared"
    var desde: int = 0
    while desde < log.length() {
        let resto: String = log.substring(desde, log.length())
        let j: int = resto.indexOf(marca)
        if j < 0 { break }
        let fin: int = desde + j
        var ini: int = fin
        var sigue: bool = true
        while ini > 0 and sigue {
            let c: int = log.charAt(ini - 1)
            if es_ident_pista(c, false) { ini = ini - 1 } else { sigue = false }
        }
        var abre: bool = false
        if ini > 0 and ini < fin {
            let q: int = log.charAt(ini - 1)
            let c0: int = log.charAt(ini)
            abre = q == 39 and es_ident_pista(c0, true)
        }
        if abre {
            let n: String = log.substring(ini, fin)
            if not vistos.contains(n) { vistos.insert(n, 1); out.push(n) }
        }
        desde = fin + marca.length()
    }
    return ordenar_texto(out)
}

fn archivos_de(dir: String, out: Array) {
    let hijos: Array = ordenar_texto(readdir(dir))
    var i: int = 0
    while i < hijos.length() {
        let h: String = hijos[i]
        let p: String = dir + "/" + h
        let st: Array = stat(p)
        if st.length() >= 5 {
            let es_dir: bool = st[3]
            let es_arch: bool = st[4]
            if es_dir { archivos_de(p, out) } else if es_arch { out.push(p) }
        }
        i = i + 1
    }
    return 0
}

// La línea declara `fn n(` (con pub/export y async opcionales): el
// ^(pub |export )?(async )?fn n\( de antes. Devuelve 0 si no, 1 si es pública,
// 2 si es privada.
fn declara_fn(linea: String, n: String) -> int {
    var l: String = linea
    var vis: bool = false
    if l.startsWith("pub ") { l = l.substring(4, l.length()); vis = true }
    else if l.startsWith("export ") { l = l.substring(7, l.length()); vis = true }
    if l.startsWith("async ") { l = l.substring(6, l.length()) }
    if not l.startsWith("fn " + n + "(") { return 0 }
    if vis or linea.startsWith("async ") { return 1 }
    return 2
}

fn nyx_pista_import(log: String, orig: String) {
    let nombres: Array = nombres_no_declarados(log)
    if nombres.length() == 0 { return 0 }
    var archivos: Array = []
    if file_exists(orig + "/src") { archivos_de(orig + "/src", archivos) }
    var k: int = 0
    while k < nombres.length() {
        let n: String = nombres[k]
        var def: String = ""
        var privada: bool = false
        var a: int = 0
        while a < archivos.length() and def == "" {
            let f: String = archivos[a]
            let lineas: Array = read_file(f).split("\n")
            var li: int = 0
            while li < lineas.length() and def == "" {
                let l: String = lineas[li]
                if declara_fn(l, n) > 0 { def = f }
                li = li + 1
            }
            a = a + 1
        }
        if def != "" {
            // priv: hay un `fn n(` sin pub en ese archivo (el grep de antes).
            let lineas2: Array = read_file(def).split("\n")
            var lj: int = 0
            while lj < lineas2.length() {
                let l2: String = lineas2[lj]
                if l2.startsWith("fn " + n + "(") { privada = true }
                lj = lj + 1
            }
            var rel: String = def
            if rel.startsWith(orig + "/") { rel = rel.substring(orig.length() + 1, rel.length()) }
            if rel.endsWith(".nx") { rel = rel.substring(0, rel.length() - 3) }
            var priv: String = ""
            if privada { priv = " (y es privada: le falta pub)" }
            err_line("nota: '" + n + "' está en " + rel + priv + " y este módulo no lo importa. Sin [lib] compilaba porque el programa inlineado comparte un solo espacio de nombres; una biblioteca se compila sola y ve solo lo que importa: agrega  import \"" + rel + "\"")
        }
        k = k + 1
    }
    return 0
}

// ===== COMPILACIÓN SEPARADA: [lib] modules (arco compilacion-separada, Task 6) =====
//
// Cada módulo de `[lib] modules` se compila como UNA unidad de biblioteca
// (NYX_LIB_UNIT=1: lo ajeno sale linkonce_odr, ver g_lib_unit en codegen.nx), a
// un .o que vive en target/nyx-lib/ y se REUTILIZA mientras su huella no cambie.
// El programa se compila con NYX_LIB_MODULES: esos imports no se inlinean, se
// declaran (la interfaz de las tasks 3-4) y el enlace trae el .o.
//
// LA HUELLA es lo que decide reutilizar, y tiene que cubrir TODO lo que entra
// en el .o, porque reutilizar un objeto viejo es un fallo silencioso (un struct
// con otro layout se lee con offsets equivocados — medido en la Task 4):
//   - el binario del compilador (otro compilador, otro IR),
//   - las flags que cambian el objeto (-O2, NO_GC) y la lista de [lib] (lo que
//     esta unidad inlinea o declara depende de ella),
//   - el fuente del módulo y de TODO su cierre de imports, incluidos el prelude
//     y los std/ que use (se inlinean dentro de la unidad).
// El programa principal nunca se cachea: se recompila siempre contra las
// interfaces vigentes.

// Cierre de imports de `path` (sin .nx), en orden de visita: cada entrada es el
// archivo real leído. std/ se busca en `std_dir`; lo demás, relativo al proyecto.
// `imports_de` (archivo → sus paths importados) y `vistos` son Maps: con 250
// módulos, releer y partir el cierre de cada uno y buscar linealmente costaba
// ~9 s por build SIN cambios (medido 2026-09-23); cada archivo se lee una vez.
fn lib_cierre(path: String, std_dir: String, visitados: Array, vistos: Map, imports_de: Map) {
    var archivo: String = path + ".nx"
    if path.startsWith("std/") { archivo = std_dir + "/" + path.substring(4, path.length()) + ".nx" }
    if vistos.contains(archivo) { return 0 }
    vistos.insert(archivo, 1)
    if not imports_de.contains(archivo) {
        var imps: Array = []
        if file_exists(archivo) {
            let lineas: Array = read_file(archivo).split("\n")
            var i: int = 0
            while i < lineas.length() {
                let l: String = lineas[i]
                let t: String = l.trim()
                if t.startsWith("import ") {
                    let a: int = t.indexOf("\"")
                    if a >= 0 {
                        let resto: String = t.substring(a + 1, t.length())
                        let b: int = resto.indexOf("\"")
                        if b > 0 { imps.push(resto.substring(0, b)) }
                    }
                }
                i = i + 1
            }
        } else {
            imps.push("")
        }
        imports_de.insert(archivo, imps)
    }
    let mis: Array = imports_de.get(archivo)
    if mis.length() == 1 {
        let unico: String = mis[0]
        if unico == "" { return 0 }
    }
    visitados.push(archivo)
    var j: int = 0
    while j < mis.length() {
        let ip: String = mis[j]
        lib_cierre(ip, std_dir, visitados, vistos, imports_de)
        j = j + 1
    }
    return 0
}

// sha256 del contenido de `f`, memoizado: el prelude y los módulos compartidos se
// hashean UNA vez por build y no una por cada módulo que los importa.
fn hash_archivo(f: String, hashes: Map) -> String {
    if hashes.contains(f) {
        let h: String = hashes.get(f)
        return h
    }
    let h2: String = sha256(read_file(f))
    hashes.insert(f, h2)
    return h2
}

// ===== HUELLA POR INTERFAZ (fricción nyxerp 20260924-150024, 2026-09-24) =====
// Una unidad [lib] que importa la biblioteca B inlinea el TEXTO de B para
// semantic, pero de B solo genera `declare` (codegen, es_lib_declarado). Su .o
// depende entonces de la INTERFAZ de B —firmas, tipos, constantes, globales—, no
// de los cuerpos de sus fns ni de sus comentarios. Antes la huella hasheaba B
// entero: una línea de comentario en un módulo central recompilaba 105 de 171
// módulos de nyxerp (y nyx build volvía a 216 s). Ahora, para cada biblioteca
// separable del cierre que NO es el propio módulo, se hashea su interfaz.
// Lo que se inlinea de verdad (módulos que no son [lib], los que caen en
// NYX0302, el prelude y el módulo propio) sigue hasheándose entero.

// Los caracteres se leen con charAt() como int y se comparan contra literales
// char ('/', '{', '\n'…). Hasta el 2026-09-27 se comparaban contra códigos ASCII
// (47, 123, 10…) para esquivar un bug ya arreglado: asignar charAt() a un
// `var c: char` ya declarado emitía IR inválido.
fn es_ident_c(c: int) -> bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

// Fin (exclusivo) del literal que empieza en `i`, o -1 si ahí no empieza uno:
// "..." con escapes, """...""" y r"..." (sin escapes), y '.' con escapes.
fn fin_de_literal(src: String, i: int) -> int {
    let n: int = src.length()
    let c: int = src.charAt(i)
    if c == 'r' and i + 1 < n {
        let d: int = src.charAt(i + 1)
        if d == '"' {
            if i > 0 {
                let a: int = src.charAt(i - 1)
                if es_ident_c(a) { return -1 }
            }
            var j: int = i + 2
            while j < n {
                let cj: int = src.charAt(j)
                if cj == '"' { return j + 1 }
                j = j + 1
            }
            return n
        }
    }
    if c == '"' {
        if i + 2 < n {
            let d1: int = src.charAt(i + 1)
            let d2: int = src.charAt(i + 2)
            if d1 == '"' and d2 == '"' {
                var k: int = i + 3
                while k + 2 < n {
                    let k0: int = src.charAt(k)
                    let k1: int = src.charAt(k + 1)
                    let k2: int = src.charAt(k + 2)
                    if k0 == '"' and k1 == '"' and k2 == '"' { return k + 3 }
                    k = k + 1
                }
                return n
            }
        }
        var j2: int = i + 1
        while j2 < n {
            let cj2: int = src.charAt(j2)
            if cj2 == '\\' {
                j2 = j2 + 2
            } else if cj2 == '"' {
                return j2 + 1
            } else {
                j2 = j2 + 1
            }
        }
        return n
    }
    if c == '\'' {
        var j3: int = i + 1
        while j3 < n and j3 < i + 12 {
            let cj3: int = src.charAt(j3)
            if cj3 == '\\' {
                j3 = j3 + 2
            } else if cj3 == '\'' {
                return j3 + 1
            } else {
                j3 = j3 + 1
            }
        }
        return j3
    }
    return -1
}

// Interfaz de un módulo: su texto SIN comentarios (// y /* */ anidados), SIN los
// cuerpos de sus fns de nivel superior y con los espacios normalizados. Todo lo
// demás queda, literal por literal: firmas, struct/enum, constantes, globales,
// atributos. Un `fn` de nivel superior sin cuerpo (extern) no se lleva la llave
// del siguiente tipo: la espera se corta al terminar la línea fuera de paréntesis.
fn interfaz_de(src: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = src.length()
    var i: int = 0
    var llaves: int = 0
    var parens: int = 0
    var fn_pend: bool = false
    var saltando: bool = false
    var cuerpo: int = 0
    var espacio: bool = false
    var escrito: bool = false
    while i < n {
        let c: int = src.charAt(i)
        var c2: int = 0
        if i + 1 < n {
            let sig: int = src.charAt(i + 1)
            c2 = sig
        }
        if c == '/' and c2 == '/' {
            var fin_l: bool = false
            while i < n and not fin_l {
                let cl: int = src.charAt(i)
                if cl == '\n' { fin_l = true } else { i = i + 1 }
            }
            espacio = true
        } else if c == '/' and c2 == '*' {
            var prof: int = 1
            i = i + 2
            while i < n and prof > 0 {
                let b0: int = src.charAt(i)
                var b1: int = 0
                if i + 1 < n {
                    let bb: int = src.charAt(i + 1)
                    b1 = bb
                }
                if b0 == '/' and b1 == '*' {
                    prof = prof + 1
                    i = i + 2
                } else if b0 == '*' and b1 == '/' {
                    prof = prof - 1
                    i = i + 2
                } else {
                    i = i + 1
                }
            }
            espacio = true
        } else {
            let fin: int = fin_de_literal(src, i)
            if fin > 0 {
                if not saltando {
                    if espacio and escrito { sb.append(" ") }
                    espacio = false
                    sb.append(src.substring(i, fin))
                    escrito = true
                }
                i = fin
            } else if saltando {
                if c == '{' { cuerpo = cuerpo + 1 }
                if c == '}' {
                    cuerpo = cuerpo - 1
                    if cuerpo == 0 {
                        saltando = false
                        sb.append("{}")
                    }
                }
                i = i + 1
            } else if c == ' ' or c == '\t' or c == '\r' or c == '\n' {
                if c == '\n' and parens == 0 { fn_pend = false }
                espacio = true
                i = i + 1
            } else {
                if llaves == 0 and c == 'f' and c2 == 'n' {
                    var antes_ok: bool = true
                    if i > 0 {
                        let pa: int = src.charAt(i - 1)
                        if es_ident_c(pa) { antes_ok = false }
                    }
                    var despues_ok: bool = true
                    if i + 2 < n {
                        let pd: int = src.charAt(i + 2)
                        if es_ident_c(pd) { despues_ok = false }
                    }
                    if antes_ok and despues_ok { fn_pend = true }
                }
                if c == '(' { parens = parens + 1 }
                if c == ')' { parens = parens - 1 }
                if espacio and escrito { sb.append(" ") }
                espacio = false
                if c == '{' and llaves == 0 and fn_pend {
                    fn_pend = false
                    saltando = true
                    cuerpo = 1
                } else {
                    if c == '{' { llaves = llaves + 1 }
                    if c == '}' { llaves = llaves - 1 }
                    sb.append(src.substring(i, i + 1))
                    escrito = true
                }
                i = i + 1
            }
        }
    }
    return sb.to_string()
}

// ¿El módulo cuyo fuente es `src` se compila aparte? Mismo criterio que
// razon_no_separable (resolve.nx): sin fn genérica exportada, sin impl, sin
// trait. (build.nx no enlaza resolve: se repite el chequeo, que es de líneas.)
fn separable_texto(src: String) -> bool {
    let lineas: Array = src.split("\n")
    var i: int = 0
    while i < lineas.length() {
        let l: String = lineas[i]
        let t: String = l.trim()
        if t.startsWith("impl ") or t.startsWith("impl<") { return false }
        if t.startsWith("trait ") or t.startsWith("pub trait ") or t.startsWith("export trait ") { return false }
        var pref: String = ""
        if t.startsWith("pub fn ") { pref = "pub fn " }
        if t.startsWith("export fn ") { pref = "export fn " }
        if pref != "" {
            let resto: String = t.substring(pref.length(), t.length())
            var k: int = 0
            var sigue: bool = true
            while k < resto.length() and sigue {
                let rk: int = resto.charAt(k)
                if es_ident_c(rk) { k = k + 1 } else { sigue = false }
            }
            if k < resto.length() {
                let rk2: int = resto.charAt(k)
                if rk2 == 60 { return false }
            }
        }
        i = i + 1
    }
    return true
}

// ===== RECURSOS DE include_bytes EN LA HUELLA (fricción nyxerp 20260930-170003) =====
// include_bytes lee el archivo AL COMPILAR y lo deja dentro del .o, así que el
// archivo es parte de lo que entra en el objeto igual que el fuente. Hasta el
// 2026-10-01 la huella no lo miraba: editar el recurso dejaba el .o viejo y
// nyx run/test/build servían el contenido anterior en silencio (ni `touch` del
// .nx alcanzaba, porque la huella es de contenido). Ahora, por cada archivo que
// se hashea ENTERO, se suman la ruta y el sha256 de cada include_bytes("…") que
// nombra. La ruta se resuelve desde la raíz del proyecto —el cwd de nyx_build,
// el mismo que usa lib_cierre—, igual que lo hace el codegen con NYX_PROJECT_DIR.
// Una biblioteca hasheada por INTERFAZ no aporta los suyos: sus cuerpos no se
// emiten en esta unidad (solo `declare`), su propio .o lleva su propia huella.
// Escanear el texto (y no el AST) puede sumar de más —una mención en un
// comentario—, nunca de menos: lo peor es una recompilación de sobra.
fn huella_include_bytes(f: String, hashes: Map) -> String {
    let clave: String = "include_bytes:" + f
    if hashes.contains(clave) {
        let h: String = hashes.get(clave)
        return h
    }
    var out: String = ""
    if file_exists(f) {
        let src: String = read_file(f)
        if src.indexOf("include_bytes") >= 0 {
            let partes: Array = src.split("include_bytes(\"")
            var i: int = 1
            while i < partes.length() {
                let resto: String = partes[i]
                let fin: int = resto.indexOf("\"")
                if fin > 0 {
                    let ruta: String = resto.substring(0, fin)
                    var h: String = "ausente"
                    if file_exists(ruta) { h = hash_archivo(ruta, hashes) }
                    out = out + "|ib:" + ruta + "=" + h
                }
                i = i + 1
            }
        }
    }
    hashes.insert(clave, out)
    return out
}

// sha256 de la INTERFAZ de `f` si es una biblioteca separable del proyecto (y
// no el módulo propio); del contenido entero en otro caso, más sus recursos de
// include_bytes (ver huella_include_bytes). Memoizado.
fn hash_para_huella(f: String, propio: String, libs: Map, hashes: Map) -> String {
    if f == propio or not f.endsWith(".nx") { return hash_archivo(f, hashes) + huella_include_bytes(f, hashes) }
    let modulo: String = f.substring(0, f.length() - 3)
    if not libs.contains(modulo) { return hash_archivo(f, hashes) + huella_include_bytes(f, hashes) }
    let clave: String = "interfaz:" + f
    if hashes.contains(clave) {
        let h: String = hashes.get(clave)
        return h
    }
    let src: String = read_file(f)
    var h2: String = ""
    if separable_texto(src) { h2 = "i:" + sha256(interfaz_de(src)) } else { h2 = sha256(src) + huella_include_bytes(f, hashes) }
    hashes.insert(clave, h2)
    return h2
}

fn lib_huella(modulo: String, base: String, std_dir: String, hashes: Map, imports_de: Map, libs: Map) -> String {
    var visitados: Array = []
    var vistos: Map = Map.new()
    lib_cierre(modulo, std_dir, visitados, vistos, imports_de)
    // StringBuilder: el cierre de un módulo de nyxerp tiene ~300 archivos, y
    // `todo = todo + …` recopiaba lo acumulado en cada uno, para cada módulo: era
    // la mitad del tiempo de un `nyx_build libs` sin cambios, que `nyx test` paga
    // en cada archivo (medido 2026-10-17). Mismo texto, misma huella.
    var todo: StringBuilder = StringBuilder.new()
    todo.append(base + "|" + hash_archivo(std_dir + "/prelude.nx", hashes))
    let propio: String = modulo + ".nx"
    let std_pref: String = std_dir + "/"
    var i: int = 0
    while i < visitados.length() {
        let f: String = visitados[i]
        // Los std/ entran por su ruta RELATIVA: la absoluta lleva la carpeta de
        // la instalación (versions/<id>), que cambia en cada install aunque el
        // archivo sea el mismo (ver lib_identidad_compilador). Su contenido sí
        // entra, por el hash.
        var nombre: String = f
        if f.startsWith(std_pref) { nombre = "std" + f.substring(std_dir.length(), f.length()) }
        todo.append("|" + nombre + "=" + hash_para_huella(f, propio, libs, hashes))
        i = i + 1
    }
    return sha256(todo.to_string())
}

// Identidad del compilador para la huella de [lib]: el sha256 de su CONTENIDO,
// no su ruta. Hasta 2026-10-17 era ruta + tamaño + mtime (el criterio de
// make/ninja), y como cada `make install-local` / `nyx update` arma
// ~/.nyx/versions/<id-con-fecha>/, una reinstalación con el MISMO compilador
// recompilaba todo target/nyx-lib (fricción nyxerp 20261017: 302 módulos, ~50
// min). Hashear los 8 MB cuesta ~300 ms, así que el hash se guarda en
// target/nyx-lib/.compilador junto a la clave ruta:tamaño:mtime que lo produjo:
// se paga una vez por instalación, no por build. Si la clave no coincide o el
// archivo no está, se recalcula; nunca se confía en un hash sin su clave.
fn lib_identidad_compilador(nyx_bin: String) -> String {
    let st: Array = stat(nyx_bin)
    if st.length() < 3 { return nyx_bin }
    let tam: int = st[0]
    let mt: int = st[2]
    let clave: String = nyx_bin + ":" + int_to_string(tam) + ":" + int_to_string(mt)
    let cache: String = "target/nyx-lib/.compilador"
    if file_exists(cache) {
        let lineas: Array = read_file(cache).split("\n")
        if lineas.length() >= 2 {
            let c0: String = lineas[0]
            let c1: String = lineas[1]
            if c0 == clave and c1.length() == 64 { return "c:" + c1 }
        }
    }
    let h: String = sha256(read_file(nyx_bin))
    mkdir("target")
    mkdir("target/nyx-lib")
    write_file(cache, clave + "\n" + h + "\n")
    return "c:" + h
}

// Los .o de las bibliotecas: reutiliza el de huella vigente, o compila la
// unidad y la guarda. Devuelve los objetos y el mapa en el orden del manifiesto.
struct LibRes {
    ok: bool,
    objs: Array,
    mapa: String,
}

// El build paralelo de [lib] (arco build-lib-paralelo, 2026-10-17). Las
// unidades no dependen unas de otras para compilar —una biblioteca que importa
// otra lee su TEXTO y solo emite `declare`—, así que no hay grafo que ordenar:
// solo el enlace necesita todos los objetos. Cada unidad pasa por dos hijos, el
// compilador y `clang -c`; el estado de la unidad k vive en los arrays de
// LibJobs (etapa: 0 sin lanzar, 1 compilador, 2 clang, 9 terminada). El .o se
// escribe a un temporal y se publica con rename: un objeto a medio escribir
// nunca tiene el nombre que la huella reutiliza.
struct LibJobs {
    mods: Array,
    objs: Array,
    inls: Array,
    seguros: Array,
    etapa: Array,
    hijo: Array,
    rc: Array,
    fallo: Array,
    avisos: Array,
    // [siguiente unidad cuyos avisos imprimir, unidades lanzadas]
    cuenta: Array,
}

fn lib_corriendo(j: LibJobs) -> int {
    var n: int = 0
    var k: int = 0
    while k < j.etapa.length() {
        let e: int = j.etapa[k]
        if e == 1 or e == 2 { n = n + 1 }
        k = k + 1
    }
    return n
}

// Imprime los avisos (⚠) de las unidades terminadas, en orden, sin saltear una
// que siga corriendo.
fn lib_vaciar(j: LibJobs) {
    var sig: int = j.cuenta[0]
    while sig < j.etapa.length() {
        let e: int = j.etapa[sig]
        if e != 9 { break }
        let w: String = j.avisos[sig]
        if w != "" { err_print(w) }
        sig = sig + 1
    }
    j.cuenta[0] = sig
    return 0
}

fn lib_fallo_alguna(j: LibJobs) -> bool {
    var k: int = 0
    while k < j.fallo.length() {
        let f: String = j.fallo[k]
        if f != "" { return true }
        k = k + 1
    }
    return false
}

// Lanza la unidad k: borra sus objetos viejos, copia el fuente al temporal y
// arranca el compilador (stdout y stderr a <k>.log).
fn lib_lanzar(j: LibJobs, k: int, nyx_bin: String, nyx_home: String, env_base: Array, lista: String, orig: String, tmpd: String) {
    let m: String = j.mods[k]
    let seguro: String = j.seguros[k]
    let dir: String = orig + "/target/nyx-lib"
    let viejos: Array = readdir(dir)
    var i: int = 0
    while i < viejos.length() {
        let v: String = viejos[i]
        if v.startsWith(seguro + "-") { let _r: int = remove_file(dir + "/" + v) }
        i = i + 1
    }
    let ks: String = int_to_string(k)
    let lsrc: String = tmpd + "/lib_" + ks + ".nx"
    write_file(lsrc, read_file(orig + "/" + m + ".nx"))
    var env: Array = []
    var e: int = 0
    while e < env_base.length() { let par: Array = env_base[e]; env.push(par); e = e + 1 }
    env.push(["NYX_LIB_UNIT", "1"])
    env.push(["NYX_LIB_SELF", m])
    env.push(["NYX_LIB_MODULES", lista])
    env.push(["NYX_SRC", lsrc])
    env.push(["NYX_SRC_DISPLAY", m + ".nx"])
    env.push(["NYX_PROJECT_DIR", orig])
    let log: String = tmpd + "/" + ks + ".log"
    write_file(log, "")
    var o = spawn_opts()
    o.stdin = Stdio.Null
    o.stdout = Stdio.File(log, "a")
    o.stderr = Stdio.File(log, "a")
    o.cwd = nyx_home
    o.env = env
    term_flush()
    match try_spawn([nyx_bin], o) {
        Result.Ok(c) => {
            j.hijo[k] = c.handle
            j.etapa[k] = 1
        }
        Result.Err(er) => {
            write_file(log, er.msg + "\n")
            j.fallo[k] = "127"
            j.etapa[k] = 9
        }
    }
    let lanzadas: int = j.cuenta[1]
    j.cuenta[1] = lanzadas + 1
    return 0
}

// Un paso de las unidades que corren: la que terminó el compilador pasa a clang
// (o termina, con rc 3 = cae al inlining, NYX0302), la que terminó clang
// publica su objeto.
fn lib_avanzar(j: LibJobs, opt_flags: String, tmpd: String) {
    var k: int = 0
    while k < j.etapa.length() {
        let e: int = j.etapa[k]
        if e == 1 or e == 2 {
            let hh: int = j.hijo[k]
            let c: Child = Child { handle: hh, program: "nyx" }
            var termino: bool = false
            var rc: int = 0
            match try_child_try_wait(c) {
                Result.Ok(op) => {
                    match op {
                        Option.Some(x) => { termino = true; rc = x }
                        Option.None => {}
                    }
                }
                Result.Err(_er) => { termino = true; rc = 1 }
            }
            if termino {
                let ks: String = int_to_string(k)
                let log: String = tmpd + "/" + ks + ".log"
                let lsrc_ll: String = tmpd + "/lib_" + ks + ".ll"
                let obj: String = j.objs[k]
                if e == 1 {
                    if rc == 3 {
                        j.avisos[k] = avisos_de(read_file(log))
                        let inl: String = j.inls[k]
                        write_file(inl, "")
                        j.etapa[k] = 9
                    } else if rc != 0 {
                        j.rc[k] = rc
                        j.fallo[k] = int_to_string(rc)
                        j.etapa[k] = 9
                    } else {
                        j.avisos[k] = avisos_de(read_file(log))
                        let argv: Array = concat(concat(["clang", "-c"], palabras(opt_flags)), ["-Wno-override-module", lsrc_ll, "-o", obj + ".tmp" + ks])
                        var o = spawn_opts()
                        o.stdin = Stdio.Null
                        o.stderr = Stdio.File(tmpd + "/" + ks + ".clang", "w")
                        term_flush()
                        match try_spawn(argv, o) {
                            Result.Ok(c2) => { j.hijo[k] = c2.handle; j.etapa[k] = 2 }
                            Result.Err(er) => {
                                write_file(tmpd + "/" + ks + ".clang", er.msg + "\n")
                                j.fallo[k] = "clang"
                                j.etapa[k] = 9
                            }
                        }
                    }
                } else {
                    if rc == 0 {
                        let _m: int = rename_file(obj + ".tmp" + ks, obj)
                    } else {
                        let _r: int = remove_file(obj + ".tmp" + ks)
                        j.fallo[k] = "clang"
                    }
                    j.etapa[k] = 9
                }
                let e2: int = j.etapa[k]
                if e2 == 9 {
                    let _a: int = remove_file(tmpd + "/lib_" + ks + ".nx")
                    let _b: int = remove_file(lsrc_ll)
                }
            }
        }
        k = k + 1
    }
    return 0
}

// nyx_lib_turno: espera un lugar libre (hasta `par` a la vez), vacía los
// avisos ya listos y dice si alguna unidad falló (entonces no se lanzan más).
// Camino rápido: sin ninguna unidad lanzada no hay nada que esperar (es el caso
// de `nyx test`, que pasa por acá en CADA archivo con todo reutilizado).
fn lib_turno(j: LibJobs, par: int, opt_flags: String, tmpd: String) -> bool {
    let lanzadas: int = j.cuenta[1]
    if lanzadas == 0 { return true }
    lib_avanzar(j, opt_flags, tmpd)
    while lib_corriendo(j) >= par {
        sleep(10)
        lib_avanzar(j, opt_flags, tmpd)
    }
    lib_vaciar(j)
    return not lib_fallo_alguna(j)
}

// NYX_J: trabajos a la vez — NYX_JOBS (lo pone `-j`), o los núcleos.
fn lib_trabajos() -> int {
    let v: String = getenv("NYX_JOBS")
    if jobs_valido(v) { return string_to_int_or(v, 1) }
    if v != "" { return 1 }
    return cpu_count()
}

fn lib_objetos(config: ProjectConfig, nyx_home: String, nyx_bin: String, opt_flags: String, gc_flag: String, gc_env: Array, orig: String, tmpd: String) -> LibRes {
    if config.lib_modules.length() == 0 { return LibRes { ok: true, objs: [], mapa: "" } }
    let lista: String = config.lib_modules.join(",")
    let ident: String = lib_identidad_compilador(nyx_bin)
    // La huella usa las banderas y el entorno del compilador COMO TEXTO, igual
    // que cuando eran parte del script: los objetos ya guardados siguen valiendo.
    let base: String = ident + "|" + opt_flags + "|" + gc_flag + "|" + lista
    var hashes: Map = Map.new()
    var imports_de: Map = Map.new()
    // Las bibliotecas del proyecto: de ellas la huella mira solo la interfaz.
    var libs_set: Map = Map.new()
    var lsi: int = 0
    while lsi < config.lib_modules.length() {
        let lsm: String = config.lib_modules[lsi]
        libs_set.insert(lsm, 1)
        lsi = lsi + 1
    }
    mkdir_p(orig + "/target/nyx-lib")
    // Candado del PROYECTO sobre target/nyx-lib, exclusivo y hasta que termina
    // esta función. Dos builds del mismo proyecto a la vez —nyxerp corre cuatro
    // `nyx test` en paralelo y cada uno pasa por `nyx_build libs`— se borraban y
    // pisaban los objetos: el borrado de los objetos viejos de una unidad se
    // llevaba el temporal que el otro build estaba escribiendo (visto el
    // 2026-10-17 en la verificación del arco build-lib-paralelo: «clang: unable to
    // rename temporary»). Con el candado, el segundo espera y después reutiliza lo
    // que el primero dejó. Si el candado no se puede tomar, se sigue sin él.
    let candado_p: String = orig + "/target/nyx-lib/.lock"
    var candado: FileLock = FileLock { handle: -1, path: "" }
    match try_lock_file_nowait(candado_p, true) {
        Result.Ok(op) => {
            match op {
                Option.Some(l) => { candado = l }
                Option.None => {
                    print("   esperando a otro build del mismo proyecto (target/nyx-lib)")
                    match try_lock_file(candado_p, true) {
                        Result.Ok(l2) => { candado = l2 }
                        Result.Err(_e) => {}
                    }
                }
            }
        }
        Result.Err(_e) => {}
    }
    let n: int = config.lib_modules.length()
    var j: LibJobs = LibJobs { mods: [], objs: [], inls: [], seguros: [], etapa: [], hijo: [], rc: [], fallo: [], avisos: [], cuenta: [0, 0] }
    var i: int = 0
    while i < n {
        let m: String = config.lib_modules[i]
        let seguro: String = m.replace("/", "_")
        let h: String = lib_huella(m, base, nyx_home + "/std", hashes, imports_de, libs_set).substring(0, 16)
        j.mods.push(m)
        j.seguros.push(seguro)
        j.objs.push(orig + "/target/nyx-lib/" + seguro + "-" + h + ".o")
        j.inls.push(orig + "/target/nyx-lib/" + seguro + "-" + h + ".inline")
        j.etapa.push(0)
        j.hijo.push(0)
        j.rc.push(0)
        j.fallo.push("")
        j.avisos.push("")
        i = i + 1
    }
    // Primera pasada, en el orden del manifiesto: cada unidad reutiliza su objeto o
    // se lanza (hasta NYX_J a la vez). Las líneas `reusing` y `compiling` salen en
    // ese orden; los avisos de cada unidad, en cuanto ella y todas las anteriores
    // terminaron. Con NYX_J=1 eso es exactamente la salida de antes del arco.
    let par: int = lib_trabajos()
    var parar: bool = false
    i = 0
    while i < n {
        if not parar and not lib_turno(j, par, opt_flags, tmpd) { parar = true }
        let m: String = j.mods[i]
        let obj: String = j.objs[i]
        let inl: String = j.inls[i]
        if not parar {
            if file_exists(obj) { print("   reusing " + m + " (lib, sin cambios)"); j.etapa[i] = 9 }
            else if file_exists(inl) { j.etapa[i] = 9 }
            else {
                print("   compiling " + m + " (lib)")
                lib_lanzar(j, i, nyx_bin, nyx_home, gc_env, lista, orig, tmpd)
            }
        } else { j.etapa[i] = 9 }
        i = i + 1
    }
    while lib_corriendo(j) > 0 {
        lib_avanzar(j, opt_flags, tmpd)
        if lib_corriendo(j) > 0 { sleep(10) }
    }
    lib_vaciar(j)
    // Segunda pasada: los errores de TODAS las unidades que fallaron, en orden, y
    // recién después los objetos y el mapa en el orden del manifiesto (enlace
    // determinista). Una unidad que no llegó a correr (por un error anterior) no
    // tiene objeto y no se enlaza: el build sale con error igual.
    var res: LibRes = LibRes { ok: true, objs: [], mapa: "" }
    var mapa: StringBuilder = StringBuilder.new()
    i = 0
    while i < n {
        let m: String = j.mods[i]
        let obj: String = j.objs[i]
        let f: String = j.fallo[i]
        let ks: String = int_to_string(i)
        if f != "" {
            res.ok = false
            if f == "clang" {
                err_line("error: clang failed (" + m + "):")
                err_print(read_file(tmpd + "/" + ks + ".clang"))
            } else {
                err_line("error: nyx compile failed (" + m + "):")
                let log: String = read_file(tmpd + "/" + ks + ".log")
                err_print(log)
                nyx_pista(string_to_int_or(f, 1))
                nyx_pista_import(log, orig)
            }
        } else if file_exists(obj) {
            res.objs.push(obj)
            mapa.append(" " + m + "=" + obj)
        }
        i = i + 1
    }
    res.mapa = mapa.to_string()
    if candado.handle >= 0 { unlock_file(candado) }
    return res
}

// `-j` / NYX_JOBS: un entero positivo escrito solo con dígitos.
fn jobs_valido(v: String) -> bool {
    if v.length() == 0 or v.length() > 4 { return false }
    var i: int = 0
    while i < v.length() {
        let c: char = v.charAt(i)
        if c < '0' or c > '9' { return false }
        i = i + 1
    }
    return string_to_int_or(v, 0) > 0
}

// Runtime precompilado AUTOMÁTICO (fricción de nyxerp, 2026-09-24): el
// runtime (~24 .c) es idéntico en cada compilación y compilarlo domina el
// costo de un build o de cada archivo de `nyx test`; NYX_RT_ARCHIVE lo
// evitaba, pero había que saber que existía y armar el .a a mano. El build lo
// arma solo, una vez, en ~/.cache/nyx/rt/<clave>/, con clave = sha256 de las
// banderas + la lista de fuentes + `clang --version` + el CONTENIDO de los
// .c/.h: un install nuevo del runtime es otra clave, así que nunca se enlaza un
// .a viejo. Se arma en un temporal y se publica con rename (atómico): dos
// compilaciones a la vez no se pisan. Cualquier falla (sin HOME escribible, sin
// ar) devuelve "" y se compilan las fuentes como siempre. NYX_NO_RT_CACHE=1 lo
// apaga; un NYX_RT_ARCHIVE explícito manda. Directorios sin usar en 14 días se
// podan. Corre dentro del candado compartido del toolchain, así que las fuentes
// no cambian mientras se calcula la clave. (test.nx tiene su propia copia, en
// bash todavía: build.nx y test.nx son programas aparte, sin módulo común. Desde
// que esta salió del script la clave no coincide con la de test.nx byte a byte
// —el orden de los .h era el del glob de bash—, así que cada uno arma su .a.)
fn h_de(dir: String) -> Array {
    var out: Array = []
    let nombres: Array = ordenar_texto(readdir(dir))
    var i: int = 0
    while i < nombres.length() {
        let n: String = nombres[i]
        if n.endsWith(".h") { out.push(dir + "/" + n) }
        i = i + 1
    }
    return out
}

fn rt_auto(fl: String, extra: Array, archivador: String, fuentes: Array, rt: String) -> String {
    if getenv("NYX_NO_RT_CACHE") != "" { return "" }
    var base: String = getenv("XDG_CACHE_HOME")
    if base == "" {
        let home: String = dir_usuario()
        if home == "" { return "" }
        base = home + "/.cache"
    }
    base = base + "/nyx/rt"
    var clave: StringBuilder = StringBuilder.new()
    // extra (rutas de Windows, que pueden traer espacios) va aparte de fl, y vacío
    // no cambia la clave de los builds de Linux.
    clave.append(fl + extra.join(" ") + "\n" + fuentes.join(" ") + "\n")
    let ver: Array = salida_de(["clang", "--version"]).split("\n")
    if ver.length() > 0 { let v0: String = ver[0]; clave.append(v0 + "\n") }
    // Los .h del motor regex vendorizado también (arco regex-windows): sus .c van en
    // `fuentes` solo en Windows, pero un cambio en tre.h tiene que invalidar la caché.
    let todo: Array = concat(concat(concat(fuentes, h_de(rt)), h_de(rt + "/os")), h_de(rt + "/vendor/tre"))
    var i: int = 0
    while i < todo.length() {
        let f: String = todo[i]
        if file_exists(f) { clave.append(read_file(f)) }
        i = i + 1
    }
    let key: String = sha256(clave.to_string()).substring(0, 16)
    let dir: String = base + "/" + key
    let a: String = dir + "/libnyxrt.a"
    if file_exists(a) {
        // Marca de uso para la poda: crear un archivo cambia el mtime del directorio.
        let _r: int = remove_file(dir + "/.usado")
        write_file(dir + "/.usado", "")
        return a
    }
    mkdir_p(dir)
    if not file_exists(dir) { return "" }
    // Poda: directorios de clave sin usar en 14 días.
    let ahora: int = time_epoch()
    let claves: Array = readdir(base)
    i = 0
    while i < claves.length() {
        let c: String = claves[i]
        let st: Array = stat(base + "/" + c)
        if st.length() >= 4 {
            let mt: int = st[2]
            let es_dir: bool = st[3]
            if es_dir and c != key and ahora - mt > 14 * 86400 { borrar_arbol(base + "/" + c, 0) }
        }
        i = i + 1
    }
    var tmp: String = ""
    var intento: int = 0
    while tmp == "" and intento < 50 {
        g_tmp_n = g_tmp_n + 1
        let t: String = dir + "/.tmp." + int_to_string(getpid()) + "_" + int_to_string(g_tmp_n)
        if mkdir(t) == 0 { tmp = t }
        intento = intento + 1
    }
    if tmp == "" { return "" }
    // Con un tope de trabajos = núcleos: con -O2 cada clang pesa varias veces más
    // que en -O0, y los 26 a la vez pedían memoria de más en una máquina chica.
    let par: int = cpu_count()
    let flags: Array = concat(palabras(fl), extra)
    var hijos: Array = []
    var objs: Array = []
    var ok: bool = true
    var n: int = 0
    while n < fuentes.length() {
        while hijos.length() >= par { hijos = rt_esperar_uno(hijos) }
        let f: String = fuentes[n]
        let o_path: String = tmp + "/" + int_to_string(n + 1) + ".o"
        objs.push(o_path)
        var o = spawn_opts()
        o.stdin = Stdio.Null
        o.stdout = Stdio.Null
        o.stderr = Stdio.Null
        o.cwd = rt + "/.."
        match try_spawn(concat(concat(["clang"], flags), ["-Wno-deprecated-declarations", "-c", f, "-o", o_path]), o) {
            Result.Ok(c) => { hijos.push(c.handle) }
            Result.Err(_e) => { ok = false }
        }
        n = n + 1
    }
    while hijos.length() > 0 { hijos = rt_esperar_uno(hijos) }
    var todos: bool = ok
    i = 0
    while i < objs.length() {
        let op: String = objs[i]
        if not file_exists(op) { todos = false }
        i = i + 1
    }
    if todos {
        var o2 = spawn_opts()
        o2.stdin = Stdio.Null
        o2.stdout = Stdio.Null
        o2.stderr = Stdio.Null
        var arc: bool = false
        match try_spawn(concat([archivador, "rcs", tmp + "/libnyxrt.a"], objs), o2) {
            Result.Ok(c) => {
                match try_child_wait(c) {
                    Result.Ok(rc) => { arc = rc == 0 }
                    Result.Err(_e) => {}
                }
            }
            Result.Err(_e) => {}
        }
        if arc and rename_file(tmp + "/libnyxrt.a", a) == 0 {
            borrar_arbol(tmp, 0)
            return a
        }
    }
    borrar_arbol(tmp, 0)
    return ""
}

// Espera a que termine alguno de los clang del runtime (sondeo cada 10 ms) y
// devuelve los que siguen corriendo. El resultado de cada uno se ve después en
// si dejó su .o.
fn rt_esperar_uno(hijos: Array) -> Array {
    while true {
        var siguen: Array = []
        var i: int = 0
        while i < hijos.length() {
            let h: int = hijos[i]
            match try_child_try_wait(Child { handle: h, program: "clang" }) {
                Result.Ok(op) => {
                    match op {
                        Option.Some(_rc) => {}
                        Option.None => { siguen.push(h) }
                    }
                }
                Result.Err(_e) => {}
            }
            i = i + 1
        }
        if siguen.length() < hijos.length() { return siguen }
        sleep(10)
    }
    return hijos
}

// Antes de compilar en cruzado: que estén lld y las bibliotecas del destino
// (multiarch de Debian/Ubuntu, D2a del spec compilacion-cruzada-linux). Sin
// esto el usuario veía un error de enlace de clang sobre `-lgc`; ahora ve qué
// falta y el comando que lo instala. No instala nada solo. `-print-file-name`
// devuelve una ruta absoluta si encuentra la biblioteca y el nombre pelado si no.
// crtbeginS.o es la señal de libgcc-N-dev del destino: sin él lld falla con
// «cannot open crtendS.o» y «-lgcc_s» (medido en el servidor el 2026-10-30, con
// las otras cinco ya instaladas). N es la versión del gcc del host, que es la
// que la distro trae para las dos arquitecturas.
fn cruzado_diag(triple: String, arch: String) -> bool {
    var deb: String = "amd64"
    if arch == "aarch64" { deb = "arm64" }
    var falta: String = ""
    match find_program("ld.lld") {
        Option.Some(_p) => {}
        Option.None => { falta = falta + " lld" }
    }
    let libs: Array = ["libc.so", "libgc.so", "libssl.so", "libcrypto.so", "libz.so", "crtbeginS.o"]
    var i: int = 0
    while i < libs.length() {
        let l: String = libs[i]
        let p: String = salida_de(["clang", "--target=" + triple, "-print-file-name=" + l]).trim()
        if not p.startsWith("/") or not file_exists(p) { falta = falta + " " + l }
        i = i + 1
    }
    if falta == "" { return true }
    var gccv: String = salida_de(["gcc", "-dumpversion"]).trim()
    if gccv.contains(".") { gccv = gccv.substring(0, gccv.indexOf(".")) }
    if gccv == "" { gccv = "14" }
    err_line("error: para compilar en cruzado a " + triple + " faltan:" + falta)
    err_line("  instálalas con: sudo dpkg --add-architecture " + deb + " && sudo apt update && \\")
    err_line("    sudo apt install libc6-dev:" + deb + " libgc-dev:" + deb + " libssl-dev:" + deb + " zlib1g-dev:" + deb + " libgcc-" + gccv + "-dev:" + deb + " lld")
    return false
}

// ===== Windows (W6 Task 4) =====
// El compilador y el enlace corren EN Windows (D1 = (a)); desde Linux x86_64-pc-windows-msvc
// también se arma cruzado (arco win-cross); aarch64-pc-windows-msvc se rechaza (D6).
fn triple_win() -> String { return "x86_64-pc-windows-msvc" }
fn host_es_windows() -> bool { return host_os() == "windows" }
fn es_triple_windows(t: String) -> bool { return t == triple_win() or t == "aarch64-pc-windows-msvc" }

// Directorio del usuario: en Windows es USERPROFILE (HOME solo existe bajo Git Bash/MSYS y
// allí es una ruta /c/Users/... que las herramientas nativas no entienden), con HOME de
// respaldo; en el resto, HOME. Mismo criterio en resolve/codegen/nyx (dir_usuario_*).
fn dir_usuario() -> String {
    if host_es_windows() {
        let up: String = getenv("USERPROFILE")
        if up != "" { return up }
    }
    return getenv("HOME")
}

// Android arm64 / Termux (arco target-android). Las dependencias (sysroot de bionic,
// compiler-rt, libunwind, bdwgc y OpenSSL estáticos) las arma
// scripts/build_android_deps.sh del repo del lenguaje; viven en NYX_ANDROID_DEPS o,
// por omisión, en ~/.cache/nyx-android-deps. El nivel de API sale del archivo API.
fn triple_android() -> String { return "aarch64-linux-android" }

fn android_deps_dir() -> String {
    let d: String = getenv("NYX_ANDROID_DEPS")
    if d != "" { return d }
    return dir_usuario() + "/.cache/nyx-android-deps"
}

fn android_api(d: String) -> String {
    if file_exists(d + "/API") { return read_file(d + "/API").trim() }
    return "24"
}

// Comprueba que las dependencias estén ANTES de compilar: sin ellas el usuario
// veía un error de clang sobre un header.
fn android_deps_ok(d: String) -> bool {
    var falta: bool = false
    if not file_exists(d + "/sysroot") { falta = true }
    if not file_exists(d + "/include/gc.h") { falta = true }
    if not file_exists(d + "/lib/libgc.a") or not file_exists(d + "/lib/libssl.a") or not file_exists(d + "/lib/libcrypto.a") { falta = true }
    if not file_exists(d + "/clang-rt/libclang_rt.builtins-aarch64-android.a") or not file_exists(d + "/clang-rt/libunwind.a") { falta = true }
    if falta {
        err_line("error: faltan las dependencias para Android arm64 en " + d)
        err_line("  arma el sysroot y las bibliotecas con: scripts/build_android_deps.sh ~/.cache/nyx-android-deps")
        err_line("  (el script vive en el repo del lenguaje; NYX_ANDROID_DEPS=<dir> apunta a otro lugar)")
        return false
    }
    return true
}

// Banderas comunes de compilación (runtime, [lib] y src.ll). -fno-emulated-tls es
// obligatorio: sin él los _Thread_local del runtime van por emutls. Nunca -I<runtime>
// (eclipsaría time.h/strings.h del sistema) y no se pasa -D__ANDROID_API__.
fn android_cflags(d: String) -> String {
    return " --target=aarch64-linux-android" + android_api(d) + " --sysroot=" + d + "/sysroot -fno-emulated-tls -fPIC -Wno-override-module -I" + d + "/include"
}

struct RecetaWin {
    ok: bool,
    cflags: Array,    // para compilar el runtime
    ldflags: Array,   // lo que va al final del enlace
    ar: String        // archivador del runtime (llvm-ar, o llvm-ar-<N> si solo hay el sufijado)
}

// Primer nombre de `nombres` que está en PATH, o "".
fn primer_programa(nombres: Array) -> String {
    var i: int = 0
    while i < nombres.length() {
        let p: String = nombres[i]
        match find_program(p) {
            Option.Some(_r) => { return p }
            Option.None => {}
        }
        i = i + 1
    }
    return ""
}

// Archivo que puede estar con otra capitalización (xwin deja LIBCMT.lib y libcmt.lib).
fn existe_alguno(dir: String, nombres: Array) -> bool {
    var i: int = 0
    while i < nombres.length() {
        let n: String = nombres[i]
        if file_exists(dir + "/" + n) { return true }
        i = i + 1
    }
    return false
}

// Comprueba TODO lo que el enlace necesita ANTES de compilar: sin esto el usuario
// veía un error de clang sobre un header o, peor, un .exe que pide gc.dll.
// - bdwgc: el parcheado de W3 (enable_large_config=ON), ESTÁTICO y /MT. Con
//   gc.dll al lado de gc.lib, ese gc.lib es la biblioteca de importación: el .exe
//   no arrancaría solo (Step 5 del spike).
// - OpenSSL: openssl:x64-windows-static de vcpkg. Se pide siempre, porque el
//   runtime se arma una sola vez en la caché, con tls.c y crypto.c adentro; como
//   va en un archivador, solo el programa que los usa arrastra OpenSSL al .exe.
// Fuera de Windows (arco win-cross) las piezas vienen de dos directorios:
// NYX_WIN_SYSROOT (xwin splat: crt/ y sdk/) y NYX_WIN_DEPS (scripts/build_win_deps.sh).
fn receta_windows(nyx_home: String) -> RecetaWin {
    var falta: Array = []
    var ar: String = ""
    let cruzado: bool = not host_es_windows()
    match find_program("clang") {
        Option.Some(_r) => {}
        Option.None => { falta.push("clang no está en PATH (viene con LLVM)") }
    }
    match find_program("lld-link") {
        Option.Some(_r) => {}
        Option.None => { falta.push("lld-link no está en PATH (viene con LLVM; en Debian: apt install lld)") }
    }
    if cruzado {
        ar = primer_programa(["llvm-ar", "llvm-ar-21", "llvm-ar-20", "llvm-ar-19", "llvm-ar-18", "llvm-ar-17", "llvm-ar-16", "llvm-ar-15"])
        if ar == "" { falta.push("llvm-ar no está en PATH (viene con LLVM; en Debian: apt install llvm)") }
    } else {
        ar = "llvm-ar"
        match find_program(ar) {
            Option.Some(_r) => {}
            Option.None => { falta.push("llvm-ar no está en PATH (viene con LLVM)") }
        }
    }
    var cflags: Array = ["-D_CRT_SECURE_NO_WARNINGS"]
    var ldflags: Array = []
    if cruzado {
        let sysroot: String = getenv("NYX_WIN_SYSROOT")
        let deps: String = getenv("NYX_WIN_DEPS")
        var sys_ok: bool = sysroot != ""
        if sys_ok and (not file_exists(sysroot + "/crt/include/vcruntime.h") or not existe_alguno(sysroot + "/crt/lib/x86_64", ["libcmt.lib", "LIBCMT.lib"])
                or not file_exists(sysroot + "/sdk/include/ucrt") or not file_exists(sysroot + "/sdk/include/um") or not file_exists(sysroot + "/sdk/include/shared")) {
            sys_ok = false
        }
        if not sys_ok {
            falta.push("NYX_WIN_SYSROOT: el sysroot de Windows (crt/ y sdk/) armado con `xwin --accept-license splat --output <dir>` (acepta la licencia de Microsoft)")
        }
        var deps_ok: bool = deps != ""
        if deps_ok and (not file_exists(deps + "/include/gc.h") or not file_exists(deps + "/include/openssl/ssl.h") or not file_exists(deps + "/lib/gc.lib")
                or not file_exists(deps + "/lib/libssl.lib") or not file_exists(deps + "/lib/libcrypto.lib")) {
            deps_ok = false
        }
        if not deps_ok {
            falta.push("NYX_WIN_DEPS: bdwgc y OpenSSL estáticos para Windows (include/ y lib/{gc,libssl,libcrypto}.lib); se arman con scripts/build_win_deps.sh")
        }
        if falta.length() == 0 {
            // -ffile-prefix-map: que el .exe no lleve rutas de esta máquina (__FILE__ del runtime).
            // -mno-incremental-linker-compatible: sin fecha en el .obj (reproducible).
            cflags = ["-D_CRT_SECURE_NO_WARNINGS", "-D_MT", "-mno-incremental-linker-compatible",
                "-isystem", sysroot + "/crt/include", "-isystem", sysroot + "/sdk/include/ucrt",
                "-isystem", sysroot + "/sdk/include/um", "-isystem", sysroot + "/sdk/include/shared",
                "-I" + deps + "/include", "-ffile-prefix-map=" + nyx_home + "=/nyx"]
            ldflags = ["-Wl,/libpath:" + sysroot + "/crt/lib/x86_64", "-Wl,/libpath:" + sysroot + "/sdk/lib/um/x86_64",
                "-Wl,/libpath:" + sysroot + "/sdk/lib/ucrt/x86_64", "-L" + deps + "/lib", "-lgc", "-llibssl", "-llibcrypto",
                "-lcrypt32", "-lws2_32", "-luser32", "-ladvapi32", "-liphlpapi", "-lsetupapi", "-Wl,/Brepro"]
        }
    } else {
        let gc_inc: String = getenv("NYX_GC_INCLUDE")
        let gc_lib: String = getenv("NYX_GC_LIBDIR")
        if gc_inc == "" or not file_exists(gc_inc + "/gc.h") {
            falta.push("NYX_GC_INCLUDE: el directorio con gc.h de bdwgc")
        }
        if gc_lib == "" or not file_exists(gc_lib + "/gc.lib") {
            falta.push("NYX_GC_LIBDIR: el directorio con el gc.lib ESTÁTICO de bdwgc (/MT, enable_large_config=ON)")
        } else if file_exists(gc_lib + "/gc.dll") {
            falta.push("NYX_GC_LIBDIR apunta a un bdwgc dinámico (hay un gc.dll en " + gc_lib + "): el .exe pediría gc.dll; hace falta el estático")
        }
        let vcpkg: String = getenv("VCPKG_ROOT")
        let ossl: String = vcpkg + "/installed/x64-windows-static"
        if vcpkg == "" or not file_exists(ossl + "/lib/libssl.lib") or not file_exists(ossl + "/include/openssl/ssl.h") {
            falta.push("VCPKG_ROOT: un vcpkg con OpenSSL estático (vcpkg install openssl:x64-windows-static)")
        }
        if falta.length() == 0 {
            cflags = ["-D_CRT_SECURE_NO_WARNINGS", "-I" + gc_inc, "-I" + ossl + "/include"]
            ldflags = ["-L" + gc_lib, "-lgc", "-L" + ossl + "/lib", "-llibssl", "-llibcrypto",
                "-lcrypt32", "-lws2_32", "-luser32", "-ladvapi32"]
        }
    }
    if falta.length() > 0 {
        err_line("error: para armar un .exe falta:")
        var i: int = 0
        while i < falta.length() { let m: String = falta[i]; err_line("  - " + m); i = i + 1 }
        return RecetaWin { ok: false, cflags: [], ldflags: [], ar: "" }
    }
    return RecetaWin { ok: true, cflags: cflags, ldflags: ldflags, ar: ar }
}

// NYX_HOME → ~/.nyx → el directorio actual si tiene nyx_bootstrap (monorepo).
// Absoluto: los hijos corren con cwd = NYX_HOME.
fn build_nyx_home() -> String {
    var nyx_home: String = getenv("NYX_HOME")
    if nyx_home == "" {
        let home_dir: String = dir_usuario()
        if home_dir != "" and file_exists(home_dir + "/.nyx/runtime/runtime.c") { nyx_home = home_dir + "/.nyx" }
    }
    if nyx_home == "" and (file_exists("nyx_bootstrap") or file_exists("nyx_bootstrap.exe")) { nyx_home = "." }
    if nyx_home == "" { return "" }
    return absoluta(nyx_home)
}

// El compilador: nyx_bootstrap (monorepo) o bin/nyx (instalado).
fn build_nyx_bin(nyx_home: String) -> String {
    if host_es_windows() {
        let boot_exe: String = nyx_home + "/nyx_bootstrap.exe"
        if file_exists(boot_exe) { return boot_exe }
        return nyx_home + "/bin/nyx.exe"
    }
    var nyx_bin: String = nyx_home + "/nyx_bootstrap"
    if not file_exists(nyx_bin) { nyx_bin = nyx_home + "/bin/nyx" }
    return nyx_bin
}

// Candado del toolchain, COMPARTIDO: un `make install-local` lo toma
// EXCLUSIVO, así que no puede cambiar el compilador ni la stdlib a mitad de
// esta compilación (contrato en CLAUDE.md §Sesiones paralelas, 2026-09-20). Si
// no se puede tomar no se bloquea nada, como sin flock en la máquina.
fn candado_toolchain(nyx_home: String) -> FileLock {
    match try_lock_file(nyx_home + "/.toolchain.lock", false) {
        Result.Ok(l) => { return l }
        Result.Err(_e) => { return FileLock { handle: -1, path: "" } }
    }
}

// `NYX_NO_GC=1 NYX_TARGET=x ` (el prefijo de entorno del script, que sigue
// entrando así en la huella de [lib]) como pares para SpawnOpts.env.
fn env_de_prefijo(prefijo: String) -> Array {
    var out: Array = []
    let partes: Array = palabras(prefijo)
    var i: int = 0
    while i < partes.length() {
        let p: String = partes[i]
        let eq: int = p.indexOf("=")
        if eq > 0 { out.push([p.substring(0, eq), p.substring(eq + 1, p.length())]) }
        i = i + 1
    }
    return out
}

// `nyx_build libs [--release]` — interno, lo llama `nyx test`. Construye (o
// reutiliza) los objetos de `[lib] modules` con la MISMA huella y el mismo
// caché que `nyx build`, y deja en stdout una línea
//   NYX_LIB_MAP: src/a=/ruta/a.o src/b=/ruta/b.o
// con los que se pueden enlazar (un módulo que cae al inlining, NYX0302, no
// aparece). Así una suite de pruebas compila cada biblioteca UNA vez y cada
// archivo de prueba solo la enlaza — donde nyxerp paga el costo de hoy.
fn run_libs(config: ProjectConfig, release: bool) -> bool {
    let nyx_home: String = build_nyx_home()
    if nyx_home == "" {
        print("error: NYX_HOME not set and nyx not installed (~/.nyx/)")
        return false
    }
    let nyx_bin: String = build_nyx_bin(nyx_home)
    var opt_flags: String = ""
    if release { opt_flags = "-O2" }
    var gc_flag: String = ""
    if config.no_gc { gc_flag = "NYX_NO_GC=1 " }
    let orig: String = getcwd()
    let tmpd: String = tmp_dir_propio("nyx_libs_")
    if tmpd == "" {
        err_line("error: no se pudo crear un directorio temporal en " + temp_dir())
        return false
    }
    let candado: FileLock = candado_toolchain(nyx_home)
    pila_compilador_subir()
    let r: LibRes = lib_objetos(config, nyx_home, nyx_bin, opt_flags, gc_flag, env_de_prefijo(gc_flag), orig, tmpd)
    pila_compilador_restaurar()
    if candado.handle >= 0 { unlock_file(candado) }
    borrar_arbol(tmpd, 0)
    if not r.ok { return false }
    print("NYX_LIB_MAP:" + r.mapa)
    return true
}

fn run_build(config: ProjectConfig, release: bool, target_flag: String) -> bool {
    // target efectivo: flag CLI > [build] target del nyx.toml
    var eff_target: String = config.target
    if target_flag != "" { eff_target = target_flag }
    let host_win: bool = host_es_windows()
    var tgt_note = ""
    if eff_target != "" { tgt_note = " [" + eff_target + "]" }
    print("-> building " + config.name + " v" + config.version + tgt_note)

    // Resolve dependencies
    let deps_ok: bool = resolve_deps(config)
    if deps_ok == false { return false }

    // Check that main file exists
    if not file_exists(config.main_file) {
        print("error: main file not found: " + config.main_file)
        return false
    }

    // Determine NYX_NO_GC flag
    var gc_flag = ""
    if config.no_gc { gc_flag = "NYX_NO_GC=1 " }

    print("   compiling " + config.main_file)

    var output_name: String = config.name
    if config.bin_name != "" { output_name = config.bin_name }
    // El binario de un `--main` va a target/, no a la raíz. En la raíz, el
    // .gitignore que siembra `nyx init` no lo cubría (solo /<name>), y ningún
    // patrón lo arregla sin tapar archivos legítimos: `/<name>-*` escondería
    // en silencio un script `miapp-deploy` del usuario. target/ ya está
    // ignorado y es donde wasm deja sus artefactos. El binario principal no se
    // mueve: `./<name>` es contrato de `nyx run` y de los deploys.
    var native_out: String = output_name
    var native_dir: String = ""
    if config.bin_name != "" {
        native_out = "target/" + output_name
        native_dir = "target"
    }
    var opt_flags = ""
    if release { opt_flags = "-O2" }

    // Destino Linux explícito (arco compilacion-cruzada-linux): el IR no depende
    // de la arquitectura y el runtime se compila de fuentes en cada build, así
    // que cruzar es pasarle `--target` a los tres clang (enlace, [lib] modules y
    // la caché del runtime) y enlazar con lld, que conoce los dos destinos. El
    // artefacto va a target/<triple>/ como el de wasm, para no pisar el binario
    // nativo. El triple del propio host vale también: compila nativo, sin
    // banderas de más. El host se mira con host_arch() (el `uname -m`).
    var linux_arch: String = ""
    if eff_target == "x86_64-unknown-linux-gnu" { linux_arch = "x86_64" }
    if eff_target == "aarch64-unknown-linux-gnu" { linux_arch = "aarch64" }
    // Con un espacio adelante, o vacías: el build nativo arma exactamente las
    // mismas banderas que antes y sus cachés (runtime y [lib]) no cambian de clave.
    var tgt_cc: String = ""
    var tgt_ld: String = ""
    var cruzado: bool = false
    if linux_arch != "" {
        native_out = "target/" + eff_target + "/" + output_name
        native_dir = "target/" + eff_target
        if host_arch() != linux_arch {
            tgt_cc = " --target=" + eff_target
            tgt_ld = tgt_cc + " -fuse-ld=lld"
            cruzado = true
            // El compilador también lo sabe: triple del módulo y guarda de asm.
            // Va con gc_flag, que es prefijo de entorno del compilador y entra
            // en la huella de [lib] modules.
            gc_flag = gc_flag + "NYX_TARGET=" + eff_target + " "
        }
    }
    // Android arm64 (arco target-android): clang + lld contra el sysroot de bionic de
    // build_android_deps.sh. PIE dinámico (linker64) por omisión; NYX_ANDROID_STATIC=1
    // lo arma estático, SOLO para probarlo en un Linux arm64 normal: sin dlopen no
    // andan sqlite ni el inflate de zlib.
    let android: bool = eff_target == triple_android()
    if android and not host_win {
        let ad: String = android_deps_dir()
        if not android_deps_ok(ad) { return false }
        native_out = "target/" + eff_target + "/" + output_name
        native_dir = "target/" + eff_target
        // -ffile-prefix-map: que el binario no lleve rutas de esta máquina (__FILE__ de
        // crypto.c/tls.c), igual que el .exe de win-cross (fricción nyxerp 2026-11-07).
        tgt_cc = android_cflags(ad) + " -ffile-prefix-map=" + build_nyx_home() + "=/nyx -ffile-prefix-map=" + ad + "=/nyx-android-deps"
        tgt_ld = tgt_cc + " -fuse-ld=lld -nodefaultlibs"
        if getenv("NYX_ANDROID_STATIC") == "1" { tgt_ld = tgt_ld + " -static" }
        gc_flag = gc_flag + "NYX_TARGET=" + eff_target + " "
    }
    if host_win and (linux_arch != "" or android) {
        print("error: desde Windows no se compila para " + eff_target)
        print("  en Windows, nyx build arma el .exe de esta máquina; para Linux, compila en Linux")
        return false
    }
    // En Windows el build nativo ES el de Windows, con o sin --target.
    if host_win and eff_target == "" { eff_target = triple_win() }
    // Desde Linux (arco win-cross) el triple de Windows x86_64 también arma el .exe,
    // con clang + lld-link y un sysroot de xwin (receta_windows).
    if eff_target == triple_win() and (not host_win or host_arch() == "x86_64") {
        native_out = "target/" + output_name + ".exe"
        native_dir = "target"
        tgt_cc = " --target=" + eff_target
        tgt_ld = tgt_cc + " -fuse-ld=lld-link"
        gc_flag = gc_flag + "NYX_TARGET=" + eff_target + " "
    }
    let link_flags: String = opt_flags + tgt_ld

    // Target WASM: subset portable del runtime, clang wasm32-wasi (paquetes
    // Debian: wasi-libc + libclang-rt wasm32 + lld), NYX_NO_GC forzado (no hay
    // Boehm en wasm) y salida <name>.wasm. Esto reemplaza el "exporta
    // NYX_TARGET a mano": [build] target en nyx.toml o `nyx build --target
    // wasm32-wasi` alcanzan.
    // Un TRIPLE desconocido construía NATIVO y salía 0: `--target wasm32-wasy`
    // (con typo) producía un ELF aarch64 mientras el banner decía
    // «[wasm32-wasy]». El valor nunca llegaba al compilador —que sí lo habría
    // rechazado— porque esta rama solo mira si es exactamente "wasm32-wasi".
    // Pedir wasm y recibir nativo sin una palabra es la misma familia que la
    // flag desconocida que se arregló hoy, un nivel más adentro: en el VALOR.
    // (fricción nyxerp 2026-09-10)
    if eff_target != "" and eff_target != "wasm32-wasi" and linux_arch == "" and not android {
        if eff_target != "x86_64-pc-windows-msvc" and eff_target != "aarch64-pc-windows-msvc" {
            print("error: target desconocido: " + eff_target)
            print("  targets soportados: x86_64-unknown-linux-gnu, aarch64-unknown-linux-gnu, aarch64-linux-android, x86_64-pc-windows-msvc y wasm32-wasi")
            print("  (sin --target se compila para la plataforma actual)")
            return false
        }
        // Un triple de Windows fuera de Windows caía al build NATIVO, imprimía
        // «build complete» y salía 0 con un ELF donde se pidió un .exe (fricción
        // nyxerp 2026-10-29): se rechaza con su motivo. En Windows x86_64 sigue de
        // largo; ARM64 no está medido.
        if eff_target != triple_win() or (host_win and host_arch() != "x86_64") {
            print("error: nyx build todavía no arma ejecutables para " + eff_target + " desde esta máquina")
            print("  desde Linux se arma x86_64-pc-windows-msvc (cruzado) y en Windows x86_64 el nativo;")
            print("  ARM64 todavía no está medido")
            return false
        }
    }

    let nyx_home: String = build_nyx_home()
    if nyx_home == "" {
        print("error: NYX_HOME not set and nyx not installed (~/.nyx/)")
        return false
    }
    let nyx_bin: String = build_nyx_bin(nyx_home)
    let rt: String = nyx_home + "/runtime"
    let orig: String = getcwd()

    // Scratch único por proceso (el mktemp de antes), no el script.nx/script.ll
    // compartido de NYX_HOME — dos `nyx build` concurrentes pisaban el .nx/.ll
    // ajeno (carrera real, ver TASKS.md). El driver deriva el .ll de NYX_SRC.
    let tmpd: String = tmp_dir_propio("nyx_build_")
    if tmpd == "" {
        err_line("error: no se pudo crear un directorio temporal en " + temp_dir())
        return false
    }
    let candado: FileLock = candado_toolchain(nyx_home)
    pila_compilador_subir()
    var ok: bool = false
    if eff_target == "wasm32-wasi" {
        ok = build_wasm(config, output_name, nyx_home, nyx_bin, rt, orig, tmpd)
    } else {
        ok = build_nativo(config, opt_flags, tgt_cc, link_flags, gc_flag, cruzado, eff_target, linux_arch, native_out, native_dir, nyx_home, nyx_bin, rt, orig, tmpd)
    }
    pila_compilador_restaurar()
    if candado.handle >= 0 { unlock_file(candado) }
    borrar_arbol(tmpd, 0)
    return ok
}

fn build_nativo(config: ProjectConfig, opt_flags: String, tgt_cc: String, link_flags: String, gc_flag: String, cruzado: bool, eff_target: String, linux_arch: String, native_out: String, native_dir: String, nyx_home: String, nyx_bin: String, rt: String, orig: String, tmpd: String) -> bool {
    if cruzado and not cruzado_diag(eff_target, linux_arch) { return false }
    // El runtime: sus 24 fuentes, o un archivo precompilado si NYX_RT_ARCHIVE
    // apunta a uno que EXISTE — el mismo contrato que `nyx test` (test.nx) y los
    // scripts internos. Pedido de nyxerp (fricción 20260917-234222-team-1: «que
    // `nyx test` y `nyx build` honren NYX_RT_ARCHIVE»); build faltaba. Compilar
    // el runtime domina el costo de un build chico: sin esto, la compilación
    // separada ([lib] modules) no se podía medir.
    var nombres: Array = ["runtime.c", "strings.c", "runtime-arrays.c", "maps.c", "file-io.c", "iterators.c", "net.c", "thread.c", "regex.c",
        "time.c", "crypto.c", "tls.c", "scheduler.c", "event_loop.c", "sqlite_adapter.c",
        "compress.c", "random.c", "url.c", "msgpack.c", "csv.c", "websocket.c", "persist.c",
        // llama_adapter va SIEMPRE: es dlopen-lazy (cero dependencia dura de
        // libllama) y sin él todo import de std/llm muere en el LINK con
        // "undefined reference to nyx_llm_*" (friction A10, 2026-07-31).
        "http2.c", "process.c", "llama_adapter.c", "os/os_posix.c"]
    // Windows: sin los que son solo posix. process.c es fork/exec (std/process va
    // por os_win32.c). regex.c sí va: la CRT de MSVC no trae <regex.h>, así que en
    // Windows usa el TRE de musl vendorizado en runtime/vendor/tre (arco
    // regex-windows, 2026-11-08); hasta entonces std/regex no enlazaba ahí.
    let win: bool = es_triple_windows(eff_target)
    var cc_win: Array = []
    var ld_win: Array = []
    var win_ar: String = "llvm-ar"
    if win {
        let rw: RecetaWin = receta_windows(nyx_home)
        if not rw.ok { return false }
        win_ar = rw.ar
        cc_win = rw.cflags
        ld_win = rw.ldflags
        nombres = ["runtime.c", "strings.c", "runtime-arrays.c", "maps.c", "file-io.c", "iterators.c", "net.c", "thread.c",
            "time.c", "crypto.c", "tls.c", "scheduler.c", "sqlite_adapter.c",
            "compress.c", "random.c", "url.c", "msgpack.c", "csv.c", "websocket.c", "persist.c",
            "http2.c", "llama_adapter.c", "os/event_loop_win32.c", "os/os_win32.c",
            "regex.c", "vendor/tre/regcomp.c", "vendor/tre/regexec.c", "vendor/tre/tre-mem.c", "vendor/tre/regerror.c"]
    }
    var fuentes: Array = []
    var i: int = 0
    while i < nombres.length() { let nm: String = nombres[i]; fuentes.push(rt + "/" + nm); i = i + 1 }
    var rt_in: Array = fuentes
    var rt_archive: String = getenv("NYX_RT_ARCHIVE")
    if rt_archive != "" and file_exists(rt_archive) {
        rt_in = [absoluta(rt_archive)]
    } else {
        // El runtime va SIEMPRE con -O2, también sin --release (2026-10-27): es
        // código nuestro que nadie depura desde un programa Nyx, y a -O0 todo lo
        // que vive en C (cripto, JSON, strings, red) corría ~7 veces más lento
        // —nyxerp midió PBKDF2 así y lo reportó como lentitud de la función—. Va
        // a la caché, así que se compila una sola vez; el código del usuario sigue
        // con opt_flags. Las banderas del destino entran en la clave de la caché:
        // sin eso un libnyxrt.a de x86_64 se enlazaría en un build de aarch64.
        var archivador: String = "ar"
        if win { archivador = win_ar }
        let a: String = rt_auto("-O2" + tgt_cc, cc_win, archivador, fuentes, rt)
        if a != "" { rt_in = [a] }
    }
    // [lib] modules: bibliotecas compiladas aparte y reutilizadas (Task 6 de
    // compilacion-separada). Solo nativo: en wasm se inlinean como siempre.
    // tgt_cc va con opt_flags: entra en la huella de la caché de bibliotecas y
    // en su `clang -c`.
    let gc_env: Array = env_de_prefijo(gc_flag)
    var lib_objs: Array = []
    var env: Array = gc_env
    if config.lib_modules.length() > 0 {
        let r: LibRes = lib_objetos(config, nyx_home, nyx_bin, opt_flags + tgt_cc, gc_flag, gc_env, orig, tmpd)
        if not r.ok { return false }
        lib_objs = r.objs
        env = concat_env(gc_env, [["NYX_LIB_MODULES", config.lib_modules.join(",")]])
    }
    let srcnx: String = tmpd + "/src.nx"
    let srcll: String = tmpd + "/src.ll"
    write_file(srcnx, read_file(orig + "/" + config.main_file))
    env = concat_env(env, [["NYX_SRC", srcnx], ["NYX_SRC_DISPLAY", config.main_file], ["NYX_PROJECT_DIR", orig]])
    let log: String = tmpd + "/log"
    let rc: int = correr_a_log([nyx_bin], nyx_home, env, log)
    if rc != 0 {
        err_line("error: nyx compile failed:")
        err_print(read_file(log))
        nyx_pista(rc)
        return false
    }
    // Los avisos (⚠, NYX0302, W1xx) se mostraban SOLO si la compilación
    // fallaba: con éxito el log se tiraba entero. Requisito del
    // task-5-report de compilacion-separada: «el compilador lo DICE».
    err_print(avisos_de(read_file(log)))
    if native_dir != "" { mkdir_p(orig + "/" + native_dir) }
    var argv: Array = concat(concat(["clang"], palabras(link_flags)), [srcll])
    // Sin caché, el runtime entra en fuentes sueltas y necesita las -I acá.
    if win { argv = concat(argv, concat(["-Wno-unused-command-line-argument", "-Wno-deprecated-declarations"], cc_win)) }
    argv = concat(concat(argv, lib_objs), rt_in)
    if win {
        argv = concat(argv, concat(ld_win, ["-o", orig + "/" + native_out]))
    } else if eff_target == triple_android() {
        // bionic: pthread vive en libc (sin -lpthread); compiler-rt y libunwind
        // vienen del directorio de deps porque se enlaza con -nodefaultlibs.
        let ad: String = android_deps_dir()
        argv = concat(argv, ["-L" + ad + "/lib", "-lgc", "-lz", "-lssl", "-lcrypto", "-lm", "-lc", "-ldl",
            ad + "/clang-rt/libclang_rt.builtins-aarch64-android.a", ad + "/clang-rt/libunwind.a", "-o", orig + "/" + native_out])
    } else {
        argv = concat(argv, ["-lgc", "-lpthread", "-ldl", "-lm", "-lssl", "-lcrypto", "-lz", "-o", orig + "/" + native_out])
    }
    let lrc: int = correr_err_a(argv, nyx_home, log)
    if lrc != 0 {
        let txt: String = read_file(log)
        err_line("error: clang link failed:")
        clang_failure_attribution(txt, config.main_file)
        err_print(txt)
        return false
    }
    print("✓ Built: " + native_out)
    return true
}

fn concat_env(a: Array, b: Array) -> Array {
    var out: Array = []
    var i: int = 0
    while i < a.length() { let x: Array = a[i]; out.push(x); i = i + 1 }
    i = 0
    while i < b.length() { let y: Array = b[i]; out.push(y); i = i + 1 }
    return out
}

fn build_wasm(config: ProjectConfig, output_name: String, nyx_home: String, nyx_bin: String, rt: String, orig: String, tmpd: String) -> bool {
    var sysroot: String = getenv("WASI_SYSROOT")
    if sysroot == "" { sysroot = "/usr" }
    if not file_exists(sysroot + "/lib/wasm32-wasi/libc.a") {
        err_line("error: wasi-libc no encontrado - sudo apt install wasi-libc libclang-rt-19-dev-wasm32 lld-19")
        return false
    }
    let srcnx: String = tmpd + "/src.nx"
    let srcll: String = tmpd + "/src.ll"
    write_file(srcnx, read_file(orig + "/" + config.main_file))
    let log: String = tmpd + "/log"
    let env: Array = [["NYX_TARGET", "wasm32-wasi"], ["NYX_NO_GC", "1"], ["NYX_SRC", srcnx], ["NYX_SRC_DISPLAY", config.main_file], ["NYX_PROJECT_DIR", orig]]
    if correr_a_log([nyx_bin], nyx_home, env, log) != 0 {
        err_line("error: nyx compile failed:")
        err_print(read_file(log))
        return false
    }
    // La lista de fuentes sale de runtime/wasm.srcs, no de una copia acá: era
    // la TERCERA (Makefile, run_wasm_tests.sh y esta), con un comentario que
    // decía «mantener en sync» — o sea, a mano. Cuando W1 sumó os_wasm.c hubo
    // que agregarlo a las tres, y olvidarse de una rompe el link con símbolos
    // os_* indefinidos.
    var wasm_srcs: Array = []
    if file_exists(rt + "/wasm.srcs") {
        let lineas: Array = read_file(rt + "/wasm.srcs").split("\n")
        var i: int = 0
        while i < lineas.length() {
            let l0: String = lineas[i]
            let l: String = l0.trim()
            if l != "" and not l.startsWith("#") {
                if l.startsWith("runtime/") { wasm_srcs.push(rt + "/" + l.substring(8, l.length())) } else { wasm_srcs.push(l) }
            }
            i = i + 1
        }
    }
    if wasm_srcs.length() == 0 {
        err_line("error: runtime/wasm.srcs vacío o ausente en " + rt)
        return false
    }
    mkdir_p(orig + "/target/wasm32-wasi")
    let wasm: String = orig + "/target/wasm32-wasi/" + output_name + ".wasm"
    var argv: Array = ["clang", "--target=wasm32-wasi", "--sysroot=" + sysroot, "-O2", "-I" + rt + "/wasi",
        "-Wl,-z,stack-size=1048576", "-Wl,--export-table", srcll]
    argv = concat(concat(argv, wasm_srcs), ["-o", wasm])
    if correr_err_a(argv, nyx_home, log) != 0 {
        let txt: String = read_file(log)
        err_line("error: clang wasm link failed:")
        clang_failure_attribution(txt, config.main_file)
        err_print(txt)
        return false
    }
    // Asyncify (arco async-real-wasm, D-5): solo si el compilador dejó en el .ll
    // la lista de imports que suspenden. Sin esa línea no se toca nada: el .wasm
    // sale byte a byte como antes y binaryen no hace falta. Con la línea y sin
    // wasm-opt, error con la receta — nunca un .wasm que trapea al primer await.
    var asy: String = ""
    let marca: String = "; nyx-asyncify-imports: "
    let ll_lineas: Array = read_file(srcll).split("\n")
    var li: int = 0
    while li < ll_lineas.length() and asy == "" {
        let l: String = ll_lineas[li]
        if l.startsWith(marca) { asy = l.substring(marca.length(), l.length()) }
        li = li + 1
    }
    if asy != "" {
        var wopt: String = getenv("NYX_WASM_OPT")
        if wopt == "" {
            match find_program("wasm-opt") {
                Option.Some(p) => { wopt = p }
                Option.None => {}
            }
        }
        if wopt == "" {
            err_line("error: el programa usa imports que suspenden (await que espera al anfitrion: " + asy + ") y falta wasm-opt - sudo apt install binaryen, o NYX_WASM_OPT=/ruta/a/wasm-opt")
            return false
        }
        if correr_err_a([wopt, wasm, "--asyncify", "--pass-arg=asyncify-imports@" + asy, "-O2", "-o", wasm], nyx_home, log) != 0 {
            err_line("error: wasm-opt --asyncify fallo:")
            err_print(read_file(log))
            return false
        }
    }
    print("built target/wasm32-wasi/" + output_name + ".wasm (run: wasmtime target/wasm32-wasi/" + output_name + ".wasm)")
    return true
}

fn print_info(config: ProjectConfig) {
    print("Project: " + config.name)
    print("Version: " + config.version)
    print("Main:    " + config.main_file)
    if config.target != "" {
        print("Target:  " + config.target)
    }
    if config.description != "" {
        print("Desc:    " + config.description)
    }
    if config.no_gc {
        print("Mode:    no-GC (systems)")
    } else {
        print("Mode:    GC (default)")
    }
}

// `--main <archivo.nx>`: compilar otro punto de entrada del MISMO proyecto
// (fricción nyxerp 2026-09-14). El caso que lo pidió: un main que dibuja (puro)
// y sirve (sockets) no compila a wasm, y la parte pura no tenía cómo viajar sola
// sin partir el repositorio en dos. La ruta es relativa a la raíz del proyecto,
// igual que `main` en nyx.toml: el build hace `cp "$ORIG_DIR/<main>"`, y los
// imports del proyecto se resuelven desde ahí.
// Devuelve "" si la ruta es usable; si no, el mensaje de error.
fn main_flag_error(main_flag: String) -> String {
    if main_flag.startsWith("/") {
        return "--main espera una ruta relativa a la raíz del proyecto (donde está nyx.toml), no una absoluta: " + main_flag
    }
    if not main_flag.endsWith(".nx") {
        return "--main espera un archivo .nx: " + main_flag
    }
    if not file_exists(main_flag) {
        return "--main: no existe el archivo '" + main_flag + "' (la ruta es relativa a la raíz del proyecto)"
    }
    return ""
}

// Quita un "./" inicial para comparar rutas escritas de dos formas.
fn strip_dot_slash(p: String) -> String {
    if p.startsWith("./") { return p.substring(2, p.length()) }
    return p
}

// Nombre del artefacto para un `--main`: `<name>-<stem>` (src/navegador.nx →
// miapp-navegador; nativo en target/, wasm en target/wasm32-wasi/). Con el nombre del paquete a secas, un `nyx build --main`
// PISABA el binario principal, y un `nyx run` posterior ejecutaba otro programa
// sin decir nada. Si el --main es el mismo archivo que el del manifiesto, el
// artefacto es el de siempre.
fn bin_name_for_main(config: ProjectConfig, main_flag: String) -> String {
    if main_flag == "" { return "" }
    if strip_dot_slash(main_flag) == strip_dot_slash(config.main_file) { return "" }
    var base: String = main_flag
    var i: int = 0
    while i < main_flag.length() {
        let c: char = main_flag.charAt(i)
        if c == '/' { base = main_flag.substring(i + 1, main_flag.length()) }
        i = i + 1
    }
    let stem: String = base.substring(0, base.length() - 3)
    return config.name + "-" + stem
}

// ===== MAIN =====

// Versión del toolchain: UNA fuente de verdad (archivo VERSION, sembrado por
// install.sh en ~/.nyx/VERSION y presente en la raíz del monorepo). El
// fallback hardcodeado se bumpea vía el checklist de docs/VERSIONING.md.
fn toolchain_version() -> String {
    var vh: String = getenv("NYX_HOME")
    if vh == "" {
        let hd: String = dir_usuario()
        if hd != "" { vh = hd + "/.nyx" }
    }
    if vh != "" {
        if file_exists(vh + "/VERSION") {
            let raw: String = read_file(vh + "/VERSION")
            return raw.trim()
        }
    }
    if file_exists("VERSION") {
        let raw2: String = read_file("VERSION")
        return raw2.trim()
    }
    // B3: fallback solo si no hay VERSION ni NYX_HOME (no debería pasar en un
    // toolchain instalado). Mantenerlo al día igual — un fallback stale confunde.
    return "0.42.1"
}

// ===== FRICTION REPORT (v0.17, AI-first) =====
// Loop de retroalimentación proyecto→equipo Nyx: cualquier usuario (o su
// asistente IA) reporta bugs/gotchas/fricción de doc sin salir del proyecto.
// Sin args: genera FRICTION_REPORT.md con la plantilla estándar.
// Con archivo: lo envía al buzón compartido (nyx-kv, cola q:friction,
// payload b64 — el mismo canal cross-instancia ya probado en producción).
// Token opcional en ~/.nyx-kv-token; SIN token el envío es ANÓNIMO y la
// cola pública es legible por terceros: NO incluir código propietario ni
// secretos. Fail-soft: si no hay red, el reporte queda en el archivo y se
// sugiere GitHub issues.

fn report_template() -> String {
    var t = "# FRICTION — reporte para el mantenedor de Nyx\n\n"
    t = t + "> Completa las secciones. El USUARIO revisa este archivo (FRICTION.md).\n"
    t = t + "> No hace falta enviar nada. Opcional (canal del equipo, público): nyx report --send\n\n"
    t = t + "## Que intentaba hacer\n\n(objetivo en 1-3 lineas)\n\n"
    t = t + "## Codigo minimo reproducible\n\n```nyx\n// el .nx mas chico que reproduce el problema\n```\n\n"
    t = t + "## Error literal / comportamiento observado\n\n```\n(pega la salida exacta del compilador o runtime)\n```\n\n"
    t = t + "## Que decia la documentacion\n\n(cita de LLM.md/SPEC/CHEATSHEET si aplica - o 'no encontre nada')\n\n"
    t = t + "## Clasificacion\n\n- [ ] DOC (la doc miente o falta)\n- [ ] LENGUAJE (bug del compilador/runtime)\n- [ ] IDEA (mejora/feature)\n\n"
    t = t + "## Entorno\n\n- nyx: v" + toolchain_version() + "\n- so/arch: (uname -sm)\n"
    return t
}

fn run_report(file_arg: String, do_send: bool) -> bool {
    // Salida PRIMARIA: un archivo local FRICTION.md que el USUARIO administra.
    // El envío al canal del equipo (KV cola q:friction) es OPT-IN con --send.
    let local_path = "FRICTION.md"

    if not do_send {
        if file_exists(local_path) {
            let cur: String = read_file(local_path)
            if cur.length() >= 40 {
                print("FRICTION.md ya existe con contenido — avísale al usuario para que lo revise.")
                print("(opcional, para enviarlo al equipo de Nyx: nyx report --send)")
                return true
            }
        }
        write_file(local_path, report_template())
        print("creado FRICTION.md — completa las secciones (tu asistente IA puede hacerlo)")
        print("y AVÍSALE AL USUARIO. No hace falta enviar nada: el usuario lo revisa.")
        print("(opcional, para el equipo de Nyx: nyx report --send)")
        return true
    }

    // --send: enviar al canal del equipo (KV, opt-in).
    var src = local_path
    if file_arg != "" { src = file_arg }
    if not file_exists(src) {
        print("error: no existe " + src + " — ejecuta `nyx report` primero para crear FRICTION.md")
        return false
    }
    let contenido: String = read_file(src)
    if contenido.length() < 40 {
        print("error: el reporte parece vacío — completa la plantilla primero")
        return false
    }

    // token opcional
    var token = ""
    let home: String = dir_usuario()
    if home != "" {
        if file_exists(home + "/.nyx-kv-token") {
            let raw: String = read_file(home + "/.nyx-kv-token")
            token = raw.trim()
        }
    }
    if token == "" {
        print("aviso: envío ANÓNIMO (cola pública legible por terceros — sin secretos)")
    }

    let h: int = kv_connect_auth("nyxkv.com", 6380, token)
    if h < 0 {
        print("error: no se pudo conectar al buzón (nyxkv.com:6380)")
        print("el reporte quedó en " + src + " — puedes abrir un issue:")
        print("  https://github.com/nyxlang-dev/nyx/issues")
        return false
    }
    let payload: String = "b64:" + base64_encode(contenido)
    let n: int = kv_rpush(h, "q:friction", payload)
    kv_close(h)
    if n <= 0 {
        print("error: el buzón rechazó el reporte")
        return false
    }
    print("reporte enviado al equipo (cola q:friction, posición " + int_to_string(n) + ") — gracias!")
    return true
}

// ===== CAPABILITIES INDEX (Fase 1 AI-first) =====
// Genera CAPABILITIES.md: índice por-tarea de la stdlib (qué existe) para que una
// LLM no reinvente ni se meta a leer std/ fuente. Self-contained: NO importa
// doc.nx (import de módulos compiler/ no aporta funciones al IR — blocker conocido).
// Se regenera de la stdlib instalada, así que siempre está en sync con la versión.

// Resuelve el dir de la stdlib: NYX_HOME → ~/.nyx → ./ (monorepo).
fn capabilities_std_dir() -> String {
    var nyx_home: String = getenv("NYX_HOME")
    if nyx_home == "" {
        let home_dir: String = dir_usuario()
        let candidate: String = home_dir + "/.nyx"
        if home_dir != "" and file_exists(candidate + "/std") {
            nyx_home = candidate
        }
    }
    if nyx_home == "" {
        if file_exists("std") { nyx_home = "." }
    }
    if nyx_home == "" { return "" }
    return nyx_home + "/std"
}

// Categoría por tarea de un módulo (tabla curada). "" = "Otros".
fn module_category(name: String) -> String {
    // La guarda (d) de run_capabilities_test.sh falla si un módulo de std/ cae en
    // «Otros»: un módulo nuevo se agrega acá en el mismo commit que lo crea. Hasta
    // 2026-10-17 caían 34, entre ellos serve, postgres, error y math.
    if name == "error" or name == "prelude" { return "Núcleo" }
    if name == "http" or name == "web" or name == "websocket" or name == "cookie" { return "HTTP & Web" }
    // Módulos del navegador (wasm32-wasi con el shim): van con la web, no a «Otros».
    if name.startsWith("browser") or name == "dom" or name == "vdom" or name == "component" or name == "router" or name == "routematch" { return "HTTP & Web" }
    if name == "serve" or name == "template" or name == "multipart" or name == "session" or name == "proxy" or name == "webpush" { return "HTTP & Web" }
    if name == "sqlite" or name == "db" or name == "kvclient" or name == "postgres" or name == "resp" { return "Bases de datos & KV" }
    if name == "json" or name == "msgpack" or name == "toml" or name == "csv" or name == "base64" or name == "compress" or name == "barcode" or name == "pdf" { return "Serialización & datos" }
    if name == "xml" or name == "xlsx" or name == "zip" or name == "image" or name == "percent" or name == "pdf_render" { return "Serialización & datos" }
    if name == "fs" or name == "file" or name == "io" or name == "path" or name == "serial" { return "Archivos & I/O" }
    if name == "tcp" or name == "udp" or name == "net" or name == "http2" or name == "dns" or name == "url" or name == "smtp" or name == "imap" or name == "mime" or name == "mdns" { return "Red" }
    if name == "thread" or name == "channel" or name == "scheduler" or name == "sync" or name == "async" or name == "pool" { return "Concurrencia" }
    if name == "crypto" or name == "tls" or name == "hash" or name == "random" or name == "uuid" or name == "oauth2" or name == "rsa" or name == "webpushcrypto" { return "Cripto & seguridad" }
    if name == "time" or name == "datetime" { return "Tiempo" }
    if name == "string" or name == "strings" or name == "stringbuilder" or name == "regex" or name == "unicode" { return "Strings & texto" }
    if name == "math" or name == "math_ext" or name == "expr" { return "Matemática" }
    if name == "array" or name == "map" or name == "collections" { return "Colecciones & estructuras" }
    if name == "set" or name == "deque" or name == "linkedlist" or name == "stack" or name == "btreemap" or name == "priorityqueue" or name == "graph" or name == "matrix" { return "Colecciones & estructuras" }
    if name == "statemachine" or name == "events" { return "Colecciones & estructuras" }
    if name == "arena" or name == "box" or name == "rc" or name == "ownership" or name == "owned" or name == "wasm_mem" { return "Memoria" }
    if name == "llm" { return "IA & LLM" }
    if name == "args" or name == "cli" or name == "log" or name == "logging" or name == "semver" or name == "testing" or name == "quickcheck" or name == "proptest" or name == "exec" or name == "process" { return "Tooling & CLI" }
    return ""
}

// Delta de paréntesis de una línea: +1 por cada '(', -1 por cada ')'.
// Usado para detectar firmas de fn que parten los params en varias líneas
// (ej. std/proptest.nx::prop_int, std/webpush.nx::webpush_encrypt_with_keys) —
// mientras el acumulado sea > 0 los params siguen abiertos, hay que seguir leyendo.
fn capabilities_paren_delta(s: String) -> int {
    var delta = 0
    var bi = 0
    while bi < s.length() {
        let c: char = s.charAt(bi)
        if c == '(' { delta = delta + 1 }
        if c == ')' { delta = delta - 1 }
        bi = bi + 1
    }
    return delta
}

// Firma de una declaración hasta '{' (o hasta el fin si no hay), sin espacios
// sobrantes.
fn capabilities_cut_sig(sig: String) -> String {
    var cut = -1
    var bi = 0
    while bi < sig.length() {
        let c: char = sig.charAt(bi)
        if c == '{' and cut == -1 { cut = bi }
        bi = bi + 1
    }
    if cut >= 0 { return sig.substring(0, cut).trim() }
    return sig.trim()
}

// Sección markdown de un módulo: sus pub fn (firma hasta '{') + /// doc si hay,
// y después sus tipos públicos con los métodos de sus `impl`.
//
// Los tipos y métodos entran desde el 2026-10-20 (fricción nyxerp): el índice
// solo listaba funciones libres, así que una API hecha de métodos —`doc.render()`
// de std/pdf_render, `s.read()` de std/http, `d.text()` de std/pdf— quedaba
// invisible para quien consulta CAPABILITIES.md, igual que los structs que la
// sostienen (HttpStream, PdfRendered...). Un método es una línea `    fn` (o
// `    pub fn`) dentro de un bloque `impl T` que cierra con `}` en la columna 0,
// como están escritos todos los std/*.nx; los que empiezan con `__` son
// internos y no se listan.
// Retorna "" si el módulo no tiene nada público.
fn capabilities_module_section(std_dir: String, filename: String) -> String {
    let modname: String = filename.substring(0, filename.length() - 3)  // strip .nx
    let source: String = read_file(std_dir + "/" + filename)
    let lines: Array<String> = source.split("\n")
    var body = ""
    var pending_doc = ""
    var count = 0
    // Tipos públicos en orden de aparición, y métodos por tipo (Arrays paralelos).
    var type_names: Array = []
    var type_lines: Array = []
    var meth_owner: Array = []
    var meth_lines: Array = []
    var in_impl = ""
    var i = 0
    while i < lines.length() {
        let ln: String = lines[i]
        let trimmed: String = ln.trim()
        if ln.startsWith("}") { in_impl = "" }
        if trimmed.startsWith("///") {
            let dt: String = trimmed.substring(3, trimmed.length())
            let dtt: String = dt.trim()
            if pending_doc == "" { pending_doc = dtt } else { pending_doc = pending_doc + " " + dtt }
        } else {
            // `async fn` también (std/browser_idb, std/browser_serial): sin esto los
            // módulos de await en wasm no aparecían en el índice y nadie los encontraba.
            let is_fn: bool = trimmed.startsWith("pub fn ") or trimmed.startsWith("export fn ") or trimmed.startsWith("pub async fn ") or trimmed.startsWith("export async fn ")
            let is_type: bool = (trimmed.startsWith("pub struct ") or trimmed.startsWith("pub enum ")) and in_impl == ""
            let is_impl: bool = ln.startsWith("impl ")
            let is_method: bool = in_impl != "" and ln.startsWith("    ") and not ln.startsWith("     ") and (trimmed.startsWith("fn ") or trimmed.startsWith("pub fn ")) and not trimmed.startsWith("fn __") and not trimmed.startsWith("pub fn __")
            if is_impl {
                // `impl T {`, `impl<T> Caja<T> {` o `impl Rasgo for T {`: el dueño
                // es el tipo después de `for` si lo hay, si no el primer nombre.
                var head: String = capabilities_cut_sig(trimmed.substring(5, trimmed.length()))
                let fpos: int = head.indexOf(" for ")
                if fpos >= 0 { head = head.substring(fpos + 5, head.length()).trim() }
                let lt: int = head.indexOf("<")
                if lt >= 0 { head = head.substring(0, lt) }
                in_impl = head.trim()
            } else if is_type {
                let tparts: Array<String> = capabilities_cut_sig(trimmed).split(" ")
                var tname: String = ""
                if tparts.length() >= 3 { tname = tparts[2] }
                let tlt: int = tname.indexOf("<")
                if tlt >= 0 { tname = tname.substring(0, tlt) }
                type_names.push(tname)
                var tl: String = "- `" + capabilities_cut_sig(trimmed) + "`"
                if pending_doc != "" { tl = tl + " — " + pending_doc }
                type_lines.push(tl)
            } else if is_method {
                var sig: String = trimmed
                var balance: int = capabilities_paren_delta(sig)
                while balance > 0 and i + 1 < lines.length() {
                    i = i + 1
                    let cont: String = lines[i].trim()
                    if cont != "" { sig = sig + " " + cont }
                    balance = balance + capabilities_paren_delta(cont)
                }
                var ml: String = "  - `" + capabilities_cut_sig(sig) + "`"
                if pending_doc != "" { ml = ml + " — " + pending_doc }
                meth_owner.push(in_impl)
                meth_lines.push(ml)
            } else if is_fn {
                var sig: String = trimmed
                // Firma multi-línea (params partidos entre líneas): mientras los
                // paréntesis no balanceen, seguir consumiendo líneas y unir con un
                // solo espacio — si no, la firma emitida queda TRUNCADA a la primera
                // línea (bug real cazado en std/proptest.nx y std/webpush.nx).
                var balance: int = capabilities_paren_delta(sig)
                while balance > 0 and i + 1 < lines.length() {
                    i = i + 1
                    let cont: String = lines[i].trim()
                    if cont != "" {
                        if sig.length() > 0 and sig.charAt(sig.length() - 1) == '(' {
                            sig = sig + cont
                        } else {
                            sig = sig + " " + cont
                        }
                    }
                    balance = balance + capabilities_paren_delta(cont)
                }
                body = body + "- `" + capabilities_cut_sig(sig) + "`"
                if pending_doc != "" { body = body + " — " + pending_doc }
                body = body + "\n"
                count = count + 1
            }
            pending_doc = ""
        }
        i = i + 1
    }
    // Tipos: los públicos con sus métodos; métodos de un tipo que no es público
    // del módulo (impl de un tipo de otro módulo) no se listan.
    var types_md = ""
    var nmeth = 0
    var ti = 0
    while ti < type_names.length() {
        let tn: String = type_names[ti]
        let tl: String = type_lines[ti]
        types_md = types_md + tl + "\n"
        var mi = 0
        while mi < meth_owner.length() {
            let mo: String = meth_owner[mi]
            if mo == tn {
                let ml: String = meth_lines[mi]
                types_md = types_md + ml + "\n"
                nmeth = nmeth + 1
            }
            mi = mi + 1
        }
        ti = ti + 1
    }
    if count == 0 and type_names.length() == 0 { return "" }
    var out = "### `std/" + modname + "`\n\n"
    if count > 0 {
        out = out + "`import \"std/" + modname + "\"` — " + int_to_string(count) + " funciones:\n\n"
        out = out + body + "\n"
    } else {
        out = out + "`import \"std/" + modname + "\"`\n\n"
    }
    if type_names.length() > 0 {
        out = out + "Tipos (" + int_to_string(type_names.length()) + ") y métodos (" + int_to_string(nmeth) + "):\n\n"
        out = out + types_md + "\n"
    }
    return out
}

// Subsección de BUILTINS GLOBALES para una categoría, leída de
// `<std_dir>/builtins.index` (generado por scripts/gen_builtins_index.sh).
//
// POR QUÉ (fricción de nyxerp, 2026-09-11): este índice se armaba escaneando
// `std/*.nx`, y los builtins globales no viven ahí — los declara el compilador.
// Los 191 estaban AUSENTES del índice que `AGENTS.md` manda consultar, incluida
// toda la criptografía. Un equipo pidió una KDF de contraseñas, la KDF ya
// existía, no la encontraron, y estuvieron a punto de escribir PBKDF2 a mano
// sobre `hmac_sha256`. Su frase: «una primitiva que existe y no se puede
// encontrar es, en la práctica, una primitiva que no existe».
//
// Si el archivo no está —toolchain viejo, o instalación parcial— se devuelve ""
// y el índice sale como antes: sin builtins, pero sin romperse.
fn capabilities_builtins_section(std_dir: String, cat: String) -> String {
    let idx_path: String = std_dir + "/builtins.index"
    if not file_exists(idx_path) { return "" }
    let raw: String = read_file(idx_path)
    let lines: Array = raw.split("\n")
    var body: String = ""
    var n: int = 0
    var li: int = 0
    while li < lines.length() {
        let line: String = lines[li]
        if line.length() > 8 {
            if line.substring(0, 8) == "builtin\t" {
                let f: Array = line.split("\t")
                if f.length() >= 5 {
                    let nombre: String = f[1]
                    let aridad: String = f[2]
                    let categoria: String = f[3]
                    let desc: String = f[4]
                    // 6º campo (2026-09-27): "no-wasm" si el builtin no existe en
                    // wasm32-wasi. Un índice viejo de 5 campos sigue sirviendo.
                    var dest: String = ""
                    if f.length() >= 6 {
                        let d6: String = f[5]
                        dest = d6
                    }
                    if categoria == cat {
                        var fila: String = "- `" + nombre + "` (" + aridad + " arg"
                        if aridad != "1" { fila = fila + "s" }
                        fila = fila + ")"
                        if desc != "" { fila = fila + " — " + desc }
                        if dest == "no-wasm" { fila = fila + " · *no existe en wasm32-wasi*" }
                        body = body + fila + "\n"
                        n = n + 1
                    }
                }
            }
        }
        li = li + 1
    }
    if n == 0 { return "" }
    return "### Builtins globales (sin `import`)\n\n" + body + "\n"
}

fn run_capabilities(out_arg: String) -> bool {
    let std_dir: String = capabilities_std_dir()
    if std_dir == "" {
        print("error: no encuentro la stdlib (probé NYX_HOME/std, ~/.nyx/std, ./std)")
        return false
    }
    let entries: Array = readdir(std_dir)
    // "Matemática" agrupa std/math, std/math_ext, std/expr y los builtins math_*.
    let cats: Array<String> = ["Núcleo", "HTTP & Web", "Bases de datos & KV", "Serialización & datos", "Archivos & I/O", "Red", "Concurrencia", "Cripto & seguridad", "Tiempo", "Strings & texto", "Matemática", "Colecciones & estructuras", "Memoria", "IA & LLM", "Tooling & CLI", "Otros"]
    var doc = "# CAPABILITIES — índice de la stdlib de Nyx\n\n"
    doc = doc + "<!-- nyx-version: " + toolchain_version() + " -->\n"
    // Firma de la stdlib que calcula el wrapper (_caps_stamp en scripts/nyx):
    // el self-heal de `nyx build` regenera si no coincide. Sin el wrapper no
    // hay firma, y el próximo build lo regenera una vez.
    let caps_stamp: String = getenv("NYX_CAPS_STAMP")
    if caps_stamp != "" { doc = doc + "<!-- nyx-stdlib: " + caps_stamp + " -->\n" }
    doc = doc + "> Auto-generado por `nyx capabilities` desde la stdlib instalada — siempre en sync con tu versión.\n"
    // Español neutro (regla 9 del arco andamiaje-sdd): sin voseo. La cabecera
    // sigue siendo castellana aunque el proyecto sea `--lang en` — bilingüizarla
    // por idioma está fichado aparte en TASKS.md.
    doc = doc + "> Es el índice de QUÉ EXISTE: antes de escribir una función, busca aquí si un módulo ya lo hace,\n"
    doc = doc + "> impórtalo y úsalo. NO leas el fuente de `std/`. Ver `AGENTS.md` para cómo escribir Nyx.\n\n"
    var ci = 0
    while ci < cats.length() {
        let cat: String = cats[ci]
        var cat_body = ""
        var ei = 0
        while ei < entries.length() {
            let ent: String = entries[ei]
            if ent.endsWith(".nx") {
                let modname: String = ent.substring(0, ent.length() - 3)
                var mcat: String = module_category(modname)
                if mcat == "" { mcat = "Otros" }
                if mcat == cat {
                    let sect: String = capabilities_module_section(std_dir, ent)
                    if sect != "" { cat_body = cat_body + sect }
                }
            }
            ei = ei + 1
        }
        let bi_sect: String = capabilities_builtins_section(std_dir, cat)
        if cat_body != "" or bi_sect != "" {
            doc = doc + "## " + cat + "\n\n" + cat_body + bi_sect
        }
        ci = ci + 1
    }
    var out_path = "CAPABILITIES.md"
    if out_arg != "" { out_path = out_arg }
    write_file(out_path, doc)
    print("CAPABILITIES.md generado desde " + std_dir + " (" + int_to_string(entries.length()) + " archivos escaneados)")
    return true
}

fn main() -> int {
    let args: Array<String> = get_args()

    // Default command
    var command = "build"
    var release = false
    var target_flag = ""
    var main_flag = ""

    if args.length() >= 2 {
        let cmd: String = args[1]
        command = cmd
    }
    // `nyx --version` / `nyx -v` / `nyx version`: sin esto el driver (lo que corre en
    // Windows, sin el wrapper bash) contestaba «unknown command». Lee <nyx_home>/VERSION;
    // el wrapper de Linux imprime además las huellas del compilador y el prelude.
    if command == "--version" or command == "-v" or command == "version" {
        let vhome: String = build_nyx_home()
        var vtxt: String = ""
        if vhome != "" and file_exists(vhome + "/VERSION") { vtxt = read_file(vhome + "/VERSION").trim() }
        if vtxt == "" {
            print("nyx (versión desconocida)")
        } else {
            print("nyx " + vtxt)
        }
        return 0
    }
    // `nyx check|fmt|test`: herramientas compañeras (<nyx_home>/bin/nyx_<cmd>[.exe]). En Linux
    // el wrapper bash las resuelve antes de llegar acá; en Windows no hay wrapper y las despacha
    // el driver con los argumentos restantes. Va ANTES de validar flags: son de la herramienta.
    if command == "check" or command == "fmt" or command == "test" {
        let thome: String = build_nyx_home()
        var tbin: String = ""
        if thome != "" {
            var cands: Array = [thome + "/bin/nyx_" + command + ".exe", thome + "/bin/nyx_" + command, thome + "/nyx_" + command]
            if host_es_windows() { cands = [thome + "/bin/nyx_" + command + ".exe", thome + "/nyx_" + command + ".exe"] }
            var ci: int = 0
            while ci < cands.length() {
                let cand: String = cands[ci]
                if tbin == "" and file_exists(cand) { tbin = cand }
                ci = ci + 1
            }
        }
        if tbin == "" {
            if command == "test" and host_es_windows() {
                err_line("error: nyx test todavía no está disponible en Windows")
                err_line("  (depende de reescribir compiler/test.nx sin bash; ver TASKS.md)")
            } else {
                err_line("error: nyx_" + command + " no está instalado en " + thome)
                err_line("  instala el toolchain de nuevo, o compila la herramienta (make build-" + command + ")")
            }
            return 1
        }
        if command == "test" {
            var targv: Array = [tbin]
            var ti: int = 2
            while ti < args.length() { targv.push(args[ti]); ti = ti + 1 }
            return correr_programa(targv)
        }
        // check|fmt: las herramientas leen NYX_SRC (con script.nx de respaldo) y NUNCA
        // sus argumentos. Pasar la ruta como argumento era un falso verde: `nyx check
        // roto.nx` daba rc 0 revisando un script.nx inexistente (laptop, win-cross T5,
        // 2026-11-03). Misma lógica que la rama check|vet|fmt de scripts/nyx: destino,
        // existencia, NYX_PROJECT_DIR y el filtro del protocolo LSP de nyx_check.
        var proto: bool = getenv("NYX_CHECK_PROTOCOL") == "1"
        var destino: String = ""
        var ti: int = 2
        while ti < args.length() {
            let a: String = args[ti]
            if command == "check" and a == "--lsp" { proto = true }
            else if destino == "" { destino = a }
            ti = ti + 1
        }
        if destino == "" {
            if file_exists("nyx.toml") and file_exists("src/main.nx") { destino = "src/main.nx" } else { destino = "script.nx" }
        }
        if not file_exists(destino) {
            err_line("error: no existe el archivo '" + destino + "'")
            err_line("  Uso: nyx " + command + " [archivo.nx]   (sin argumento usa src/main.nx)")
            return 1
        }
        var tenv: Array = [["NYX_SRC", destino], ["NYX_HOME", thome]]
        if getenv("NYX_PROJECT_DIR") == "" {
            let pd: String = raiz_del_proyecto(getcwd())
            if pd != "" { tenv.push(["NYX_PROJECT_DIR", pd]) }
        }
        var o = spawn_opts()
        o.env = tenv
        if command == "check" and not proto { o.stdout = Stdio.Pipe }
        term_flush()
        match try_spawn([tbin], o) {
            Result.Ok(c) => {
                if command == "check" and not proto {
                    match try_child_collect(c) {
                        Result.Ok(r) => {
                            let ls: Array = r.stdout.split("\n")
                            var li: int = 0
                            while li < ls.length() {
                                var l: String = ls[li]
                                // En Windows nyx_check escribe END\r\n: tras partir por \n queda "END\r",
                                // que no es "END", y print le sumaba otro \r\n (laptop, T5 ronda 1).
                                if l.length() > 0 and l.charAt(l.length() - 1) == 13 { l = l.substring(0, l.length() - 1) }
                                let es_proto: bool = l.startsWith("SYM:") or l.startsWith("DEF:") or l.startsWith("DIAG:") or l == "END"
                                if not es_proto and not (li == ls.length() - 1 and l == "") { print(l) }
                                li = li + 1
                            }
                            return r.code
                        }
                        Result.Err(e) => { err_line("error: " + e.msg); return 1 }
                    }
                }
                match try_child_wait(c) {
                    Result.Ok(rc) => { return rc }
                    Result.Err(e) => { err_line("error: " + e.msg); return 1 }
                }
            }
            Result.Err(e) => { err_line(tbin + ": " + e.msg); return 127 }
        }
    }
    // Flags: --release / --target <triple> (en cualquier orden tras el comando)
    //
    // Una flag DESCONOCIDA es un error, no silencio. Antes
    // `nyx build --flag-que-no-existe` compilaba y salía 0 ignorándola: una flag
    // mal escrita no hacía nada y nadie se enteraba — así fue como un equipo
    // terminó leyendo el Makefile para descubrir cómo compilar a wasm
    // (fricción nyxerp, 2026-09-10). `nyx init` ya validaba así desde antes; lo
    // que faltaba era aplicar el mismo criterio acá.
    //
    // Solo se validan las flags de los comandos que las tienen (`build`, `run`,
    // `test`): los demás parsean sus argumentos en su propio bloque más abajo y
    // rechazar acá lo que ellos aceptan sería peor que no validar.
    var fi = 2
    var flag_desconocida = ""
    var pide_ayuda = false
    let valida_flags: bool = command == "build" or command == "run" or command == "test" or command == "libs"
    while fi < args.length() {
        let flag: String = args[fi]
        if flag == "--" {
            // Todo lo que sigue es del PROGRAMA, no de nyx. Es la convención
            // estándar y CLAUDE.md la documenta («usar `--` para args que
            // parezcan flags de nyx»). Sin este corte, la validación de flags
            // desconocidas rechazaba `nyx run -- --release`, que es
            // exactamente para lo que existe `--`. Lo cazó
            // run-wrapper-args-dashdash: el gate hizo su trabajo.
            fi = args.length()
        }
        else if flag == "--release" { release = true }
        else if flag == "--main" {
            var mval: String = ""
            if fi + 1 < args.length() {
                let mv: String = args[fi + 1]
                if not mv.startsWith("--") { mval = mv }
            }
            if mval == "" {
                if flag_desconocida == "" {
                    flag_desconocida = "--main necesita un archivo (por ejemplo: --main src/navegador.nx)"
                }
            } else {
                main_flag = mval
                fi = fi + 1
            }
        }
        else if flag == "--help" or flag == "-h" { pide_ayuda = true }
        else if flag == "-j" or flag == "--jobs" or flag.startsWith("-j") or flag.startsWith("--jobs=") {
            // Trabajos a la vez para las unidades de [lib] (arco build-lib-paralelo).
            // Viaja como NYX_JOBS (la lee lib_trabajos), la misma variable que puede
            // fijar quien llama (nyx test pasa por `nyx_build libs` sin flags).
            var jval: String = ""
            if flag == "-j" or flag == "--jobs" {
                if fi + 1 < args.length() {
                    let jv: String = args[fi + 1]
                    jval = jv
                    fi = fi + 1
                }
            } else if flag.startsWith("--jobs=") {
                jval = flag.substring(7, flag.length())
            } else {
                jval = flag.substring(2, flag.length())
            }
            if jobs_valido(jval) {
                setenv("NYX_JOBS", jval)
            } else if flag_desconocida == "" {
                flag_desconocida = "-j necesita un entero positivo (por ejemplo: -j 4); recibió «" + jval + "»"
            }
        }
        else if flag == "--target" {
            if fi + 1 < args.length() {
                let tval: String = args[fi + 1]
                target_flag = tval
                fi = fi + 1
            } else {
                flag_desconocida = "--target necesita un valor (por ejemplo: --target wasm32-wasi)"
            }
        } else {
            if valida_flags and flag.length() > 1 {
                if flag.charAt(0) == '-' and flag_desconocida == "" {
                    flag_desconocida = "flag desconocida para `nyx " + command + "`: " + flag
                }
            }
        }
        fi = fi + 1
    }

    if pide_ayuda and valida_flags {
        print("nyx " + command + " — flags disponibles:")
        print("  --release            compila optimizado")
        print("  --target <triple>    destino de compilación (por defecto, el de [build] en nyx.toml)")
        print("  --main <archivo.nx>  otro punto de entrada del proyecto (por defecto, el main de nyx.toml);")
        print("                       el artefacto va a target/<nombre>-<archivo> para no pisar el principal")
        print("  -j, --jobs <n>       unidades de [lib] que se compilan a la vez (por defecto, los núcleos;")
        print("                       también NYX_JOBS). -j 1 compila en serie")
        print("  --help, -h           esta ayuda")
        print("")
        print("El proyecto se lee de nyx.toml: nombre, versión, main y dependencias.")
        return 0
    }
    if flag_desconocida != "" {
        print("error: " + flag_desconocida)
        print("  `nyx " + command + " --help` lista las flags disponibles")
        return 1
    }

    // Banner único y honesto (adiós "Build System v1.9.0" de la era pre-reset)
    print("nyx v" + toolchain_version() + " — " + command)

    // Handle `nyx init [name] [--lang en|es] [--agent=a,b]`
    if command == "init" {
        var init_name = ""
        var init_lang = ""
        var init_agents = ""
        var init_sdd = false
        var bad_flag = ""
        var missing_value = ""
        var ii = 2
        while ii < args.length() {
            let a: String = args[ii]
            var handled: bool = false
            // `--lang xx` / `--agent a,b`: el valor es OBLIGATORIO. Si la
            // bandera es el último argumento o la sigue otra `--flag`, es un
            // error RUIDOSO — un `nyx init proy --lang` que sembrara en inglés
            // por defecto es exactamente la falla muda que este repo persigue.
            if a == "--lang" or a == "--agent" {
                handled = true
                var value: String = ""
                if ii + 1 < args.length() {
                    let nv: String = args[ii + 1]
                    if nv.startsWith("--") == false { value = nv }
                }
                if value == "" {
                    missing_value = a
                } else {
                    if a == "--lang" { init_lang = value }
                    if a == "--agent" { init_agents = value }
                    ii = ii + 1
                }
            }
            if handled == false and a.startsWith("--lang=") {
                handled = true
                init_lang = a.substring(7, a.length())
                if init_lang == "" { missing_value = "--lang" }
            }
            if handled == false and a.startsWith("--agent=") {
                handled = true
                init_agents = a.substring(8, a.length())
                if init_agents == "" { missing_value = "--agent" }
            }
            // `--sdd`: init normal + andamiaje SDD (spec §3). Sin valor: es un
            // interruptor, y el proyecto sigue siendo el mismo si no se pasa.
            if handled == false and a == "--sdd" {
                handled = true
                init_sdd = true
            }
            if handled == false and a.startsWith("--") {
                // `nyx init` acepta EXACTAMENTE --lang y --agent. `--release` y
                // `--target` no significan nada acá: aceptarlos hacía que
                // `nyx init --target x86 proy` tomara «x86» como nombre.
                handled = true
                bad_flag = a
            }
            if handled == false {
                if init_name == "" { init_name = a }
            }
            ii = ii + 1
        }
        if bad_flag != "" {
            print("error: flag desconocida para `nyx init`: " + bad_flag)
            print("  Uso: nyx init [nombre] [--lang en|es] [--agent=claude,cursor,copilot] [--sdd]")
            return 1
        }
        if missing_value != "" {
            print("error: " + missing_value + " necesita un valor")
            print("  Uso: nyx init [nombre] [--lang en|es] [--agent=claude,cursor,copilot] [--sdd]")
            return 1
        }
        // Sin --lang: NYX_LANG si vale "es", si no "en" (ADR-1: un idioma por
        // proyecto, elegido al sembrar y grabado en el sello).
        if init_lang == "" {
            let env_lang: String = getenv("NYX_LANG")
            if env_lang == "es" { init_lang = "es" }
            if init_lang == "" { init_lang = "en" }
        }
        if init_lang != "en" and init_lang != "es" {
            print("error: --lang inválido: '" + init_lang + "' (valores válidos: en, es)")
            return 1
        }
        if validate_agents(init_agents) == false { return 1 }
        let ok: bool = run_init(init_name, init_lang, init_agents)
        if ok == false { return 1 }
        // El andamiaje va DESPUÉS del init normal (necesita el AGENTS.md ya
        // sembrado para insertarle el disparador). Sin la bandera no se ejecuta
        // ni una línea de esto: el listado dorado por defecto no cambia.
        if init_sdd {
            var sdd_dir: String = init_name
            if sdd_dir == "" { sdd_dir = "." }
            print("")
            let sok: bool = run_sdd_init(sdd_dir, init_lang)
            if sok == false { return 1 }
        }
        return 0
    }

    // `nyx sdd init` (proyecto que ya existe) y `nyx sdd evidence` (regenerar
    // lo GENERADO contra la toolchain instalada; lo usa `nyx update`). El
    // idioma NO se pregunta: sale del sello de AGENTS.md (project_lang).
    if command == "sdd" {
        var sub: String = ""
        if args.length() >= 3 {
            let s: String = args[2]
            sub = s
        }
        if sub == "init" {
            let ok: bool = run_sdd_init(".", project_lang("."))
            if ok { return 0 }
            return 1
        }
        if sub == "evidence" {
            let ok: bool = run_sdd_evidence(".", project_lang("."))
            if ok { return 0 }
            return 1
        }
        if sub == "" {
            print("error: `nyx sdd` necesita un subcomando (init, evidence)")
        } else {
            print("error: subcomando desconocido para `nyx sdd`: '" + sub + "' (válidos: init, evidence)")
        }
        print("  Uso: nyx sdd init      # siembra el andamiaje SDD en este proyecto")
        print("       nyx sdd evidence  # regenera docs/evidence/ para la toolchain instalada")
        return 1
    }

    // Handle `nyx_build add <pkg> [--from <url>]` (no nyx.toml required)
    if command == "add" {
        if args.length() < 3 {
            print("Usage: nyx_build add <package-name> [--from <url>]")
            return 1
        }
        let pkg_name: String = args[2]
        var pkg_url = ""
        if args.length() >= 5 {
            let from_flag: String = args[3]
            if from_flag == "--from" {
                let url_val: String = args[4]
                pkg_url = url_val
            }
        }
        // Build a minimal config for context
        var dummy_names: Array = []
        var dummy_versions: Array = []
        let dummy: ProjectConfig = ProjectConfig {
            name: "project", version: "0.1.0", main_file: "",
            manifest_main_file: "",
            description: "", no_gc: false, target: "",
            dep_names: dummy_names, dep_versions: dummy_versions, toml_error: "", bin_name: "",
            lib_modules: []
        }
        let ok: bool = run_add(pkg_name, pkg_url, dummy)
        if ok { return 0 }
        return 1
    }

    // Handle `nyx report [archivo.md]` — feedback de fricción hacia el
    // equipo de Nyx (no requiere nyx.toml)
    if command == "report" {
        var report_file = ""
        var do_send = false
        var ri = 2
        while ri < args.length() {
            let ra: String = args[ri]
            if ra == "--send" {
                do_send = true
            } else {
                if ra != "--release" { report_file = ra }
            }
            ri = ri + 1
        }
        let ok: bool = run_report(report_file, do_send)
        if ok { return 0 }
        return 1
    }

    // `nyx_build agents-merge <AGENTS.md> <plantilla> <lang> <salida>` — lo
    // llama `nyx update --sync-docs` (no requiere nyx.toml).
    if command == "agents-merge" {
        if args.length() < 6 {
            print("uso: nyx_build agents-merge <AGENTS.md> <plantilla> <lang> <salida>")
            return 1
        }
        let a_dst: String = args[2]
        let a_tpl: String = args[3]
        let a_lang: String = args[4]
        let a_out: String = args[5]
        if run_agents_merge(a_dst, a_tpl, a_lang, a_out) { return 0 }
        return 1
    }

    // Handle `nyx capabilities [out.md]` — genera el índice de la stdlib para
    // LLMs (no requiere nyx.toml; corre en cualquier dir con la stdlib instalada).
    if command == "capabilities" {
        var out_arg = ""
        if args.length() >= 3 {
            let oa: String = args[2]
            if oa != "--release" { out_arg = oa }
        }
        let cok: bool = run_capabilities(out_arg)
        if cok { return 0 }
        return 1
    }

    // Read nyx.toml
    if not file_exists("nyx.toml") {
        print("error: nyx.toml not found in current directory")
        print("Create a nyx.toml with:")
        print("  [package]")
        print("  name = \"myapp\"")
        print("  version = \"0.1.0\"")
        print("  main = \"src/main.nx\"")
        return 1
    }

    let toml_content: String = read_file("nyx.toml")
    var config: ProjectConfig = parse_toml(toml_content)

    if config.toml_error != "" {
        print("error: " + config.toml_error)
        return 1
    }

    if config.name == "" {
        print("error: nyx.toml missing [package] name field")
        return 1
    }

    // `--main` solo tiene sentido para lo que compila. Se valida ANTES de
    // resolver dependencias o compilar: un archivo mal escrito se dice en el
    // acto, no tras un build entero.
    if main_flag != "" {
        if command != "build" and command != "run" {
            print("error: --main solo vale para `nyx build` y `nyx run`")
            return 1
        }
        let merr: String = main_flag_error(main_flag)
        if merr != "" {
            print("error: " + merr)
            return 1
        }
        config.bin_name = bin_name_for_main(config, main_flag)
        config.main_file = main_flag
    }

    if command == "info" {
        print_info(config)
        return 0
    }

    if command == "libs" {
        if run_libs(config, release) { return 0 }
        return 1
    }

    if command == "build" {
        let ok: bool = run_build(config, release, target_flag)
        if ok {
            write_lockfile(config)
            print("build complete")
            return 0
        }
        return 1
    }

    if command == "run" {
        // Convención cargo/npm: `--help` ANTES de `--` es ayuda del PM y NO
        // compila nada (antes ejecutaba el proyecto ignorando el flag). Para
        // pasarle `--help` al programa: `nyx run -- --help`.
        var hi: int = 2
        while hi < args.length() {
            let ha: String = args[hi]
            if ha == "--" {
                hi = args.length()
            } else {
                if ha == "--help" or ha == "-h" {
                    print("Usage: nyx run [--release] [--target <triple>] [--main <archivo.nx>] [args...]")
                    print("       nyx run -- <args...>   (todo tras -- va al programa)")
                    print("")
                    print("Compila el proyecto (nyx.toml) y lo ejecuta, reenviando")
                    print("los argumentos al binario resultante.")
                    return 0
                }
                hi = hi + 1
            }
        }
        let ok: bool = run_build(config, false, target_flag)
        var run_bin: String = config.name
        if config.bin_name != "" { run_bin = config.bin_name }
        if ok {
            write_lockfile(config)
            // P1 friction-portscan: reenviar al binario los args posteriores a
            // `run`. Antes se ejecutaba `./<name>` pelado y get_args() solo veía
            // argv[0] — ni con `--` — aunque el binario invocado a mano SÍ los
            // recibía (y CLAUDE.md documentaba `nyx run ... -- args` como si
            // funcionara). Los flags del PM (--release/--target <v>) se consumen
            // acá; tras un `--` TODO va literal al programa, incluso si parece
            // un flag del PM.
            // `nyx run --target <no-nativo>` ejecutaba `./<name>` — el binario
            // NATIVO de un build anterior. Imprimía la salida correcta y salía
            // 0, así que parecía que había corrido el wasm: no corría. Medido
            // el 2026-09-10. Ahora se ejecuta el artefacto del target con su
            // runner, o se falla diciendo qué falta — nunca otra cosa en
            // silencio.
            var eff_run_target: String = config.target
            if target_flag != "" { eff_run_target = target_flag }
            if eff_run_target == "wasm32-wasi" {
                let artefacto: String = "target/wasm32-wasi/" + run_bin + ".wasm"
                if not file_exists(artefacto) {
                    print("error: no se encontró " + artefacto)
                    return 1
                }
                // El runner se busca igual que en run_wasm_tests.sh: si no
                // está, se dice qué falta y cómo correrlo a mano, en vez de
                // ejecutar otra cosa.
                var wasmtime: String = ""
                match find_program("wasmtime") {
                    Option.Some(p) => { wasmtime = p }
                    Option.None => {}
                }
                if wasmtime == "" {
                    print("error: el artefacto es " + artefacto + " pero no hay runtime de wasm para ejecutarlo")
                    print("  instala wasmtime, o ejecútalo tú mismo: wasmtime " + artefacto)
                    return 1
                }
                var wargv: Array = [wasmtime, artefacto]
                var wi: int = 2
                var w_dash: bool = false
                while wi < args.length() {
                    let wa: String = args[wi]
                    if w_dash { wargv.push(wa) }
                    else {
                        if wa == "--" { w_dash = true }
                        else if wa == "--target" or wa == "--main" { wi = wi + 1 }
                    }
                    wi = wi + 1
                }
                return correr_programa(wargv)
            }
            var run_arch: String = ""
            var run_en_target: bool = false
            if eff_run_target == "x86_64-unknown-linux-gnu" { run_arch = "x86_64" }
            if eff_run_target == "aarch64-unknown-linux-gnu" { run_arch = "aarch64" }
            if run_arch != "" {
                // El triple del host corre el artefacto de target/<triple>/ con
                // los args de siempre (más abajo); uno de otra arquitectura daría
                // «exec format error», así que se dice antes qué pasa.
                if host_arch() != run_arch {
                    print("error: target/" + eff_run_target + "/" + run_bin + " es un binario " + run_arch + " y esta máquina no lo puede ejecutar")
                    print("  cópialo a una máquina " + run_arch + " y córrelo ahí")
                    return 1
                }
                run_bin = eff_run_target + "/" + run_bin
                run_en_target = true
                eff_run_target = ""
            }
            // El .exe de esta máquina: run_build ya rechazó cualquier otro caso.
            let win_run: bool = host_es_windows() and (eff_run_target == "" or eff_run_target == triple_win())
            if win_run { eff_run_target = "" }
            if eff_run_target == triple_android() {
                print("error: `nyx run` no ejecuta un artefacto de Android en esta máquina (es un PIE de bionic, linker64)")
                print("  cópialo a un teléfono con Termux y córrelo ahí: target/" + eff_run_target + "/" + run_bin)
                return 1
            }
            if eff_run_target != "" {
                print("error: `nyx run` no sabe ejecutar un artefacto de " + eff_run_target)
                print("  usa `nyx build --target " + eff_run_target + "` y ejecútalo con el runner de esa plataforma")
                return 1
            }

            var prog: String = "./" + run_bin
            if config.bin_name != "" or run_en_target { prog = "./target/" + run_bin }
            if win_run { prog = "./target/" + run_bin + ".exe" }
            var run_argv: Array = [prog]
            var pi: int = 2
            var after_dashdash: bool = false
            while pi < args.length() {
                let pa: String = args[pi]
                if after_dashdash {
                    run_argv.push(pa)
                } else {
                    if pa == "--" {
                        after_dashdash = true
                    } else {
                        if pa == "--release" {
                            pi = pi
                        } else {
                            // --target y --main son del PM: ni la flag ni su
                            // valor llegan al programa.
                            if pa == "--target" or pa == "--main" {
                                pi = pi + 1
                            } else {
                                run_argv.push(pa)
                            }
                        }
                    }
                }
                pi = pi + 1
            }
            return correr_programa(run_argv)
        }
        return 1
    }

    print("error: unknown command " + command)
    print("hint: nyx [init|add|build|run|check|fmt|test|info|report|capabilities|version] [--release] [--target <triple>] [--main <archivo.nx>]")
    return 1
}
