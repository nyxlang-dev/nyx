/// Campo `name` de una fila de gotchas_table(); "" si el nombre no existe.
pub fn gotcha_field(row: Array, name: String) -> String {
    var idx: int = -1
    if name == "id" { idx = 0 }
    if name == "kind" { idx = 1 }
    if name == "severity" { idx = 2 }
    if name == "since" { idx = 3 }
    if name == "fixed_in" { idx = 4 }
    if name == "pattern" { idx = 5 }
    if name == "vet_code" { idx = 6 }
    if name == "anchor" { idx = 7 }
    if name == "lies" { idx = 8 }
    if name == "test" { idx = 9 }
    if name == "title_en" { idx = 10 }
    if name == "title_es" { idx = 11 }
    if idx < 0 { return "" }
    let value: String = row[idx]
    return value
}
