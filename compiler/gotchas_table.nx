    rows.push(["option-struct-multifield-link", "fixed", "n/a", "0.22.21", "0.31.0", "", "", "boxing", "as the payload fails to LINK|rompe el LINK|clang refuses it every time|clang lo rechaza siempre", "tests/compiler/language/test-386-option-struct-multifield.nx,tests/ai-first/15-http-items-api.nx", "`Option<Struct>`/`Result<Struct, E>` with a 2+-field struct as the payload WORKS — return the struct directly, no Array packing needed.", "`Option<Struct>`/`Result<Struct, E>` con un struct de 2+ campos como payload FUNCIONA — retorna el struct directamente, sin empaquetarlo en un Array."])
    rows.push(["udp-binary-payload-intact", "fixed", "n/a", "0.23.0", "0.23.0", "", "", "udp_sendto", "", "tests/ai-first/20-udp-binary-payload.nx", "`udp_sendto`/`udp_recvfrom` carry binary payloads intact (fixed 2026-07-30)", "`udp_sendto`/`udp_recvfrom` transportan payloads binarios intactos (arreglado 2026-07-30)"])
    rows.push(["tls-peer-cert-introspection", "fixed", "n/a", "0.23.1", "0.23.1", "", "", "tls_peer_cert", "", "tests/ai-first/19-tls-introspection.nx", "You CAN inspect the peer's TLS certificate — no C bindings needed (v0.23.1)", "SÍ se puede inspeccionar el certificado TLS del peer — sin bindings a C (v0.23.1)"])
    rows.push(["missing-method-compile-error", "fixed", "n/a", "0.24.0", "0.24.0", "", "", "NYX1022", "", "", "A method that doesn't exist for the receiver's type is now a compile error, not garbage (v0.24.0)", "Un método que no existe para el tipo del receiver ahora es un error de compilación, no basura (v0.24.0)"])
    rows.push(["repl-declared-subset", "fixed", "n/a", "0.24.3", "0.24.3", "", "", "NYX30", "", "", "The REPL evaluates a declared SUBSET and says so loudly (v0.24.2-3)", "El REPL evalúa un SUBCONJUNTO declarado y lo dice en voz alta (v0.24.2-3)"])
    rows.push(["bind-failure-loud", "fixed", "n/a", "0.24.4", "0.24.4", "", "", "cannot bind port", "", "tests/ai-first/21-bind-failure-loud.nx", "A failed bind is LOUD now (v0.24.4)", "Un bind que falla ahora es RUIDOSO (v0.24.4)"])
    rows.push(["file-api-names", "fixed", "n/a", "0.24.4", "0.24.4", "", "", "file_open", "open_file(|close_file(", "", "The real buffered file API is `file_open()`/`file_write_string()`/`file_close()` — not `open_file()` or `close_file()` (invented names)", "La API real de archivos con buffer es `file_open()`/`file_write_string()`/`file_close()` — no `open_file()` ni `close_file()` (nombres inventados)"])
    rows.push(["array-index-float-write", "fixed", "n/a", "0.24.10", "0.24.10", "", "", "", "corrupts the value on the next read", "tests/ai-first/17-csv-aggregator.nx,tests/ai-first/18-http-client-filter.nx", "`arr[i] = <float>` on an existing Array WORKS", "`arr[i] = <float>` sobre un Array existente FUNCIONA"])
    rows.push(["sync-global-init-reliable", "fixed", "n/a", "0.24.27", "0.24.27", "", "", "mutex_new", "", "tests/ai-first/23-sync-global-mutex-wg-timeout.nx", "Stateful handles (`mutex_new()`, `sem_new()`, `wg_new()`) are RELIABLE as global initializers (since v0.24.27; measured 2026-08-21)", "Los handles con estado (`mutex_new()`, `sem_new()`, `wg_new()`) son CONFIABLES como inicializadores globales (desde v0.24.27; medido 2026-08-21)"])
    rows.push(["continue-in-for-loop", "fixed", "n/a", "0.31.0", "0.31.0", "", "", "", "", "tests/compiler/language/test-416-continue-en-for-in.nx", "`continue` inside a `for … in` loop moves to the next iteration (fixed 2026-09-13)", "`continue` dentro de un `for … in` pasa a la siguiente vuelta (arreglado el 2026-09-13)"])
    rows.push(["http-host-header-port", "fixed", "n/a", "0.31.0", "0.31.0", "", "", "", "", "tests/ai-first/28-http-host-port.nx", "The `std/http` client sends `Host` with the port when it is not the scheme default (fixed 2026-09-14)", "El cliente de `std/http` manda `Host` con el puerto cuando no es el de omisión del esquema (arreglado el 2026-09-14)"])
    rows.push(["json-truncated-rejected", "fixed", "n/a", "0.31.0", "0.31.0", "", "", "", "", "tests/ai-first/27-json-truncado.nx", "A truncated JSON document is an `Err`, not a shorter `Ok` (fixed 2026-09-14)", "Un JSON truncado es un `Err`, no un `Ok` más corto (arreglado el 2026-09-14)"])
    rows.push(["nested-fn-sees-module", "fixed", "n/a", "0.31.0", "0.31.0", "", "", "", "", "tests/compiler/language/test-413-fn-anidada-ve-traits-y-genericos.nx", "A nested function — and an `async fn` body — sees everything its module sees (fixed 2026-09-11)", "Una función anidada —y el cuerpo de una `async fn`— ve todo lo que ve su módulo (arreglado el 2026-09-11)"])
    rows.push(["try-early-exit-pop", "fixed", "n/a", "0.31.0", "0.31.0", "", "", "", "", "tests/compiler/language/test-431-try-salida-temprana-pop.nx", "Leaving a `try` early with `return`, `?`, `break` or `continue` no longer leaks a try level (fixed 2026-09-15)", "Salir de un `try` antes de tiempo con `return`, `?`, `break` o `continue` ya no pierde un nivel de try (arreglado el 2026-09-15)"])
    rows.push(["std-private-shadows-builtin", "fixed", "loud", "0.32.0", "0.32.1", "", "", "string_to_int", "", "tests/ai-first/30-std-privada-homonima-de-builtin.nx", "A private function in a `std/` module with the same name as a builtin no longer hijacks your call.", "Una función privada de un módulo de `std/` con el mismo nombre que un builtin ya no se apropia de tu llamada."])
    return rows
}

/// Campo `name` de una fila de gotchas_table(); "" si el nombre no existe.
pub fn gotcha_field(row: Array, name: String) -> String {
    var idx: int = -1
    if name == "id" { idx = 0 }
    if name == "kind" { idx = 1 }
    if name == "severity" { idx = 2 }
    if name == "since" { idx = 3 }
    if name == "fixed_in" { idx = 4 }
    if name == "pattern" { idx = 5 }
    if name == "vet_code" { idx = 6 }
    if name == "anchor" { idx = 7 }
    if name == "lies" { idx = 8 }
    if name == "test" { idx = 9 }
    if name == "title_en" { idx = 10 }
    if name == "title_es" { idx = 11 }
    if idx < 0 { return "" }
    let value: String = row[idx]
    return value
}
