// GENERATED by gendocs from docs/gotchas/ — do not edit
// Fuente: docs/gotchas/*.md — regenerar con `make gen-agent-docs`.
//
// Cada fila es un Array<String> de 12 campos, en este orden:
//   0 id · 1 kind · 2 severity · 3 since · 4 fixed_in · 5 pattern
//   6 vet_code · 7 anchor · 8 lies · 9 test · 10 title_en · 11 title_es
// title_* es la forma corta SIN los `**` que la envuelven, con los saltos
// de línea colapsados a espacios (un literal de Nyx es de una sola línea).
// `lies` y `test` pueden traer varias entradas: `lies` separadas por «|»,
// `test` por comas.

// El recorte que aplica el matcheo TEXTUAL de los `pattern:` — sin él un
// comentario o un string que CITA un gotcha se reporta como si fuera código.
// FUENTE ÚNICA: esta función y GOTCHA_SCAN_SRC (su propio fuente, más abajo)
// salen de la MISMA plantilla de compiler/gendocs.nx: compiler/vet.nx llama a
// la función y compiler/build.nx inyecta la constante en el test de
// constitución que siembra `nyx sdd init`, así que no pueden divergir.
// Trims what a TEXTUAL match must not see: the first // outside quotes (and
// everything after it), plus the contents of every double-quoted literal
// (each byte blanked to a space, quotes and positions kept, so line and
// column numbers never move). A backslash-escaped quote inside a literal does
// not close it. Deliberate scope: only // and double quotes — Nyx has no
// block comments today; if it ever gets them, extend this.
// charAt() returns an int: 34 is a double quote, 92 a backslash, 47 a slash.
pub fn gotcha_scan_line(line: String) -> String {
    var out: String = ""
    let n: int = line.length()
    var in_str: bool = false
    var i: int = 0
    while i < n {
        let c: int = line.charAt(i)
        if in_str {
            if c == 34 {
                out = out + "\""
                in_str = false
                i = i + 1
            } else if c == 92 and i + 1 < n {
                out = out + "  "
                i = i + 2
            } else {
                out = out + " "
                i = i + 1
            }
        } else if c == 34 {
            out = out + "\""
            in_str = true
            i = i + 1
        } else if c == 47 and i + 1 < n and line.charAt(i + 1) == 47 {
            return out
        } else {
            out = out + line.substring(i, i + 1)
            i = i + 1
        }
    }
    return out
}

