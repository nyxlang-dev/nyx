// examples/http2-server.nx — servidor HTTP/2 sobre std/http2
// En claro (h2c):  ./bin [puerto]                 → curl --http2-prior-knowledge http://127.0.0.1:3004/
// Sobre TLS (h2):  ./bin <puerto> <cert> <key>    → curl --http2 -k https://127.0.0.1:<puerto>/

import "std/http2"

fn handle_request(method: String, path: String, headers: Array, body: String) -> Array {
    if path == "/" {
        let html: String = "<html><body><h1>Hello from Nyx HTTP/2!</h1><p>Method: " + method + "</p></body></html>"
        let resp_headers: Array = ["content-type", "text/html; charset=utf-8", "server", "nyx-http2"]
        let result: Array = [200, resp_headers, html]
        return result
    }
    if path == "/json" {
        let json_body: String = "{\"status\":\"ok\",\"server\":\"nyx-http2\",\"protocol\":\"h2c\"}"
        let resp_headers2: Array = ["content-type", "application/json", "server", "nyx-http2"]
        let result2: Array = [200, resp_headers2, json_body]
        return result2
    }
    if path == "/ping" {
        let resp_headers3: Array = ["content-type", "text/plain", "server", "nyx-http2"]
        let result3: Array = [200, resp_headers3, "pong"]
        return result3
    }
    if path == "/big" {
        // 300 KB: más que la ventana inicial de control de flujo (65 535).
        let trozo: String = "0123456789abcdef".repeat(64)
        let resp_headers5: Array = ["content-type", "text/plain"]
        let result5: Array = [200, resp_headers5, trozo.repeat(293)]
        return result5
    }
    if path == "/echo" {
        let resp_headers6: Array = ["content-type", "text/plain", "x-method", method]
        let result6: Array = [200, resp_headers6, body]
        return result6
    }
    // 404
    let not_found_body: String = "404 Not Found"
    let resp_headers4: Array = ["content-type", "text/plain", "server", "nyx-http2"]
    let result4: Array = [404, resp_headers4, not_found_body]
    return result4
}

fn main() -> int {
    var port: int = 3004
    let args: Array = get_args()
    if args.length() > 1 {
        let port_str: String = args[1]
        port = string_to_int(port_str)
    }
    if args.length() > 3 {
        let cert: String = args[2]
        let key: String = args[3]
        println("nyx-http2 (TLS) listening on port " + int_to_string(port))
        if h2_serve_tls(port, 4, cert, key, handle_request) < 0 {
            println("no se pudo cargar el certificado o abrir el puerto")
            return 1
        }
        return 0
    }
    println("nyx-http2 listening on port " + int_to_string(port))
    h2_serve(port, 4, handle_request)
    return 0
}
