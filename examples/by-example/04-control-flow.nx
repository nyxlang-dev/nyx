// Control de flujo: if/else, while, for con range, break y continue

fn main() -> int {
    // if / else if / else
    let x: int = 7
    if x > 10 {
        print("mayor que 10")
    } else if x > 5 {
        print("entre 5 y 10")
    } else {
        print("5 o menos")
    }

    // while que cuenta del 1 al 5
    var i: int = 1
    while i <= 5 {
        print("while: " + int_to_string(i))
        i = i + 1
    }

    // for con range (0..5 excluye el 5)
    for n in 0..5 {
        print("range: " + int_to_string(n))
    }

    // for con array
    let colores: Array = ["rojo", "verde", "azul"]
    for c in colores {
        print("color: " + c)
    }

    // break y continue
    var k: int = 0
    while k < 10 {
        k = k + 1
        if k == 3 {
            continue
        }
        if k == 6 {
            break
        }
        print("k = " + int_to_string(k))
    }

    return 0
}
