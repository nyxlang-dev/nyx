// Timer y sleep: medir tiempo transcurrido con monotonic_ms() y pausar con sleep().
//
// monotonic_ms() cuenta desde que arrancó la máquina, no desde 1970: una
// lectura suelta no es una fecha. Lo que vale es la DIFERENCIA entre dos, y
// para eso el reloj monotónico es el correcto — un salto de NTP no puede hacer
// que el tiempo transcurrido salte ni retroceda. Para una fecha: time_epoch().

fn main() -> int {
    print("start")

    let t0: int = monotonic_ms()

    // Pausar 500 milisegundos
    sleep(500)

    let t1: int = monotonic_ms()
    let elapsed: int = t1 - t0

    print("500ms passed")
    print("tiempo real: " + int_to_string(elapsed) + "ms")

    // Medir una operacion costosa
    let t2: int = monotonic_ms()
    var suma: int = 0
    var i: int = 0
    while i < 1000000 {
        suma = suma + i
        i = i + 1
    }
    let t3: int = monotonic_ms()
    let dur: int = t3 - t2
    print("suma de 0..1M = " + int_to_string(suma))
    print("duracion loop: " + int_to_string(dur) + "ms")

    return 0
}
