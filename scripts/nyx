#!/usr/bin/env bash
# nyx — wrapper script for running Nyx programs directly
# Usage: nyx script.nx [args...]
#        #!/usr/bin/env nyx  (shebang in .nx files)
#
# Requires: nyx_bootstrap in PATH or in the same directory as this script

set -e

# ── Spinner helper ──────────────────────────────────────
# Usage: spin "message" command arg1 arg2 ...
spin() {
    local msg="$1"; shift

    "$@" > /dev/null 2>&1 &
    local pid=$!
    local i=0

    while kill -0 "$pid" 2>/dev/null; do
        case $((i % 4)) in
            0) f="◐" ;; 1) f="◓" ;; 2) f="◑" ;; 3) f="◒" ;;
        esac
        printf "\r  \033[1;36m%s\033[0m %s" "$f" "$msg" >&2
        i=$((i + 1))
        sleep 0.15
    done

    wait "$pid"
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        printf "\r  \033[1;32m✓\033[0m %s\033[K\n" "$msg" >&2
    else
        printf "\r  \033[1;31m✗\033[0m %s\033[K\n" "$msg" >&2
        return "$rc"
    fi
}

# Resolve symlinks so SCRIPT_DIR points to the real location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# NYX_HOME resolution: env var → script parent → ~/.nyx/
if [ -n "${NYX_HOME:-}" ]; then
    : # already set
elif [ -f "$SCRIPT_DIR/../nyx_bootstrap" ]; then
    NYX_HOME="$SCRIPT_DIR/.."
elif [ -f "$SCRIPT_DIR/../bin/nyx" ] && [ -d "$SCRIPT_DIR/../runtime" ]; then
    NYX_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "$HOME/.nyx/runtime" ]; then
    NYX_HOME="$HOME/.nyx"
else
    NYX_HOME="$SCRIPT_DIR/.."
fi

# Find nyx compiler binary (nyx_bootstrap or installed bin/nyx)
if [ -x "$NYX_HOME/nyx_bootstrap" ]; then
    NYX_BOOTSTRAP="$NYX_HOME/nyx_bootstrap"
elif [ -x "$NYX_HOME/bin/nyx" ]; then
    NYX_BOOTSTRAP="$NYX_HOME/bin/nyx"
elif command -v nyx_bootstrap &>/dev/null; then
    NYX_BOOTSTRAP="nyx_bootstrap"
else
    echo "error: nyx compiler not found." >&2
    echo "  Install: curl -sSf https://nyxlang.com/install.sh | sh" >&2
    exit 1
fi

# ── Update check (once per day, in background) ──────────
check_for_updates() {
    local check_file="$NYX_HOME/.last_check"
    local now
    now=$(date +%s)

    # Skip if checked in the last 24h
    if [ -f "$check_file" ]; then
        local last
        last=$(cat "$check_file" 2>/dev/null || echo 0)
        local diff=$((now - last))
        if [ "$diff" -lt 86400 ]; then
            return
        fi
    fi

    # Save timestamp now (even if check fails)
    echo "$now" > "$check_file" 2>/dev/null

    # Compare local vs remote hash (needs .git)
    if [ -d "$NYX_HOME/.git" ]; then
        local local_hash remote_hash
        local_hash=$(cd "$NYX_HOME" && git rev-parse HEAD 2>/dev/null)
        remote_hash=$(cd "$NYX_HOME" && git ls-remote origin HEAD 2>/dev/null | cut -f1)
        if [ -n "$remote_hash" ] && [ -n "$local_hash" ] && [ "$local_hash" != "$remote_hash" ]; then
            printf "\033[1;33m  A new version of Nyx is available. Run 'nyx update' to upgrade.\033[0m\n" >&2
        fi
    fi
}

# Run update check (skips if checked in last 24h)
check_for_updates

# Handle flags
case "${1:-}" in
    --version|-v)
        if [ -f "$NYX_HOME/VERSION" ]; then
            echo "nyx $(cat "$NYX_HOME/VERSION")"
        else
            echo "nyx 0.31.0"
        fi
        exit 0
        ;;
    --help|-h|help)
        # P1 friction-portscan: `help` como comando (antes `nyx help run` caía al
        # camino de archivo suelto y buscaba un fichero llamado "help").
        echo "Usage: nyx <file.nx> [args...]"
        echo "       nyx <command> [options]"
        echo ""
        echo "Commands:"
        echo "  init [name]   Create a new project (nyx.toml + src/main.nx + AGENTS.md + docs/nyx/)"
        echo "                  --lang en|es                  language of the seeded docs (default: NYX_LANG, else en)"
        echo "                  --agent=claude,cursor,copilot  also seed the 3-line adapter for those tools"
        echo "                  --sdd                          also seed the SDD scaffolding (see below)"
        echo "  sdd init      Seed the SDD scaffolding in an EXISTING project (constitution,"
        echo "                glossary, evidence, ADR template, specs/, constitution test, guide)"
        echo "  sdd evidence  Regenerate docs/evidence/ for the installed toolchain"
        echo "  add <pkg>     Add a package dependency"
        echo "  build         Build the project"
        echo "  run [args...] Build and run the project (args go to the program;"
        echo "                use -- to pass args that look like nyx flags)"
        echo "  info          Show project info"
        echo ""
        echo "Self-check (no linking, no execution — chainable with &&):"
        echo "  check [f.nx]  Parse + type-check only. Exit 1 on error. FASTEST feedback."
        echo "  fmt   [f.nx]  Canonical formatting (to stdout)"
        echo "  vet   [f.nx]  Unused vars, dead code, unused imports"
        echo "  test          Run tests/*.nx  (tests use: test \"name\" { ... })"
        echo "                (no argument = src/main.nx)"
        echo ""
        echo "  update        Update Nyx to the latest version (+ what's new)"
        echo "  update --sync-docs   Refresh AI context (AGENTS.md + docs/nyx/) in this project"
        echo "  report [f.md] Send a friction/bug report to the Nyx team"
        echo "  uninstall     Remove Nyx from this system"
        echo ""
        echo "Options:"
        echo "  --version     Show version"
        echo "  --help        Show this help"
        exit 0
        ;;
esac

# Handle uninstall and update
case "${1:-}" in
    uninstall)
        echo "Uninstalling Nyx..."
        rm -f "$HOME/.local/bin/nyx"
        rm -rf "$HOME/.nyx"
        echo "Nyx has been uninstalled."
        echo "  Removed: ~/.nyx/"
        echo "  Removed: ~/.local/bin/nyx"
        exit 0
        ;;
    update)
        # ── nyx update --sync-docs: refresca el contexto para agentes del
        # PROYECTO (AGENTS.md + docs/nyx/) desde el toolchain. Así el asistente
        # de un proyecto aislado aprende las features nuevas sin re-init.
        # Desde ADR-1 (2026-09-04) el proyecto es MONOLINGÜE: el juego de
        # plantillas sale de `templates/<lang>/`, con lang leído del sello del
        # propio AGENTS.md (`nyx-lang: xx`, default en). LLM.md sale siempre de
        # `templates/en/` (la referencia densa es monolingüe por decisión).
        # Los adaptadores por proveedor (CLAUDE.md, .cursorrules, copilot) NO
        # se pisan: son opt-in y suelen tener ediciones del usuario.
        # La MIGRACIÓN de layouts viejos (LLM.md en la raíz, CHEATSHEET.md,
        # .claude/skills sembradas) es otra tarea: acá no se mueve ni se borra
        # nada del proyecto.
        if [ "${2:-}" = "--sync-docs" ]; then
            if [ ! -f nyx.toml ]; then
                echo "error: no hay nyx.toml aca - corre esto dentro de un proyecto Nyx" >&2
                exit 1
            fi
            synced=""
            lang="en"
            if [ -f AGENTS.md ]; then
                _l="$(sed -n 's/.*nyx-lang: \([a-z][a-z]\).*/\1/p' AGENTS.md | head -1)"
                [ -n "$_l" ] && lang="$_l"
            fi
            [ -d "$NYX_HOME/templates/$lang" ] || lang="en"
            # Sello de versión + idioma al final de cada archivo resembrado (el
            # mismo que pone nyx_build init — ver seed_file en
            # compiler/build.nx); con él _warn_seed_drift deja de avisar y la
            # próxima deriva vuelve a verse.
            _stamp_seed() { printf '\n<!-- nyx-version: %s nyx-lang: %s -->\n' "$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')" "$lang" >> "$1"; }

            # ── Migración del layout viejo (spec §2 «Migración de proyectos
            # existentes», Task 6) — corre ANTES de sincronizar nada. Regla de
            # oro: solo se toca lo que llevaba NUESTRO sello
            # (`grep 'nyx-version:'`); cualquier archivo sin sello lo escribió
            # el usuario y se avisa, nunca se pisa. Siempre .bak antes de
            # mover/reemplazar/borrar. Idempotente: LLM.md/CHEATSHEET.md/
            # .claude/skills desaparecen de su lugar viejo en la primera
            # corrida (la segunda ya no los encuentra); los adaptadores se
            # comparan contra el contenido que produciríamos hoy, así que una
            # segunda corrida que ya coincide no los vuelve a tocar.
            _has_stamp() { grep -q 'nyx-version:' "$1" 2>/dev/null; }
            # _safe_backup ARCHIVO — respalda ARCHIVO en ARCHIVO.bak SIN pisar
            # un .bak preexistente (fix round 1, Task 6): un respaldo manual
            # del usuario, o el de una corrida interrumpida y restaurada a
            # mano, no se destruye en silencio. Si ARCHIVO.bak ya existe, usa
            # el primer ARCHIVO.bak.N libre y avisa; deja el path elegido en
            # $_LAST_BAK para que el caller lo cite en su mensaje. Nunca
            # aborta la migración por esto.
            _safe_backup() {
                local file="$1" bak="$1.bak"
                if [ -e "$bak" ]; then
                    local n=1
                    while [ -e "$bak.$n" ]; do n=$((n + 1)); done
                    bak="$bak.$n"
                    printf '⚠ %s.bak ya existía: respaldo en %s\n' "$file" "$bak" >&2
                fi
                cp -a "$file" "$bak"
                _LAST_BAK="$bak"
            }
            _MIG_TMP="$(mktemp -d)"
            # _migrate_adapter ARCHIVO PROVEEDOR — reemplaza ARCHIVO por el
            # adaptador fino de $NYX_HOME/templates/adapters/<proveedor>.<lang>.md
            # si ARCHIVO existe y lleva sello; deja la versión vieja en .bak.
            # Sin sello: aviso, no se toca. Ya migrado (contenido idéntico al
            # que generaríamos hoy): no hace nada — idempotencia real, sin
            # tocar el mtime.
            _migrate_adapter() {
                local file="$1" provider="$2"
                [ -f "$file" ] || return 0
                if ! _has_stamp "$file"; then
                    printf '⚠ %s no lo sembró nyx (sin sello): no se toca\n' "$file" >&2
                    return 0
                fi
                local tpl="$NYX_HOME/templates/adapters/$provider.$lang.md"
                [ -f "$tpl" ] || tpl="$NYX_HOME/templates/adapters/$provider.en.md"
                [ -f "$tpl" ] || return 0
                local want="$_MIG_TMP/$provider.want"
                cp "$tpl" "$want"
                _stamp_seed "$want"
                if cmp -s "$want" "$file"; then
                    return 0
                fi
                mkdir -p "$(dirname "$file")"
                _safe_backup "$file"
                cp "$want" "$file"
                echo "  → $file regenerado como adaptador fino (versión previa en $_LAST_BAK)"
            }
            _migrate_seeded_layout() {
                # LLM.md en la raíz CON sello → se retira; docs/nyx/LLM.md
                # queda a cargo del _sync_one de abajo (copia fresca desde el
                # template, con su propio .bak si hiciera falta).
                if [ -f LLM.md ]; then
                    if _has_stamp LLM.md; then
                        _safe_backup LLM.md
                        rm -f LLM.md
                        echo "  → LLM.md (raíz) migrado a docs/nyx/LLM.md (versión previa en $_LAST_BAK)"
                    else
                        printf '⚠ LLM.md no lo sembró nyx (sin sello): no se toca\n' >&2
                    fi
                fi
                # CHEATSHEET.md CON sello → se retira (contenido absorbido por
                # AGENTS.md + docs/nyx/ hace tiempo).
                if [ -f CHEATSHEET.md ]; then
                    if _has_stamp CHEATSHEET.md; then
                        _safe_backup CHEATSHEET.md
                        rm -f CHEATSHEET.md
                        echo "  → CHEATSHEET.md retirado (versión previa en $_LAST_BAK)"
                    else
                        printf '⚠ CHEATSHEET.md no lo sembró nyx (sin sello): no se toca\n' >&2
                    fi
                fi
                # Adaptadores por proveedor CON sello → adaptador fino (ADR-1).
                _migrate_adapter CLAUDE.md claude
                _migrate_adapter .cursorrules cursor
                _migrate_adapter .github/copilot-instructions.md copilot
                # .claude/skills/*/SKILL.md CON sello → todo el directorio a
                # .claude/skills.bak (las guías neutrales viven en
                # docs/nyx/guides/ desde ADR-1). Si CUALQUIER SKILL.md no
                # lleva sello, no se toca nada del directorio (podría tener
                # skills propias del usuario mezcladas con las nuestras).
                if [ -d .claude/skills ]; then
                    _skf_found=0
                    _skf_unstamped=0
                    for _skf in .claude/skills/*/SKILL.md; do
                        [ -f "$_skf" ] || continue
                        _skf_found=1
                        if _has_stamp "$_skf"; then
                            :
                        else
                            printf '⚠ %s no lo sembró nyx (sin sello): no se toca\n' "$_skf" >&2
                            _skf_unstamped=1
                        fi
                    done
                    if [ "$_skf_found" -eq 1 ] && [ "$_skf_unstamped" -eq 0 ]; then
                        mv .claude/skills .claude/skills.bak
                        echo "  → .claude/skills retirado (.claude/skills.bak) — las guías viven en docs/nyx/guides/"
                    fi
                fi
            }
            _migrate_seeded_layout
            rm -rf "$_MIG_TMP"

            # _sync_one PLANTILLA DESTINO — copia con .bak si el destino difería.
            # El respaldo va por _safe_backup (no por un `cp` crudo): estas son
            # las 5 rutas que --sync-docs toca SIEMPRE (AGENTS.md, docs/nyx/LLM.md
            # y las 3 guías), y un `.bak` propio del usuario no se destruye en
            # silencio — escala a .bak.N avisando, igual que la migración.
            _sync_one() {
                [ -f "$1" ] || return 0
                mkdir -p "$(dirname "$2")"
                if [ -f "$2" ] && ! cmp -s "$1" "$2"; then
                    _safe_backup "$2"
                fi
                cp "$1" "$2"
                _stamp_seed "$2"
                synced="$synced $2"
            }
            _sync_one "$NYX_HOME/templates/$lang/AGENTS.md" AGENTS.md
            _sync_one "$NYX_HOME/templates/en/docs/nyx/LLM.md" docs/nyx/LLM.md
            for _g in "$NYX_HOME/templates/$lang/docs/nyx/guides/"*.md; do
                [ -f "$_g" ] || continue
                _sync_one "$_g" "docs/nyx/guides/$(basename "$_g")"
            done
            # CAPABILITIES.md: se GENERA de la stdlib instalada (no es template).
            _NB="$NYX_HOME/nyx_build"; [ -x "$_NB" ] || _NB="$NYX_HOME/bin/nyx_build"
            if [ -x "$_NB" ]; then
                NYX_HOME="$NYX_HOME" "$_NB" capabilities CAPABILITIES.md >/dev/null 2>&1 \
                    && synced="$synced CAPABILITIES.md(generado)"
            fi
            ver=$(cat "$NYX_HOME/VERSION" 2>/dev/null || echo "?")
            printf "  \033[1;32mContexto para agentes sincronizado a nyx v%s (idioma: %s):\033[0m%s\n" "$ver" "$lang" "$synced"
            echo "  (los archivos previos con cambios quedaron en *.bak)"
            exit 0
        fi

        printf "\n  \033[1mUpdating Nyx\033[0m\n\n"
        # El proyecto desde el que se llamó: `cd "$NYX_HOME"` lo pierde, y al
        # final hay que volver para regenerar la evidencia del andamiaje SDD.
        _PROJECT_DIR="$PWD"
        cd "$NYX_HOME"
        if [ ! -d .git ]; then
            echo "error: $NYX_HOME is not a git repo. Reinstall with:" >&2
            echo "  curl -sSf https://nyxlang.com/install.sh | sh" >&2
            exit 1
        fi
        OLD_VERSION=$(cat VERSION 2>/dev/null || echo "")
        spin "Fetching latest version..." bash -c "git fetch origin && git reset --hard origin/main" \
            || { echo "error: git update failed" >&2; exit 1; }
        spin "Rebuilding compiler..." make bootstrap \
            || { echo "error: make bootstrap failed" >&2; exit 1; }
        spin "Rebuilding package manager..." make build-nyx-build \
            || { echo "error: make build-nyx-build failed" >&2; exit 1; }
        # nyx_test tambien: sin esto un update REVERTIRIA el fix de install.sh
        # (dist-clean borra compiler/, asi que despues ya no se puede rebuildear)
        spin "Rebuilding test runner..." make build-test \
            || { echo "error: make build-test failed" >&2; exit 1; }
        # nyx_check idem (C4 2026-08-11): el wrapper lo rutea, AGENTS.md lo
        # promociona, y sin este build el comando moria en toda instalacion.
        spin "Rebuilding checker..." make build-check \
            || { echo "error: make build-check failed" >&2; exit 1; }
        spin "Rebuilding vet..." make build-vet \
            || { echo "error: make build-vet failed" >&2; exit 1; }
        spin "Rebuilding formatter..." make build-fmt \
            || { echo "error: make build-fmt failed" >&2; exit 1; }
        # refrescar binarios de bin/ y limpiar dev files (lista CANONICA
        # compartida con install.sh - antes habia dos listas desincronizadas)
        mkdir -p bin
        cp nyx_bootstrap bin/nyx 2>/dev/null || true
        cp nyx_build bin/nyx_build 2>/dev/null || true
        bash scripts/dist-clean.sh "$NYX_HOME"
        NEW_VERSION=$(cat VERSION 2>/dev/null || echo "?")
        printf "\n  \033[1;32mNyx updated: %s -> %s\033[0m\n" "${OLD_VERSION:-?}" "$NEW_VERSION"
        # ── What's new: bloque del CHANGELOG entre la version vieja y la nueva ──
        if [ -f CHANGELOG.md ] && [ -n "$OLD_VERSION" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ]; then
            printf "\n  \033[1mWhat's new:\033[0m\n"
            awk -v old="[$OLD_VERSION]" '/^## \[/ { if (index($0, old)) exit } /^## /{shown++} shown{print "  " $0} shown && ++n>=60{print "  ..."; exit}' CHANGELOG.md
            echo ""
            echo "  Para actualizar el contexto IA de tus proyectos:"
            echo "    cd <proyecto> && nyx update --sync-docs"
        fi
        # ── What's new de gotchas: trampas que ya no hace falta esquivar
        # entre OLD_VERSION y NEW_VERSION (Task 2: `nyx_gendocs fixed-since`
        # imprime «id: título» de cada gotcha kind:fixed con fixed_in >
        # versión). Nunca fatal — si nyx_gendocs no está instalado (toolchain
        # vieja recién actualizada a esta misma versión, antes del próximo
        # install-local) simplemente no se muestra nada.
        if [ -n "${OLD_VERSION:-}" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ] && [ -x "$NYX_HOME/nyx_gendocs" ]; then
            printf "\n  \033[1mGotchas que ya no hace falta esquivar:\033[0m\n"
            "$NYX_HOME/nyx_gendocs" fixed-since "$OLD_VERSION" | sed 's/^/  /'
        fi
        # ── Andamiaje SDD: docs/evidence/ y el test de constitución son
        # GENERADOS desde la tabla de gotchas de la toolchain, así que después
        # de un update quedarían de la versión vieja (justo la clase de mentira
        # que este arco persigue). Solo si el proyecto desde el que se llamó
        # tiene andamiaje; nunca crea nada, nunca pisa lo que el usuario editó.
        if [ -f "$_PROJECT_DIR/nyx.toml" ] && [ -d "$_PROJECT_DIR/docs/evidence" ]; then
            _NBU="$NYX_HOME/nyx_build"; [ -x "$_NBU" ] || _NBU="$NYX_HOME/bin/nyx_build"
            if [ -x "$_NBU" ]; then
                printf "\n  \033[1mAndamiaje SDD de este proyecto:\033[0m\n"
                (cd "$_PROJECT_DIR" && NYX_HOME="$NYX_HOME" "$_NBU" sdd evidence 2>&1 | sed 's/^/  /')
            fi
        fi
        exit 0
        ;;
esac

# ── Auto-verificacion: check / vet / fmt ────────────────────────────────
# Herramientas que ya existian como binarios pero NUNCA estuvieron cableadas
# al CLI: eran targets de `make` para quien clona el repo del compilador. Un
# agente no tenia forma de verificar su propio trabajo sin compilar y ejecutar.
# Todas honran NYX_SRC (fix 2026-07-28), asi que reciben la ruta REAL del
# archivo — sin scratch compartido, sin carrera entre invocaciones.
case "${1:-}" in
    check|vet|fmt)
        _sub="$1"
        case "$_sub" in
            check) _bin_name="nyx_check"; _make="build-check" ;;
            vet)   _bin_name="nyx_vet";   _make="build-vet"   ;;
            fmt)   _bin_name="nyx_fmt";   _make="build-fmt"   ;;
        esac
        _bin="$NYX_HOME/$_bin_name"
        [ -x "$_bin" ] || _bin="$NYX_HOME/bin/$_bin_name"
        if [ ! -x "$_bin" ]; then
            echo "error: $_bin_name no esta instalado en $NYX_HOME" >&2
            echo "  Arreglalo con:  nyx update" >&2
            exit 1
        fi
        shift
        _target="${1:-}"
        if [ -z "$_target" ]; then
            # Sin argumento: el punto de entrada del proyecto, o script.nx
            if [ -f nyx.toml ] && [ -f src/main.nx ]; then
                _target="src/main.nx"
            else
                _target="script.nx"
            fi
        fi
        if [ ! -f "$_target" ]; then
            echo "error: no existe el archivo '$_target'" >&2
            echo "  Uso: nyx $_sub [archivo.nx]   (sin argumento usa src/main.nx)" >&2
            exit 1
        fi
        NYX_SRC="$_target" NYX_HOME="$NYX_HOME" exec "$_bin"
        ;;
esac

# Route test subcommand to nyx_test
case "${1:-}" in
    test)
        NYX_TEST="$NYX_HOME/nyx_test"
        if [ ! -x "$NYX_TEST" ]; then
            # El mensaje viejo mandaba a `make build-test`, IMPOSIBLE de correr:
            # dist-clean.sh borra compiler/ y el Makefile del arbol instalado.
            # `nyx update` si lo reconstruye (rama update de este mismo script).
            echo "error: nyx_test no esta instalado en $NYX_HOME" >&2
            echo "  Arreglalo con:  nyx update" >&2
            echo "  (o reinstala:   curl -sSf https://nyxlang.com/install.sh | sh)" >&2
            exit 1
        fi
        export NYX_HOME
        shift
        exec "$NYX_TEST" "$@"
        ;;
esac

# Route shell subcommand to nyx-shell (extraído a nyx-shell-stack 2026-07-05)
case "${1:-}" in
    shell)
        NYX_SHELL="$(command -v nyx-shell || true)"
        if [ -z "$NYX_SHELL" ]; then
            echo "error: nyx-shell not found in PATH." >&2
            echo "  Install: git clone https://github.com/nyxlang-dev/nyx-shell && cd nyx-shell && nyx build && cp nyx-shell ~/.local/bin/" >&2
            exit 1
        fi
        shift
        exec "$NYX_SHELL" "$@"
        ;;
esac

# Auto self-heal de CAPABILITIES.md: en un proyecto (nyx.toml), si el índice
# falta o quedó de una versión vieja del toolchain, regenerarlo (barato, sin red).
# Así la LLM nunca lee un índice desactualizado y nadie corre comandos a mano.
_selfheal_capabilities() {
    [ -f nyx.toml ] || return 0
    local nb="$NYX_HOME/nyx_build"
    [ -x "$nb" ] || nb="$NYX_HOME/bin/nyx_build"
    [ -x "$nb" ] || return 0
    local curver
    curver="$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')"
    if [ ! -f CAPABILITIES.md ] || { [ -n "$curver" ] && ! grep -q "nyx-version: $curver" CAPABILITIES.md 2>/dev/null; }; then
        NYX_HOME="$NYX_HOME" "$nb" capabilities CAPABILITIES.md >/dev/null 2>&1 || true
    fi
}

# Aviso de deriva del contexto IA sembrado (F3 del informe de fricción, A2):
# AGENTS.md lleva el sello `<!-- nyx-version: X -->` desde que nyx init lo
# siembra (seed_file en compiler/build.nx). Si falta o es de otra versión, el
# agente está leyendo manuales de otro toolchain — se avisa en stderr, una
# vez por build, y NUNCA se toca el archivo (puede tener ediciones del
# usuario): refrescar es decisión suya con `nyx update --sync-docs` (deja .bak).
# CAPABILITIES.md sí se regenera solo porque es 100% generado; AGENTS.md no.
_warn_seed_drift() {
    [ -f nyx.toml ] && [ -f AGENTS.md ] || return 0
    local curver
    curver="$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$curver" ] || return 0
    if ! grep -q "nyx-version: $curver" AGENTS.md 2>/dev/null; then
        printf '\033[1;33m⚠ AGENTS.md fue sembrado por otra versión de nyx (o sin sello): el contexto IA puede estar desactualizado — `nyx update --sync-docs` lo refresca (deja .bak).\033[0m\n' >&2
    fi
}

# Route PM subcommands to nyx_build
case "${1:-}" in
    init|add|build|info|report|capabilities|sdd)
        NYX_BUILD="$NYX_HOME/nyx_build"
        [ ! -x "$NYX_BUILD" ] && NYX_BUILD="$NYX_HOME/bin/nyx_build"
        if [ ! -x "$NYX_BUILD" ]; then
            echo "error: nyx_build not found." >&2
            exit 1
        fi
        export NYX_HOME
        [ "$1" = "build" ] && { _selfheal_capabilities; _warn_seed_drift; }
        exec "$NYX_BUILD" "$@"
        ;;
    run)
        # nyx run file.nx → execute file directly
        if [ $# -ge 2 ] && echo "$2" | grep -q '\.nx$'; then
            shift  # remove "run", leave file.nx as $1
        else
            # nyx run → PM command (build + execute project)
            NYX_BUILD="$NYX_HOME/nyx_build"
            if [ ! -x "$NYX_BUILD" ]; then
                echo "error: nyx_build not found. Run: cd $NYX_HOME && make build-nyx-build" >&2
                exit 1
            fi
            export NYX_HOME
            _selfheal_capabilities
            _warn_seed_drift
            exec "$NYX_BUILD" "$@"
        fi
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Usage: nyx <file.nx> [args...]" >&2
    exit 1
fi

INPUT_FILE="$1"
shift

if [ ! -f "$INPUT_FILE" ]; then
    echo "error: file not found: $INPUT_FILE" >&2
    exit 1
fi

# Runtime sources (relative to NYX_HOME)
RUNTIME_SRCS="$NYX_HOME/runtime/runtime.c $NYX_HOME/runtime/strings.c \
  $NYX_HOME/runtime/runtime-arrays.c $NYX_HOME/runtime/maps.c \
  $NYX_HOME/runtime/file-io.c $NYX_HOME/runtime/iterators.c \
  $NYX_HOME/runtime/net.c $NYX_HOME/runtime/thread.c \
  $NYX_HOME/runtime/regex.c $NYX_HOME/runtime/time.c \
  $NYX_HOME/runtime/crypto.c $NYX_HOME/runtime/tls.c \
  $NYX_HOME/runtime/scheduler.c $NYX_HOME/runtime/event_loop.c \
  $NYX_HOME/runtime/sqlite_adapter.c $NYX_HOME/runtime/compress.c \
  $NYX_HOME/runtime/random.c $NYX_HOME/runtime/url.c \
  $NYX_HOME/runtime/msgpack.c $NYX_HOME/runtime/websocket.c \
  $NYX_HOME/runtime/persist.c $NYX_HOME/runtime/http2.c \
  $NYX_HOME/runtime/process.c $NYX_HOME/runtime/llama_adapter.c \
  $NYX_HOME/runtime/os/os_posix.c"
LIBS="-lgc -lpthread -ldl -lm -lssl -lcrypto -lz"

# Use a temp directory to avoid polluting CWD
TMPDIR_NYX="$(mktemp -d /tmp/nyx_run_XXXXXX)"
trap 'rm -rf "$TMPDIR_NYX"' EXIT

cp "$INPUT_FILE" "$TMPDIR_NYX/script.nx"

# Detección de proyecto (B2): si `nyx run <archivo.nx>` se invoca dentro de un
# proyecto Nyx (nyx.toml encontrado subiendo desde el CWD), exportar
# NYX_PROJECT_DIR para que `import "src/..."` resuelva — igual que `nyx build`,
# que corre desde la raíz del proyecto. Antes fallaba con el mismo error mudo de
# B1 salvo que el usuario pusiera NYX_PROJECT_DIR=$PWD a mano. Un
# NYX_PROJECT_DIR explícito del usuario tiene prioridad (no se pisa).
if [ -z "${NYX_PROJECT_DIR:-}" ]; then
    _pd="$PWD"
    while [ "$_pd" != "/" ]; do
        if [ -f "$_pd/nyx.toml" ]; then
            export NYX_PROJECT_DIR="$_pd"
            break
        fi
        _pd="$(dirname "$_pd")"
    done
fi

# Change to NYX_HOME so the driver can find std/ and compiler/. NYX_SRC apunta
# al scratch propio de esta invocación (script.nx/script.ll compartidos en
# NYX_HOME causaban una carrera real entre compilaciones concurrentes).
# El output del compilador (diagnósticos de texto Y el NDJSON de NYX_DIAG=json)
# se captura a un log: silencioso en éxito, volcado a stderr en fallo — igual
# que `nyx build`. Tragarlo con `>/dev/null 2>&1` dejaba al usuario (y a las
# LLM) con una sola línea muda y cero JSON, rompiendo la promesa AI-first (B1).
BUILD_LOG="$TMPDIR_NYX/build.log"
if ! (cd "$NYX_HOME" && NYX_SRC="$TMPDIR_NYX/script.nx" "$NYX_BOOTSTRAP" && \
  clang "$TMPDIR_NYX/script.ll" $RUNTIME_SRCS $LIBS -o "$TMPDIR_NYX/prog") > "$BUILD_LOG" 2>&1; then
    cat "$BUILD_LOG" >&2
    echo "error: compilation failed for $INPUT_FILE" >&2
    exit 1
fi

"$TMPDIR_NYX/prog" "$@"
