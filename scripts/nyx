#!/usr/bin/env bash
# nyx — wrapper script for running Nyx programs directly
# Usage: nyx script.nx [args...]
#        #!/usr/bin/env nyx  (shebang in .nx files)
#
# Requires: nyx_bootstrap in PATH or in the same directory as this script

set -e

# ── Spinner helper ──────────────────────────────────────
# Usage: spin "message" command arg1 arg2 ...
spin() {
    local msg="$1"; shift

    "$@" > /dev/null 2>&1 &
    local pid=$!
    local i=0

    while kill -0 "$pid" 2>/dev/null; do
        case $((i % 4)) in
            0) f="◐" ;; 1) f="◓" ;; 2) f="◑" ;; 3) f="◒" ;;
        esac
        printf "\r  \033[1;36m%s\033[0m %s" "$f" "$msg" >&2
        i=$((i + 1))
        sleep 0.15
    done

    wait "$pid"
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        printf "\r  \033[1;32m✓\033[0m %s\033[K\n" "$msg" >&2
    else
        printf "\r  \033[1;31m✗\033[0m %s\033[K\n" "$msg" >&2
        return "$rc"
    fi
}

# Resolve symlinks so SCRIPT_DIR points to the real location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# NYX_HOME resolution: env var → script parent → ~/.nyx/
if [ -n "${NYX_HOME:-}" ]; then
    : # already set
elif [ -f "$SCRIPT_DIR/../nyx_bootstrap" ]; then
    NYX_HOME="$SCRIPT_DIR/.."
elif [ -f "$SCRIPT_DIR/../bin/nyx" ] && [ -d "$SCRIPT_DIR/../runtime" ]; then
    NYX_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "$HOME/.nyx/runtime" ]; then
    NYX_HOME="$HOME/.nyx"
else
    NYX_HOME="$SCRIPT_DIR/.."
fi

# Find nyx compiler binary (nyx_bootstrap or installed bin/nyx)
if [ -x "$NYX_HOME/nyx_bootstrap" ]; then
    NYX_BOOTSTRAP="$NYX_HOME/nyx_bootstrap"
elif [ -x "$NYX_HOME/bin/nyx" ]; then
    NYX_BOOTSTRAP="$NYX_HOME/bin/nyx"
elif command -v nyx_bootstrap &>/dev/null; then
    NYX_BOOTSTRAP="nyx_bootstrap"
else
    echo "error: nyx compiler not found." >&2
    echo "  Install: curl -sSf https://nyxlang.com/install.sh | sh" >&2
    exit 1
fi

# ── Update check (once per day, in background) ──────────
check_for_updates() {
    local check_file="$NYX_HOME/.last_check"
    local now
    now=$(date +%s)

    # Skip if checked in the last 24h
    if [ -f "$check_file" ]; then
        local last
        last=$(cat "$check_file" 2>/dev/null || echo 0)
        local diff=$((now - last))
        if [ "$diff" -lt 86400 ]; then
            return
        fi
    fi

    # Save timestamp now (even if check fails)
    echo "$now" > "$check_file" 2>/dev/null

    # Compare local vs remote hash (needs .git)
    if [ -d "$NYX_HOME/.git" ]; then
        local local_hash remote_hash
        local_hash=$(cd "$NYX_HOME" && git rev-parse HEAD 2>/dev/null)
        remote_hash=$(cd "$NYX_HOME" && git ls-remote origin HEAD 2>/dev/null | cut -f1)
        if [ -n "$remote_hash" ] && [ -n "$local_hash" ] && [ "$local_hash" != "$remote_hash" ]; then
            printf "\033[1;33m  A new version of Nyx is available. Run 'nyx update' to upgrade.\033[0m\n" >&2
        fi
    fi
}

# Firma de la stdlib instalada: cksum de todo lo que lee `nyx capabilities`
# (std/*.nx + std/builtins.index) más VERSION. CAPABILITIES.md la lleva en su
# cabecera (`<!-- nyx-stdlib: N -->`, la escribe el generador desde
# NYX_CAPS_STAMP). Antes el self-heal miraba SOLO el número de versión: una
# stdlib que crecía sin subir la versión (install-local diario) dejaba el índice
# viejo y un equipo reimplementó SMTP porque std/smtp no aparecía (2026-09-24).
_caps_stamp() {
    cat "$NYX_HOME"/std/*.nx "$NYX_HOME/std/builtins.index" "$NYX_HOME/VERSION" 2>/dev/null \
        | cksum | tr -s ' ' '-'
}

# Candado del toolchain (~/.nyx/.toolchain.lock, contrato en CLAUDE.md
# §Sesiones paralelas regla 3): `make install-local` y `nyx update` lo toman
# EXCLUSIVO; lo que compila contra el toolchain, COMPARTIDO. nyx build/test lo
# toman por archivo desde nyx_build/nyx_test; este helper cubre lo que despacha
# el wrapper directo (nyx check/vet/fmt, `nyx archivo.nx`) y el update, que
# hasta 2026-09-24 reescribía binarios sin mirarlo (fricción de nyxerp).
# Queda tomado en el fd 9 del shell: lo hereda el `exec` del binario, o se
# suelta con `exec 9>&-`. Sin flock, o con NYX_HOME de solo lectura (nadie
# puede instalar ahí), no hay candado y se sigue.
# Uso: _toolchain_lock s|x "qué se está haciendo"
_toolchain_lock() {
    command -v flock >/dev/null 2>&1 || return 0
    local lock="$NYX_HOME/.toolchain.lock" wait="${NYX_LOCK_WAIT:-600}"
    { exec 9>"$lock"; } 2>/dev/null || return 0
    flock -n "-$1" 9 && return 0
    if [ "$1" = x ]; then
        echo "nyx: esperando el candado del toolchain para $2: hay una compilación o instalación en curso en esta máquina (hasta ${wait}s)..." >&2
    else
        echo "nyx: esperando el candado del toolchain para $2: hay una instalación en curso en esta máquina (hasta ${wait}s)..." >&2
    fi
    flock "-$1" -w "$wait" 9 && return 0
    echo "error: el candado del toolchain sigue tomado tras ${wait}s: $lock" >&2
    exec 9>&-   # que fuser no liste a este mismo proceso
    (command -v fuser >/dev/null 2>&1 && fuser -v "$lock" 2>&1 | sed 's/^/    /' >&2) || true
    echo "  Espera a que termine, o sube el plazo con NYX_LOCK_WAIT=<segundos>. No se cambió nada." >&2
    exit 1
}

# Run update check (skips if checked in last 24h)
check_for_updates

# Handle flags
case "${1:-}" in
    --version|-v)
        # Identidad de la INSTALACIÓN, no solo el número de release.
        #
        # POR QUÉ (fricción de nyxerp, 2026-09-12): un equipo reportó un bloqueo
        # total y no pudo decir con qué compilación lo midió — «nyx --version dice
        # 0.31.0 y ~/.nyx/VERSION también, pero durante esta misma sesión llegaron
        # tres cambios de comportamiento sin que ese número se moviera». Tenían
        # razón, y además el bug que reportaban ERA una discrepancia entre las dos
        # mitades del toolchain: un prelude nuevo con un compilador viejo.
        #
        # Las huellas se CALCULAN de los archivos reales, no se leen de un sello
        # escrito al instalar. Un sello es justamente lo que puede quedar viejo —
        # el modo de fallo que estamos arreglando— mientras que el hash del binario
        # que se va a ejecutar no puede mentir sobre qué binario es.
        #
        # Se muestran las DOS mitades a propósito: compilador y prelude se instalan
        # por separado y pueden no corresponderse. Dos instalaciones con el mismo
        # número de versión y distinto par de huellas no son la misma cosa, y ahora
        # se ve.
        _nyx_id() {   # $1 = archivo → 8 hex, o "?" si no se puede
            [ -r "$1" ] || { printf '?'; return 0; }
            if command -v sha256sum >/dev/null 2>&1; then
                sha256sum "$1" 2>/dev/null | cut -c1-8 | tr -d '\n'
            elif command -v shasum >/dev/null 2>&1; then
                shasum -a 256 "$1" 2>/dev/null | cut -c1-8 | tr -d '\n'
            elif command -v cksum >/dev/null 2>&1; then
                cksum "$1" 2>/dev/null | awk '{printf "%08x", $1}'
            else
                printf '?'
            fi
        }
        _ver="$(tr -d '[:space:]' < "$NYX_HOME/VERSION" 2>/dev/null || true)"
        [ -n "$_ver" ] || _ver="unknown"
        echo "nyx $_ver (compiler $(_nyx_id "$NYX_BOOTSTRAP"), prelude $(_nyx_id "$NYX_HOME/std/prelude.nx"))"
        _home_abs="$(cd "$NYX_HOME" 2>/dev/null && pwd -P || echo "$NYX_HOME")"
        echo "  home:     $_home_abs"
        _bin_abs="$NYX_BOOTSTRAP"
        if [ -e "$NYX_BOOTSTRAP" ] && command -v readlink >/dev/null 2>&1; then
            _bin_abs="$(readlink -f "$NYX_BOOTSTRAP" 2>/dev/null || echo "$NYX_BOOTSTRAP")"
        fi
        echo "  compiler: $_bin_abs"
        exit 0
        ;;
    --help|-h|help)
        # P1 friction-portscan: `help` como comando (antes `nyx help run` caía al
        # camino de archivo suelto y buscaba un fichero llamado "help").
        echo "Usage: nyx <file.nx> [args...]"
        echo "       nyx <command> [options]"
        echo ""
        echo "Commands:"
        echo "  init [name]   Create a new project (nyx.toml + src/main.nx + AGENTS.md + docs/nyx/)"
        echo "                  --lang en|es                  language of the seeded docs (default: NYX_LANG, else en)"
        echo "                  --agent=claude,cursor,copilot  also seed the 3-line adapter for those tools"
        echo "                  --sdd                          also seed the SDD scaffolding (see below)"
        echo "  sdd init      Seed the SDD scaffolding in an EXISTING project (constitution,"
        echo "                glossary, evidence, ADR template, specs/, constitution test, guide)"
        echo "  sdd evidence  Regenerate docs/evidence/ for the installed toolchain"
        echo "  add <pkg>     Add a package dependency"
        echo "  build         Build the project"
        echo "                  --release                      optimized build"
        echo "                  --target wasm32-wasi           WebAssembly -> target/wasm32-wasi/<name>.wasm"
        echo "                  --target x86_64-pc-windows-msvc  Windows (cross)"
        echo "                  --main src/other.nx            another entry point -> <name>-other"
        echo "  run [args...] Build and run the project (args go to the program;"
        echo "                use -- to pass args that look like nyx flags)"
        echo "                  --target wasm32-wasi           build and run under wasmtime"
        echo "  info          Show project info"
        echo ""
        echo "Self-check (no linking, no execution — chainable with &&):"
        echo "  check [f.nx]  Parse + type-check only. Exit 1 on error. FASTEST feedback."
        echo "                  --lsp              raw LSP protocol (SYM:/DEF:/DIAG:/END) for editors"
        echo "  fmt   [f.nx]  Canonical formatting (to stdout)"
        echo "  vet   [f.nx]  Unused vars, dead code, unused imports"
        echo "  test [f.nx]   Run tests/*.nx  (tests use: test \"name\" { ... })"
        echo "                (no argument = discover from nyx.toml / tests/)"
        echo "                  --filter <string>  only run tests whose file name matches"
        echo "                  --verbose, -v      show test output even on pass"
        echo "                  --timeout <secs>   per-test timeout (default 30)"
        echo "                  --coverage         + src/ functions no test called (file:line name)"
        echo "                  --coverage=lcov    same, plus target/coverage.lcov"
        echo "                                     (needs llvm-profdata; native target only)"
        echo "                  (an unknown -option is an error)"
        echo ""
        echo "  update        Update Nyx to the latest version (+ what's new)"
        echo "  update --version <rev>   Instalar una revisión concreta (tag, sha o rama)"
        echo "  update --check       Only report whether a newer version exists (changes nothing)"
        echo "  update --sync-docs   Refresh AI context (AGENTS.md + docs/nyx/) in this project"
        echo "  report [f.md] Send a friction/bug report to the Nyx team"
        echo "  uninstall     Remove Nyx from this system"
        echo ""
        echo "Options:"
        echo "  --version     Show version"
        echo "  --help        Show this help"
        exit 0
        ;;
esac

# Handle uninstall and update
case "${1:-}" in
    uninstall)
        echo "Uninstalling Nyx..."
        rm -f "$HOME/.local/bin/nyx"
        rm -rf "$HOME/.nyx"
        echo "Nyx has been uninstalled."
        echo "  Removed: ~/.nyx/"
        echo "  Removed: ~/.local/bin/nyx"
        exit 0
        ;;
    update)
        # ── nyx update --sync-docs: refresca el contexto para agentes del
        # PROYECTO (AGENTS.md + docs/nyx/) desde el toolchain. Así el asistente
        # de un proyecto aislado aprende las features nuevas sin re-init.
        # Desde ADR-1 (2026-09-04) el proyecto es MONOLINGÜE: el juego de
        # plantillas sale de `templates/<lang>/`, con lang leído del sello del
        # propio AGENTS.md (`nyx-lang: xx`, default en). LLM.md sale siempre de
        # `templates/en/` (la referencia densa es monolingüe por decisión).
        # Los adaptadores por proveedor (CLAUDE.md, .cursorrules, copilot) NO
        # se pisan: son opt-in y suelen tener ediciones del usuario.
        # La MIGRACIÓN de layouts viejos (LLM.md en la raíz, CHEATSHEET.md,
        # .claude/skills sembradas) es otra tarea: acá no se mueve ni se borra
        # nada del proyecto.
        if [ "${2:-}" = "--sync-docs" ]; then
            if [ ! -f nyx.toml ]; then
                echo "error: no hay nyx.toml aca - corre esto dentro de un proyecto Nyx" >&2
                exit 1
            fi
            synced=""
            lang="en"
            if [ -f AGENTS.md ]; then
                _l="$(sed -n 's/.*nyx-lang: \([a-z][a-z]\).*/\1/p' AGENTS.md | head -1)"
                [ -n "$_l" ] && lang="$_l"
            fi
            [ -d "$NYX_HOME/templates/$lang" ] || lang="en"
            # Sello de versión + idioma al final de cada archivo resembrado (el
            # mismo que pone nyx_build init — ver seed_file en
            # compiler/build.nx); con él _warn_seed_drift deja de avisar y la
            # próxima deriva vuelve a verse.
            _stamp_seed() { printf '\n<!-- nyx-version: %s nyx-lang: %s -->\n' "$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')" "$lang" >> "$1"; }

            # ── Migración del layout viejo (spec §2 «Migración de proyectos
            # existentes», Task 6) — corre ANTES de sincronizar nada. Regla de
            # oro: solo se toca lo que llevaba NUESTRO sello
            # (`grep 'nyx-version:'`); cualquier archivo sin sello lo escribió
            # el usuario y se avisa, nunca se pisa. Siempre .bak antes de
            # mover/reemplazar/borrar. Idempotente: LLM.md/CHEATSHEET.md/
            # .claude/skills desaparecen de su lugar viejo en la primera
            # corrida (la segunda ya no los encuentra); los adaptadores se
            # comparan contra el contenido que produciríamos hoy, así que una
            # segunda corrida que ya coincide no los vuelve a tocar.
            _has_stamp() { grep -q 'nyx-version:' "$1" 2>/dev/null; }
            # _safe_backup ARCHIVO — respalda ARCHIVO en ARCHIVO.bak SIN pisar
            # un .bak preexistente (fix round 1, Task 6): un respaldo manual
            # del usuario, o el de una corrida interrumpida y restaurada a
            # mano, no se destruye en silencio. Si ARCHIVO.bak ya existe, usa
            # el primer ARCHIVO.bak.N libre y avisa; deja el path elegido en
            # $_LAST_BAK para que el caller lo cite en su mensaje. Nunca
            # aborta la migración por esto.
            _safe_backup() {
                local file="$1" bak="$1.bak"
                if [ -e "$bak" ]; then
                    local n=1
                    while [ -e "$bak.$n" ]; do n=$((n + 1)); done
                    bak="$bak.$n"
                    printf '⚠ %s.bak ya existía: respaldo en %s\n' "$file" "$bak" >&2
                fi
                cp -a "$file" "$bak"
                _LAST_BAK="$bak"
            }
            _MIG_TMP="$(mktemp -d)"
            # _migrate_adapter ARCHIVO PROVEEDOR — reemplaza ARCHIVO por el
            # adaptador fino de $NYX_HOME/templates/adapters/<proveedor>.<lang>.md
            # si ARCHIVO existe y lleva sello; deja la versión vieja en .bak.
            # Sin sello: aviso, no se toca. Ya migrado (contenido idéntico al
            # que generaríamos hoy): no hace nada — idempotencia real, sin
            # tocar el mtime.
            _migrate_adapter() {
                local file="$1" provider="$2"
                [ -f "$file" ] || return 0
                if ! _has_stamp "$file"; then
                    printf '⚠ %s no lo sembró nyx (sin sello): no se toca\n' "$file" >&2
                    return 0
                fi
                local tpl="$NYX_HOME/templates/adapters/$provider.$lang.md"
                [ -f "$tpl" ] || tpl="$NYX_HOME/templates/adapters/$provider.en.md"
                [ -f "$tpl" ] || return 0
                local want="$_MIG_TMP/$provider.want"
                cp "$tpl" "$want"
                _stamp_seed "$want"
                if cmp -s "$want" "$file"; then
                    return 0
                fi
                mkdir -p "$(dirname "$file")"
                _safe_backup "$file"
                cp "$want" "$file"
                echo "  → $file regenerado como adaptador fino (versión previa en $_LAST_BAK)"
            }
            _migrate_seeded_layout() {
                # LLM.md en la raíz CON sello → se retira; docs/nyx/LLM.md
                # queda a cargo del _sync_one de abajo (copia fresca desde el
                # template, con su propio .bak si hiciera falta).
                if [ -f LLM.md ]; then
                    if _has_stamp LLM.md; then
                        _safe_backup LLM.md
                        rm -f LLM.md
                        echo "  → LLM.md (raíz) migrado a docs/nyx/LLM.md (versión previa en $_LAST_BAK)"
                    else
                        printf '⚠ LLM.md no lo sembró nyx (sin sello): no se toca\n' >&2
                    fi
                fi
                # CHEATSHEET.md CON sello → se retira (contenido absorbido por
                # AGENTS.md + docs/nyx/ hace tiempo).
                if [ -f CHEATSHEET.md ]; then
                    if _has_stamp CHEATSHEET.md; then
                        _safe_backup CHEATSHEET.md
                        rm -f CHEATSHEET.md
                        echo "  → CHEATSHEET.md retirado (versión previa en $_LAST_BAK)"
                    else
                        printf '⚠ CHEATSHEET.md no lo sembró nyx (sin sello): no se toca\n' >&2
                    fi
                fi
                # Adaptadores por proveedor CON sello → adaptador fino (ADR-1).
                _migrate_adapter CLAUDE.md claude
                _migrate_adapter .cursorrules cursor
                _migrate_adapter .github/copilot-instructions.md copilot
                # .claude/skills/*/SKILL.md CON sello → todo el directorio a
                # .claude/skills.bak (las guías neutrales viven en
                # docs/nyx/guides/ desde ADR-1). Si CUALQUIER SKILL.md no
                # lleva sello, no se toca nada del directorio (podría tener
                # skills propias del usuario mezcladas con las nuestras).
                if [ -d .claude/skills ]; then
                    _skf_found=0
                    _skf_unstamped=0
                    for _skf in .claude/skills/*/SKILL.md; do
                        [ -f "$_skf" ] || continue
                        _skf_found=1
                        if _has_stamp "$_skf"; then
                            :
                        else
                            printf '⚠ %s no lo sembró nyx (sin sello): no se toca\n' "$_skf" >&2
                            _skf_unstamped=1
                        fi
                    done
                    if [ "$_skf_found" -eq 1 ] && [ "$_skf_unstamped" -eq 0 ]; then
                        mv .claude/skills .claude/skills.bak
                        echo "  → .claude/skills retirado (.claude/skills.bak) — las guías viven en docs/nyx/guides/"
                    fi
                fi
            }
            _migrate_seeded_layout
            rm -rf "$_MIG_TMP"

            # _sync_one PLANTILLA DESTINO — copia con .bak si el destino difería.
            # El respaldo va por _safe_backup (no por un `cp` crudo): estas son
            # las 5 rutas que --sync-docs toca SIEMPRE (AGENTS.md, docs/nyx/LLM.md
            # y las 3 guías), y un `.bak` propio del usuario no se destruye en
            # silencio — escala a .bak.N avisando, igual que la migración.
            _sync_one() {
                [ -f "$1" ] || return 0
                mkdir -p "$(dirname "$2")"
                if [ -f "$2" ] && ! cmp -s "$1" "$2"; then
                    _safe_backup "$2"
                fi
                cp "$1" "$2"
                _stamp_seed "$2"
                synced="$synced $2"
            }
            # Bloque PROPIO del proyecto en AGENTS.md: lo que esté entre
            # `<!-- proyecto:inicio -->` y `<!-- proyecto:fin -->` sobrevive al
            # resembrado. Pedido de nyxerp (2026-09-24): --sync-docs les borró
            # cuatro veces sus «Reglas de este proyecto» y las restauraban desde
            # git. Si la plantilla trae los mismos marcadores, el bloque vuelve a
            # ese lugar; si no, va al final, antes del sello. Se arma PRIMERO el
            # resultado y se compara: si no cambió, no se toca ni se deja .bak
            # (idempotente). Sin marcadores en el proyecto, igual que siempre.
            _sync_agents() {
                local tpl="$NYX_HOME/templates/$lang/AGENTS.md"
                [ -f "$tpl" ] || return 0
                local want blk
                want="$(mktemp)"; blk="$(mktemp)"
                # Los marcadores cuentan SOLO en una línea propia: la plantilla los
                # CITA dentro de una oración para explicarlos, y con un match suelto
                # esa prosa pasaba por «bloque del proyecto» — se agregaba al final y
                # la segunda corrida volvía a reescribir AGENTS.md (no idempotente).
                local ini='^[[:space:]]*<!-- proyecto:inicio -->[[:space:]]*$'
                local fin='^[[:space:]]*<!-- proyecto:fin -->[[:space:]]*$'
                if [ -f AGENTS.md ] && grep -qE "$ini" AGENTS.md && grep -qE "$fin" AGENTS.md; then
                    awk -v ini="$ini" -v fin="$fin" '$0 ~ ini {f=1} f{print} $0 ~ fin {f=0}' AGENTS.md > "$blk"
                fi
                if [ -s "$blk" ] && grep -qE "$ini" "$tpl"; then
                    awk -v blk="$blk" -v ini="$ini" -v fin="$fin" '
                        $0 ~ ini { while ((getline l < blk) > 0) print l; skip=1; next }
                        skip && $0 ~ fin { skip=0; next }
                        !skip { print }' "$tpl" > "$want"
                else
                    cp "$tpl" "$want"
                    if [ -s "$blk" ]; then printf '\n' >> "$want"; cat "$blk" >> "$want"; fi
                fi
                _stamp_seed "$want"
                if [ -f AGENTS.md ] && cmp -s "$want" AGENTS.md; then
                    rm -f "$want" "$blk"; return 0
                fi
                [ -f AGENTS.md ] && _safe_backup AGENTS.md
                cp "$want" AGENTS.md
                synced="$synced AGENTS.md"
                [ -s "$blk" ] && echo "  → AGENTS.md: se conservó el bloque propio del proyecto (<!-- proyecto:inicio --> … <!-- proyecto:fin -->)"
                rm -f "$want" "$blk"
            }
            _sync_agents
            _sync_one "$NYX_HOME/templates/en/docs/nyx/LLM.md" docs/nyx/LLM.md
            for _g in "$NYX_HOME/templates/$lang/docs/nyx/guides/"*.md; do
                [ -f "$_g" ] || continue
                _sync_one "$_g" "docs/nyx/guides/$(basename "$_g")"
            done
            # CAPABILITIES.md: se GENERA de la stdlib instalada (no es template).
            _NB="$NYX_HOME/nyx_build"; [ -x "$_NB" ] || _NB="$NYX_HOME/bin/nyx_build"
            if [ -x "$_NB" ]; then
                NYX_CAPS_STAMP="$(_caps_stamp)" NYX_HOME="$NYX_HOME" "$_NB" capabilities CAPABILITIES.md >/dev/null 2>&1 \
                    && synced="$synced CAPABILITIES.md(generado)"
            fi
            ver=$(cat "$NYX_HOME/VERSION" 2>/dev/null || echo "?")
            printf "  \033[1;32mContexto para agentes sincronizado a nyx v%s (idioma: %s):\033[0m%s\n" "$ver" "$lang" "$synced"
            echo "  (los archivos previos con cambios quedaron en *.bak)"
            exit 0
        fi

        # ── Opciones que NUNCA actualizan (fricción de nyxerp, 2026-09-24):
        # `nyx update --help` actualizaba DE VERDAD —cualquier argumento que no
        # fuera --sync-docs/--version caía a la actualización— y le cambió el
        # toolchain a una suite de otro equipo a mitad de corrida. Ahora solo
        # actualizan `nyx update` a secas y `--version <rev>`; todo lo demás
        # es ayuda, consulta o error, sin tocar la instalación.
        case "${2:-}" in
            ""|--version) ;;
            -h|--help|help)
                echo "Usage: nyx update [--version <rev> | --check | --sync-docs]"
                echo ""
                echo "  (no args)          Update Nyx to the latest version (+ what's new)"
                echo "  --version <rev>    Install a specific revision (tag, sha or branch)"
                echo "  --check            Only report whether a newer version exists (changes nothing)"
                echo "  --sync-docs        Refresh AI context (AGENTS.md + docs/nyx/) in this project"
                echo "  -h, --help         Show this help (changes nothing)"
                exit 0
                ;;
            --check)
                # Solo consulta: `git fetch` mueve refs remotas en el .git del
                # toolchain, nunca el árbol instalado ni los binarios.
                if [ ! -d "$NYX_HOME/.git" ]; then
                    echo "error: $NYX_HOME is not a git repo — can't check for updates" >&2
                    exit 1
                fi
                if ! git -C "$NYX_HOME" fetch --quiet origin 2>/dev/null; then
                    echo "error: git fetch failed (no network?) — nothing was changed" >&2
                    exit 1
                fi
                _cur_ver=$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')
                _new_ver=$(git -C "$NYX_HOME" show origin/main:VERSION 2>/dev/null | tr -d '[:space:]')
                _local=$(git -C "$NYX_HOME" rev-parse --short HEAD 2>/dev/null)
                _remote=$(git -C "$NYX_HOME" rev-parse --short origin/main 2>/dev/null)
                if [ "$_local" = "$_remote" ]; then
                    echo "nyx is up to date: v${_cur_ver:-?} ($_local)"
                else
                    _behind=$(git -C "$NYX_HOME" rev-list --count HEAD..origin/main 2>/dev/null || echo "?")
                    echo "update available: v${_cur_ver:-?} ($_local) -> v${_new_ver:-?} ($_remote), $_behind commit(s) behind"
                    echo "  run 'nyx update' to install it"
                fi
                exit 0
                ;;
            *)
                echo "error: unknown option for 'nyx update': ${2}" >&2
                echo "  nothing was changed — see 'nyx update --help'" >&2
                exit 2
                ;;
        esac

        # EXCLUSIVO antes de tocar nada: el update reescribe el compilador y la
        # stdlib en su lugar, y una suite ajena a mitad de corrida mezclaría
        # dos versiones (lo mismo que ya protegía install-local).
        _toolchain_lock x "actualizar"
        printf "\n  \033[1mUpdating Nyx\033[0m\n\n"
        # El proyecto desde el que se llamó: `cd "$NYX_HOME"` lo pierde, y al
        # final hay que volver para regenerar la evidencia del andamiaje SDD.
        _PROJECT_DIR="$PWD"
        cd "$NYX_HOME"
        if [ ! -d .git ]; then
            echo "error: $NYX_HOME is not a git repo. Reinstall with:" >&2
            echo "  curl -sSf https://nyxlang.com/install.sh | sh" >&2
            exit 1
        fi
        OLD_VERSION=$(cat VERSION 2>/dev/null || echo "")

        # --version <rev>: instalar una revisión CONCRETA en vez de la punta.
        #
        # POR QUÉ (fricción de nyxerp, 2026-09-17): `nyx update` solo sabía ir a
        # «latest», así que una máquina que se actualizaba no podía volver a la
        # revisión de otra, y la única convergencia posible era que todas
        # avanzaran a la vez. Peor con un cambio que rompe código: si la versión
        # nueva rechaza algo que antes compilaba, el equipo queda sin salida —
        # que es exactamente lo que pasó al publicar 0.32.0 (`pub`/NYX1036).
        #
        # Acepta cualquier cosa que git sepa resolver: un tag (`v0.32.0`), un sha
        # o una rama. Se resuelve ANTES de tocar nada, para que una ref inválida
        # no deje la instalación a medio actualizar.
        _NYX_REV="origin/main"
        _NYX_REV_LABEL="latest"
        if [ "${2:-}" = "--version" ]; then
            if [ -z "${3:-}" ]; then
                echo "error: --version necesita una revisión (tag, sha o rama)" >&2
                echo "  ej: nyx update --version v0.32.0" >&2
                exit 1
            fi
            _NYX_REV="$3"
            _NYX_REV_LABEL="$3"
        fi
        spin "Fetching..." bash -c "git fetch origin --tags" \
            || { echo "error: git fetch failed" >&2; exit 1; }
        if [ "$_NYX_REV" != "origin/main" ]; then
            # Verificar que la ref EXISTE antes de resetear: si no, se avisa y se
            # sale sin haber tocado la instalación.
            if ! git rev-parse --verify --quiet "$_NYX_REV^{commit}" >/dev/null; then
                echo "error: no existe la revisión '$_NYX_REV' en este repo" >&2
                echo "  las publicadas se listan con: git -C \"$NYX_HOME\" tag" >&2
                exit 1
            fi
        fi
        spin "Checking out $_NYX_REV_LABEL..." bash -c "git reset --hard '$_NYX_REV'" \
            || { echo "error: git update failed" >&2; exit 1; }
        spin "Rebuilding compiler..." make bootstrap \
            || { echo "error: make bootstrap failed" >&2; exit 1; }
        spin "Rebuilding package manager..." make build-nyx-build \
            || { echo "error: make build-nyx-build failed" >&2; exit 1; }
        # nyx_test tambien: sin esto un update REVERTIRIA el fix de install.sh
        # (dist-clean borra compiler/, asi que despues ya no se puede rebuildear)
        spin "Rebuilding test runner..." make build-test \
            || { echo "error: make build-test failed" >&2; exit 1; }
        # nyx_check idem (C4 2026-08-11): el wrapper lo rutea, AGENTS.md lo
        # promociona, y sin este build el comando moria en toda instalacion.
        spin "Rebuilding checker..." make build-check \
            || { echo "error: make build-check failed" >&2; exit 1; }
        spin "Rebuilding vet..." make build-vet \
            || { echo "error: make build-vet failed" >&2; exit 1; }
        spin "Rebuilding formatter..." make build-fmt \
            || { echo "error: make build-fmt failed" >&2; exit 1; }
        # refrescar binarios de bin/ y limpiar dev files (lista CANONICA
        # compartida con install.sh - antes habia dos listas desincronizadas)
        mkdir -p bin
        # Copiar AL LADO y renombrar encima, nunca cp directo: si un programa está
        # corriendo con bin/nyx, cp falla con 'Text file busy' y el binario viejo
        # queda instalado. Antes el error se tiraba (2>/dev/null || true) y el
        # update terminaba anunciando la versión nueva con el compilador anterior.
        for par in "nyx_bootstrap:bin/nyx" "nyx_build:bin/nyx_build"; do
            src="${par%%:*}"; dst="${par#*:}"
            { cp "$src" "$dst.nuevo.$$" && mv -f "$dst.nuevo.$$" "$dst"; } \
                || { rm -f "$dst.nuevo.$$"; echo "error: no se pudo instalar $dst" >&2; exit 1; }
        done
        bash scripts/dist-clean.sh "$NYX_HOME"
        NEW_VERSION=$(cat VERSION 2>/dev/null || echo "?")
        printf "\n  \033[1;32mNyx updated: %s -> %s\033[0m\n" "${OLD_VERSION:-?}" "$NEW_VERSION"
        # ── What's new: bloque del CHANGELOG entre la version vieja y la nueva ──
        if [ -f CHANGELOG.md ] && [ -n "$OLD_VERSION" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ]; then
            printf "\n  \033[1mWhat's new:\033[0m\n"
            awk -v old="[$OLD_VERSION]" '/^## \[/ { if (index($0, old)) exit } /^## /{shown++} shown{print "  " $0} shown && ++n>=60{print "  ..."; exit}' CHANGELOG.md
            echo ""
            echo "  Para actualizar el contexto IA de tus proyectos:"
            echo "    cd <proyecto> && nyx update --sync-docs"
        fi
        # ── What's new de gotchas: trampas que ya no hace falta esquivar
        # entre OLD_VERSION y NEW_VERSION (Task 2: `nyx_gendocs fixed-since`
        # imprime «id: título» de cada gotcha kind:fixed con fixed_in >
        # versión). Nunca fatal — si nyx_gendocs no está instalado (toolchain
        # vieja recién actualizada a esta misma versión, antes del próximo
        # install-local) simplemente no se muestra nada.
        if [ -n "${OLD_VERSION:-}" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ] && [ -x "$NYX_HOME/nyx_gendocs" ]; then
            printf "\n  \033[1mGotchas que ya no hace falta esquivar:\033[0m\n"
            "$NYX_HOME/nyx_gendocs" fixed-since "$OLD_VERSION" | sed 's/^/  /'
        fi
        # ── Andamiaje SDD: docs/evidence/ y el test de constitución son
        # GENERADOS desde la tabla de gotchas de la toolchain, así que después
        # de un update quedarían de la versión vieja (justo la clase de mentira
        # que este arco persigue). Solo si el proyecto desde el que se llamó
        # tiene andamiaje; nunca crea nada, nunca pisa lo que el usuario editó.
        if [ -f "$_PROJECT_DIR/nyx.toml" ] && [ -d "$_PROJECT_DIR/docs/evidence" ]; then
            _NBU="$NYX_HOME/nyx_build"; [ -x "$_NBU" ] || _NBU="$NYX_HOME/bin/nyx_build"
            if [ -x "$_NBU" ]; then
                printf "\n  \033[1mAndamiaje SDD de este proyecto:\033[0m\n"
                (cd "$_PROJECT_DIR" && NYX_HOME="$NYX_HOME" "$_NBU" sdd evidence 2>&1 | sed 's/^/  /')
            fi
        fi
        exit 0
        ;;
esac

# ── Auto-verificacion: check / vet / fmt ────────────────────────────────
# Herramientas que ya existian como binarios pero NUNCA estuvieron cableadas
# al CLI: eran targets de `make` para quien clona el repo del compilador. Un
# agente no tenia forma de verificar su propio trabajo sin compilar y ejecutar.
# Todas honran NYX_SRC (fix 2026-07-28), asi que reciben la ruta REAL del
# archivo — sin scratch compartido, sin carrera entre invocaciones.
case "${1:-}" in
    check|vet|fmt)
        _sub="$1"
        case "$_sub" in
            check) _bin_name="nyx_check"; _make="build-check" ;;
            vet)   _bin_name="nyx_vet";   _make="build-vet"   ;;
            fmt)   _bin_name="nyx_fmt";   _make="build-fmt"   ;;
        esac
        _bin="$NYX_HOME/$_bin_name"
        [ -x "$_bin" ] || _bin="$NYX_HOME/bin/$_bin_name"
        if [ ! -x "$_bin" ]; then
            echo "error: $_bin_name no esta instalado en $NYX_HOME" >&2
            echo "  Arréglalo con:  nyx update" >&2
            exit 1
        fi
        shift
        # `nyx check` es para personas y agentes: nyx_check habla además el
        # protocolo del LSP (SYM:/DEF:/DIAG:/END, compiler/nyx_check.nx), cientos
        # de líneas que tapaban el diagnóstico. El wrapper lo filtra; --lsp (o
        # NYX_CHECK_PROTOCOL=1) lo deja pasar crudo para un editor.
        _proto=0
        if [ "$_sub" = check ] && [ "${1:-}" = "--lsp" ]; then _proto=1; shift; fi
        [ "${NYX_CHECK_PROTOCOL:-}" = 1 ] && _proto=1
        _target="${1:-}"
        if [ -z "$_target" ]; then
            # Sin argumento: el punto de entrada del proyecto, o script.nx
            if [ -f nyx.toml ] && [ -f src/main.nx ]; then
                _target="src/main.nx"
            else
                _target="script.nx"
            fi
        fi
        if [ ! -f "$_target" ]; then
            echo "error: no existe el archivo '$_target'" >&2
            echo "  Uso: nyx $_sub [archivo.nx]   (sin argumento usa src/main.nx)" >&2
            exit 1
        fi
        # Detección de proyecto — MISMA que la rama `run` (B2, más abajo), que
        # esta rama nunca alcanzaba: el `exec` de acá corta antes. Sin
        # NYX_PROJECT_DIR, `nyx check` resolvía `import "src/x"` solo si el
        # usuario estaba parado justo en la raíz del proyecto, y ni así el
        # prelude (arco tooling-type-gates, 2026-09-08). Un NYX_PROJECT_DIR
        # explícito del usuario tiene prioridad.
        if [ -z "${NYX_PROJECT_DIR:-}" ]; then
            _pd="$PWD"
            while [ "$_pd" != "/" ]; do
                if [ -f "$_pd/nyx.toml" ]; then
                    export NYX_PROJECT_DIR="$_pd"
                    break
                fi
                _pd="$(dirname "$_pd")"
            done
        fi
        _toolchain_lock s "nyx $_sub"
        if [ "$_sub" = check ] && [ "$_proto" = 0 ]; then
            # set +e: con set -e el pipeline sale con el rc de grep (1 si no
            # quedó nada que mostrar) antes de leer el de nyx_check.
            set +e
            NYX_SRC="$_target" NYX_HOME="$NYX_HOME" "$_bin" 2>&1 | grep -vE '^(SYM|DEF|DIAG):|^END$'
            _rc=${PIPESTATUS[0]}
            exit "$_rc"
        fi
        NYX_SRC="$_target" NYX_HOME="$NYX_HOME" exec "$_bin"
        ;;
esac

# Route test subcommand to nyx_test
case "${1:-}" in
    test)
        NYX_TEST="$NYX_HOME/nyx_test"
        if [ ! -x "$NYX_TEST" ]; then
            # El mensaje viejo mandaba a `make build-test`, IMPOSIBLE de correr:
            # dist-clean.sh borra compiler/ y el Makefile del arbol instalado.
            # `nyx update` si lo reconstruye (rama update de este mismo script).
            echo "error: nyx_test no esta instalado en $NYX_HOME" >&2
            echo "  Arreglalo con:  nyx update" >&2
            echo "  (o reinstala:   curl -sSf https://nyxlang.com/install.sh | sh)" >&2
            exit 1
        fi
        export NYX_HOME
        shift
        exec "$NYX_TEST" "$@"
        ;;
esac

# Subcomandos que delegan en un binario COMPAÑERO (productos extraídos del
# monorepo: nyx-shell 2026-07-05, nyx-edit 2026-09-11). No viven acá, pero se
# invocan como `nyx shell` / `nyx edit` desde cualquier proyecto.
#
# Resolución, en orden: PATH primero (una build de desarrollo gana), y después
# el bin del toolchain — que es donde `make install` de cada producto lo deja,
# así el binario viaja con el toolchain y no depende de que el usuario tenga
# otro directorio en el PATH. Antes solo se miraba PATH, y `~/.nyx/bin` ni
# siquiera suele estar ahí (el `nyx` que el usuario invoca es un symlink desde
# ~/.local/bin), así que un producto instalado en el toolchain era invisible.
_resolve_companion() {
    local nombre="$1" hallado dir
    hallado="$(command -v "$nombre" 2>/dev/null || true)"
    if [ -n "$hallado" ]; then printf '%s\n' "$hallado"; return 0; fi
    for dir in "$NYX_HOME/bin" "$HOME/.nyx/bin"; do
        if [ -x "$dir/$nombre" ]; then printf '%s\n' "$dir/$nombre"; return 0; fi
    done
    return 1
}

case "${1:-}" in
    shell|edit)
        _sub="$1"
        _bin="nyx-$_sub"
        _repo="nyx-$_sub"
        if ! _ruta="$(_resolve_companion "$_bin")"; then
            echo "error: $_bin no está ni en el PATH ni en el bin del toolchain." >&2
            echo "  Instalar:" >&2
            echo "    git clone https://github.com/nyxlang-dev/$_repo && cd $_repo && make install" >&2
            echo "  (make install compila y deja el binario junto al toolchain," >&2
            echo "   así \`nyx $_sub\` anda desde cualquier proyecto)" >&2
            exit 1
        fi
        shift
        exec "$_ruta" "$@"
        ;;
esac

# Auto self-heal de CAPABILITIES.md: en un proyecto (nyx.toml), si el índice
# falta o su firma de stdlib (_caps_stamp) no es la del toolchain instalado,
# regenerarlo (barato, sin red: ~30 ms la firma, ~0.2 s regenerar).
# Así la LLM nunca lee un índice desactualizado y nadie corre comandos a mano.
_selfheal_capabilities() {
    [ -f nyx.toml ] || return 0
    local nb="$NYX_HOME/nyx_build"
    [ -x "$nb" ] || nb="$NYX_HOME/bin/nyx_build"
    [ -x "$nb" ] || return 0
    local stamp
    stamp="$(_caps_stamp)"
    if [ ! -f CAPABILITIES.md ] || ! grep -qF "<!-- nyx-stdlib: $stamp -->" CAPABILITIES.md 2>/dev/null; then
        NYX_CAPS_STAMP="$stamp" NYX_HOME="$NYX_HOME" "$nb" capabilities CAPABILITIES.md >/dev/null 2>&1 || true
    fi
}

# Aviso de deriva del contexto IA sembrado (F3 del informe de fricción, A2):
# AGENTS.md lleva el sello `<!-- nyx-version: X -->` desde que nyx init lo
# siembra (seed_file en compiler/build.nx). Si falta o es de otra versión, el
# agente está leyendo manuales de otro toolchain — se avisa en stderr, una
# vez por build, y NUNCA se toca el archivo (puede tener ediciones del
# usuario): refrescar es decisión suya con `nyx update --sync-docs` (deja .bak).
# CAPABILITIES.md sí se regenera solo porque es 100% generado; AGENTS.md no.
_warn_seed_drift() {
    [ -f nyx.toml ] && [ -f AGENTS.md ] || return 0
    local curver
    curver="$(cat "$NYX_HOME/VERSION" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$curver" ] || return 0
    if ! grep -q "nyx-version: $curver" AGENTS.md 2>/dev/null; then
        printf '\033[1;33m⚠ AGENTS.md fue sembrado por otra versión de nyx (o sin sello): el contexto IA puede estar desactualizado — `nyx update --sync-docs` lo refresca (deja .bak).\033[0m\n' >&2
    fi
}

# Route PM subcommands to nyx_build
case "${1:-}" in
    init|add|build|info|report|capabilities|sdd)
        NYX_BUILD="$NYX_HOME/nyx_build"
        [ ! -x "$NYX_BUILD" ] && NYX_BUILD="$NYX_HOME/bin/nyx_build"
        if [ ! -x "$NYX_BUILD" ]; then
            echo "error: nyx_build not found." >&2
            exit 1
        fi
        export NYX_HOME
        [ "$1" = "build" ] && { _selfheal_capabilities; _warn_seed_drift; }
        # `nyx capabilities` a mano también sella la firma: si no, el próximo
        # build lo regeneraría una vez de más.
        [ "$1" = "capabilities" ] && export NYX_CAPS_STAMP="$(_caps_stamp)"
        exec "$NYX_BUILD" "$@"
        ;;
    run)
        # nyx run file.nx → execute file directly
        if [ $# -ge 2 ] && echo "$2" | grep -q '\.nx$'; then
            shift  # remove "run", leave file.nx as $1
        else
            # nyx run → PM command (build + execute project)
            NYX_BUILD="$NYX_HOME/nyx_build"
            if [ ! -x "$NYX_BUILD" ]; then
                echo "error: nyx_build not found. Run: cd $NYX_HOME && make build-nyx-build" >&2
                exit 1
            fi
            export NYX_HOME
            _selfheal_capabilities
            _warn_seed_drift
            exec "$NYX_BUILD" "$@"
        fi
        ;;
esac

if [ $# -lt 1 ]; then
    echo "Usage: nyx <file.nx> [args...]" >&2
    exit 1
fi

INPUT_FILE="$1"
shift

if [ ! -f "$INPUT_FILE" ]; then
    echo "error: file not found: $INPUT_FILE" >&2
    exit 1
fi

# Runtime sources (relative to NYX_HOME)
RUNTIME_SRCS="$NYX_HOME/runtime/runtime.c $NYX_HOME/runtime/strings.c \
  $NYX_HOME/runtime/runtime-arrays.c $NYX_HOME/runtime/maps.c \
  $NYX_HOME/runtime/file-io.c $NYX_HOME/runtime/iterators.c \
  $NYX_HOME/runtime/net.c $NYX_HOME/runtime/thread.c \
  $NYX_HOME/runtime/regex.c $NYX_HOME/runtime/time.c \
  $NYX_HOME/runtime/crypto.c $NYX_HOME/runtime/tls.c \
  $NYX_HOME/runtime/scheduler.c $NYX_HOME/runtime/event_loop.c \
  $NYX_HOME/runtime/sqlite_adapter.c $NYX_HOME/runtime/compress.c \
  $NYX_HOME/runtime/random.c $NYX_HOME/runtime/url.c \
  $NYX_HOME/runtime/msgpack.c $NYX_HOME/runtime/websocket.c \
  $NYX_HOME/runtime/persist.c $NYX_HOME/runtime/http2.c \
  $NYX_HOME/runtime/process.c $NYX_HOME/runtime/llama_adapter.c \
  $NYX_HOME/runtime/os/os_posix.c"
LIBS="-lgc -lpthread -ldl -lm -lssl -lcrypto -lz"

# Use a temp directory to avoid polluting CWD
TMPDIR_NYX="$(mktemp -d /tmp/nyx_run_XXXXXX)"
trap 'rm -rf "$TMPDIR_NYX"' EXIT

cp "$INPUT_FILE" "$TMPDIR_NYX/script.nx"

# Detección de proyecto (B2): si `nyx run <archivo.nx>` se invoca dentro de un
# proyecto Nyx (nyx.toml encontrado subiendo desde el CWD), exportar
# NYX_PROJECT_DIR para que `import "src/..."` resuelva — igual que `nyx build`,
# que corre desde la raíz del proyecto. Antes fallaba con el mismo error mudo de
# B1 salvo que el usuario pusiera NYX_PROJECT_DIR=$PWD a mano. Un
# NYX_PROJECT_DIR explícito del usuario tiene prioridad (no se pisa).
if [ -z "${NYX_PROJECT_DIR:-}" ]; then
    _pd="$PWD"
    while [ "$_pd" != "/" ]; do
        if [ -f "$_pd/nyx.toml" ]; then
            export NYX_PROJECT_DIR="$_pd"
            break
        fi
        _pd="$(dirname "$_pd")"
    done
fi

# Change to NYX_HOME so the driver can find std/ and compiler/. NYX_SRC apunta
# al scratch propio de esta invocación (script.nx/script.ll compartidos en
# NYX_HOME causaban una carrera real entre compilaciones concurrentes).
# El output del compilador (diagnósticos de texto Y el NDJSON de NYX_DIAG=json)
# se captura a un log: silencioso en éxito, volcado a stderr en fallo — igual
# que `nyx build`. Tragarlo con `>/dev/null 2>&1` dejaba al usuario (y a las
# LLM) con una sola línea muda y cero JSON, rompiendo la promesa AI-first (B1).
#
# Pila del compilador (fricción nyxerp 20260920-200024, spec
# docs/design/specs/2026-09-23-pila-del-compilador-design.md): nyx_bootstrap va
# en -O0 y cada nivel de una expresión binaria apila ~151 KB de codegen, así que
# 53 operandos `+` agotaban los 8 MB por omisión. Se sube a 64 MB SOLO en el
# subshell del compilador —el programa del usuario corre con su pila de
# siempre— y nunca se baja una más grande. Si igual muere por señal, se dice la
# causa conocida en vez de dejar solo el «Segmentation fault» del shell.
BUILD_LOG="$TMPDIR_NYX/build.log"
_nyx_rc=0
# Candado compartido SOLO mientras se compila y enlaza: el programa del usuario
# puede ser un servidor que no termina nunca, y no debe trabar las instalaciones.
_toolchain_lock s "compilar $INPUT_FILE"
(cd "$NYX_HOME" && \
  { _c=$(ulimit -s 2>/dev/null) || _c=unlimited; \
    if [ "$_c" != unlimited ] && [ "$_c" -lt 65536 ] 2>/dev/null; then ulimit -s 65536 2>/dev/null || true; fi; } && \
  NYX_SRC="$TMPDIR_NYX/script.nx" "$NYX_BOOTSTRAP" && \
  clang "$TMPDIR_NYX/script.ll" $RUNTIME_SRCS $LIBS -o "$TMPDIR_NYX/prog") > "$BUILD_LOG" 2>&1 || _nyx_rc=$?
exec 9>&-
if [ "$_nyx_rc" -ne 0 ]; then
    cat "$BUILD_LOG" >&2
    echo "error: compilation failed for $INPUT_FILE" >&2
    if [ "$_nyx_rc" -ge 128 ]; then
        echo "nota: el compilador murio por una senal (rc=$_nyx_rc). La causa conocida es quedarse sin pila con una expresion muy larga o muy anidada (cientos de operandos en una sola expresion): conviene partirla en varias. Si no es eso, se puede reportar con 'nyx report'." >&2
    fi
    exit 1
fi

"$TMPDIR_NYX/prog" "$@"
