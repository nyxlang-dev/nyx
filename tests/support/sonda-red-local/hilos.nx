// Sonda: N+1 goroutines leyendo UDP con SO_RCVTIMEO=2s; una goroutine libre mide cuanto tarda en correr.
import "std/net"
import "std/error"
import "std/sync"

var FDS: Array = []
var DONE: AtomicCounter = counter_new(0)
var FREE_AT: AtomicCounter = counter_new(0)
var T0: Array = []

fn lector() -> int {
    // coge el siguiente fd
    let i: int = counter_inc(DONE) - 1
    let fd: int = FDS[i]
    match try_udp_recvfrom(fd, 100) {
        Result.Ok(d) => { return 0 }
        Result.Err(e) => { return 1 }
    }
    return 0
}

fn libre() -> int {
    counter_set(FREE_AT, time_ms() - T0[0])
    return 0
}

fn main() -> int {
    var i: int = 0
    while i < 6 {
        let fd: int = match try_udp_bind("127.0.0.1", 0) { Result.Ok(f) => { f } Result.Err(e) => { 0 - 1 } }
        try_tcp_set_timeout(fd, 2)
        FDS.push(fd)
        i = i + 1
    }
    T0.push(time_ms())
    var k: int = 0
    while k < 5 {
        thread_spawn(lector)
        k = k + 1
    }
    sleep(200)
    counter_set(FREE_AT, 0 - 1)
    spawn { return libre() }
    sleep(3000)
    print("libre corrio a los ms: " + int_to_string(counter_get(FREE_AT)))
    return 0
}
