// test-499 — std/dns (arco dns-registros): codec y parser contra paquetes
// fijados byte a byte, sin red.
//
// Lo que se puede romper sin que nada falle a la vista:
//   - la consulta (cabecera de 12 bytes, etiquetas con su largo): un byte de
//     más y el servidor real contesta FORMERR, que aquí no se ve;
//   - TXT de varias cadenas: SPF/DKIM largos vienen partidos en cadenas de 255
//     bytes y hay que UNIRLAS (RFC 7208 §3.3), un elemento por registro;
//   - el parser es de entrada hostil: puntero de compresión circular, longitud
//     mentirosa, paquete truncado en cada byte, cuenta de registros inflada.
//     Ninguno puede leer fuera del paquete ni colgarse.

import "std/dns"
import "std/error"

fn hv(c: int) -> int {
    if c >= 48 and c <= 57 { return c - 48 }
    return c - 87          // a-f
}

// "12 34 ab" -> los bytes crudos.
fn hx(s: String) -> String {
    let parts: Array = s.split(" ")
    var b: Array = []
    var i: int = 0
    while i < parts.length() {
        let t: String = parts[i]
        if t.length() == 2 { b.push(hv(t.charAt(0)) * 16 + hv(t.charAt(1))) }
        i = i + 1
    }
    return string_from_bytes(b, 0, b.length())
}

// Pregunta de "example.com" tipo T: 07 example 03 com 00, QTYPE, QCLASS=IN.
fn qsec(t: String) -> String {
    return "07 65 78 61 6d 70 6c 65 03 63 6f 6d 00 " + t + " 00 01"
}

// Cabecera de respuesta: ID 0x1234, flags dados, 1 pregunta, N respuestas.
fn hdr(flags: String, an: String) -> String {
    return "12 34 " + flags + " 00 01 " + an + " 00 00 00 00 "
}

fn parse(p: String) -> Result<Array, Error> {
    return __dns_parse_response(p, 4660, "example.com")
}

fn recs_of(p: String) -> Array {
    let r: Result<Array, Error> = parse(p)
    match r {
        Result.Ok(v) => {
            let recs: Array = v[1]
            return recs
        }
        Result.Err(e) => {
            print("inesperado: " + e.msg)
            assert(false)
            return []
        }
    }
}

fn err_of(p: String) -> Error {
    let r: Result<Array, Error> = parse(p)
    match r {
        Result.Ok(_v) => {
            print("se esperaba Err")
            assert(false)
            return err_new(0, "", "")
        }
        Result.Err(e) => { return e }
    }
}

fn main() {
    // ---- consulta: bytes exactos
    let q: Result<String, Error> = __dns_build_query("example.com", 16, 4660)
    match q {
        Result.Ok(s) => {
            assert(s == hx("12 34 01 00 00 01 00 00 00 00 00 00 " + qsec("00 10")))
            assert(s.length() == 29)
        }
        Result.Err(_e) => { assert(false) }
    }
    // punto final y mayúsculas: mismo paquete (el nombre va tal cual)
    let q2: Result<String, Error> = __dns_build_query("example.com.", 16, 4660)
    match q2 {
        Result.Ok(s) => { assert(s.length() == 29) }
        Result.Err(_e) => { assert(false) }
    }
    // nombres inválidos
    let b1: Result<String, Error> = __dns_build_query("a..b", 16, 1)
    match b1 {
        Result.Ok(_s) => { assert(false) }
        Result.Err(e) => { assert(e.kind == "invalid") }
    }
    var long63: String = ""
    var k: int = 0
    while k < 64 { long63 = long63 + "a"; k = k + 1 }
    let b2: Result<String, Error> = __dns_build_query(long63 + ".com", 16, 1)
    match b2 {
        Result.Ok(_s) => { assert(false) }
        Result.Err(e) => { assert(e.kind == "invalid") }
    }
    let b3: Result<String, Error> = __dns_build_query("a.com", 16, 70000)
    match b3 {
        Result.Ok(_s) => { assert(false) }
        Result.Err(e) => { assert(e.kind == "invalid") }
    }
    print("consulta ok")

    // ---- TXT de una cadena: "v=spf1 -all"
    let txt1: String = hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 01 2c 00 0c 0b 76 3d 73 70 66 31 20 2d 61 6c 6c")
    let r1: Array = recs_of(txt1)
    assert(r1.length() == 1)
    let rec1: Array = r1[0]
    assert(rec1[0] == 16)
    assert(rec1[1] == 300)
    assert(rec1[2] == "v=spf1 -all")

    // ---- TXT de varias cadenas en un registro + segundo registro
    let txt2: String = hx(hdr("81 80", "00 02") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 00 3c 00 06 02 61 62 02 63 64"
        + " c0 0c 00 10 00 01 00 00 00 3c 00 03 02 78 79")
    let r2: Array = recs_of(txt2)
    assert(r2.length() == 2)
    let a: Array = r2[0]
    let b: Array = r2[1]
    assert(a[2] == "abcd")
    assert(b[2] == "xy")

    // ---- TXT con una cadena vacía y un byte alto (bytes >= 128 intactos)
    let txt3: String = hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 00 3c 00 04 00 02 c8 00")
    let r3: Array = recs_of(txt3)
    let c3: Array = r3[0]
    let s3: String = c3[2]
    assert(s3.length() == 2)
    assert(s3.charAt(0) == 200)
    assert(s3.charAt(1) == 0)
    print("txt ok")

    // ---- CNAME con compresión: www.example.com (puntero al nombre de la pregunta)
    let cn: String = hx(hdr("81 80", "00 01") + qsec("00 05")
        + " c0 0c 00 05 00 01 00 00 00 3c 00 06 03 77 77 77 c0 0c")
    let rc: Array = recs_of(cn)
    let cr: Array = rc[0]
    assert(cr[0] == 5)
    assert(cr[2] == "www.example.com")

    // ---- MX: preferencia 10, mail.example.com
    let mx: String = hx(hdr("81 80", "00 01") + qsec("00 0f")
        + " c0 0c 00 0f 00 01 00 00 00 3c 00 09 00 0a 04 6d 61 69 6c c0 0c")
    let rm: Array = recs_of(mx)
    let mr: Array = rm[0]
    assert(mr[0] == 15)
    let mv: Array = mr[2]
    assert(mv[0] == 10)
    assert(mv[1] == "mail.example.com")
    print("cname mx ok")

    // ---- respuestas sin registros y códigos de error
    let nx: Error = err_of(hx(hdr("81 83", "00 00") + qsec("00 10")))
    assert(nx.kind == "not_found" and nx.code == 3)
    assert(dns_is_nxdomain(nx))
    assert(not dns_is_nodata(nx))
    let nd: Error = err_of(hx(hdr("81 80", "00 00") + qsec("00 10")))
    assert(nd.kind == "not_found" and nd.code == 61)
    assert(dns_is_nodata(nd))
    let sf: Error = err_of(hx(hdr("81 82", "00 00") + qsec("00 10")))
    assert(sf.kind == "io" and sf.code == 2)
    let rf: Error = err_of(hx(hdr("81 85", "00 00") + qsec("00 10")))
    assert(rf.kind == "io" and rf.code == 5)
    // TC: Ok con tc = 1 y sin registros (el transporte reintenta por TCP)
    let tcr: Result<Array, Error> = parse(hx(hdr("83 80", "00 00") + qsec("00 10")))
    match tcr {
        Result.Ok(v) => {
            assert(v[0] == 1)
            let none: Array = v[1]
            assert(none.length() == 0)
        }
        Result.Err(_e) => { assert(false) }
    }
    print("errores ok")

    // ---- ID y pregunta repetida
    let wid: Result<Array, Error> = __dns_parse_response(txt1, 4661, "example.com")
    match wid {
        Result.Ok(_v) => { assert(false) }
        Result.Err(e) => { assert(e.kind == "parse" and e.code == 1) }
    }
    let wq: Result<Array, Error> = __dns_parse_response(txt1, 4660, "otro.com")
    match wq {
        Result.Ok(_v) => { assert(false) }
        Result.Err(e) => { assert(e.kind == "parse" and e.code == 1) }
    }
    // la pregunta se compara sin distinguir mayúsculas y con punto final
    let okq: Result<Array, Error> = __dns_parse_response(txt1, 4660, "EXAMPLE.com.")
    match okq {
        Result.Ok(_v) => {}
        Result.Err(_e) => { assert(false) }
    }
    // no es una respuesta (QR = 0)
    let qr0: Error = err_of(hx(hdr("01 00", "00 01") + qsec("00 10")))
    assert(qr0.kind == "parse")

    // ---- entrada hostil
    // puntero circular: la respuesta apunta a su propio byte (offset 29)
    let circ: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 1d 00 10 00 01 00 00 00 3c 00 03 02 78 79"))
    assert(circ.kind == "parse")
    // RDLENGTH mayor que el paquete
    let lie: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 00 3c 00 ff 02 78 79"))
    assert(lie.kind == "parse")
    // cadena TXT que se sale de su RDATA
    let over: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 00 3c 00 02 05 61"))
    assert(over.kind == "parse")
    // puntero fuera del paquete
    let far: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10")
        + " c0 ff 00 10 00 01 00 00 00 3c 00 03 02 78 79"))
    assert(far.kind == "parse")
    // tipo de etiqueta reservado (0x40)
    let resv: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10")
        + " 40 0c 00 10 00 01 00 00 00 3c 00 03 02 78 79"))
    assert(resv.kind == "parse")
    // cuenta de registros inflada (65535) con un solo registro real
    let inf: Error = err_of(hx(hdr("81 80", "ff ff") + qsec("00 10")
        + " c0 0c 00 10 00 01 00 00 00 3c 00 03 02 78 79"))
    assert(inf.kind == "parse")
    // MX demasiado corto y CNAME cuyo nombre se sale del RDATA
    let mxs: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 0f")
        + " c0 0c 00 0f 00 01 00 00 00 3c 00 02 00 0a"))
    assert(mxs.kind == "parse")
    let cns: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 05")
        + " c0 0c 00 05 00 01 00 00 00 3c 00 02 03 77 77 77"))
    assert(cns.kind == "parse")
    // nombre de 300 bytes por compresión encadenada: tope de 255
    var one: String = " 3e"                    // etiqueta de 62 bytes
    var m: int = 0
    while m < 62 { one = one + " 61"; m = m + 1 }
    var lbl: String = ""
    var j: int = 0
    while j < 5 { lbl = lbl + one; j = j + 1 }   // 5 x 63 = 315 bytes > 255
    let bigname: Error = err_of(hx(hdr("81 80", "00 01") + qsec("00 10") + lbl
        + " 00 00 10 00 01 00 00 00 3c 00 03 02 78 79"))
    assert(bigname.kind == "parse")

    // ---- truncado en cada byte: ningún prefijo del paquete válido puede dar Ok
    // ni leer fuera de límites (txt2 trae dos registros y el segundo corta al final)
    var cut: int = 0
    while cut < txt2.length() {
        let r: Result<Array, Error> = __dns_parse_response(txt2.substring(0, cut), 4660, "example.com")
        match r {
            Result.Ok(v) => {
                // un prefijo solo puede dar Ok si es una respuesta TC; aquí no hay
                assert(false)
            }
            Result.Err(_e) => {}
        }
        cut = cut + 1
    }
    // y el mismo recorrido sobre MX/CNAME (rama de nombres comprimidos en RDATA)
    cut = 0
    while cut < mx.length() {
        let r: Result<Array, Error> = __dns_parse_response(mx.substring(0, cut), 4660, "example.com")
        match r {
            Result.Ok(_v) => { assert(false) }
            Result.Err(_e) => {}
        }
        cut = cut + 1
    }
    print("hostil ok")

    // ---- resolv.conf: hasta 3 IPv4, IPv6 y basura se saltan
    let rc1: Array = __dns_parse_resolv("# comentario\nnameserver 10.0.0.1\nnameserver ::1\nsearch x.y\nnameserver\t10.0.0.2 \nnameserver 10.0.0.3\nnameserver 10.0.0.4\nnameserver 999.1.1.1\nnameserver 1.2.3\n")
    assert(rc1.length() == 3)
    assert(rc1[0] == "10.0.0.1")
    assert(rc1[1] == "10.0.0.2")
    assert(rc1[2] == "10.0.0.3")
    assert(__dns_parse_resolv("").length() == 0)
    assert(__dns_parse_resolv("options edns0\nnameserver fe80::1%eth0\n").length() == 0)
    print("resolv ok")
}
