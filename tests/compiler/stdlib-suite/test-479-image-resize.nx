// test-479 — std/image, Task 4: redimensionado, recorte y composición de alfa (spec std-image, D-5/D-7).
//
// Cada caso decodifica una fixture (JPEG o PNG), le aplica UNA operación y compara los
// bytes con la referencia que PILLOW produjo del mismo archivo (tests/fixtures/image/
// gen_resize_fixtures.py): Image.resize con LANCZOS al achicar y BILINEAR al agrandar,
// ImageOps.fit para image_resize_cover, Image.crop y Image.paste con máscara para
// image_flatten; los RGBA se remuestrean premultiplicados como hace Pillow. Pasa si la
// salida es IDÉNTICA (sumsq 0): el filtro reproduce el de Pillow con sus pesos de 22 bits.
// Operaciones: 1 image_resize(a, b), 2 image_resize_fit(a, b), 3 image_resize_cover(a, b),
// 4 image_crop(a, b, c, d), 5 image_flatten(a, b, c).

import "std/image"
import "std/error"

fn dec(bytes: String) -> Image {
    let r: Result<Image, Error> = image_decode(bytes, image_limits())
    match r {
        Result.Ok(img) => { return img }
        Result.Err(e) => {
            println("¡no decodificó!: " + e.msg)
            return Image { width: 0, height: 0, channels: 1, rows: [], icc: "", reduction: 1 }
        }
    }
}

fn unwrap(r: Result<Image, Error>) -> Image {
    match r {
        Result.Ok(img) => { return img }
        Result.Err(e) => {
            println("ERR " + e.kind + ": " + e.msg)
            return Image { width: 0, height: 0, channels: 1, rows: [], icc: "", reduction: 1 }
        }
    }
}

fn case(name: String, src: String, op: int, a: int, b: int, c: int, d: int, ref: String, w: int, h: int, ch: int) {
    let img: Image = dec(src)
    var out: Image = img
    if op == 1 { out = unwrap(image_resize(img, a, b)) }
    if op == 2 { out = unwrap(image_resize_fit(img, a, b)) }
    if op == 3 { out = unwrap(image_resize_cover(img, a, b)) }
    if op == 4 { out = unwrap(image_crop(img, a, b, c, d)) }
    if op == 5 { out = image_flatten(img, a, b, c) }
    if out.width != w or out.height != h or out.channels != ch or out.rows.length() != h {
        println(name + " FORMA " + int_to_string(out.width) + "x" + int_to_string(out.height) + "x" + int_to_string(out.channels) + " esperado " + int_to_string(w) + "x" + int_to_string(h) + "x" + int_to_string(ch))
        return
    }
    if ref.length() != w * h * ch {
        println(name + " REF de largo " + int_to_string(ref.length()))
        return
    }
    var sumsq: int = 0
    var mx: int = 0
    var y: int = 0
    while y < h {
        let row: String = out.rows[y]
        var i: int = 0
        while i < w * ch {
            var dd: int = row.charAt(i) - ref.charAt(y * w * ch + i)
            if dd < 0 { dd = 0 - dd }
            if dd > mx { mx = dd }
            sumsq = sumsq + dd * dd
            i = i + 1
        }
        y = y + 1
    }
    var verdict: String = "FALLA"
    if sumsq == 0 { verdict = "ok" }
    println(name + " " + int_to_string(w) + "x" + int_to_string(h) + " ch=" + int_to_string(ch) + " sumsq=" + int_to_string(sumsq) + " max=" + int_to_string(mx) + " " + verdict)
}

fn main() -> int {
    case("resize-pil420-40x30", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 1, 40, 30, 0, 0, include_bytes("tests/fixtures/image/resize/resize-pil420-40x30.ref"), 40, 30, 3)
    case("resize-pil420-20x15", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 1, 20, 15, 0, 0, include_bytes("tests/fixtures/image/resize/resize-pil420-20x15.ref"), 20, 15, 3)
