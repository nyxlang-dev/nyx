// test-527 — temp_dir de std/fs (W6 Task 2, D7): el directorio temporal sin
// escribir "/tmp" a mano, que en Windows no existe. Sin separador al final, y
// un archivo escrito ahí se lee de vuelta. Las reglas finas ($TMPDIR vacío o
// con "/" de más) las cubre tests/runtime-unit/test_os_build_host.c.

import "std/error"
import "std/fs"

// remove_file borra también un directorio vacío, como remove(3): en Windows el
// remove() de la UCRT no lo hacía y nyx build dejaba temporales (W6 Task 4).
fn prueba_remove_dir(base: String) {
    let d: String = base + "/nyx_t527_" + int_to_string(getpid())
    if mkdir(d) != 0 { println("mkdir falló"); return 0 }
    if remove_file(d) == 0 and not file_exists(d) { println("remove_file borra un directorio vacío") } else { println("remove_file no borró el directorio") }
    return 0
}

fn main() -> int {
    let d: String = temp_dir()
    if d == "" { println("temp_dir: vacío") } else { println("temp_dir: no vacío") }
    if d.endsWith("/") or d.endsWith("\\") { println("termina en separador: " + d) } else { println("sin separador al final") }
    let f: String = d + "/nyx-test-527-" + int_to_string(getpid()) + ".txt"
    match try_write_file(f, "hola 527") {
        Result.Ok(_n) => {
            match try_read_file(f) {
                Result.Ok(s) => { println("leído: " + s) }
                Result.Err(e) => { println("leer: " + e.msg) }
            }
            remove_file(f)
        }
        Result.Err(e) => { println("escribir: " + e.msg) }
    }
    if file_exists(f) { println("quedó el archivo") } else { println("borrado") }
    prueba_remove_dir(d)
    return 0
}
