// test-497 — std/image, arco image-rapido: huellas CRC32 de la salida de
// image_resize / image_resize_fit / image_encode_jpeg / image_decode.
//
// El arco reescribe los bucles internos del redimensionado, del decodificador y del
// codificador para que una hoja escaneada de 1275 x 1650 baje de segundos a décimas. La
// condición es que NINGÚN byte de salida cambie (es la igualdad con Pillow que fijan
// test-479/480/482). Este test se escribió ANTES de tocar el código y su expected/ es la
// salida del código anterior: si una optimización cambia un solo byte, el CRC lo delata.
//
// Cubre 1, 3 y 4 canales, achicar/agrandar por eje, anchos que no son múltiplo de 8
// muestras (cola de los bucles por palabras), soportes anchos (escala 3: ksize 19) y la
// forma de una hoja (ancho 1275, alto reducido para que el test sea rápido).

import "std/image"
import "std/zip"

// Imagen sintética determinista: degradados + un patrón de bits que mezcla todo, con
// zonas planas (como una hoja blanca) y bordes duros (como el texto).
fn synth(w: int, h: int, ch: int) -> Image {
    var rows: Array = []
    var y: int = 0
    while y < h {
        var parts: Array = []
        var x: int = 0
        while x < w {
            var r: int = (x * 7 + y * 3) % 256
            var g: int = (x ^ y) % 256
            var b: int = (x * y + 11 * x) % 256
            if x > w / 4 and x < w / 2 and y > h / 4 and y < h / 2 {
                r = 250
                g = 250
                b = 250
            }
            if (x / 5 + y / 7) % 9 == 0 {
                r = 0
                g = 0
                b = 0
            }
            if ch == 1 {
                parts.push(chr((r + g + b) / 3))
            } else {
                parts.push(chr(r))
                parts.push(chr(g))
                parts.push(chr(b))
                if ch == 4 {
                    parts.push(chr((x * 5 + y) % 256))
                }
            }
            x = x + 1
        }
        rows.push(parts.join(""))
        y = y + 1
    }
    return Image { width: w, height: h, channels: ch, rows: rows, icc: "", reduction: 1 }
}

fn crc_img(tab: Array, img: Image) -> String {
    var all: String = ""
    var c: int = 0xFFFFFFFF
    for r: String in img.rows {
        let n: int = r.length()
        var i: int = 0
        while i < n {
            let t: int = tab[(c ^ r.charAt(i)) & 0xFF]
            c = t ^ (c >> 8)
            i = i + 1
        }
    }
    return int_to_string(img.width) + "x" + int_to_string(img.height) + "x" + int_to_string(img.channels) + " crc=" + int_to_string(c ^ 0xFFFFFFFF)
}

fn crc_str(tab: Array, s: String) -> String {
    return "len=" + int_to_string(s.length()) + " crc=" + int_to_string(zip_crc32_part(tab, s, 0, s.length()))
}

fn rz(tab: Array, name: String, img: Image, w: int, h: int) {
    match image_resize(img, w, h) {
        Result.Ok(o) => { println(name + " -> " + crc_img(tab, o)) }
        Result.Err(e) => { println(name + " ERR " + e.msg) }
    }
}

fn fit(tab: Array, name: String, img: Image, w: int, h: int) {
    match image_resize_fit(img, w, h) {
        Result.Ok(o) => { println(name + " -> " + crc_img(tab, o)) }
        Result.Err(e) => { println(name + " ERR " + e.msg) }
    }
}

fn dec(tab: Array, name: String, jpeg: String) {
    match image_decode(jpeg, image_limits()) {
        Result.Ok(o) => { println(name + " decode -> " + crc_img(tab, o)) }
        Result.Err(e) => { println(name + " decode ERR " + e.msg) }
    }
    match image_decode_scaled(jpeg, image_limits(), 2) {
        Result.Ok(o) => { println(name + " decode/2 -> " + crc_img(tab, o)) }
        Result.Err(e) => { println(name + " decode/2 ERR " + e.msg) }
    }
}

fn enc(tab: Array, name: String, img: Image, q: int) -> String {
    match image_encode_jpeg(img, q) {
        Result.Ok(b) => {
            println(name + " q" + int_to_string(q) + " encode -> " + crc_str(tab, b))
            return b
        }
        Result.Err(e) => {
            println(name + " encode ERR " + e.msg)
            return ""
        }
    }
}

fn main() -> int {
    let tab: Array = zip_crc32_table()
    let g1: Image = synth(97, 71, 1)
    let g3: Image = synth(97, 71, 3)
    let g4: Image = synth(97, 71, 4)

    // achicar los dos ejes, una pasada con soporte 7
    rz(tab, "gris 97x71 -> 50x40", g1, 50, 40)
    rz(tab, "rgb 97x71 -> 50x40", g3, 50, 40)
    rz(tab, "rgba 97x71 -> 50x40", g4, 50, 40)
    // un solo eje
    rz(tab, "rgb 97x71 -> 97x30", g3, 97, 30)
    rz(tab, "rgb 97x71 -> 40x71", g3, 40, 71)
    // agrandar (triangular)
    rz(tab, "gris 97x71 -> 130x90", g1, 130, 90)
    rz(tab, "rgb 97x71 -> 200x150", g3, 200, 150)
    rz(tab, "rgba 97x71 -> 111x83", g4, 111, 83)
    // casi sin achicar, como la hoja: 97x71 -> 95x69
    rz(tab, "rgb 97x71 -> 95x69", g3, 95, 69)
    rz(tab, "rgba 97x71 -> 95x69", g4, 95, 69)
    rz(tab, "gris 97x71 -> 95x69", g1, 95, 69)
    fit(tab, "rgb fit 60x60", g3, 60, 60)
    fit(tab, "rgba fit 60x60", g4, 60, 60)
    fit(tab, "gris fit 300x20", g1, 300, 20)

    // soporte ancho (escala 3: ksize 19), anchos que no son múltiplo de 8 muestras
    let b3: Image = synth(300, 200, 3)
    let b1: Image = synth(301, 203, 1)
    let b4: Image = synth(299, 201, 4)
    rz(tab, "rgb 300x200 -> 100x70", b3, 100, 70)
    rz(tab, "gris 301x203 -> 101x69", b1, 101, 69)
    rz(tab, "rgba 299x201 -> 99x67", b4, 99, 67)
    rz(tab, "rgb 300x200 -> 150x100", b3, 150, 100)

    // la forma de una hoja: 1275 de ancho, pocas filas
    let sheet: Image = synth(1275, 40, 3)
    rz(tab, "hoja 1275x40 -> 1238x39", sheet, 1238, 39)
    rz(tab, "hoja 1275x40 -> 1238x40", sheet, 1238, 40)
    fit(tab, "hoja fit 1238x1238", sheet, 1238, 1238)
    let sheet1: Image = synth(1275, 40, 1)
    rz(tab, "hoja gris 1275x40 -> 1238x39", sheet1, 1238, 39)
    let sheet4: Image = synth(1275, 40, 4)
    rz(tab, "hoja rgba 1275x40 -> 1238x39", sheet4, 1238, 39)

    // codificador y decodificador (4:2:0 hasta q90, 4:4:4 por encima; gris con 1 componente)
    let j3: String = enc(tab, "rgb 300x200", b3, 85)
    let j3hi: String = enc(tab, "rgb 300x200", b3, 95)
    let j1: String = enc(tab, "gris 301x203", b1, 80)
    let jd: String = enc(tab, "rgba 299x201", b4, 75)
    let jsheet: String = enc(tab, "hoja rgb 1275x40", sheet, 85)
    dec(tab, "rgb 300x200", j3)
    dec(tab, "rgb q95", j3hi)
    dec(tab, "gris", j1)
    dec(tab, "rgba", jd)
    dec(tab, "hoja", jsheet)
    println("fin")
    return 0
}
