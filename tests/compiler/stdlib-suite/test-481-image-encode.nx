// test-481 — std/image, Task 5: codificador JPEG (spec std-image, D-7).
//
// 1. Dorados: image_encode_jpeg produce EXACTAMENTE los bytes de tests/fixtures/image/encode/
//    (FDCT entera + Huffman estándar: salida determinista, la misma en nativo y en wasm).
//    Un cambio de bytes es un cambio de codificador y hay que mirarlo antes de regenerar.
// 2. Los dorados son JPEG válidos para un decodificador INDEPENDIENTE: Pillow los decodificó
//    y escribió las .ref; image_decode tiene que dar esos mismos bytes (sumsq 0). Y el PSNR
//    contra la entrada es el de Pillow codificando a la misma calidad (lo comprueba el
//    generador, gen_encode_fixtures.py; acá se exige el techo de error medido).
//    Cubre las dos mitades de la regla de submuestreo (q90 = 4:2:0, q91 = 4:4:4), q1 y q100,
//    gris (1 componente) y alfa compuesto sobre blanco.
// 3. Validaciones, imágenes mínimas (1x1, una fila, una columna), sin EXIF y con JFIF, el
//    perfil ICC (uno y partido en dos APP2) y su quita, y el alfa transparente.

import "std/image"
import "std/error"

// El golden se compara exacto, la .ref con lo que image_decode saca del golden, y el error
// de la entrada (codificar -> decodificar) contra el techo `maxsq`.
fn case(name: String, src: String, q: int, golden: String, ref: String, w: int, h: int, ch: int, maxsq: int) {
    let r: Result<Image, Error> = image_decode(src, image_limits())
    match r {
        Result.Err(e) => { println(name + " ENTRADA " + e.msg) }
        Result.Ok(img0) => {
            let img: Image = image_flatten(img0, 255, 255, 255)
            let e: Result<String, Error> = image_encode_jpeg(img0, q)
            match e {
                Result.Err(er) => { println(name + " ERR " + er.msg) }
                Result.Ok(out) => {
                    var same: String = "igual"
                    if out != golden { same = "DISTINTO(" + int_to_string(out.length()) + " vs " + int_to_string(golden.length()) + ")" }
                    let d: Result<Image, Error> = image_decode(out, image_limits())
                    match d {
                        Result.Err(er) => { println(name + " VUELTA " + er.msg) }
                        Result.Ok(back) => {
                            var pil: int = 0
                            var inp: int = 0
                            var y: int = 0
                            while y < h and back.height == h and back.width == w {
                                let row: String = back.rows[y]
                                let srow: String = img.rows[y]
                                var i: int = 0
                                while i < w * ch {
                                    var dd: int = row.charAt(i) - ref.charAt(y * w * ch + i)
                                    pil = pil + dd * dd
                                    var de: int = row.charAt(i) - srow.charAt(i)
                                    inp = inp + de * de
                                    i = i + 1
                                }
                                y = y + 1
                            }
                            var verdict: String = "ok"
                            if same != "igual" or pil != 0 or inp > maxsq or back.width != w or back.height != h or back.channels != ch { verdict = "FALLA" }
                            println(name + " " + int_to_string(out.length()) + " bytes " + same + " vs-pillow=" + int_to_string(pil) + " " + int_to_string(back.width) + "x" + int_to_string(back.height) + "x" + int_to_string(back.channels) + " " + verdict)
                        }
                    }
                }
            }
        }
    }
}

// Imagen sintética suave (gradientes), w x h con ch canales; alfa constante `a` si ch == 4.
fn synth(w: int, h: int, ch: int, a: int) -> Image {
    var rows: Array = []
    var y: int = 0
    while y < h {
        var px: Array = []
        var x: int = 0
        while x < w {
            px.push((x * 255) / (w + 1))
            if ch >= 3 {
                px.push((y * 255) / (h + 1))
                px.push(((x + y) * 255) / (w + h + 1))
            }
            if ch == 4 { px.push(a) }
            x = x + 1
        }
        rows.push(string_from_bytes(px, 0, w * ch))
        y = y + 1
    }
    return Image { width: w, height: h, channels: ch, rows: rows, icc: "", reduction: 1 }
}

fn enc(img: Image, q: int) -> String {
    let r: Result<String, Error> = image_encode_jpeg(img, q)
    match r {
        Result.Ok(s) => { return s }
        Result.Err(e) => {
            println("ERR " + e.kind + ": " + e.msg)
            return ""
        }
    }
}

fn dec(bytes: String) -> Image {
    let r: Result<Image, Error> = image_decode(bytes, image_limits())
    match r {
        Result.Ok(img) => { return img }
        Result.Err(e) => {
            println("¡no decodificó!: " + e.msg)
            return Image { width: 0, height: 0, channels: 1, rows: [], icc: "", reduction: 1 }
        }
    }
}

fn bad(name: String, img: Image, q: int) {
    let r: Result<String, Error> = image_encode_jpeg(img, q)
    match r {
        Result.Ok(s) => { println(name + " codificó " + int_to_string(s.length()) + " bytes") }
        Result.Err(e) => { println(name + " -> " + e.kind + ": " + e.msg) }
    }
}

// Error cuadrático medio por muestra x 100 entre dos imágenes del mismo tamaño.
fn mse100(a: Image, b: Image) -> int {
    var s: int = 0
    var n: int = 0
    var y: int = 0
    while y < a.height {
        var i: int = 0
        while i < a.width * a.channels {
            let d: int = a.rows[y].charAt(i) - b.rows[y].charAt(i)
            s = s + d * d
            n = n + 1
            i = i + 1
        }
        y = y + 1
    }
    return (s * 100) / n
}

// Byte de muestreo del componente 1 (el H/V de Y) en el SOF0 en decimal (34 = 0x22 = 4:2:0, 17 = 0x11 = 4:4:4), o -1 si no hay.
fn sof_sampling(b: String) -> int {
    var i: int = 2
    while i + 4 < b.length() {
        if b.charAt(i) != 0xFF { return 0 - 1 }
        let m: int = b.charAt(i + 1)
        let len: int = (b.charAt(i + 2) << 8) | b.charAt(i + 3)
        if m == 0xC0 { return b.charAt(i + 4 + 6 + 1) }
        i = i + 2 + len
    }
    return 0 - 1
}

// El perfil ICC de la imagen decodificada de estos bytes.
fn icc_of(bytes: String) -> String {
    let im: Image = dec(bytes)
    return im.icc
}

fn yn(x: bool) -> String {
    if x { return "sí" }
    return "no"
}

fn has(b: String, needle: String) -> bool {
    return b.indexOf(needle) >= 0
}

fn main() -> int {
    case("pil420-q80", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 80, include_bytes("tests/fixtures/image/encode/pil420-q80.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q80.ref"), 83, 61, 3, 1593809)
    case("pil420-q1", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 1, include_bytes("tests/fixtures/image/encode/pil420-q1.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q1.ref"), 83, 61, 3, 19830971)
    case("pil420-q10", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 10, include_bytes("tests/fixtures/image/encode/pil420-q10.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q10.ref"), 83, 61, 3, 9518396)
    case("pil420-q50", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 50, include_bytes("tests/fixtures/image/encode/pil420-q50.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q50.ref"), 83, 61, 3, 3429688)
    case("pil420-q90", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 90, include_bytes("tests/fixtures/image/encode/pil420-q90.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q90.ref"), 83, 61, 3, 584540)
    case("pil420-q91", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 91, include_bytes("tests/fixtures/image/encode/pil420-q91.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q91.ref"), 83, 61, 3, 191183)
    case("pil420-q100", include_bytes("tests/fixtures/image/jpeg/pil420.jpg"), 100, include_bytes("tests/fixtures/image/encode/pil420-q100.jpg"), include_bytes("tests/fixtures/image/encode/pil420-q100.ref"), 83, 61, 3, 4153)
    case("s444-q75", include_bytes("tests/fixtures/image/jpeg/s444.jpg"), 75, include_bytes("tests/fixtures/image/encode/s444-q75.jpg"), include_bytes("tests/fixtures/image/encode/s444-q75.ref"), 41, 27, 3, 3519170)
    case("s444-q95", include_bytes("tests/fixtures/image/jpeg/s444.jpg"), 95, include_bytes("tests/fixtures/image/encode/s444-q95.jpg"), include_bytes("tests/fixtures/image/encode/s444-q95.ref"), 41, 27, 3, 16748)
    case("gray-q80", include_bytes("tests/fixtures/image/jpeg/gray.jpg"), 80, include_bytes("tests/fixtures/image/encode/gray-q80.jpg"), include_bytes("tests/fixtures/image/encode/gray-q80.ref"), 41, 27, 1, 28289)
    case("gray-q20", include_bytes("tests/fixtures/image/jpeg/gray.jpg"), 20, include_bytes("tests/fixtures/image/encode/gray-q20.jpg"), include_bytes("tests/fixtures/image/encode/gray-q20.ref"), 41, 27, 1, 350671)
    case("disc-q80", include_bytes("tests/fixtures/image/resize/alpha-disc.png"), 80, include_bytes("tests/fixtures/image/encode/disc-q80.jpg"), include_bytes("tests/fixtures/image/encode/disc-q80.ref"), 48, 36, 3, 204207)
    case("rgba8-q60", include_bytes("tests/fixtures/image/rgba8.png"), 60, include_bytes("tests/fixtures/image/encode/rgba8-q60.jpg"), include_bytes("tests/fixtures/image/encode/rgba8-q60.ref"), 21, 13, 3, 1343637)

    // ── validaciones ──
    let base: Image = synth(20, 12, 3, 255)
    bad("q0", base, 0)
    bad("q101", base, 101)
    bad("q-5", base, 0 - 5)
    bad("ancho 0", Image { width: 0, height: 12, channels: 3, rows: [], icc: "", reduction: 1 }, 80)
    bad("65536 de ancho", Image { width: 65536, height: 1, channels: 3, rows: [], icc: "", reduction: 1 }, 80)
    bad("2 canales", Image { width: 1, height: 1, channels: 2, rows: ["ab"], icc: "", reduction: 1 }, 80)
    bad("faltan filas", Image { width: 2, height: 3, channels: 1, rows: ["ab"], icc: "", reduction: 1 }, 80)
    bad("fila corta", Image { width: 2, height: 1, channels: 3, rows: ["abc"], icc: "", reduction: 1 }, 80)
    println("calidad por omisión " + int_to_string(image_default_quality()))

    // ── tamaños mínimos: ida y vuelta con las dimensiones exactas ──
    for sz: Array in [[1, 1], [1, 17], [17, 1], [8, 8], [9, 9], [16, 16], [33, 5]] {
        let im: Image = synth(sz[0], sz[1], 3, 255)
        let b: Image = dec(enc(im, 90))
        println("rgb " + int_to_string(sz[0]) + "x" + int_to_string(sz[1]) + " -> " + int_to_string(b.width) + "x" + int_to_string(b.height) + "x" + int_to_string(b.channels) + " mse*100=" + int_to_string(mse100(im, b)))
    }
    let g: Image = synth(13, 7, 1, 255)
    let gb: Image = dec(enc(g, 85))
    println("gris 13x7 -> " + int_to_string(gb.width) + "x" + int_to_string(gb.height) + "x" + int_to_string(gb.channels) + " mse*100=" + int_to_string(mse100(g, gb)))

    // ── la regla de submuestreo, mirada en el SOF0: 34 (0x22) = 4:2:0, 17 (0x11) = 4:4:4 ──
    let big: Image = synth(64, 48, 3, 255)
    println("muestreo q90=" + int_to_string(sof_sampling(enc(big, 90))) + " q91=" + int_to_string(sof_sampling(enc(big, 91))) + " gris=" + int_to_string(sof_sampling(enc(synth(16, 16, 1, 255), 90))))

    // ── calidad: más calidad, menos error y más bytes ──
    let big80: String = enc(big, 80)
    let big30: String = enc(big, 30)
    let big95: String = enc(big, 95)
    println("monótono " + yn(big30.length() < big80.length() and big80.length() < big95.length()) + " " + yn(mse100(big, dec(big95)) < mse100(big, dec(big80)) and mse100(big, dec(big80)) < mse100(big, dec(big30))))

    // ── sin EXIF, con JFIF; la orientación ya viene aplicada ──
    let o6: Image = dec(include_bytes("tests/fixtures/image/jpeg/orient6.jpg"))
    let o6out: String = enc(o6, 80)
    let info: Result<ImageInfo, Error> = image_info(o6out)
    match info {
        Result.Ok(i) => { println("orient6 re-codificado: " + i.format + " " + int_to_string(i.width) + "x" + int_to_string(i.height) + " orientación " + int_to_string(i.orientation) + " progresivo " + yn(i.progressive)) }
        Result.Err(e) => { println("info ERR " + e.msg) }
    }
    println("JFIF " + yn(has(o6out, "JFIF")) + " Exif " + yn(has(o6out, "Exif")) + " XMP " + yn(has(o6out, "xpacket")) + " empieza FFD8 " + yn(o6out.charAt(0) == 0xFF and o6out.charAt(1) == 0xD8) + " termina FFD9 " + yn(o6out.charAt(o6out.length() - 2) == 0xFF and o6out.charAt(o6out.length() - 1) == 0xD9))

    // ── ICC: se conserva (uno y partido en dos APP2), y image_strip_icc lo quita ──
    let icc1: String = include_bytes("tests/fixtures/image/jpeg/icc.bin")
    let withicc: Image = Image { width: base.width, height: base.height, channels: 3, rows: base.rows, icc: icc1, reduction: 1 }
    println("icc 700 B: " + yn(icc_of(enc(withicc, 80)) == icc1))
    var bigicc: Array = []
    var k: int = 0
    while k < 70000 {
        bigicc.push((k * 7 + 3) & 0xFF)
        k = k + 1
    }
    let icc2: String = string_from_bytes(bigicc, 0, 70000)
    let withbig: Image = Image { width: base.width, height: base.height, channels: 3, rows: base.rows, icc: icc2, reduction: 1 }
    println("icc 70000 B (2 trozos): " + yn(icc_of(enc(withbig, 80)) == icc2))
    println("sin perfil: " + yn(icc_of(enc(image_strip_icc(withicc), 80)) == "") + " y sin quitar queda " + int_to_string(icc_of(enc(base, 80)).length()))

    // ── alfa: se compone sobre blanco (transparente -> blanco, opaco -> el color) ──
    let clear: Image = synth(8, 8, 4, 0)
    let cb: Image = dec(enc(clear, 95))
    println("transparente -> " + int_to_string(cb.channels) + " canales, píxel " + int_to_string(cb.rows[3].charAt(9)) + "," + int_to_string(cb.rows[3].charAt(10)) + "," + int_to_string(cb.rows[3].charAt(11)))
    let opaque: Image = synth(8, 8, 4, 255)
    println("opaco: igual que sin alfa: " + yn(enc(opaque, 80) == enc(synth(8, 8, 3, 255), 80)))
    // compuesto sobre otro fondo con image_flatten antes de codificar
    let green: Image = dec(enc(image_flatten(clear, 0, 255, 0), 95))
    println("fondo verde -> " + int_to_string(green.rows[3].charAt(9)) + "," + int_to_string(green.rows[3].charAt(10)) + "," + int_to_string(green.rows[3].charAt(11)))

    // ── cada fila de MCU cuenta: una imagen que pasa el límite de 16 y de 8 ──
    let tall: Image = synth(31, 40, 3, 255)
    let tb: Image = dec(enc(tall, 92))
    println("31x40 q92 -> " + int_to_string(tb.width) + "x" + int_to_string(tb.height) + " mse*100=" + int_to_string(mse100(tall, tb)))
    println("fin")
    return 0
}
