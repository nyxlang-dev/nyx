// test-477 — std/image, Task 3: JPEG secuencial (baseline) a píxeles (spec std-image, D-4/D-6).
//
// Cada caso decodifica un JPEG de tests/fixtures/image/jpeg/ y lo compara byte a byte
// con la referencia de PILLOW (libjpeg-turbo): el .ref lo escribió
// tests/fixtures/image/gen_jpeg_fixtures.py abriendo el mismo archivo con Pillow, no
// este código. Hay 4:4:4, 4:2:2, 4:2:0, 4:4:0, 4:1:1 y 4:1:0, gris, RGB con
// marcador Adobe, marcadores de reinicio (DRI/RSTn) con cada submuestreo, escaneos de
// un componente y mixtos, SOF1, tablas Huffman repartidas, relleno FF, las 8
// orientaciones EXIF (y un XMP detrás del EXIF), imágenes de 1x1 y 9x9 y JPEG de Pillow.
// Un caso «-dN» es la decodificación reducida a 1/N (image_decode_scaled).
//
// Criterio: `sumsq` es la suma de los cuadrados de las diferencias contra Pillow y `max`
// la mayor diferencia. Umbral 99 = tiene que ser IDÉNTICO a Pillow (sumsq 0); umbral 30
// o 40 = PSNR >= ese valor en dB (sumsq * 10^(dB/10) <= 255^2 * muestras), que es
// como la spec pide medir donde los decodificadores difieren (reducción, y el croma
// de los submuestreos que libjpeg-turbo no interpola). Pasa si cumple el umbral.

import "std/image"
import "std/error"

fn check(name: String, jpg: String, ref: String, w: int, h: int, ch: int, denom: int, thr: int) {
    var r: Result<Image, Error> = image_decode(jpg, image_limits())
    if denom > 1 { r = image_decode_scaled(jpg, image_limits(), denom) }
    match r {
        Result.Err(e) => { println(name + " ERR " + e.kind + ": " + e.msg) }
        Result.Ok(img) => {
            if img.width != w or img.height != h or img.channels != ch or img.rows.length() != h {
                println(name + " FORMA " + int_to_string(img.width) + "x" + int_to_string(img.height) + "x" + int_to_string(img.channels) + " esperado " + int_to_string(w) + "x" + int_to_string(h) + "x" + int_to_string(ch))
                return
            }
            if ref.length() != w * h * ch {
                println(name + " REF de largo " + int_to_string(ref.length()))
                return
            }
            var sumsq: int = 0
            var mx: int = 0
            var y: int = 0
            while y < h {
                let row: String = img.rows[y]
                var i: int = 0
                while i < w * ch {
                    var dd: int = row.charAt(i) - ref.charAt(y * w * ch + i)
                    if dd < 0 { dd = 0 - dd }
                    if dd > mx { mx = dd }
                    sumsq = sumsq + dd * dd
                    i = i + 1
                }
                y = y + 1
            }
            var ok: bool = false
            if thr == 99 { ok = sumsq == 0 }
            if thr == 40 { ok = sumsq * 10000 <= 65025 * w * h * ch }
            if thr == 30 { ok = sumsq * 1000 <= 65025 * w * h * ch }
            var verdict: String = "FALLA"
            if ok { verdict = "ok" }
            println(name + " " + int_to_string(w) + "x" + int_to_string(h) + " ch=" + int_to_string(ch) + " red=" + int_to_string(img.reduction) + " sumsq=" + int_to_string(sumsq) + " max=" + int_to_string(mx) + " " + verdict)
        }
    }
}

fn main() -> int {
    check("s444", include_bytes("tests/fixtures/image/jpeg/s444.jpg"), include_bytes("tests/fixtures/image/jpeg/s444.ref"), 41, 27, 3, 1, 99)
    check("s444-d2", include_bytes("tests/fixtures/image/jpeg/s444.jpg"), include_bytes("tests/fixtures/image/jpeg/s444-d2.ref"), 21, 14, 3, 2, 99)
    check("s444-d4", include_bytes("tests/fixtures/image/jpeg/s444.jpg"), include_bytes("tests/fixtures/image/jpeg/s444-d4.ref"), 11, 7, 3, 4, 99)
