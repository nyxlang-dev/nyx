    check("s440", include_bytes("tests/fixtures/image/jpeg/s440.jpg"), include_bytes("tests/fixtures/image/jpeg/s440.ref"), 41, 27, 3, 1, 99)
    check("s440-d2", include_bytes("tests/fixtures/image/jpeg/s440.jpg"), include_bytes("tests/fixtures/image/jpeg/s440-d2.ref"), 21, 14, 3, 2, 99)
