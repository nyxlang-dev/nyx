// Fix soundness inc 2: `self` by-value es un frame-local (copia) → guardar `&v` en
// `self.f` NO escapa. No debe marcar NYX1222 (se pierde la detección de &mut self.f=&x,
// miss seguro documentado). NYX_BORROW=error.
struct Box { f: *int }

impl Box {
    fn set(self, v: int) {
        self.f = &v
    }
}

fn main() {
    var b: Box = Box { f: 0 as *int }
    b.set(7)
    print(1)
}
