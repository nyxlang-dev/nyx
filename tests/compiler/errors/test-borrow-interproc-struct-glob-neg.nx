// inc 3c-2a NEG: Ref<'a> es ref-like, pero el arg es un GLOBAL (no frame-bound) →
// ninguna fuente cuelga → sin marca.
let G: int = 7
struct Ref<'a> { r: &'a int }

fn make(x: &int) -> Ref { return Ref { r: x } }

fn caller() -> Ref {
    let h: Ref = make(&G)
    return h
}

fn main() { print(1) }
