// two() tiene 2 params-ref y NO anota 'a → elisión es ambigua → no se infiere origen
// (miss seguro, Etapa 2 lo resolvería con 'a explícito).
fn two(a: &int, b: &int) -> &int { return a }

fn caller() -> &int {
    let local: int = 1
    let x: int = 2
    let r: &int = two(&local, &x)
    return r
}

fn main() { print(1) }
