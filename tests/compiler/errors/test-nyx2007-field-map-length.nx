// NYX2007 (S9, ronda 2): `length` sobre un campo Map. El bloque field_access
// despachaba TODO por nombre; `length` emitía nyx_array_length sobre el i8* del
// Map. Hermano del test de `push`. (Un campo String sí puede `.length()`: ése
// cae al camino genérico y ahora funciona — antes también leía el String como
// Array.)
// Expected stderr (contains): "NYX2007"
struct S { m: Map<String, int> }

fn main() -> int {
    let s: S = S { m: {"a": 1} }
    print(s.m.length())
    return 0
}
