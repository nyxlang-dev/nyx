// http_find_headers devuelve Array<String>: los valores de cabecera son texto.
// Anotar un valor como int es NYX1003; antes compilaba y leía el puntero del
// String como entero.
import "std/http"

fn main() {
    let planas = ["Set-Cookie", "a=1", "Set-Cookie", "b=2"]
    let cookies = http_find_headers(planas, "set-cookie")
    let n: int = cookies[0]
    print(n)
}

main()
