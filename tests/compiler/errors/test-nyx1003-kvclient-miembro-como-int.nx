// kv_smembers devuelve Array<String>: todo elemento RESP llega como texto
// (también los enteros). Anotar un miembro como int es NYX1003; antes
// compilaba y leía el puntero del String como entero.
import "std/kvclient"

fn main() {
    let miembros = kv_smembers(0, "set")
    let n: int = miembros[0]
    print(n)
}

main()
