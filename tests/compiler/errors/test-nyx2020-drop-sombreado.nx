// NYX2020: dos locales afín-con-Drop con el mismo nombre en una función. El
// drop determinista (T4c) lleva sus slots por nombre; antes del arco
// alcance-de-bloque-codegen esto terminaba en «redefinition of %r.dropslot»
// de clang, sin línea. Ahora es un error que explica qué renombrar.
import "std/owned"
var g_drops: int = 0
var g_suma: int = 0
#[affine]
struct Res { id: int }
impl Drop for Res { fn drop(self) { g_drops = g_drops + 1  g_suma = g_suma + self.id } }
fn sombreado(flag: bool) {
    let r: Res = Res { id: 10 }
    if flag {
        let r: Res = Res { id: 1 }
        print("adentro " + int_to_string(r.id))
    }
    print("afuera " + int_to_string(r.id))
}
fn main() {
    sombreado(true)
    print("drops=" + int_to_string(g_drops) + " suma=" + int_to_string(g_suma))
    assert(g_drops == 2)
    assert(g_suma == 11)
    print("ok")
}
