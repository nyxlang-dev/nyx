import "std/owned"
var g_drops: int = 0
#[affine]
struct Res { id: int }
impl Drop for Res { fn drop(self) { g_drops = g_drops + 1 } }
fn consume(r: Res) {
    print("consumed " + int_to_string(r.id))
}
fn main() {
    let x: Res = Res { id: 9 }
    consume(x)
    print("drops=" + int_to_string(g_drops))
    assert(g_drops == 1)
    print("ok")
}
