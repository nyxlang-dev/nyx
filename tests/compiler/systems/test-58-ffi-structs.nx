// Test 58: FFI structs with #[repr(C)]

#[repr(C)]
struct Point {
    x: int,
    y: int
}

extern "C" fn labs(n: int) -> int

fn main() -> int {
    // repr(C) struct init (stack allocated)
    var p = Point { x: -5, y: 10 }
    let abs_x: int = labs(p.x)
    print(abs_x)
    assert(abs_x == 5)
    print(p.y)
    assert(p.y == 10)

    // Modify fields
    p.x = 42
    print(p.x)
    assert(p.x == 42)

    return 0
}
