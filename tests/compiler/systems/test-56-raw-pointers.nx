// Test 56: Raw pointers and unsafe blocks

fn main() -> int {
    // Basic pointer: address-of and dereference
    var x: int = 42
    unsafe {
        let p: *int = &x
        let val: int = *p
        print(val)  // 42
        assert(val == 42)

        // Write through pointer
        *p = 100
    }
    print(x)  // 100
    assert(x == 100)

    // Pointer to i32
    var y: i32 = 10i32
    unsafe {
        let q: *i32 = &y
        let v: i32 = *q
        print(v)  // 10
        // BUG (2026-07-30, ver report task-3): `v == 10i32` comparando dos i32
        // donde al menos uno viene de una variable (no literal-literal) rompe
        // codegen — "defined with type 'i32' but expected 'i64'" en clang.
        // Repro mínimo: `let a: i32 = 1i32; let b: i32 = 2i32; let c: bool = a
        // == b`. Workaround acá: castear a `int` antes de comparar (no toca
        // compiler/, fuera de scope de esta tarea).
        assert((v as int) == 10)

        *q = 20i32
    }
    print(y)  // 20
    assert((y as int) == 20)

    return 0
}
