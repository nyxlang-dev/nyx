import "std/owned"

var g_drops: int = 0

#[affine]
struct Res { id: int }

impl Drop for Res {
    fn drop(self) { g_drops = g_drops + 1 }
}

fn make_res() -> Res {
    let r: Res = Res { id: 1 }
    return r          // MOVE afuera: make_res NO debe dropear r
}

fn scope() {
    let x: Res = make_res()   // x es dueño ahora
    print("id=" + int_to_string(x.id))
}                             // x drop aquí (una vez)

fn main() {
    scope()
    print("drops=" + int_to_string(g_drops))
    assert(g_drops == 1)      // exactamente 1: si make_res dropeara r → 2
    print("ok")
}
