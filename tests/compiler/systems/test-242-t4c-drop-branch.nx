import "std/owned"
var g_drops: int = 0
#[affine]
struct Res { id: int }
impl Drop for Res { fn drop(self) { g_drops = g_drops + 1 } }
fn use_branch(flag: bool) {
    if flag {
        let a: Res = Res { id: 1 }
        print("then " + int_to_string(a.id))
    } else {
        let b: Res = Res { id: 2 }
        print("else " + int_to_string(b.id))
    }
}
fn main() {
    use_branch(true)
    use_branch(false)
    print("drops=" + int_to_string(g_drops))
    assert(g_drops == 2)
    print("ok")
}
