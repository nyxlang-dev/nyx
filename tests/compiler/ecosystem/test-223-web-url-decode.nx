// test-223-web-url-decode — std/web::url_decode ahora decodifica percent-encoding
// (%XX), no solo `+`. Antes corrompía silenciosamente toda la ingesta de forms.
// Self-checking con assert().

import "std/web"

fn main() {
    // url_decode directo
    assert(url_decode("hello%20world") == "hello world")   // %20 → espacio
    assert(url_decode("a+b") == "a b")                      // + → espacio (preservado)
    assert(url_decode("a%26b") == "a&b")                    // %26 → &
    assert(url_decode("x%3Dy") == "x=y")                    // %3D → =
    assert(url_decode("plain") == "plain")                  // sin encoding, intacto
    assert(url_decode("S%C3%A3o") == "São")                 // UTF-8 multibyte

    // parse_query_string usa url_decode en clave y valor.
    // NOTA: Map.get() se bindea a `let` tipado a propósito — usarlo INLINE en la
    // comparación (`assert(q.get(k) == ...)`) hoy da SEGV (bug de coerción i64→ptr
    // inline, mismo caso que arr[i]; ver TASKS.md item Map.get String inline).
    let q: Map = parse_query_string("/search?name=John%20Doe&city=S%C3%A3o")
    let qname: String = q.get("name")
    let qcity: String = q.get("city")
    assert(qname == "John Doe")
    assert(qcity == "São")

    // parse_form_data (application/x-www-form-urlencoded)
    let f: Map = parse_form_data("msg=hola%20mundo&expr=1%2B1%3D2", "application/x-www-form-urlencoded")
    let fmsg: String = f.get("msg")
    let fexpr: String = f.get("expr")
    assert(fmsg == "hola mundo")
    assert(fexpr == "1+1=2")                                // %2B → + literal, %3D → =

    print("web url_decode OK")
}
