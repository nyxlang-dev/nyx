// test-374 (E5.1): las hermanas try_ de red — try_tcp_connect/
// try_tcp_listen/try_udp_bind devuelven Result<int, Error> en vez de
// abortar/loggear por stderr como las centinelas viejas
// (tcp_connect/tcp_listen/tcp_close, builtins).
//
// Import bare (`import "std/modulo"`, ver test-372/373): la forma
// `{ } from` quedó obsoleta desde Task 1.
//
// std/net (no std/socket): módulo NUEVO — ver el comentario header de
// std/net.nx para el porqué (mismo mecanismo que std/fs.nx, sin el
// problema de congelamiento del prelude).

import "std/net"
import "std/error"

fn main() -> int {
    // (a) listen efímero (puerto 0 → el kernel asigna uno libre) — Ok.
    let l: Result<int, Error> = try_tcp_listen("127.0.0.1", 0)
    if l.is_ok() { print("listen-ok") }
    match l {
        Result.Ok(fd) => { tcp_close(fd) }
        Result.Err(e) => { print("no-deberia") }
    }

    // (b) connect a un puerto alto cerrado (nadie escucha ahí) — Err con
    // kind "connection" y code 111 (ECONNREFUSED, salida MEDIDA). El 58734
    // está dentro del rango efímero, pero un connect no es vulnerable a eso:
    // un puerto que otro proceso usa como LOCAL de una conexión saliente no
    // acepta conexiones, así que igual da ECONNREFUSED.
    match try_tcp_connect("127.0.0.1", 58734) {
        Result.Ok(fd) => { print("no-deberia") ; tcp_close(fd) }
        Result.Err(e) => { print(e.kind) ; print(int_to_string(e.code)) }
    }

    // (c) listen duplicado del MISMO puerto — el primero reserva el puerto,
    // el segundo choca contra EADDRINUSE. Salida MEDIDA de kind/code
    // (decisión in_use documentada en std/error.nx).
    // SIN PUERTO FIJO (2026-09-14): antes eran dos listen al 58735, dentro del
    // rango efímero del kernel (32768–60999), de donde salen los puertos
    // locales de las conexiones salientes de cualquier proceso; si otro lo
    // tenía tomado, el PRIMER listen fallaba (medido en test_net_result.c el
    // 2026-09-13). Ahora el primero va al puerto 0 y try_local_port lee
    // cuál asignó el kernel: la colisión es la que el test provoca y ninguna otra.
    let first: Result<int, Error> = try_tcp_listen("127.0.0.1", 0)
    match first {
        Result.Ok(fd1) => {
            match try_local_port(fd1) {
                Result.Ok(puerto) => {
                    if puerto > 0 { print("port-ok") }
                    match try_tcp_listen("127.0.0.1", puerto) {
                        Result.Ok(fd2) => { print("no-deberia") ; tcp_close(fd2) }
                        Result.Err(e2) => { print(e2.kind) ; print(int_to_string(e2.code)) }
                    }
                }
                Result.Err(ep) => { print("no-deberia-puerto") }
            }
            tcp_close(fd1)
        }
        Result.Err(e1) => { print("no-deberia-tampoco") }
    }

    // (d) host NO-numérico ("localhost") — review final F1: inet_pton()
    // no lo parsea (no es una IP), runtime/net.c ahora lo rechaza con
    // -EINVAL en vez de bindear INADDR_ANY en silencio. kind "invalid"
    // (vocabulario cerrado de std/error.nx), code 22.
    match try_tcp_listen("localhost", 0) {
        Result.Ok(fd3) => { print("no-deberia-tampoco-2") ; tcp_close(fd3) }
        Result.Err(e3) => { print(e3.kind) ; print(int_to_string(e3.code)) }
    }

    // (e) try_local_port sobre un fd inválido — Err con EBADF (9), que
    // errno_to_kind lleva a "io".
    match try_local_port(-1) {
        Result.Ok(p) => { print("no-deberia-puerto-2") }
        Result.Err(e4) => { print(e4.kind) ; print(int_to_string(e4.code)) }
    }

    // smoke de convivencia: los builtins viejos (tcp_listen/tcp_close)
    // siguen funcionando sin tocar nada de este módulo.
    let old: int = tcp_listen("127.0.0.1", 0)
    tcp_close(old)
    print("sigo-vivo")
    return 0
}
