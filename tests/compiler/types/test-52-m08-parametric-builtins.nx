// Test 52: M-08 session 7 — happy path for parametric built-in methods.
//
// Exercises: Array<T>.push/contains/indexOf, Array.join, Array.slice,
// Map<K,V>.put/get/has, with every call type-correct against the
// receiver's element / key / value types.

fn main() -> int {
    var nums: Array<int> = [1, 2, 3]
    nums.push(4)
    let tail: Array<int> = nums.slice(1, 3)

    let words: Array<String> = ["uno", "dos", "tres"]
    let joined: String = words.join(", ")

    print(int_to_string(nums.length()))
    print(int_to_string(tail.length()))
    print(joined)
    print("OK")
    return 0
}
