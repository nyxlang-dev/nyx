// Test 48: M-08 session 3 — happy path for binop type inference.
//
// Exercises:
//   - arithmetic int op int → int
//   - arithmetic float op int → float (coercion)
//   - String concat (+) with int and bool coerced
//   - comparison → bool
//   - logical and/or → bool
//   - bitwise & | ^ << >> → int
//   - unary ! (bool), - (int/float), ~ (int)

fn main() -> int {
    let a: int = 2 + 3 * 4
    let b: float = 1.5 + 2.0
    let s: String = "valor: " + a
    let msg: String = "flag: " + true

    let cmp: bool = a < 100
    let both: bool = cmp and b > 0.0
    let either: bool = cmp or false

    let mask: int = (0xFF & 0x0F) | (1 << 3)
    let xor: int = mask ^ 1
    let neg: int = -a
    let flip: bool = !cmp
    let comp: int = ~mask

    print(int_to_string(a))
    print(float_to_string(b))
    print(s)
    print(msg)
    if both { print("both") }
    if either { print("either") }
    print(int_to_string(mask))
    print(int_to_string(xor))
    print(int_to_string(neg))
    if flip { print("flip-true") } else { print("flip-false") }
    print(int_to_string(comp))
    print("OK")
    return 0
}
