// Struct tupla completo: varios campos posicionales, constructor `Nombre(a, b)`
// e índice `p.0` (además de `p._0`). Hasta 2026-11-11 la declaración aceptaba
// un solo tipo, `Id(3)` llegaba a clang como una llamada a una función que no
// existe y `i.0` daba 0 con un mensaje suelto.
struct Id(int)
struct Point(int, int)
struct Par(String, float,)
fn suma(p: Point) -> int { return p.0 + p.1 }
fn hacer(n: int) -> Point { return Point(n, n * 2) }
fn main() {
    let i = Id(3)
    assert(i.0 == 3)
    assert(i._0 == 3)
    let p = Point(3, 4)
    assert(p.0 == 3)
    assert(p._1 == 4)
    assert(suma(p) == 7)
    assert(suma(Point(10, 20)) == 30)
    assert(suma(hacer(5)) == 15)
    let q = Par("x", 1.5)
    assert(q.0 == "x")
    assert(q.1 > 1.4)
    // La forma con llaves sigue valiendo.
    let r = Point { _0: 1, _1: 2 }
    assert(r.0 + r.1 == 3)
    // Las tuplas de siempre no cambian.
    let t = (1, "dos")
    assert(t.0 == 1)
    assert(t.1 == "dos")
    print("ok")
}
