// test-145-spawn: verifica la sintaxis spawn { body } para goroutines.
//
// `spawn { }` compila a nyx_goroutine_spawn_closure_detached: una goroutine
// DETACHED sobre el scheduler M:N, que se auto-cosecha. (El comentario viejo
// decía «desugars to thread_spawn»; eso dejó de ser cierto en T5b.2 — ver
// test-243, que documenta el re-apuntado. Corregido 2026-09-10.)
//
// El contador es lo que convierte esto en un test (review pre-merge de W3 H1):
// antes solo imprimía, así que un `spawn` que no ejecutara el cuerpo salía con
// rc=0 igual. En el subset de Windows entra como NONE —gate = rc=0— o sea que
// ahí el print no lo miraba nadie.
import "std/sync"

var corridas: AtomicCounter = counter_new(0)

fn main() -> int {
    // Fire-and-forget: cada una registra que su cuerpo REALMENTE corrió.
    spawn { print("goroutine 1"); counter_inc(corridas); return 0 }
    spawn { print("goroutine 2"); counter_inc(corridas); return 0 }
    spawn { print("goroutine 3"); counter_inc(corridas); return 0 }

    // Give goroutines time to run
    sleep(50)

    assert(counter_get(corridas) == 3)

    print("spawn syntax ok")
    print("spawn ok")
    return 0
}
