// test-309-chained-array-method.nx — método encadenado sobre retorno Array (P1)
//
// `f(args).length()` con `fn f(...) -> Array` compilaba SIN error y devolvía 0:
// el camino de receiver-EXPRESIÓN de codegen_method_call no tenía ramas para
// métodos de Array, así que caía al `return "i64 0"` mudo. El IR lo mostraba
// crudo: la call devolvía `{ i64, i8* }*` correctamente y el método emitía la
// CONSTANTE 0, ignorando el receiver. Silently-wrong = anti AI-first; se cazó
// escribiendo el test de D6 (http_find_headers), donde un assert encadenado
// daba falso negativo.
// Bindear primero SIEMPRE funcionó — el bug es solo el encadenado.
// Self-checking con assert() (abortivo).

fn tres() -> Array {
    let a: Array = [10, 20, 30]
    return a
}

fn palabras() -> Array {
    let w: Array = ["uno", "dos"]
    return w
}

fn vacio() -> Array {
    let e: Array = []
    return e
}

fn test_length_encadenado() {
    // El caso que motivó el ítem
    assert(tres().length() == 3)
    assert(vacio().length() == 0)
    // Y sigue coincidiendo con la forma bindeada
    let b: Array = tres()
    assert(b.length() == tres().length())
    print("length encadenado ok")
}

fn test_otros_metodos_encadenados() {
    assert(tres().indexOf(20) == 1)
    assert(tres().indexOf(99) == 0 - 1)
    let j: String = palabras().join("-")
    assert(j == "uno-dos")
    // reverse() muta IN-PLACE y devuelve void (contrato preexistente del
    // lenguaje, igual que sobre una variable) — encadenado sobre un temporal
    // no tiene efecto observable; no se testea un valor de retorno que no existe.
    let s: Array = tres().slice(1, 3)
    assert(s.length() == 2)
    assert(s[0] == 20)
    // pop/shift devuelven el elemento (mutan el temporal, que se descarta)
    assert(tres().pop() == 30)
    assert(tres().shift() == 10)
    print("otros metodos encadenados ok")
}

fn test_lo_que_ya_funcionaba() {
    // Regresión: la indexación encadenada y los métodos de String encadenados
    // NUNCA estuvieron rotos — verificar que siguen bien.
    assert(tres()[0] == 10)
    assert(tres()[2] == 30)
    print("indexacion encadenada intacta ok")
}

fn main() {
    test_length_encadenado()
    test_otros_metodos_encadenados()
    test_lo_que_ya_funcionaba()
    print("test-309-chained-array-method ok")
}
