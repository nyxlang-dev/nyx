// test-389 — orden lexicográfico entre String: <, <=, >, >=
//
// Reporte de fricción 2026-09-08: los cuatro operadores de orden emitían
// `icmp slt i64` sobre dos %nyx_string*, IR inválido que clang rechazaba al
// enlazar («'%618' defined with type 'ptr' but expected 'i64'»), mientras
// `nyx check` y `nyx vet` daban el programa por bueno. La rama de comparación
// de punteros EXCLUÍA %nyx_string* pero nadie agregó la de comparar por
// contenido, así que caía al fallback entero.
//
// Semántica: lexicográfico por BYTES (nyx_string_compare = memcmp + longitud;
// a igual prefijo gana la más corta). Consistente con «Strings = bytes».

fn main() -> int {
    // Caso del reporte: fechas AAAA-MM-DD ordenan cronológicamente como texto
    let a: String = "2025-06-01"
    let b: String = "2025-06-02"
    assert(a <= b, "a <= b")
    assert(a < b, "a < b")
    assert(b > a, "b > a")
    assert(b >= a, "b >= a")
    assert(not (b <= a), "not (b <= a)")
    assert(not (a > b), "not (a > b)")

    // Iguales: <= y >= verdaderos, < y > falsos
    let c: String = "2025-06-01"
    assert(a <= c, "iguales: <=")
    assert(a >= c, "iguales: >=")
    assert(not (a < c), "iguales: not <")
    assert(not (a > c), "iguales: not >")

    // Prefijo: a igual prefijo, gana la más corta
    assert("abc" < "abcd", "prefijo mas corto primero")
    assert("abcd" > "abc", "prefijo mas largo despues")

    // Orden por byte, no por longitud
    assert("b" > "abc", "orden por byte, no por largo")

    // Vacía es la menor
    assert("" < "a", "vacia menor")
    assert("" <= "", "vacia igual")

    // Mayúsculas antes que minúsculas (ASCII)
    assert("Z" < "a", "mayuscula antes que minuscula (ASCII)")

    // El uso real del reporte: elegir el más reciente de una lista de fechas
    var fechas: Array = ["2025-06-02", "2025-01-15", "2025-12-31", "2025-03-08"]
    var maxf: String = fechas[0]
    var i: int = 1
    while i < fechas.length() {
        let f: String = fechas[i]
        if f > maxf { maxf = f }
        i = i + 1
    }
    assert(maxf == "2025-12-31", "maximo por comparacion lexicografica")

    print("OK test-389 string order compare")
    return 0
}
